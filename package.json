{
  "name": "princetires-live-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Playwright + Lighthouse checks of the live princetires.ca storefront.",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.3.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "perf": "node scripts/lighthouse-budget.mjs",
    "perf:baseline": "node scripts/lighthouse-budget.mjs --write-baseline",
    "test:scripts": "node --test scripts/lighthouse-budget.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDAllan/princetires.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MDAllan/princetires/issues"
  },
  "homepage": "https://github.com/MDAllan/princetires#readme"
}
