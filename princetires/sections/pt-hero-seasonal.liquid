    {
      "type": "checkbox",
      "id": "enable_snow",
      "label": "Falling snow on winter states",
      "default": true,
      "info": "Pure CSS — no images, no scripts, no extra requests. Off automatically in spring and summer."
    },
    {
      "type": "header",
      "content": "Search"
