        { "value": "preseason",   "label": "Force: Pre-season (beat the rush)" },
        { "value": "changeover",  "label": "Force: Winter changeover rush" },
        { "value": "deep_winter", "label": "Force: Deep winter (repair/replace)" },
        { "value": "spring",      "label": "Force: Spring swap-back" },
