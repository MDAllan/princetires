{%- comment -%}
  No JSON-LD here on purpose. The old LocalBusiness block carried a placeholder
  address and towns we don't serve. Business schema lives in the site-wide
  LocalBusiness snippet, which reads the real NAP from pt-nap.
{%- endcomment -%}
<section
  class="abth"
  style="
    --abth-bg: {{ section.settings.bg_color }};
    --abth-text: {{ section.settings.text_color }};
    --abth-accent: {{ section.settings.accent_color }};
    --abth-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.image != blank -%}
    <div class="abth__bg" aria-hidden="true">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
      <div class="abth__overlay"></div>
    </div>
  {%- endif -%}

  <div class="abth__container">
    <div class="abth__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="abth__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="abth__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="abth__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="abth__ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_link | default: routes.root_url }}" class="abth__btn abth__btn--primary">
            {{ section.settings.cta_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_link | default: '#' }}" class="abth__btn abth__btn--secondary">
            {{ section.settings.cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.last_updated != blank -%}
        <p class="abth__updated">
          <time datetime="{{ section.settings.last_updated }}">Last updated: {{ section.settings.last_updated | date: "%B %-d, %Y" }}</time>
        </p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="abth__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="abth__stat" {{ block.shopify_attributes }}>
              <span class="abth__stat-value">{{ block.settings.value }}</span>
              <span class="abth__stat-label">{{ block.settings.label }}</span>
            </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .abth {
    background: #fff;
    font-family: 'Outfit', sans-serif;
    padding: 7rem 0 0;
  }

  .abth__bg { display: none; }
  .abth__overlay { display: none; }

  .abth__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 6rem;
    width: 100%;
  }

  .abth__content {
    max-width: 780px;
    padding-bottom: 3rem;
  }

  .abth__eyebrow {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: #dc2626;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .abth__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: #111;
  }

  .abth__subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1.7;
    color: #6b7280;
    margin: 0 0 2rem;
    max-width: 600px;
  }

  .abth__ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .abth__updated {
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #9ca3af;
    text-transform: uppercase;
  }
  .abth__updated time { color: inherit; }

  .abth__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    padding: 0.8rem 1.75rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .abth__btn--primary {
    background: #dc2626;
    color: #fff;
  }

  .abth__btn--primary:hover {
    background: #b91c1c;
    transform: translateY(-1px);
  }

  .abth__btn--secondary {
    background: #f9fafb;
    color: #111;
    border: 1px solid #e5e7eb;
  }

  .abth__btn--secondary:hover {
    background: #f0f0f0;
    transform: translateY(-1px);
  }

  .abth__stats {
    display: flex;
    border-top: 1px solid #f3f4f6;
    margin-top: 3rem;
  }

  .abth__stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1.5rem 1rem;
    border-right: 1px solid #f3f4f6;
  }

  .abth__stat:last-child {
    border-right: none;
  }

  .abth__stat-value {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #F5820B;
    line-height: 1;
  }

  .abth__stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    color: #6b7280;
    text-align: center;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 989px) {
    .abth__container {
      padding: 0 4rem;
    }
    .abth__stats {
      flex-wrap: wrap;
    }
    .abth__stat {
      flex: 1 1 50%;
      border-right: none;
      border-bottom: 1px solid #f3f4f6;
    }
    .abth__stat:nth-child(odd) {
      border-right: 1px solid #f3f4f6;
    }
    .abth__stat:last-child,
    .abth__stat:nth-last-child(2):nth-child(odd) {
      border-bottom: none;
    }
  }

  @media (max-width: 749px) {
    .abth {
      padding: 5rem 0 0;
    }
    .abth__heading {
      font-size: clamp(2.2rem, 8vw, 3.6rem);
    }
    .abth__container {
      padding: 0 2rem;
    }
    .abth__subtitle {
      font-size: 1.25rem;
    }
    .abth__stat {
      flex: 1 1 50%;
      border-right: none;
      border-bottom: 1px solid #f3f4f6;
    }
    .abth__stat:nth-child(odd) {
      border-right: 1px solid #f3f4f6;
    }
    .abth__stat:last-child {
      border-bottom: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About — Hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "About Prince Tires"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "default": "Calgary's Trusted Tire Shop — Quality You Can Drive On"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Serving Calgary drivers across every neighbourhood since day one. From winter tires to seasonal swaps, we keep your vehicle road-ready with honest pricing and same-day service."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop tires"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Book an appointment"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated date (YYYY-MM-DD)",
      "info": "Optional freshness signal for SEO/GEO. Renders as 'Last updated: Mon DD, YYYY' below the CTAs.",
      "default": "2026-05-13"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F5820B"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2022"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Family-owned since"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About — Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "2022", "label": "Family-owned since" } },
        { "type": "stat", "settings": { "value": "2", "label": "Calgary shops" } },
        { "type": "stat", "settings": { "value": "4.9★", "label": "Google rating" } },
        { "type": "stat", "settings": { "value": "60+", "label": "Tire brands" } }
      ]
    }
  ]
}
{% endschema %}
