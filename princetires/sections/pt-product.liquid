{%- comment -%}
  Product page for TIRES and WHEELS - 2026-11-13 redesign, the owner-approved
  TIGHT layout (canvas Product / ProductMobile / ProductStates /
  WheelProduct / WheelProductMobile .dc.html).

  Layout: thumbs column + photo left; compact buy box right (price, "Tires
  only" set line, lead time, "- 4 +" stepper on the same row as the red
  "Request installation", outlined "Add to cart - $X", installed total incl.
  GST with its breakdown); then 3 cards (specs / installation / will it fit)
  and tabs (description / warranty / shipping & returns / FAQ). Under 990px
  the cards and tabs become one list of dropdowns and the title sits above
  the photo. Styles: assets/pt-rd-pdp.css (all .rdp- prefixed) on top of the
  shared assets/pt-rd.css (.rd-).

  Contracts other code reads - keep them when editing:
  - booking buttons (.ptp__book-btn, .ptp__sticky-book): every data-* that
    openBookingModal(btn) reads. data-qty is new: the stepper's quantity,
    also written to localStorage pt-booking-qty just before the modal opens.
  - .ptp__quote-btn data-* (openQuoteModal), [data-pt-trade-info] and
    [data-pt-price][data-pt-variant-id][data-pt-multiplier] (pt-header
    trade-price toggle; the multiplier follows the stepper).
  - back-in-stock: [data-ptp-bis-*] + the POST to /api/stock-notify.
  - pt-recently-viewed: .ptp__title, .ptp__vendor, .ptp__gallery-main-img,
    .ptp__price-current, .ptp__pricing-card[data-pt-unit].
  - pt-clearance-badge: .ptp__title.
  - tests: .ptp__stock[data-pt-stock-kind][data-pt-stock-state],
    .ptp__cta-stack, a[data-pt-call-to-book], .ptp__add-btn.
  - .ptp__installed-price data-set-count / set-cents / install-cents /
    levy-cents / levy-in-price / wheel / gst-cents / total-cents and
    .ptp__installed-note[data-pt-levy-in-total] (kept in step with the stepper).
{%- endcomment -%}
{%- liquid
  assign tire_size = product.metafields.custom.tire_size | default: ''
  assign product_title = product.title

  assign inventory_source = 'store'
  if product.tags contains 'trial'
    assign inventory_source = 'trial'
  endif

  comment
    Is this a WHEEL? The rule lives in snippets/pt-is-wheel.liquid (merged
    2026-11-13 with the app's productKind rule): no tire size, and a bolt
    pattern, or a type naming wheels / rims / alloy, or the Wheels tag, or a
    blank type whose title names wheels / rims. 107 Armed "Blank"
    (undrilled) wheels have no bolt pattern, so the bolt pattern alone is not
    enough.
  endcomment
  capture pt_is_wheel_raw
    render 'pt-is-wheel', product: product
  endcapture
  assign is_wheel = false
  if pt_is_wheel_raw contains 'true'
    assign is_wheel = true
  endif

  assign season_tag = ''
  comment
    Canonical source: custom.seasonality metafield. Tag loop is a fallback only
    - imported products often carry both an "all-weather-rated" tag AND a stray
    "Summer" supplier-feed tag, so the in-loop reassignment let the last match
    win and the PDP showed the wrong badge + wrong FAQ/recommendation copy.
  endcomment
  assign m_season = product.metafields.custom.seasonality | default: ''
  if m_season != blank
    assign season_tag = m_season
  endif
  if season_tag == blank
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'winter'
        assign season_tag = 'Winter'
      elsif tag_down contains 'all-weather' or tag_down contains 'all weather'
        assign season_tag = 'All-Weather'
      elsif tag_down contains 'all-season' or tag_down contains 'all season'
        assign season_tag = 'All-Season'
      elsif tag_down contains 'summer'
        assign season_tag = 'Summer'
      endif
    endfor
  endif
  if season_tag == blank
    assign type_down = product.type | downcase
    if type_down contains 'winter'
      assign season_tag = 'Winter'
    elsif type_down contains 'passenger'
      assign season_tag = 'All-Season'
    elsif type_down contains 'trailer'
      assign season_tag = 'Trailer'
    endif
  endif
  comment
    A season (and 3PMSF) is a TIRE rating. Wheels get no season; "Winter
    approved" (a wheel fact) is kept in wheel_winter_ok.
  endcomment
  assign wheel_winter_ok = false
  if is_wheel
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'winter approved' or tag_down contains 'winter-approved'
        assign wheel_winter_ok = true
      endif
    endfor
    if product.description contains 'Winter Approved:</strong> Yes'
      assign wheel_winter_ok = true
    endif
    assign season_tag = ''
  endif
  assign season_display = season_tag | downcase | capitalize

  comment
    3PMSF, 2026-11-13. Measured on the live store: 2,746 of 2,830 winter
    tires have NO custom.three_peak_snowflake value, 84 say true, none say
    false. The old page called every winter tire "3PMSF rated" in its banner
    and then answered "No" to the 3PMSF FAQ for the same tire. Now:
      has_3pmsf - metafield true, or the title / a tag names 3PMS(F)
      no_3pmsf  - metafield explicitly false and nothing above
      otherwise - unknown: the page makes no 3PMSF claim either way
  endcomment
  assign tri_val = product.metafields.custom.three_peak_snowflake.value
  assign has_3pmsf = false
  assign no_3pmsf = false
  unless is_wheel
    if tri_val == true
      assign has_3pmsf = true
    else
      assign title_up = product.title | upcase
      if title_up contains '3PMS'
        assign has_3pmsf = true
      endif
      for tag in product.tags
        assign tag_down = tag | downcase
        if tag_down contains '3pms' or tag_down contains 'three peak' or tag_down contains 'three-peak'
          assign has_3pmsf = true
        endif
      endfor
    endif
    if has_3pmsf == false and tri_val == false
      assign no_3pmsf = true
    endif
  endunless
  assign has_ms = false
  if product.metafields.custom.mud_snow.value == true
    assign has_ms = true
  endif

  comment
    Performance ratings (owner 11-13: keep exactly as the live page shows
    them). Same data source and fallbacks as live: the product's metafields,
    then the section's perf_* settings, then 0. A tire rating only: wheels
    never show it.
  endcomment
  assign perf_dry = product.metafields.custom.dry_grip.value | default: section.settings.perf_dry_grip | default: 0
  assign perf_wet = product.metafields.custom.wet_grip.value | default: section.settings.perf_wet_grip | default: 0
  assign perf_ice = product.metafields.custom.ice_grip.value | default: section.settings.perf_ice_grip | default: 0
  assign perf_snow = product.metafields.custom.snow_grip.value | default: section.settings.perf_snow_traction | default: 0
  assign perf_tread = product.metafields.custom.wear_score.value | default: section.settings.perf_tread_life | default: 0
  assign has_perf_data = false
  if perf_dry > 0 or perf_wet > 0 or perf_ice > 0 or perf_snow > 0 or perf_tread > 0
    assign has_perf_data = true
  endif
  if is_wheel
    assign has_perf_data = false
  endif

  comment
    Stat strip season colour + icon (live: the season colour in the section,
    the icon added by the old pt-product-ux2 script).
  endcomment
  comment
    season_color = live's hue, used on the icon only. season_text_color = the
    label text (14px, small): live's hue where it passes AA on the strip's
    #f9fafb, else a darker shade of the same hue (orange #F5820B -> #a95a08,
    green #16a34a -> #15803d, yellow #eab308 -> #854d0e).
  endcomment
  assign season_color = '#6b7280'
  assign season_text_color = '#6b7280'
  assign season_key = ''
  assign season_down = season_tag | downcase
  if season_down contains 'all-weather' or season_down contains 'all weather'
    assign season_color = '#F5820B'
    assign season_text_color = '#a95a08'
    assign season_key = 'allweather'
  elsif season_down contains 'all-season' or season_down contains 'all season'
    assign season_color = '#16a34a'
    assign season_text_color = '#15803d'
    assign season_key = 'allseason'
  elsif season_down contains 'winter' or season_down contains 'snow'
    assign season_color = '#2563eb'
    assign season_text_color = '#2563eb'
    assign season_key = 'winter'
  elsif season_down contains 'summer'
    assign season_color = '#eab308'
    assign season_text_color = '#854d0e'
    assign season_key = 'summer'
  elsif season_down contains 'all-terrain'
    assign season_color = '#92400e'
    assign season_text_color = '#92400e'
  elsif season_down contains 'performance'
    assign season_color = '#7c3aed'
    assign season_text_color = '#7c3aed'
  endif

  assign product_form_id = 'pt-product-form-' | append: section.id

  assign spec_width = ''
  assign spec_aspect = ''
  assign spec_rim = ''
  if tire_size != blank
    assign clean_size = tire_size | remove: 'P' | remove: 'LT' | remove: 'ST' | strip
    assign slash_parts = clean_size | split: '/'
    if slash_parts.size > 1
      assign spec_width = slash_parts[0]
      assign r_parts = slash_parts[1] | split: 'R'
      assign spec_aspect = r_parts[0]
      if r_parts.size > 1
        assign spec_rim = r_parts[1]
      endif
    else
      assign r_parts = clean_size | split: 'R'
      if r_parts.size > 1
        assign spec_width = r_parts[0]
        assign spec_rim = r_parts[1]
      endif
    endif
  endif
  assign title_words = product.title | split: ' '
  assign is_xl = false
  if title_words contains 'XL'
    assign is_xl = true
  endif

  assign unit_one = 'tire'
  assign unit_many = 'tires'
  assign unit_cap = 'Tires'
  assign unit_collection = 'tires'
  if is_wheel
    assign unit_one = 'wheel'
    assign unit_many = 'wheels'
    assign unit_cap = 'Wheels'
    assign unit_collection = 'wheels'
  endif

  comment
    THREE states, not two. max_qty == 0 means "no cap" (untracked or
    continue-selling). A tracked deny variant with none on hand is sold_out.
    The stepper, the set price and the booking button all stop at max_qty.
  endcomment
  assign cap_variant = product.selected_or_first_available_variant
  assign max_qty = 0
  assign sold_out = false
  if cap_variant.inventory_management == 'shopify' and cap_variant.inventory_policy == 'deny'
    if cap_variant.inventory_quantity > 0
      assign max_qty = cap_variant.inventory_quantity
    else
      assign sold_out = true
    endif
  endif
  comment
    Stock (snippets/pt-stock-state.liquid): kind own|supplier|out, state
    exact|bucket|low|call|plain|out (internal), text = the lead time the
    customer reads, lead = today|1-2|order|out. call = the book / add-to-cart
    buttons become a call link.
  endcomment
  capture pt_stock_raw
    render 'pt-stock-state', product: product, is_wheel: is_wheel
  endcapture
  assign pt_stock_parts = pt_stock_raw | strip | split: '|'
  assign pt_stock_kind = pt_stock_parts[0] | default: 'out'
  assign pt_stock_state = pt_stock_parts[1] | default: 'out'
  assign pt_stock_lead = pt_stock_parts[3] | default: 'out'
  assign call_to_book = false
  if pt_stock_state == 'call' and sold_out == false
    assign call_to_book = true
  endif
  assign stock_tel = settings.stock_call_tel | default: '+14034524283'
  assign stock_phone = settings.stock_call_phone | default: '(403) 452-4283'
  assign set_count = 4
  assign default_qty = 4
  if max_qty > 0 and max_qty < 4
    assign set_count = max_qty
    assign default_qty = max_qty
  endif
  assign unit_cents = product.selected_or_first_available_variant.price
  assign set_price = unit_cents | times: set_count

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign save_amount = product.compare_at_price | minus: product.price
    assign save_percent = save_amount | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  comment
    Ratings: REAL ones only (owner rule). reviews.rating >= 4.0, or the
    TyreReviews score custom.tyre_rating (0-100) >= 4.0 of 5, labelled.
  endcomment
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count | default: 0
  assign tyre_rating_raw = product.metafields.custom.tyre_rating.value | default: 0
  assign tr_star = 0
  if rating_value == blank and tyre_rating_raw > 0
    assign tr_star = tyre_rating_raw | times: 5.0 | divided_by: 100.0
  endif

  assign detected_vehicle = 'passenger'
  assign vehicle_meta = product.metafields.custom.vehicle_type | downcase | default: ''
  if vehicle_meta != blank
    if vehicle_meta contains 'suv' or vehicle_meta contains 'cuv'
      assign detected_vehicle = 'suv'
    elsif vehicle_meta contains 'light truck'
      assign detected_vehicle = 'truck'
    elsif vehicle_meta contains 'trailer'
      assign detected_vehicle = 'trailer'
    elsif vehicle_meta contains 'van'
      assign detected_vehicle = 'van'
    elsif vehicle_meta contains 'truck'
      assign detected_vehicle = 'truck'
    endif
  else
    assign type_check = product.type | downcase
    if tire_size != blank
      assign size_upper = tire_size | upcase
      if size_upper contains 'LT'
        assign detected_vehicle = 'truck'
      elsif size_upper contains 'ST'
        assign detected_vehicle = 'trailer'
      elsif size_upper contains 'R21' or size_upper contains 'R22' or size_upper contains 'R23' or size_upper contains 'R24'
        assign detected_vehicle = 'largetruck'
      endif
    endif
    if detected_vehicle == 'passenger'
      if type_check contains 'trailer'
        assign detected_vehicle = 'trailer'
      elsif type_check contains 'light truck' or type_check contains 'lt '
        assign detected_vehicle = 'truck'
      elsif type_check contains 'suv' or type_check contains 'cuv'
        assign detected_vehicle = 'suv'
      endif
    endif
    if detected_vehicle == 'passenger'
      for tag in product.tags
        assign tag_lc = tag | downcase
        if tag_lc contains 'trailer'
          assign detected_vehicle = 'trailer'
          break
        elsif tag_lc contains 'light truck' or tag_lc contains 'lt tire'
          assign detected_vehicle = 'truck'
          break
        elsif tag_lc contains 'suv'
          assign detected_vehicle = 'suv'
          break
        endif
      endfor
    endif
  endif

  comment
    Prices. Install: product.metafields.custom.install_price -> section
    setting install_cost_per_tire -> 30 (never change that setting or its
    default: wheels use it, $30/wheel). Disposal of the OLD tires is the
    customer's choice (owner, 2026-10-27), an add-on in the booking form,
    never in this total. The tire recycling levy is charged on every TIRE we
    sell, so it is in the installed total (Competition Act s.74.01(1.1)),
    unless the price already carries it (pt-levy-in-price: Trail Tire / DT /
    NCT). Wheels and wheel/tire ACCESSORIES (product type contains
    'accessor', no tire size: centre caps, lug nuts) carry no levy. A tire
    with a missing tire_size still pays it (86 ATW flotation tires have no
    tire_size) - the same rule as pt-book.js M.isTire (isWheel false = tire);
    accessories send an empty data-levy-in-price so the booking form charges
    nothing and the quote add-on is 0. One rule on all three surfaces.
  endcomment
  assign install_raw = product.metafields.custom.install_price.value | default: section.settings.install_cost_per_tire | default: 30
  assign install_per_tire = install_raw | times: 100 | round
  assign install_disp = install_per_tire | money_without_currency | remove: '.00'

  comment
    Install promotion (ported from the live theme, snippets/pt-install-promo.liquid -
    the staff app decides eligibility and writes custom.install_promo). Per-tire
    promo price, the regular price it replaces, its label and look ("strike" =
    regular struck through, "save" = the promo price on its own). The installed
    total, the breakdown and both booking buttons use the promo price, exactly as
    live does; install_disp stays the regular price (Installation card, FAQ).
  endcomment
  capture pt_ip_raw
    render 'pt-install-promo', product: product, is_wheel: is_wheel
  endcapture
  assign pt_ip = pt_ip_raw | strip | split: '|'
  assign install_promo_id = ''
  assign install_was_per_tire = 0
  if pt_ip.size >= 5
    assign install_promo_per_tire = pt_ip[0]
    assign install_promo_was = pt_ip[1]
    assign install_promo_label = pt_ip[2]
    assign install_promo_style = pt_ip[3]
    assign install_promo_id = pt_ip[4]
    assign install_promo_vehicles = pt_ip[5] | default: 'car or SUV'
    comment
      "plain" (owner 2026-11-14, as live): the promo price is simply the install price - no label, pill or strike anywhere.
    endcomment
    if install_promo_style == 'plain'
      assign install_promo_label = ''
    endif
    assign install_was_per_tire = install_promo_was | times: 100 | round
    assign install_per_tire = install_promo_per_tire | times: 100 | round
  endif
  assign install_now_disp = install_per_tire | money_without_currency | remove: '.00'
  capture levy_in_price
    render 'pt-levy-in-price', product: product
  endcapture
  assign levy_in_price = levy_in_price | strip
  assign recycling_per_tire = section.settings.recycling_fee_per_tire | default: '5' | times: 100 | round
  assign rdp_type_down = product.type | downcase
  assign is_accessory = false
  if is_wheel == false and tire_size == blank and rdp_type_down contains 'accessor'
    assign is_accessory = true
  endif
  assign levy_applies = true
  if is_wheel or is_accessory
    assign levy_applies = false
  endif
  if levy_applies == false or levy_in_price == 'true'
    assign recycling_per_tire = 0
  endif
  assign installed_subtotal = unit_cents | plus: install_per_tire | plus: recycling_per_tire | times: set_count
  assign installed_gst = installed_subtotal | times: 0.05 | round
  assign installed_total = installed_subtotal | plus: installed_gst

  capture supplier_tier
    render 'pt-supplier-tier', product: product
  endcapture
  assign supplier_tier = supplier_tier | strip

  comment
    Wheel facts for the Specifications card, from metafields first, then the
    "Key Specifications" list the feed writes into the description (seat,
    centre cap, warranties) - never the raw description itself.
  endcomment
  assign w_size = ''
  assign w_bolt = ''
  assign w_bolt_disp = ''
  assign w_et_disp = ''
  assign w_cb = ''
  assign w_finish = ''
  assign w_material = ''
  assign w_load = ''
  assign w_mpn = ''
  assign w_seat = ''
  assign w_cap = ''
  assign w_warr_structure = ''
  assign w_warr_finish = ''
  assign w_blank = false
  assign w_rd = ''
  assign w_mat_short = ''
  if is_wheel
    assign w_rd = product.metafields.custom.rim_diameter | append: '' | strip
    if w_rd.size > 2
      assign w_tail = w_rd | slice: -2, 2
      if w_tail == '.0'
        assign w_rd = w_rd | remove_last: '.0'
      endif
    endif
    assign w_rw = product.metafields.custom.rim_width | append: '' | strip
    if w_rw.size > 2
      assign w_tail = w_rw | slice: -2, 2
      if w_tail == '.0'
        assign w_rw = w_rw | remove_last: '.0'
      endif
    endif
    if w_rd != blank and w_rw != blank
      assign w_size = w_rd | append: '×' | append: w_rw
    elsif w_rd != blank
      assign w_size = w_rd | append: '″'
    endif

    assign w_bolt = product.metafields.custom.bolt_pattern | append: '' | strip
    if w_bolt != blank
      assign w_bolt_list = w_bolt | replace: ' ', '' | split: '/'
      for bp in w_bolt_list
        assign bp_disp = bp
        assign bp_parts = bp | downcase | split: 'x'
        if bp_parts.size == 2
          assign pcd = bp_parts[1] | times: 1.0
          if pcd > 0
            assign bp_inch = pcd | divided_by: 25.4
            assign bp_q = bp_inch | times: 4 | round | divided_by: 4.0
            assign bp_diff = bp_inch | minus: bp_q | abs
            if bp_diff < 0.02
              assign bp_q_s = bp_q | append: ''
              assign w_tail = bp_q_s | slice: -2, 2
              if w_tail == '.0'
                assign bp_q_s = bp_q_s | remove_last: '.0'
              endif
              assign bp_disp = bp | append: ' (' | append: bp_parts[0] | append: 'x' | append: bp_q_s | append: '″)'
            endif
          endif
        endif
        if w_bolt_disp == blank
          assign w_bolt_disp = bp_disp
        else
          assign w_bolt_disp = w_bolt_disp | append: ' / ' | append: bp_disp
        endif
      endfor
    else
      assign title_down = product.title | downcase
      if title_down contains 'blank'
        assign w_blank = true
      endif
    endif

    assign w_et = product.metafields.custom.rim_offset | append: '' | strip
    if w_et != blank
      assign w_et_first = w_et | slice: 0
      if w_et_first == '-' or w_et_first == '+' or w_et == '0'
        assign w_et_disp = 'ET ' | append: w_et | append: ' mm'
      else
        assign w_et_disp = 'ET +' | append: w_et | append: ' mm'
      endif
    endif
    assign w_cb = product.metafields.custom.center_bore | append: '' | strip

    # Finish: the longest tag the title ends with (the feeds tag the finish, e.g. "Gloss Black Milled").
    assign w_title_down = product.title | downcase | strip
    assign w_vendor_down = product.vendor | downcase
    for tag in product.tags
      assign tag_down = tag | downcase | strip
      assign tag_up = tag | upcase
      if tag_up != tag_down and tag.size > 3 and tag.size > w_finish.size and tag_down != w_vendor_down and tag_down != 'wheels'
        assign t_len = tag_down.size
        assign t_neg = 0 | minus: t_len
        assign t_tail = w_title_down | slice: t_neg, t_len
        if t_tail == tag_down
          assign w_finish = tag | strip
        endif
      endif
    endfor
    assign desc_html = product.description | default: ''
    if w_finish == blank
      assign dp = desc_html | split: 'Finish:</strong>'
      if dp.size > 1
        assign w_finish = dp[1] | split: '</li>' | first | strip_html | strip
      endif
    endif
    assign dp = desc_html | split: 'Seat:</strong>'
    if dp.size > 1
      assign w_seat = dp[1] | split: '</li>' | first | strip_html | strip
    endif
    assign dp = desc_html | split: 'Centre Cap:</strong>'
    if dp.size > 1
      assign w_cap = dp[1] | split: '</li>' | first | strip_html | strip
    endif
    assign dp = desc_html | split: 'Structure Warranty:</strong>'
    if dp.size > 1
      assign w_warr_structure = dp[1] | split: '</li>' | first | strip_html | strip
    endif
    assign dp = desc_html | split: 'Finish Warranty:</strong>'
    if dp.size > 1
      assign w_warr_finish = dp[1] | split: '</li>' | first | strip_html | strip | replace: '1 year(s)', '1 year' | replace: 'year(s)', 'years'
    endif

    assign w_type_down = product.type | downcase
    if w_type_down contains 'alloy'
      assign w_material = 'Alloy'
      assign w_mat_short = 'alloy'
      if product.tags contains 'Aluminum' or desc_html contains 'Aluminium'
        assign w_material = 'Alloy (aluminum)'
      endif
    elsif w_type_down contains 'steel'
      assign w_material = 'Steel'
      assign w_mat_short = 'steel'
    elsif product.type != blank
      assign w_material = product.type
    endif

    assign w_load_raw = product.metafields.custom.max_load_lbs | append: '' | remove: ',' | strip
    if w_load_raw != blank
      if w_load_raw contains '.'
        assign w_load = w_load_raw
      else
        assign w_load_n = w_load_raw | plus: 0
        if w_load_n >= 1000
          assign w_th = w_load_n | divided_by: 1000 | floor
          assign w_rest = w_load_n | modulo: 1000 | prepend: '00' | slice: -3, 3
          assign w_load = w_th | append: ',' | append: w_rest
        else
          assign w_load = w_load_n | append: ''
        endif
      endif
    endif
    assign w_mpn = product.metafields.custom.mpn | append: '' | strip
  endif

  assign compat = product.metafields.custom.compatible_vehicles.value
  assign compat_count = compat.count | plus: 0
  assign compat_sample = compat.sample
  assign compat_first_make = compat_sample.first.make
  assign has_compat = false
  if compat_count > 0 and compat_first_make != blank
    assign has_compat = true
  endif

  # Breadcrumb middle: the size collection (tires-17-inch / wheels-19-inch) when it exists, else the
  # first real collection (never quick-order or an app's helper collection), else Tires / Wheels.
  assign crumb_col = nil
  assign crumb_handle = ''
  if is_wheel and w_rd != blank
    assign crumb_handle = 'wheels-' | append: w_rd | append: '-inch'
  elsif spec_rim != blank
    assign crumb_handle = 'tires-' | append: spec_rim | append: '-inch'
  endif
  if crumb_handle != blank
    assign crumb_try = collections[crumb_handle]
    if crumb_try != blank and crumb_try.products_count > 0
      assign crumb_col = crumb_try
    endif
  endif
  if crumb_col == nil
    for c in product.collections
      if c.handle contains 'quick-order' or c.handle contains 'seguno' or c.handle contains 'globofilter' or c.handle == 'all' or c.handle == 'frontpage'
        continue
      endif
      assign crumb_col = c
      break
    endfor
  endif
  if crumb_col == nil and tire_size != blank or crumb_col == nil and is_wheel
    assign crumb_try = collections[unit_collection]
    if crumb_try != blank and crumb_try.products_count > 0
      assign crumb_col = crumb_try
    endif
  endif

  assign rdp_viz_on = false
  if is_wheel and product.metafields.custom.bolt_pattern != blank and product.featured_image != blank
    assign rdp_viz_on = true
  endif

  comment
    Package builder entry (wheels only): gated on the section setting AND the
    wheel-package page existing, so a push never links to a 404. The builder
    matches by bolt pattern, so an undrilled (Blank) wheel gets no button.
  endcomment
  assign ptp_pkg_page = pages['wheel-package']
  assign ptp_pkg_on = false
  if is_wheel and section.settings.show_package_cta and product.metafields.custom.bolt_pattern != blank
    if ptp_pkg_page != empty
      assign ptp_pkg_on = true
    endif
  endif

  assign quote_mode = ''
  if customer.tags contains 'staff'
    assign quote_mode = 'staff'
  elsif customer.b2b? or customer.tags contains 'wholesale'
    assign quote_mode = 'wholesale'
  endif
  assign pt_q_levy_included = false
  if is_wheel or levy_in_price == 'true' or levy_applies == false
    assign pt_q_levy_included = true
  endif

  assign sticky_phone = settings.smart_search_fallback_phone | default: '403 452 4283'
  assign sticky_phone_dig = sticky_phone | replace: ' ', '' | replace: '-', '' | replace: '.', '' | replace: '(', '' | replace: ')', ''
  assign sticky_savings = 0
  if on_sale
    assign sticky_savings = save_amount | times: set_count
  endif

  if set_count == 4
    assign set_label = 'for a set of 4'
  elsif set_count == 1
    assign set_label = 'for 1 ' | append: unit_one
  else
    assign set_label = 'for ' | append: set_count | append: ' ' | append: unit_many
  endif
  assign video_url = product.metafields.custom.video_url | default: ''
  assign variant_id = product.selected_or_first_available_variant.id
-%}

{{ 'pt-rd-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_image_zoom -%}
  <script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture rdp_book_attrs -%}
  onclick="if(window.ptpBookQty)window.ptpBookQty(this);if(typeof openBookingModal==='function')openBookingModal(this)" data-levy-in-price="{% unless is_accessory %}{{ levy_in_price }}{% endunless %}" data-is-wheel="{{ is_wheel }}" data-tire-name="{{ product.title | escape }}" data-vendor="{{ product.vendor | escape }}" data-tire-size="{{ tire_size | escape }}" data-vehicle-type="{{ detected_vehicle }}" data-tire-price="{{ product.selected_or_first_available_variant.price }}" data-install-price="{% if install_promo_id != '' %}{{ install_promo_per_tire }}{% else %}{{ product.metafields.custom.install_price.value | default: section.settings.install_cost_per_tire | default: 30 }}{% endif %}"{% if install_promo_id != '' %} data-install-was="{{ install_promo_was }}" data-install-promo-id="{{ install_promo_id }}"{% if install_promo_style != 'plain' %} data-install-promo-label="{{ install_promo_label | escape }}"{% endif %} data-install-promo-style="{{ install_promo_style }}"{% endif %} data-inventory-source="{{ inventory_source }}" data-supplier-tier="{{ supplier_tier }}" data-product-handle="{{ product.handle }}" data-variant-id="{{ variant_id }}" data-max-qty="{{ max_qty }}" data-sold-out="{{ sold_out }}" data-qty="{{ default_qty }}" data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 128 }}{% endif %}"
{%- endcapture -%}

<product-info
  class="ptp rdp rd{% if is_wheel %} rdp--wheel{% else %} rdp--tire{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  data-rdp
  data-rdp-unit-cents="{{ unit_cents }}"
  data-rdp-install-cents="{{ install_per_tire }}"
  data-rdp-install-was-cents="{{ install_was_per_tire }}"
  data-rdp-levy-cents="{{ recycling_per_tire }}"
  data-rdp-levy-in-price="{% if levy_applies and levy_in_price == 'true' %}true{% else %}false{% endif %}"
  data-rdp-levy-applies="{{ levy_applies }}"
  data-rdp-unit-one="{{ unit_one }}"
  data-rdp-unit-many="{{ unit_many }}"
  data-rdp-max="{{ max_qty }}"
>
  {%- comment -%} Breadcrumb: one black bar (the theme's own crumb is hidden on product pages in pt-rd-pdp.css). {%- endcomment -%}
  <nav class="rdp-crumbs ptp__breadcrumb" aria-label="Breadcrumb">
    <div class="rd-wrap">
      <ol class="rdp-crumbs__list ptp__breadcrumb-list">
        <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a></li>
        {%- if crumb_col != nil -%}
          <li><a href="{{ crumb_col.url }}">{{ crumb_col.title }}</a></li>
        {%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </div>
  </nav>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | default: 'Home' | json }}, "item": "{{ shop.url }}" }
      {%- if crumb_col != nil -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ crumb_col.title | json }}, "item": "{{ shop.url }}{{ crumb_col.url }}" }
        ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
      {%- endif -%}
    ]
  }
  </script>

  <div class="rd-wrap rdp-main">
    {%- comment -%}
      Garage fit bar - hidden until a saved garage vehicle is checked against
      app.princetires.ca/api/wheel-fitment. Tires: exact size = "Fits your",
      same width = "Verify fit for your". Wheels: the bolt pattern must match
      and the wheel's bore must be equal or bigger ("Bolt pattern fits your",
      plus the hub-ring note when the bore is bigger).
    {%- endcomment -%}
    <div class="rdp-fit ptp__fitment" data-ptp-fitment data-ptp-product-tire-size="{{ tire_size | escape }}" data-ptp-product-bolt="{% if is_wheel %}{{ w_bolt | escape }}{% endif %}" data-ptp-product-cb="{% if is_wheel %}{{ w_cb | escape }}{% endif %}" hidden>
      {% render 'pt-icon', name: 'check', size: 18, class: 'rdp-fit__icon ptp__fitment-icon' %}
      <span><strong><span data-ptp-fitment-prefix>Fits your</span> <span data-ptp-fitment-vehicle></span></strong><span class="rdp-fit__note" data-ptp-fitment-note></span></span>
      <a href="/pages/garage" class="rdp-fit__change ptp__fitment-change">Change vehicle</a>
    </div>

    <div class="rdp-top">
      <div class="rdp-col rdp-col--l">
        {%- comment -%} Gallery: thumbs column + photo (desktop), swipe + dots (phone). {%- endcomment -%}
        <div class="rdp-gal ptp__gallery" data-rdp-gal>
          {%- if product.images.size > 1 or video_url != blank -%}
            <div class="rdp-gal__thumbs ptp__gallery-thumbs" role="list" aria-label="Product images">
              {%- for image in product.images -%}
                <div role="listitem">
                  <button class="rdp-gal__thumb ptp__gallery-thumb{% if forloop.first %} ptp__gallery-thumb--active{% endif %}" type="button" data-ptp-thumb-idx="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }} of {{ product.images.size }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{ image | image_url: width: 180, height: 180 | image_tag: loading: 'lazy', class: 'rdp-gal__thumb-img', alt: '' }}
                  </button>
                </div>
              {%- endfor -%}
              {%- if video_url != blank -%}
                <div role="listitem">
                  <button class="rdp-gal__thumb rdp-gal__thumb--video ptp__gallery-thumb--video" type="button" data-ptp-video-thumb data-video-url="{{ video_url | escape }}" aria-label="Play video">
                    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
                  </button>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="rdp-gal__stage">
            <div class="rdp-gal__main ptp__gallery-main">
              {%- if product.images.size > 0 -%}
                <div class="rdp-gal__track" data-rdp-track>
                  {%- for image in product.images -%}
                    <div class="rdp-gal__slide{% if forloop.first %} is-on{% endif %}" data-rdp-slide="{{ forloop.index0 }}">
                      {%- if forloop.first -%}
                        {{ image | image_url: width: 1000 | image_tag: class: 'rdp-gal__img ptp__gallery-main-img', id: 'ptp-featured-img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1360px) 450px, (min-width: 990px) 34vw, 82vw', widths: '400, 600, 800, 1000', alt: image.alt | default: product.title }}
                      {%- else -%}
                        {{ image | image_url: width: 1000 | image_tag: class: 'rdp-gal__img', loading: 'lazy', sizes: '(min-width: 1360px) 450px, (min-width: 990px) 34vw, 82vw', widths: '400, 600, 800, 1000', alt: image.alt | default: product.title }}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                {%- comment -%} 547 products carry no photo: a drawn placeholder (a wheel for wheels) instead of blank space. {%- endcomment -%}
                <div class="rdp-gal__ph" aria-hidden="true">
                  {%- if is_wheel -%}{% render 'pt-icon', name: 'wheel', size: 120 %}{%- else -%}{% render 'pt-icon', name: 'tire', size: 120 %}{%- endif -%}
                  <span class="rdp-gal__ph-brand">{{ product.vendor | escape }}</span>
                  {%- if tire_size != blank -%}<span class="rdp-gal__ph-size">{{ tire_size }}</span>{%- elsif w_size != blank -%}<span class="rdp-gal__ph-size">{{ w_size }}</span>{%- endif -%}
                  <span class="rdp-gal__ph-note">Photo coming soon</span>
                </div>
              {%- endif -%}
              {%- if on_sale -%}
                <span class="rdp-gal__sale ptp__sale-badge">-{{ save_percent }}%</span>
              {%- endif -%}
            </div>
            {%- if video_url != blank -%}
              <div class="rdp-gal__video ptp__gallery-video" data-ptp-video hidden>
                <button type="button" class="rdp-gal__video-close" data-ptp-video-close aria-label="Close video">{% render 'pt-icon', name: 'close', size: 20 %}</button>
                <div class="rdp-gal__video-wrap" data-ptp-video-wrap></div>
              </div>
            {%- endif -%}
            {%- if product.images.size > 1 or video_url != blank -%}
              <div class="rdp-gal__nav">
                {%- if product.images.size > 1 -%}
                  <span class="rdp-gal__count" data-rdp-gal-count aria-live="polite">Image 1 of {{ product.images.size }}</span>
                  <span class="rdp-gal__dots">
                    {%- for image in product.images -%}
                      <button type="button" class="rdp-gal__dot" data-rdp-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }} of {{ product.images.size }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>
                    {%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if video_url != blank -%}
                  <button type="button" class="rdp-gal__vbtn" data-ptp-video-thumb data-video-url="{{ video_url | escape }}">Play video</button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if rdp_viz_on -%}
          <div class="rdp-viz" id="rdp-viz">
            {%- render 'pt-rim-visualizer', product: product -%}
          </div>
        {%- endif -%}
      </div>

      <div class="rdp-col rdp-col--r ptp__info-col{% if section.settings.enable_sticky_info %} rdp-col--sticky{% endif %}">
        <div class="rdp-head">
          <a href="{{ product.vendor | url_for_vendor }}" class="rdp-head__brand ptp__vendor">{{ product.vendor }}</a>
          <h1 class="rdp-head__title ptp__title">{{ product_title }}</h1>
          {%- assign pt_sku = product.selected_or_first_available_variant.sku -%}
          <p class="rdp-head__meta">
            {%- if is_wheel -%}
              {%- if w_mat_short != blank -%}<span>{{ w_mat_short | capitalize }} wheel</span>{%- else -%}<span>Wheel</span>{%- endif -%}
              {%- if wheel_winter_ok -%}<span class="rdp-chipx rdp-chipx--snow">Winter approved</span>{%- endif -%}
              {%- if w_size != blank -%}<span class="rdp-mi"><span class="rdp-sep" aria-hidden="true">·</span><span>{{ w_size }}</span></span>{%- endif -%}
              {%- if w_bolt != blank -%}<span class="rdp-mi"><span class="rdp-sep" aria-hidden="true">·</span><span>{{ w_bolt }}</span></span>{%- elsif w_blank -%}<span class="rdp-mi"><span class="rdp-sep" aria-hidden="true">·</span><span>Blank (undrilled)</span></span>{%- endif -%}
            {%- else -%}
              {%- comment -%}
                Season + 3PMSF as the live page's chips (owner 11-14: "I like the colours
                in the old design"): Winter and 3PMSF blue, other seasons grey with the
                season's own icon colour (All-weather orange #F5820B, All-season green,
                Summer yellow) - the same icons and colours as the live chips.
              {%- endcomment -%}
              {%- if season_display != blank -%}
                <span class="rdp-chipx{% if season_tag == 'Winter' %} rdp-chipx--snow{% endif %}">
                  {%- case season_tag -%}
                    {%- when 'Winter' -%}<svg class="rdp-chipx__ico" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9"/></svg>
                    {%- when 'Summer' -%}<svg class="rdp-chipx__ico" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    {%- when 'All-Weather' -%}<svg class="rdp-chipx__ico" viewBox="0 0 24 24" fill="none" stroke="#F5820B" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 2v1M2 8h1M3.8 3.8l.7.7M17 18H9a4 4 0 110-8 5 5 0 019.6 1.5A3.3 3.3 0 0117 18z"/></svg>
                    {%- when 'All-Season' -%}<svg class="rdp-chipx__ico" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M17 18H8a5 5 0 115-6h1a3 3 0 013 6z"/><path d="M9 21l1-2M13 21l1-2"/></svg>
                  {%- endcase -%}
                  {{- season_display -}}
                </span>
              {%- endif -%}
              {%- if has_3pmsf -%}<span class="rdp-chipx rdp-chipx--snow"><span aria-hidden="true">❄</span>Severe-snow rated (3PMSF)</span>{%- endif -%}
            {%- endif -%}
            {%- comment -%} Separator + SKU in one no-wrap group, so the "·" never sits alone at a line end; after a chip the pill itself separates, so no dot. {%- endcomment -%}
            {%- if pt_sku != blank -%}<span class="rdp-mi"><span class="rdp-sep" aria-hidden="true">·</span><span class="rdp-head__sku ptp__sku">{{ 'products.product.sku' | t }}: <span data-pt-sku>{{ pt_sku }}</span></span></span>{%- endif -%}
          </p>
          {%- if rating_value != blank and rating_value.rating >= 4.0 -%}
            <p class="rdp-head__rating ptp__rating">
              {% render 'pt-icon', name: 'star', size: 16 %}<strong>{{ rating_value.rating }}<span class="rd-sr"> out of {{ rating_value.scale_max }}</span></strong> <span>({{ rating_count }} reviews)</span>
            </p>
          {%- elsif tr_star >= 4.0 -%}
            <p class="rdp-head__rating ptp__rating">
              {% render 'pt-icon', name: 'star', size: 16 %}<strong>{{ tr_star | round: 1 }}/5</strong> <span>TyreReviews</span>
            </p>
          {%- endif -%}
          {%- comment -%} Fitment badge - "Fits your [Year Make Model]" for logged-in customers (hidden until matched). {%- endcomment -%}
          {%- render 'pt-fitment-badge', product: product -%}
        </div>

        <div class="rdp-buy">
          {%- comment -%} Sold out: no installed total and no package link next to "Sold out" (nothing to install yet). {%- endcomment -%}
          {%- if section.settings.show_installed_price and product.available -%}
            {%- comment -%} Installed total incl. 5% GST, integer cents; the stepper keeps every number and data-* in step. Display only - the store is tax-exclusive and Shopify still charges GST at checkout. {%- endcomment -%}
            <div class="rd-total rdp-total ptp__installed-price" data-rdp-total-box data-set-count="{{ set_count }}" data-set-cents="{{ set_price }}" data-install-cents="{{ install_per_tire | times: set_count }}"{% if install_promo_id != '' and install_promo_style != 'plain' %} data-install-was-cents="{{ install_was_per_tire | times: set_count }}" data-install-promo-label="{{ install_promo_label | escape }}" data-install-promo-style="{{ install_promo_style }}"{% endif %} data-levy-cents="{{ recycling_per_tire | times: set_count }}" data-levy-in-price="{% if levy_applies and levy_in_price == 'true' %}true{% else %}false{% endif %}" data-wheel="{{ is_wheel }}" data-gst-cents="{{ installed_gst }}" data-total-cents="{{ installed_total }}">
              <div class="rd-total__head ptp__installed-price-row">
                <span class="rd-total__label ptp__installed-label"><svg class="rdp-total__ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>{{ 'products.product.installed_total' | t | default: 'Installed total' }}</span>
                <span class="rd-total__amount ptp__installed-amount"><span data-rdp-total>${{ installed_total | money_without_currency }}</span> <span class="rd-total__incl ptp__installed-tax">{{ 'products.product.incl_gst' | t | default: 'incl. GST' }}</span></span>
              </div>
              {%- if install_promo_id != '' and install_promo_style != 'plain' -%}
                {%- assign ip_set_now = install_per_tire | times: set_count | round -%}
                {%- assign ip_set_was = install_was_per_tire | times: set_count | round -%}
                <p class="rdp-promo ptp__install-promo" data-install-promo-id="{{ install_promo_id }}">
                  <span class="rdp-promo__pill ptp__install-promo-pill">{{ install_promo_label | escape }}</span>
                  {%- if install_promo_style == 'strike' -%}
                    <span>Mount &amp; balance <s class="rdp-promo__was" data-rdp-promo-was>${{ ip_set_was | money_without_currency | remove: '.00' }}</s> <strong data-rdp-promo-now>${{ ip_set_now | money_without_currency | remove: '.00' }}</strong> · on a {{ install_promo_vehicles | escape }}</span>
                  {%- else -%}
                    <span>Mount &amp; balance <strong><span data-rdp-promo-now>${{ ip_set_now | money_without_currency | remove: '.00' }}</span> for <span data-rdp-promo-qty>{{ set_count }}</span></strong> · on a {{ install_promo_vehicles | escape }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}
              <div class="rdp-total__sub">
                <span class="rd-total__note ptp__installed-note" data-rdp-note data-pt-levy-in-total="{% if recycling_per_tire > 0 %}true{% else %}false{% endif %}">
                  {%- if is_wheel -%}Includes mount &amp; balance for {{ set_count }} {% if set_count == 1 %}wheel{% else %}wheels{% endif %}
                  {%- elsif levy_applies and levy_in_price == 'true' -%}Mount &amp; balance included · recycling levy is in the tire price
                  {%- elsif levy_applies -%}Mount, balance &amp; recycling levy included
                  {%- else -%}Includes mount &amp; balance
                  {%- endif -%}
                </span>
                <button type="button" class="rdp-textbtn" aria-expanded="false" aria-controls="rdp-break-{{ section.id }}" data-rdp-break-toggle>See price breakdown</button>
              </div>
              <div class="rd-total__break" id="rdp-break-{{ section.id }}" hidden>
                <div class="rd-sumrow"><span>{{ unit_cap }} (<span data-rdp-qtyword>{% if set_count == 4 %}set of 4{% elsif set_count == 1 %}1 {{ unit_one }}{% else %}{{ set_count }} {{ unit_many }}{% endif %}</span>)</span><span data-rdp-b-items>${{ set_price | money_without_currency }}</span></div>
                <div class="rd-sumrow"><span>Mount &amp; balance (<span data-rdp-b-qty>{{ set_count }}</span> × ${{ install_now_disp }}{% if install_promo_id != '' and install_promo_style != 'plain' %}, {{ install_promo_label | escape }}{% endif %})</span><span data-rdp-b-install>${{ install_per_tire | times: set_count | money_without_currency }}</span></div>
                {%- if levy_applies -%}
                  <div class="rd-sumrow"><span>Alberta recycling levy</span><span data-rdp-b-levy>{% if levy_in_price == 'true' %}In tire price{% else %}${{ recycling_per_tire | times: set_count | money_without_currency }}{% endif %}</span></div>
                {%- endif -%}
                <div class="rd-sumrow"><span>GST (5%)</span><span data-rdp-b-gst>${{ installed_gst | money_without_currency }}</span></div>
                <div class="rd-sumrow rd-sumrow--total"><span>Total installed</span><span data-rdp-b-total>${{ installed_total | money_without_currency }}</span></div>
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} Price {%- endcomment -%}
          <div class="rdp-price ptp__pricing-card" data-pt-unit="{{ unit_one }}">
            <div class="rd-price rd-price--lg">
              <div class="rd-price__row">
                <span class="rd-price__now ptp__price-current{% if on_sale %} ptp__price-current--sale{% endif %}" data-pt-price data-pt-variant-id="{{ variant_id }}" data-pt-multiplier="1">${{ product.price | money_without_currency }}</span>
                <span class="rd-price__unit ptp__price-per">/{{ unit_one }}</span>
                {%- if on_sale -%}
                  <s class="rd-price__was ptp__price-was">${{ product.compare_at_price | money_without_currency }}</s>
                  <span class="rdp-price__save ptp__save-tag">Save ${{ save_amount | money_without_currency }}/{{ unit_one }}</span>
                {%- endif -%}
              </div>
              <div class="rd-price__set">{{ unit_cap }} only: <span class="ptp__price-hero-amount" data-rdp-set data-pt-price data-pt-variant-id="{{ variant_id }}" data-pt-multiplier="{{ set_count }}">${{ set_price | money_without_currency }}</span> <span class="ptp__price-hero-label" data-rdp-set-label>{{ set_label }}</span></div>
            </div>
            {%- if customer.b2b? or customer.tags contains 'wholesale' -%}
              {%- comment -%} Phase 5A trade-price toggle: visible only when the header "Show cost" toggle is on. {%- endcomment -%}
              <div class="rdp-trade pt-trade-info" data-pt-trade-info data-pt-variant-id="{{ variant_id }}">
                <strong>Your cost:</strong> <span class="pt-trade-info__amount" data-pt-trade-amount>—</span>/{{ unit_one }}
                <span data-pt-trade-tier-wrap>· <span data-pt-trade-tier>—</span></span>
                · <strong><span data-pt-trade-pct>—</span>%</strong> off retail
              </div>
            {%- endif -%}
          </div>

          {%- assign rebate_text = product.metafields.custom.rebate_text | default: '' -%}
          {%- if rebate_text != blank -%}
            <div class="rdp-rebate ptp__rebate-banner"><strong>Rebate:</strong> {{ rebate_text }}</div>
          {%- endif -%}

          {%- comment -%} Weather note - summer tires below 7°C, winter tires above 15°C (filled client-side). {%- endcomment -%}
          <div class="rd-note rdp-weather ptp__weather-warn" data-ptp-weather-warn data-tire-season="{{ season_tag | downcase }}" hidden>
            <span data-ptp-weather-msg></span>
          </div>

          {%- comment -%} Lead time ONLY (owner rule) - snippets/pt-lead-time.liquid. {%- endcomment -%}
          <div class="rdp-lead ptp__stock" data-pt-stock-kind="{{ pt_stock_kind }}" data-pt-stock-state="{{ pt_stock_state }}">
            {%- render 'pt-lead-time', product: product, format: 'line', is_wheel: is_wheel, icon_size: 20, class: 'rd-lead--lg' -%}
          </div>

          <div class="rdp-cta ptp__cta-stack">
            {%- if call_to_book -%}
              {%- comment -%} Call to book: one call button, no stock count. {%- endcomment -%}
              <p class="rd-note">{{ 'products.stock.call_note_html' | t: tel: stock_tel, phone: stock_phone }}</p>
              <a class="rd-btn rd-btn--primary rd-btn--lg rd-btn--block ptp__book-btn ptp__call-book" href="tel:{{ stock_tel }}" data-pt-call-to-book>{{ 'products.stock.call_cta' | t }} · {{ stock_phone }}</a>
            {%- elsif product.available -%}
              {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form', class: 'rdp-form' -%}
                <input type="hidden" name="id" value="{{ variant_id }}">
                <div class="rd-buyrow rdp-buyrow">
                  <div class="rd-stepper rdp-stepper ptp__qty" role="group" aria-label="Number of {{ unit_many }}">
                    <button type="button" class="rd-stepper__btn" data-ptp-qty-minus aria-label="Fewer {{ unit_many }}">&minus;</button>
                    <input class="rd-stepper__val rdp-stepper__input" type="number" inputmode="numeric" name="quantity" value="{{ default_qty }}" min="1"{% if max_qty > 0 %} max="{{ max_qty }}"{% endif %} data-ptp-qty data-ptp-max="{{ max_qty }}" aria-label="Number of {{ unit_many }}">
                    <button type="button" class="rd-stepper__btn" data-ptp-qty-plus aria-label="More {{ unit_many }}">+</button>
                  </div>
                  <button type="button" class="rd-btn rd-btn--primary rd-btn--lg ptp__book-btn{% if sold_out %} ptp__book-btn--out{% endif %}"{% if sold_out %} disabled aria-disabled="true"{% endif %} {{ rdp_book_attrs }}>
                    {%- if sold_out -%}Sold out{%- else -%}Request installation{%- endif -%}
                  </button>
                </div>
                <button type="submit" class="rd-btn rd-btn--outline rd-btn--lg rd-btn--block ptp__add-btn">Add to cart — <span data-ptp-cart-total>${{ set_price | money_without_currency }}</span></button>
              {%- endform -%}
            {%- else -%}
              {%- comment -%}
                Sold out: the price stays; the buttons become the back-in-stock
                form plus a call option, so it is never a dead end. The form
                posts to app.princetires.ca/api/stock-notify (see the script).
              {%- endcomment -%}
              <div class="rdp-bis ptp__back-in-stock" data-ptp-bis id="rdp-bis">
                <label class="rdp-bis__label ptp__bis-text" for="rdp-bis-email">Get notified when this {{ unit_one }} is back in stock</label>
                <div class="rdp-bis__row ptp__bis-form">
                  <input id="rdp-bis-email" type="email" class="rdp-bis__email ptp__bis-email" autocomplete="email" placeholder="Email" data-ptp-bis-email required>
                  <button type="button" class="rd-btn rd-btn--primary ptp__bis-btn" data-ptp-bis-submit>{{ 'products.product.notify_me' | t | default: 'Notify me' }}</button>
                </div>
                {%- comment -%} Honeypot: real people never see or fill this; the server drops any request that has it filled. {%- endcomment -%}
                <input type="text" name="website" value="" data-ptp-bis-website tabindex="-1" autocomplete="off" aria-hidden="true" class="rdp-hp">
                <p class="rdp-bis__ok ptp__bis-success" data-ptp-bis-success hidden>{% render 'pt-icon', name: 'check', size: 16 %}Thanks — we've got your request. We'll email you when it's back in stock.</p>
                <p class="rdp-bis__err ptp__bis-error" data-ptp-bis-error role="alert" hidden></p>
              </div>
              <p class="rdp-cta__call">Need it sooner? <a href="tel:{{ stock_tel }}">Call {{ stock_phone }}</a> and we'll check.</p>
            {%- endif -%}

            {%- comment -%} Send a branded quote (staff / wholesale). The server decides branding; data-quote-mode only adapts the modal. {%- endcomment -%}
            {%- if quote_mode != '' -%}
              <button type="button" class="rd-btn rd-btn--line rd-btn--block rdp-quote ptp__quote-btn" onclick="if(typeof openQuoteModal==='function')openQuoteModal(this)" data-quote-mode="{{ quote_mode }}" data-product-handle="{{ product.handle }}" data-variant-id="{{ variant_id }}" data-tire-name="{{ product.title | escape }}" data-tire-size="{{ tire_size | escape }}" data-tire-price="{{ product.selected_or_first_available_variant.price }}" data-addon-mount="{{ product.metafields.custom.install_price.value | default: section.settings.install_cost_per_tire | default: 30 }}" data-addon-levy="{% if pt_q_levy_included %}0{% else %}{{ section.settings.quote_levy_price | default: 5 }}{% endif %}" data-addon-levy-included="{% if pt_q_levy_included %}true{% else %}false{% endif %}" data-addon-valve="{{ section.settings.quote_valve_price | default: 5 }}" data-addon-disposal="{{ section.settings.disposal_cost_per_tire | default: 5 }}" data-addon-tpms="{{ section.settings.quote_tpms_price | default: 15 }}">
                {{ 'sections.quote_modal.cta' | t }}
              </button>
            {%- endif -%}
          </div>

          {%- if ptp_pkg_on and product.available -%}
            <a class="rdp-pkg ptp__pkg-cta" href="{{ ptp_pkg_page.url }}?wheel={{ variant_id }}" data-ptp-pkg-cta>
              <span class="rdp-pkg__text"><strong>Build a package with this wheel</strong><small>Tires, sensors, hardware and install, priced together</small></span>
              {% render 'pt-icon', name: 'arrow-right', size: 20 %}
            </a>
          {%- endif -%}
          {%- if rdp_viz_on -%}
            <a class="rdp-vizlink" href="#rdp-viz" aria-controls="rdp-viz" aria-expanded="false" data-rdp-vizlink>{% render 'pt-icon', name: 'car', size: 20 %}See these on your car</a>
          {%- endif -%}

          {%- comment -%}
            Trust cards + share pill: the live page's look, kept on owner request 11-13
            (three light-grey cards, grey icon above a one-word label; the full sentence
            from the trust_N_text settings is the hover title and screen-reader text).
          {%- endcomment -%}
          {%- if section.settings.show_trust_signals -%}
            {%- assign trust_1_full = section.settings.trust_1_text | default: 'Free delivery within Calgary' -%}
            {%- assign trust_2_full = section.settings.trust_2_text | default: 'Manufacturer defect warranty' -%}
            {%- assign trust_3_full = section.settings.trust_3_text | default: 'Returns within 30 days if uninstalled and unused, stickers on' -%}
            <ul class="rdp-trust ptp__trust" role="list">
              <li class="rdp-trust__item" title="{{ trust_1_full | escape }}">
                <span class="rdp-trust__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
                <strong class="rdp-trust__label" aria-hidden="true">{{ section.settings.trust_1_label | default: 'Fast' }}</strong><span class="rd-sr">{{ trust_1_full }}</span>
              </li>
              <li class="rdp-trust__item" title="{{ trust_2_full | escape }}">
                <span class="rdp-trust__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                <strong class="rdp-trust__label" aria-hidden="true">{{ section.settings.trust_2_label | default: 'Warranty' }}</strong><span class="rd-sr">{{ trust_2_full }}</span>
              </li>
              <li class="rdp-trust__item" title="{{ trust_3_full | escape }}">
                <span class="rdp-trust__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg></span>
                <strong class="rdp-trust__label" aria-hidden="true">{{ section.settings.trust_3_label | default: 'Returns' }}</strong><span class="rd-sr">{{ trust_3_full }}</span>
              </li>
            </ul>
          {%- endif -%}

          <div class="rdp-share ptp__share ptp__share--top" data-ptp-share>
            <span class="rdp-share__label">{{ 'products.product.share' | t | default: 'Share' }}</span>
            <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" class="rdp-share__btn rdp-share__btn--wa ptp__share-btn ptp__share-btn--wa" aria-label="Share on WhatsApp">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" class="rdp-share__btn rdp-share__btn--fb ptp__share-btn ptp__share-btn--fb" aria-label="Share on Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <button type="button" class="rdp-share__btn rdp-share__btn--link ptp__share-btn ptp__share-btn--link" data-ptp-copy-url aria-label="Copy link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%}
      ===== Stat strip (live look, owner 11-13): full width under the gallery / buy row =====
      Tires: season (its colour + icon), treadwear warranty + cost per km when the
      product has a warranty_km, price per tire, brand. The tire size is left out as on
      live (it is in the title). Wheels: "Winter approved" only when tagged (a wheel
      fact, never a season or 3PMSF), price per wheel, brand.
    {%- endcomment -%}
    {%- if is_wheel or tire_size != blank -%}
      <div class="rdp-stats ptp__stats-strip" data-rdp-stats>
        {%- if is_wheel -%}
          {%- if wheel_winter_ok -%}
            <div class="rdp-stat">
              <svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9"/></svg>
              <span class="rdp-stat__num" style="color: #2563eb">Winter approved</span>
            </div>
          {%- endif -%}
        {%- elsif season_tag != blank -%}
          <div class="rdp-stat">
            {%- case season_key -%}
              {%- when 'winter' -%}<svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9"/></svg>
              {%- when 'summer' -%}<svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              {%- when 'allweather' -%}<svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="#F5820B" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 2v1M2 8h1M3.8 3.8l.7.7M17 18H9a4 4 0 110-8 5 5 0 019.6 1.5A3.3 3.3 0 0117 18z"/></svg>
              {%- when 'allseason' -%}<svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M17 18H8a5 5 0 115-6h1a3 3 0 013 6z"/><path d="M9 21l1-2M13 21l1-2"/></svg>
              {%- else -%}<svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9"/></svg>
            {%- endcase -%}
            <span class="rdp-stat__num" style="color: {{ season_text_color }}">{{ season_tag }}</span>
            <span class="rd-sr">Season rating</span>
          </div>
        {%- endif -%}
        {%- if is_wheel == false and product.metafields.custom.warranty_km != blank -%}
          <div class="rdp-stat">
            <span class="rdp-stat__num">{{ product.metafields.custom.warranty_km }}<span class="rdp-stat__unit">km</span></span>
            <span class="rdp-stat__label">Treadwear warranty</span>
          </div>
        {%- endif -%}
        <div class="rdp-stat">
          <svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L2 12V2h10l8.6 8.6a2 2 0 010 2.8z"/><circle cx="7" cy="7" r="1.5"/></svg>
          {%- comment -%} Phase 5A trade-price toggle: the number is rewritten with the API retail per-{{ unit_one }} (× 1). {%- endcomment -%}
          <span class="rdp-stat__num"><span data-pt-price data-pt-variant-id="{{ variant_id }}" data-pt-multiplier="1">${{ product.price | money_without_currency }}</span><span class="rdp-stat__unit">/{{ unit_one }}</span></span>
          <span class="rd-sr">Price per {{ unit_one }}</span>
        </div>
        {%- if is_wheel == false and product.metafields.custom.warranty_km != blank -%}
          {%- assign warranty_km_num = product.metafields.custom.warranty_km | times: 1 -%}
          {%- if warranty_km_num > 0 -%}
            {%- assign price_dollars = product.price | times: 1.0 | divided_by: 100.0 -%}
            {%- comment -%} dollars per km × 100 = cents per km (live had × 1000, which showed 10× the real figure). {%- endcomment -%}
            {%- assign cost_per_km_raw = price_dollars | divided_by: warranty_km_num | times: 100.0 -%}
            {%- assign cost_per_km_cents = cost_per_km_raw | round: 2 -%}
            <div class="rdp-stat">
              <span class="rdp-stat__num" style="color: #a95a08">{{ cost_per_km_cents }}<span class="rdp-stat__unit">&cent;/km</span></span>
              <span class="rdp-stat__label">{{ 'products.product.cost_per_km' | t | default: 'Cost per km' }}</span>
            </div>
          {%- endif -%}
        {%- endif -%}
        {%- if product.vendor != blank -%}
          <div class="rdp-stat">
            <svg class="rdp-stat__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
            <span class="rdp-stat__num rdp-stat__num--brand">{{ product.vendor }}</span>
            <span class="rd-sr">Brand</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ===== Three cards: specs / installation / will it fit ===== {%- endcomment -%}
    <div class="rdp-cards" data-rdp-group="cards">
      {%- comment -%} Specifications {%- endcomment -%}
      {%- if section.settings.show_specs_tab -%}
      <section class="rdp-d rdp-card is-open" data-rdp-d="specs" aria-labelledby="rdp-h-specs">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-specs" aria-expanded="true" aria-controls="rdp-b-specs">Specifications{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-specs">
          <dl class="rdp-rows">
            {%- if is_wheel -%}
              {%- if w_size != blank -%}<div><dt>Size</dt><dd>{{ w_size }}</dd></div>{%- endif -%}
              {%- if w_bolt_disp != blank -%}<div><dt>Bolt pattern</dt><dd>{{ w_bolt_disp }}</dd></div>{%- elsif w_blank -%}<div><dt>Bolt pattern</dt><dd>Blank (undrilled)</dd></div>{%- endif -%}
              {%- if w_et_disp != blank -%}<div><dt>Offset</dt><dd>{{ w_et_disp }}</dd></div>{%- endif -%}
              {%- if w_cb != blank -%}<div><dt>Centre bore</dt><dd>{{ w_cb }} mm</dd></div>{%- endif -%}
              {%- if w_finish != blank -%}<div><dt>Finish</dt><dd>{{ w_finish }}</dd></div>{%- endif -%}
              {%- if w_material != blank -%}<div><dt>Material</dt><dd>{{ w_material }}</dd></div>{%- endif -%}
              {%- if w_seat != blank -%}<div><dt>Lug seat</dt><dd>{{ w_seat }}</dd></div>{%- endif -%}
              {%- if w_load != blank -%}<div><dt>Max load</dt><dd>{{ w_load }} lbs per wheel</dd></div>{%- endif -%}
              {%- if wheel_winter_ok -%}<div><dt>Winter approved</dt><dd>Yes</dd></div>{%- endif -%}
              {%- if w_cap != blank -%}<div><dt>Centre cap</dt><dd>{{ w_cap }}</dd></div>{%- endif -%}
              <div><dt>Brand</dt><dd>{{ product.vendor }}</dd></div>
              {%- if w_mpn != blank -%}<div><dt>Part number</dt><dd>{{ w_mpn }}</dd></div>{%- endif -%}
              {%- if pt_sku != blank and pt_sku != w_mpn -%}<div><dt>SKU</dt><dd>{{ pt_sku }}</dd></div>{%- endif -%}
            {%- else -%}
              {%- if tire_size != blank -%}<div><dt>{{ 'sections.tire_description.spec_tire_size' | t }}</dt><dd>{{ tire_size }}</dd></div>{%- endif -%}
              {%- if spec_width != blank -%}<div><dt>{{ 'sections.tire_description.spec_section_width' | t }}</dt><dd>{{ spec_width }} mm</dd></div>{%- endif -%}
              {%- if spec_aspect != blank -%}<div><dt>{{ 'sections.tire_description.spec_aspect_ratio' | t }}</dt><dd>{{ spec_aspect }}</dd></div>{%- endif -%}
              {%- if spec_rim != blank -%}<div><dt>{{ 'sections.tire_description.spec_rim_diameter' | t }}</dt><dd>{{ spec_rim }}"</dd></div>{%- endif -%}
              {%- if season_display != blank -%}<div><dt>{{ 'sections.tire_description.spec_season' | t }}</dt><dd>{{ season_display }}</dd></div>{%- endif -%}
              {%- if has_3pmsf -%}<div><dt>Severe-snow rated (3PMSF)</dt><dd>Yes</dd></div>{%- elsif no_3pmsf -%}<div><dt>Severe-snow rated (3PMSF)</dt><dd>No</dd></div>{%- endif -%}
              {%- if has_ms -%}<div><dt>{{ 'sections.tire_description.spec_ms' | t }}</dt><dd>{{ 'sections.tire_description.yes' | t }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.load_index != blank -%}<div><dt>{{ 'sections.tire_description.spec_load_index' | t }}</dt><dd>{{ product.metafields.custom.load_index }}{%- if product.metafields.custom.max_load_lbs != blank %} ({{ product.metafields.custom.max_load_lbs }} lbs){%- endif -%}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.speed_rating != blank -%}<div><dt>{{ 'sections.tire_description.spec_speed_rating' | t }}</dt><dd>{{ product.metafields.custom.speed_rating }}{%- if product.metafields.custom.max_speed_kmh != blank %} ({{ product.metafields.custom.max_speed_kmh }} km/h){%- endif -%}</dd></div>{%- endif -%}
              {%- if is_xl -%}<div><dt>Load type</dt><dd>Extra load (XL)</dd></div>{%- endif -%}
              {%- if product.metafields.custom.ply_rating != blank -%}<div><dt>{{ 'sections.tire_description.spec_ply_rating' | t }}</dt><dd>{{ product.metafields.custom.ply_rating }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.sidewall != blank -%}<div><dt>{{ 'sections.tire_description.spec_sidewall' | t }}</dt><dd>{{ product.metafields.custom.sidewall }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.tread_depth != blank -%}<div><dt>{{ 'sections.tire_description.spec_tread_depth' | t }}</dt><dd>{{ product.metafields.custom.tread_depth }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.vehicle_type != blank -%}<div><dt>{{ 'sections.tire_description.spec_vehicle_type' | t }}</dt><dd>{{ product.metafields.custom.vehicle_type }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.run_flat != blank -%}<div><dt>{{ 'sections.tire_description.spec_run_flat' | t }}</dt><dd>{{ product.metafields.custom.run_flat }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.stud_option != blank -%}<div><dt>{{ 'sections.tire_description.spec_studdable' | t }}</dt><dd>{{ product.metafields.custom.stud_option }}</dd></div>{%- endif -%}
              {%- if product.variants.first.weight > 0 -%}<div><dt>{{ 'sections.tire_description.spec_weight' | t }}</dt><dd>{{ product.variants.first.weight }} {{ product.variants.first.weight_unit }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.utqg_treadwear != blank -%}<div><dt>UTQG {{ 'sections.tire_description.spec_utqg_treadwear' | t | downcase }}</dt><dd>{{ product.metafields.custom.utqg_treadwear }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.utqg_traction != blank -%}<div><dt>UTQG {{ 'sections.tire_description.spec_utqg_traction' | t | downcase }}</dt><dd>{{ product.metafields.custom.utqg_traction }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.utqg_temperature != blank -%}<div><dt>UTQG {{ 'sections.tire_description.spec_utqg_temperature' | t | downcase }}</dt><dd>{{ product.metafields.custom.utqg_temperature }}</dd></div>{%- endif -%}
              {%- if product.metafields.custom.warranty_km != blank -%}<div><dt>Treadwear warranty</dt><dd>{{ product.metafields.custom.warranty_km }} km</dd></div>{%- endif -%}
              {%- if product.type != blank -%}<div><dt>{{ 'sections.tire_description.spec_type' | t }}</dt><dd>{{ product.type }}</dd></div>{%- endif -%}
              <div><dt>{{ 'sections.tire_description.spec_brand' | t }}</dt><dd>{{ product.vendor }}</dd></div>
              {%- if pt_sku != blank -%}<div><dt>{{ 'products.product.sku' | t }}</dt><dd>{{ pt_sku }}</dd></div>{%- endif -%}
            {%- endif -%}
          </dl>

          {%- comment -%} Performance ratings - same rows, data and 0-100 scale as live (owner 11-13). Owner 11-13 (2nd pass): brand colours - grip bars orange, tread life green. Tires only (has_perf_data is false on wheels). A bar shows only when its metafield (or the section slider fallback) is above 0. {%- endcomment -%}
          {%- if has_perf_data and section.settings.show_performance -%}
            <h3 class="rdp-perf__h"><span>Performance ratings</span><span class="rdp-perf__scale">Scale 0–100</span></h3>
            <div class="rdp-perf ptp__perf-bars" data-ptp-perf>
              {%- if perf_dry > 0 -%}<div class="rdp-perf__row"><span class="rdp-perf__label">Dry grip</span><div class="rdp-perf__track"><div class="rdp-perf__fill rdp-perf__fill--dry" data-ptp-bar="{{ perf_dry }}" style="width:0%"></div></div><span class="rdp-perf__val" data-ptp-count="{{ perf_dry }}">0</span></div>{%- endif -%}
              {%- if perf_wet > 0 -%}<div class="rdp-perf__row"><span class="rdp-perf__label">Wet grip</span><div class="rdp-perf__track"><div class="rdp-perf__fill rdp-perf__fill--wet" data-ptp-bar="{{ perf_wet }}" style="width:0%"></div></div><span class="rdp-perf__val" data-ptp-count="{{ perf_wet }}">0</span></div>{%- endif -%}
              {%- if perf_ice > 0 -%}<div class="rdp-perf__row"><span class="rdp-perf__label">Ice grip</span><div class="rdp-perf__track"><div class="rdp-perf__fill rdp-perf__fill--ice" data-ptp-bar="{{ perf_ice }}" style="width:0%"></div></div><span class="rdp-perf__val" data-ptp-count="{{ perf_ice }}">0</span></div>{%- endif -%}
              {%- if perf_snow > 0 -%}<div class="rdp-perf__row"><span class="rdp-perf__label">Snow traction</span><div class="rdp-perf__track"><div class="rdp-perf__fill rdp-perf__fill--snow" data-ptp-bar="{{ perf_snow }}" style="width:0%"></div></div><span class="rdp-perf__val" data-ptp-count="{{ perf_snow }}">0</span></div>{%- endif -%}
              {%- if perf_tread > 0 -%}<div class="rdp-perf__row"><span class="rdp-perf__label">Tread life</span><div class="rdp-perf__track"><div class="rdp-perf__fill rdp-perf__fill--tread" data-ptp-bar="{{ perf_tread }}" style="width:0%"></div></div><span class="rdp-perf__val" data-ptp-count="{{ perf_tread }}">0</span></div>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </section>
      {%- endif -%}

      {%- comment -%} Will it fit? {%- endcomment -%}
      <section class="rdp-d rdp-card" data-rdp-d="fit" aria-labelledby="rdp-h-fit">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-fit" aria-expanded="false" aria-controls="rdp-b-fit"><span class="rdp-d__t-lg">Will it fit?</span><span class="rdp-d__t-sm">Will it fit my car?</span>{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-fit">
          {%- comment -%} "Fits N vehicles incl. ..." from app /api/fits-vehicles (hidden until it answers). {%- endcomment -%}
          {%- render 'pt-fits-vehicles', product: product -%}
          {%- if is_wheel -%}
            {%- if w_bolt != blank -%}
              <p class="rdp-p">Needs a <strong>{{ w_bolt | replace: '/', ' or ' }}</strong> bolt pattern{% if w_cb != blank %} and a hub of {{ w_cb }} mm or smaller (smaller hubs get a hub ring){% endif %}.</p>
            {%- elsif w_blank -%}
              <p class="rdp-p">This wheel is blank (undrilled), so it has no bolt pattern yet.</p>
            {%- endif -%}
          {%- elsif tire_size != blank -%}
            <p class="rdp-p">This tire fits wheels marked <strong>{{ tire_size }}</strong>. The size is printed on the side of your current tires.</p>
          {%- endif -%}
          {%- if has_compat -%}
            {%- assign compat_sample_size = compat_sample.size -%}
            {%- assign compat_rest = compat_count | minus: compat_sample_size -%}
            {%- assign compat_first_n = 6 -%}
            <p class="rdp-fitlist__h">{%- if is_wheel -%}{{- 'sections.tire_description.vehicles_heading_wheel' | t -}}{%- else -%}{{- 'sections.tire_description.vehicles_heading' | t: tire_size: tire_size -}}{%- endif -%}</p>
            <ul class="rdp-chips" role="list">
              {%- for v in compat_sample limit: compat_first_n -%}
                {%- if v.make != blank -%}<li class="rdp-chip ptp__vehicle-chip">{{ v.make | escape }} {{ v.model | escape }}{% if v.years != blank %} {{ v.years | escape }}{% endif %}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if compat_sample_size > compat_first_n or compat_rest > 0 -%}
              <details class="rdp-more-v ptp__vehicle-all">
                <summary class="rdp-textbtn">{{ 'sections.tire_description.vehicles_show_all' | t: count: compat_count }}</summary>
                <ul class="rdp-chips" role="list">
                  {%- for v in compat_sample offset: compat_first_n limit: 49 -%}
                    {%- if v.make != blank -%}<li class="rdp-chip ptp__vehicle-chip">{{ v.make | escape }} {{ v.model | escape }}{% if v.years != blank %} {{ v.years | escape }}{% endif %}</li>{%- endif -%}
                  {%- endfor -%}
                  {%- if compat_rest > 0 -%}<li class="rdp-chip rdp-chip--more">{{ 'sections.tire_description.vehicles_more' | t: count: compat_rest }}</li>{%- endif -%}
                </ul>
              </details>
            {%- endif -%}
          {%- endif -%}
          <p class="rdp-p rdp-p--last">Not sure? Call <a href="tel:{{ stock_tel }}">{{ stock_phone }}</a> and we'll check{% if is_wheel %} bolt pattern, offset and clearance{% endif %} for you.</p>
        </div>
      </section>

      {%- comment -%} Installation {%- endcomment -%}
      <section class="rdp-d rdp-card" data-rdp-d="install" aria-labelledby="rdp-h-install">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-install" aria-expanded="false" aria-controls="rdp-b-install">Installation{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-install">
          {%- if is_wheel -%}
            <p class="rdp-p">We mount your tires on these wheels, balance them, torque the lug nuts to spec, and check the torque again free at 50 to 100 km.</p>
          {%- else -%}
            <p class="rdp-p">Installation at either Calgary shop includes mounting, a standard balance, a valve stem check and torque to spec, plus a free re-torque check at 50 to 100 km.</p>
          {%- endif -%}
          <dl class="rdp-rows">
            <div><dt>Price</dt><dd>{% if install_promo_id != '' and install_promo_style == 'plain' %}${{ install_now_disp }} per {{ unit_one }} on a {{ install_promo_vehicles | escape }}{% elsif install_promo_id != '' %}${{ install_now_disp }} per {{ unit_one }} on a {{ install_promo_vehicles | escape }} ({{ install_promo_label | escape }}; regular ${{ install_disp }}){% else %}${{ install_disp }} per {{ unit_one }}{% endif %}</dd></div>
            <div><dt>Where</dt><dd>SW · 42 Ave SW, or NE · Edmonton Trail</dd></div>
            <div><dt>When</dt><dd>Pick a time — we confirm before your visit.</dd></div>
          </dl>
          {%- if is_wheel -%}
            <p class="rdp-p rdp-p--small">TPMS sensors moved or new ($60 each). If your car needs hub rings or different lug nuts, we tell you before we mount. We do not offer wheel alignment or tire storage.</p>
          {%- else -%}
            <p class="rdp-p rdp-p--small">We also do TPMS service and flat repair. We do not offer wheel alignment or tire storage.</p>
          {%- endif -%}
        </div>
      </section>
    </div>

    {%- comment -%} ===== Tabs (desktop) / dropdowns (phone): description, warranty, shipping, FAQ ===== {%- endcomment -%}
    {%- liquid
      comment
        FAQ - built once, shown in the FAQ tab and in the FAQPage JSON-LD below
        with the same strings, so the two always match.
      endcomment
      if is_wheel
        assign faq_bolt_words = w_bolt | replace: '/', ' or '
        if w_bolt != blank
          capture faq_w1_a
            echo 'It fits cars with a ' | append: faq_bolt_words | append: ' bolt pattern'
            if w_cb != blank
              echo ' and a hub of ' | append: w_cb | append: ' mm or smaller'
            endif
            echo '. Save your vehicle in My Garage and we show whether it fits. We check fit again before we mount.'
          endcapture
        endif
        if w_cb != blank
          assign faq_w2_a = 'If your hub is smaller than ' | append: w_cb | append: ' mm, a hub ring centres the wheel. We tell you before we mount.'
        endif
        assign faq_w3_a = 'Yes. Mount and balance is $' | append: install_disp | append: ' a wheel at either Calgary shop, with a free torque check at 50 to 100 km. Request a time online or call either shop.'
      elsif tire_size != blank
        capture faq_1_q
          echo 'sections.tire_description.faq_1_q' | t: title: product.title
        endcapture
        capture faq_1_a
          case season_tag
            when 'Winter'
              echo 'sections.tire_description.faq_1_a_winter' | t: title: product.title
            when 'All-Season'
              echo 'sections.tire_description.faq_1_a_all_season' | t: title: product.title
            when 'All-Weather'
              comment
                Same cautious answer with or without 3PMSF (approved mockup):
                a winter tire still does better in the most severe conditions.
              endcomment
              echo 'sections.tire_description.faq_1_a_all_weather' | t: title: product.title
            when 'Summer'
              echo 'sections.tire_description.faq_1_a_summer' | t: title: product.title
            else
              echo 'sections.tire_description.faq_1_a_default' | t: title: product.title
          endcase
        endcapture
        assign faq_has_2 = false
        if product.metafields.custom.utqg_treadwear != blank or product.metafields.custom.warranty_km != blank
          assign faq_has_2 = true
          capture faq_2_q
            echo 'sections.tire_description.faq_2_q' | t: title: product.title
          endcapture
          capture faq_2_a
            if product.metafields.custom.warranty_km != blank
              if product.metafields.custom.utqg_treadwear != blank
                echo 'sections.tire_description.faq_2_a_full' | t: title: product.title, warranty_km: product.metafields.custom.warranty_km, utqg_treadwear: product.metafields.custom.utqg_treadwear
              else
                echo 'sections.tire_description.faq_2_a_warranty' | t: title: product.title, warranty_km: product.metafields.custom.warranty_km
              endif
            else
              echo 'sections.tire_description.faq_2_a_utqg' | t: title: product.title, utqg_treadwear: product.metafields.custom.utqg_treadwear
            endif
          endcapture
        endif
        assign faq_has_3 = false
        if product.metafields.custom.load_index != blank
          assign faq_has_3 = true
          capture faq_3_q
            echo 'sections.tire_description.faq_3_q' | t: title: product.title
          endcapture
          capture faq_3_a
            if product.metafields.custom.max_load_lbs != blank
              echo 'sections.tire_description.faq_3_a_full' | t: title: product.title, load_index: product.metafields.custom.load_index, max_load_lbs: product.metafields.custom.max_load_lbs
            else
              echo 'sections.tire_description.faq_3_a_basic' | t: title: product.title, load_index: product.metafields.custom.load_index
            endif
          endcapture
        endif
        comment
          3PMSF question only when we KNOW the answer (see has_3pmsf above). It
          used to answer "No" for every winter tire with a blank metafield.
        endcomment
        assign faq_has_4 = false
        if has_3pmsf or no_3pmsf
          assign faq_has_4 = true
          capture faq_4_q
            echo 'sections.tire_description.faq_4_q' | t: title: product.title
          endcapture
          capture faq_4_a
            if has_3pmsf
              echo 'sections.tire_description.faq_4_a_yes' | t: title: product.title
            else
              echo 'sections.tire_description.faq_4_a_no' | t: title: product.title
            endif
          endcapture
        endif
        capture faq_5_q
          echo 'sections.tire_description.faq_5_q' | t
        endcapture
        capture faq_5_a
          echo 'sections.tire_description.faq_5_a' | t
        endcapture
      endif
    -%}
    <div class="rdp-tabset" data-rdp-group="tabs">
      <div class="rdp-tablist" role="tablist" aria-label="Product details">
        {%- if section.settings.show_desc_tab -%}<button type="button" role="tab" class="rdp-tab is-on" id="rdp-t-desc" aria-selected="true" aria-controls="rdp-b-desc" data-rdp-tab="desc">Description</button>{%- endif -%}
        {%- if section.settings.show_warranty_tab -%}<button type="button" role="tab" class="rdp-tab" id="rdp-t-warranty" aria-selected="false" aria-controls="rdp-b-warranty" data-rdp-tab="warranty" tabindex="-1">Warranty</button>{%- endif -%}
        {%- if section.settings.show_shipping_tab -%}<button type="button" role="tab" class="rdp-tab" id="rdp-t-ship" aria-selected="false" aria-controls="rdp-b-ship" data-rdp-tab="ship" tabindex="-1">Shipping &amp; returns</button>{%- endif -%}
        {%- if is_wheel or tire_size != blank -%}<button type="button" role="tab" class="rdp-tab" id="rdp-t-faq" aria-selected="false" aria-controls="rdp-b-faq" data-rdp-tab="faq" tabindex="-1">FAQ</button>{%- endif -%}
      </div>

      {%- if section.settings.show_desc_tab -%}
      <section class="rdp-d is-tab" data-rdp-d="desc">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-desc" aria-expanded="false" aria-controls="rdp-b-desc">Description{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-desc" role="tabpanel" aria-labelledby="rdp-t-desc">
          {%- if is_wheel -%}
            <div class="rdp-prose ptp__description" data-aeo-speakable>
              <p>
                This {% if w_rd != blank %}{{ w_rd }}-inch {% endif %}{% if w_mat_short != blank %}{{ w_mat_short }} {% endif %}wheel from {{ product.vendor }}
                {%- if w_finish != blank %} comes in {{ w_finish }}{%- endif -%}
                {%- if w_bolt != blank -%}, drilled {{ w_bolt | replace: '/', ' or ' }}{%- elsif w_blank -%}, blank (undrilled){%- endif -%}
                {%- if w_et_disp != blank %} with a {{ w_et_disp | remove: 'ET ' }} offset{%- endif -%}.
                {%- if has_compat -%}
                  {%- assign rdp_names = '' -%}
                  {%- for v in compat_sample limit: 3 -%}{%- if v.make != blank -%}{%- assign rdp_nm = v.make | append: ' ' | append: v.model -%}{%- if rdp_names == blank -%}{%- assign rdp_names = rdp_nm -%}{%- elsif forloop.last -%}{%- assign rdp_names = rdp_names | append: ' and ' | append: rdp_nm -%}{%- else -%}{%- assign rdp_names = rdp_names | append: ', ' | append: rdp_nm -%}{%- endif -%}{%- endif -%}{%- endfor -%}
                  {{ ' ' }}It fits vehicles including {{ rdp_names | escape }}.
                {%- endif -%}
              </p>
              <p>Order it through Prince Tires in Calgary and we mount and balance it with your tires at either shop.</p>
            </div>
          {%- elsif tire_size != blank -%}
            <div class="rdp-prose ptp__description" data-aeo-speakable>
              {%- liquid
                assign rdp_season_words = season_display | downcase
                assign rdp_vt = product.metafields.custom.vehicle_type | default: '' | downcase
                assign rdp_lead_word = rdp_season_words
                if rdp_lead_word == blank
                  assign rdp_lead_word = rdp_vt
                endif
                assign rdp_first = rdp_lead_word | slice: 0
                assign rdp_article = 'a'
                if rdp_first == 'a' or rdp_first == 'e' or rdp_first == 'i' or rdp_first == 'o' or rdp_first == 'u'
                  assign rdp_article = 'an'
                endif
              -%}
              <p>
                The {{ product.vendor }} {{ product.title }} is {{ rdp_article }}{% if rdp_season_words != blank %} {{ rdp_season_words }}{% endif %}{% if rdp_vt != blank and rdp_vt != rdp_season_words %} {{ rdp_vt }}{% endif %} tire available in size {{ tire_size }}.
                {%- if product.metafields.custom.load_index != blank -%}
                  {%- if product.metafields.custom.speed_rating != blank -%}{{ 'sections.tire_description.intro_rated' | t: load_index: product.metafields.custom.load_index, speed_rating: product.metafields.custom.speed_rating }}{%- endif -%}
                  {%- if product.metafields.custom.max_load_lbs != blank -%}{{ 'sections.tire_description.intro_load_capacity' | t: max_load_lbs: product.metafields.custom.max_load_lbs }}{%- endif -%}
                  {%- if product.metafields.custom.max_speed_kmh != blank -%}{{ 'sections.tire_description.intro_speed_capacity' | t: max_speed_kmh: product.metafields.custom.max_speed_kmh }}{%- endif -%}
                {%- endif -%}
              </p>
              {%- if product.metafields.custom.warranty_km != blank -%}
                <p>{{ 'sections.tire_description.intro_warranty' | t: warranty_km: product.metafields.custom.warranty_km, vendor: product.vendor }}</p>
              {%- endif -%}
              {%- comment -%} No 3PMSF paragraph here (approved mockup): the meta line, Specs row and FAQ already state it. The M+S "pair with winter tires" line is skipped on 3PMSF and Winter tires, where it would contradict the page. {%- endcomment -%}
              {%- if has_ms and has_3pmsf == false and season_tag != 'Winter' -%}
                <p>{{ 'sections.tire_description.intro_ms' | t }}</p>
              {%- endif -%}
              <p>{{ 'sections.tire_description.intro_available' | t }}</p>
            </div>
            {%- if product.metafields.custom.best_for != blank or product.metafields.custom.not_recommended_for != blank -%}
              <div class="rdp-use">
                {%- if product.metafields.custom.best_for != blank -%}
                  <p><strong>{{ 'sections.tire_description.best_for' | t }}:</strong> {{ product.metafields.custom.best_for | split: ',' | join: ', ' }}</p>
                {%- endif -%}
                {%- if product.metafields.custom.not_recommended_for != blank -%}
                  <p><strong>{{ 'sections.tire_description.not_recommended' | t }}:</strong> {{ product.metafields.custom.not_recommended_for | split: ',' | join: ', ' }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="rdp-callout rdp-callout--orange">
            <h3 class="rdp-h3 rdp-h3--first">{{ 'sections.tire_description.local_heading' | t }}</h3>
            <div class="rdp-prose ptp__local-note">
              {%- case season_tag -%}
                {%- when 'Winter' -%}<p>{{ 'sections.tire_description.local_winter' | t: title: product.title }}</p>
                {%- when 'All-Season' -%}<p>{{ 'sections.tire_description.local_all_season' | t: title: product.title }}</p>
                {%- when 'All-Weather' -%}<p>{{ 'sections.tire_description.local_all_weather' | t: title: product.title }}</p>
                {%- when 'Summer' -%}<p>{{ 'sections.tire_description.local_summer' | t: title: product.title }}</p>
                {%- else -%}<p>{{ 'sections.tire_description.local_default' | t: title: product.title }}</p>
              {%- endcase -%}
            </div>
            </div>
          {%- else -%}
            <div class="rdp-prose">
              {%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>{{ product.title }} from {{ product.vendor }}. Call <a href="tel:{{ stock_tel }}">{{ stock_phone }}</a> with any question.</p>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </section>
      {%- endif -%}

      {%- if section.settings.show_warranty_tab -%}
      <section class="rdp-d" data-rdp-d="warranty">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-warranty" aria-expanded="false" aria-controls="rdp-b-warranty">Warranty{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-warranty" role="tabpanel" aria-labelledby="rdp-t-warranty">
          {%- if is_wheel -%}
            {%- comment -%} Wheels: warranty terms only from data (the feed's Structure / Finish Warranty lines), never invented; else "Ask us". {%- endcomment -%}
            <div class="rdp-wrow">
              <svg class="rdp-wrow__ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <div class="rdp-wrow__body">
            <h3 class="rdp-wrow__h">Manufacturer warranty</h3>
            {%- if w_warr_structure != blank or w_warr_finish != blank -%}
              <dl class="rdp-rows">
                {%- if w_warr_structure != blank -%}<div><dt>Structure</dt><dd>{{ w_warr_structure }}</dd></div>{%- endif -%}
                {%- if w_warr_finish != blank -%}<div><dt>Finish</dt><dd>{{ w_warr_finish }}</dd></div>{%- endif -%}
              </dl>
              <p class="rdp-wrow__p">These terms are set by {{ product.vendor }}. Ask us for the full terms before you buy: call <a href="tel:{{ stock_tel }}">{{ stock_phone }}</a>.</p>
            {%- else -%}
              <p class="rdp-wrow__p">Warranty terms are set by {{ product.vendor }}. Ask us and we'll tell you the terms for this wheel before you buy: call <a href="tel:{{ stock_tel }}">{{ stock_phone }}</a>.</p>
            {%- endif -%}
              </div>
            </div>
          {%- else -%}
            {%- comment -%}
              Live look (owner 11-14 "I like the colours in the old design"): three
              light-grey rows, each with an orange #F5820B line icon; "— optional" and
              "See what's covered" in orange (text shade #a95a08, see pt-rd-pdp.css).
            {%- endcomment -%}
            <div class="rdp-wrow">
              <svg class="rdp-wrow__ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <div class="rdp-wrow__body">
                <h3 class="rdp-wrow__h">Manufacturing defect warranty</h3>
                <p class="rdp-wrow__p">Covers manufacturing defects for 80,000 km on all-season and all-weather tires. Winter tires are covered for 1 year from the date of purchase.</p>
                {%- if product.metafields.custom.warranty_km != blank -%}
                  <p class="rdp-wrow__p">{{ 'sections.tire_description.warranty_badge' | t: warranty_km: product.metafields.custom.warranty_km }}.</p>
                {%- endif -%}
              </div>
            </div>
            <div class="rdp-wrow">
              <svg class="rdp-wrow__ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <div class="rdp-wrow__body">
                <h3 class="rdp-wrow__h">What's covered</h3>
                <p class="rdp-wrow__p">Defects in materials and workmanship under normal driving conditions. Does not cover road hazards, punctures, improper installation, or misuse.</p>
              </div>
            </div>
            {%- liquid
              assign rdp_pp_vendor = product.vendor | strip | downcase
              # Owner 2026-11-14: the Protection Plan is offered on every tire. "all" (or blank) = every brand.
              assign rdp_pp_setting = section.settings.protection_plan_vendors | default: 'all' | strip | downcase
              assign rdp_pp_list = section.settings.protection_plan_vendors | default: 'all' | split: ','
              assign rdp_pp_ok = false
              if rdp_pp_setting == 'all' or rdp_pp_setting == blank
                assign rdp_pp_ok = true
              endif
              for rdp_pp_v in rdp_pp_list
                assign rdp_pp_vd = rdp_pp_v | strip | downcase
                if rdp_pp_vd != blank and rdp_pp_vd == rdp_pp_vendor
                  assign rdp_pp_ok = true
                endif
              endfor
            -%}
            <div class="rdp-wrow">
              <svg class="rdp-wrow__ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <div class="rdp-wrow__body">
                {%- if rdp_pp_ok -%}
                  <h3 class="rdp-wrow__h">Protection Plan <span class="rdp-wrow__opt">— optional</span></h3>
                  <p class="rdp-wrow__p">Covers the potholes, nails and sidewall damage the standard warranty doesn't. The price depends on the tire; you see it and can add it when you book your install. <a class="rdp-wrow__link" href="/pages/road-hazard-protection">See what's covered</a>.</p>
                {%- else -%}
                  <h3 class="rdp-wrow__h">Protection plans</h3>
                  <p class="rdp-wrow__p">Ask us about protection plans for this tire.</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </section>
      {%- endif -%}

      {%- if section.settings.show_shipping_tab -%}
      <section class="rdp-d" data-rdp-d="ship">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-ship" aria-expanded="false" aria-controls="rdp-b-ship">Shipping &amp; returns{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-ship" role="tabpanel" aria-labelledby="rdp-t-ship">
          <div class="rdp-prose ptp__shipping-info">
            {%- comment -%} Same lead time as the line in the buy box and the booking floor (pt-stock-state 4th field). {%- endcomment -%}
            {%- case pt_stock_lead -%}
              {%- when 'today' -%}<p data-pt-ready="own">{{ 'products.stock.ready_own_html' | t }}</p>
              {%- when '1-2' -%}<p data-pt-ready="{{ pt_stock_kind }}">{{ 'products.stock.ready_supplier_html' | t }}</p>
              {%- when 'order' -%}<p data-pt-ready="order"><strong>{{ 'products.stock.lead_order' | t }}</strong><br>We order this one in for you. Ask us for timing: <a href="tel:{{ stock_tel }}">{{ stock_phone }}</a>.</p>
            {%- endcase -%}
            <p><strong>Calgary delivery</strong><br>Free delivery within Calgary once your {{ unit_many }} are ready.</p>
            <p><strong>Outside Calgary</strong><br>Customer covers the delivery cost. Delivery may take 1–2 weeks depending on your location.</p>
            <p><strong>Returns</strong><br>{{ unit_cap }} must be uninstalled, unused, and with original stickers on. Contact us within 30 days of purchase.</p>
          </div>
        </div>
      </section>
      {%- endif -%}

      {%- if is_wheel or tire_size != blank -%}
      <section class="rdp-d" data-rdp-d="faq">
        <h2 class="rdp-d__h"><button type="button" class="rdp-d__btn" id="rdp-h-faq" aria-expanded="false" aria-controls="rdp-b-faq">FAQ{% render 'pt-icon', name: 'chevron-down', size: 20, class: 'rdp-d__chev' %}</button></h2>
        <div class="rdp-d__body" id="rdp-b-faq" role="tabpanel" aria-labelledby="rdp-t-faq">
          {%- liquid
            comment
              Owner 11-13: answers that start with "Yes." get a green tick (CSS only,
              so the visible text still matches the FAQPage JSON-LD word for word).
            endcomment
            assign faq_yes_1 = faq_1_a | strip | slice: 0, 4
            assign faq_yes_2 = faq_2_a | strip | slice: 0, 4
            assign faq_yes_3 = faq_3_a | strip | slice: 0, 4
            assign faq_yes_4 = faq_4_a | strip | slice: 0, 4
            assign faq_yes_5 = faq_5_a | strip | slice: 0, 4
            assign faq_yes_w1 = faq_w1_a | strip | slice: 0, 4
            assign faq_yes_w2 = faq_w2_a | strip | slice: 0, 4
            assign faq_yes_w3 = faq_w3_a | strip | slice: 0, 4
          -%}
          <div class="rdp-faq ptp__faq-list">
            {%- if is_wheel -%}
              {%- if w_bolt != blank -%}<div class="rdp-qa ptp__faq-item{% if faq_yes_w1 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">Will this wheel fit my car?</h3><p class="ptp__faq-a">{{ faq_w1_a | strip }}</p></div>{%- endif -%}
              {%- if w_cb != blank -%}<div class="rdp-qa ptp__faq-item{% if faq_yes_w2 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">Do I need hub rings?</h3><p class="ptp__faq-a">{{ faq_w2_a }}</p></div>{%- endif -%}
              <div class="rdp-qa ptp__faq-item{% if faq_yes_w3 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">Does Prince Tires install wheels?</h3><p class="ptp__faq-a">{{ faq_w3_a }}</p></div>
            {%- else -%}
              <div class="rdp-qa ptp__faq-item{% if faq_yes_1 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">{{ faq_1_q | strip }}</h3><p class="ptp__faq-a">{{ faq_1_a | strip }}</p></div>
              {%- if faq_has_2 -%}<div class="rdp-qa ptp__faq-item{% if faq_yes_2 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">{{ faq_2_q | strip }}</h3><p class="ptp__faq-a">{{ faq_2_a | strip }}</p></div>{%- endif -%}
              {%- if faq_has_3 -%}<div class="rdp-qa ptp__faq-item{% if faq_yes_3 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">{{ faq_3_q | strip }}</h3><p class="ptp__faq-a">{{ faq_3_a | strip }}</p></div>{%- endif -%}
              {%- if faq_has_4 -%}<div class="rdp-qa ptp__faq-item{% if faq_yes_4 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">{{ faq_4_q | strip }}</h3><p class="ptp__faq-a">{{ faq_4_a | strip }}</p></div>{%- endif -%}
              <div class="rdp-qa ptp__faq-item{% if faq_yes_5 == 'Yes.' %} rdp-qa--yes{% endif %}"><h3 class="ptp__faq-q">{{ faq_5_q | strip }}</h3><p class="ptp__faq-a">{{ faq_5_a | strip }}</p></div>
            {%- endif -%}
          </div>
          {%- comment -%} FAQPage JSON-LD - the same strings as the visible FAQ above. {%- endcomment -%}
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- if is_wheel -%}
                {%- if w_bolt != blank -%}{ "@type": "Question", "name": "Will this wheel fit my car?", "acceptedAnswer": { "@type": "Answer", "text": {{ faq_w1_a | strip | json }} } },{%- endif -%}
                {%- if w_cb != blank -%}{ "@type": "Question", "name": "Do I need hub rings?", "acceptedAnswer": { "@type": "Answer", "text": {{ faq_w2_a | json }} } },{%- endif -%}
                { "@type": "Question", "name": "Does Prince Tires install wheels?", "acceptedAnswer": { "@type": "Answer", "text": {{ faq_w3_a | json }} } }
              {%- else -%}
                { "@type": "Question", "name": {{ faq_1_q | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq_1_a | strip | json }} } }
                {%- if faq_has_2 -%},{ "@type": "Question", "name": {{ faq_2_q | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq_2_a | strip | json }} } }{%- endif -%}
                {%- if faq_has_3 -%},{ "@type": "Question", "name": {{ faq_3_q | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq_3_a | strip | json }} } }{%- endif -%}
                {%- if faq_has_4 -%},{ "@type": "Question", "name": {{ faq_4_q | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq_4_a | strip | json }} } }{%- endif -%}
                ,{ "@type": "Question", "name": {{ faq_5_q | strip | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq_5_a | strip | json }} } }
              {%- endif -%}
            ]
          }
          </script>
        </div>
      </section>
      {%- endif -%}

      <p class="rdp-links ptp__links">
        <a href="{{ routes.collections_url }}/{{ unit_collection }}?filter.p.vendor={{ product.vendor | url_encode }}" class="ptp__link">More from {{ product.vendor }}</a>
        {%- if tire_size != blank -%}
          <a href="{{ routes.collections_url }}/tires?filter.p.m.custom.tire_size={{ tire_size | url_encode }}" class="ptp__link">Compare {{ tire_size }} tires</a>
        {%- elsif is_wheel and w_rd != blank -%}
          <a href="{{ routes.collections_url }}/wheels?filter.p.m.custom.rim_diameter={{ w_rd | url_encode }}" class="ptp__link">Compare {{ w_rd }}″ wheels</a>
        {%- endif -%}
      </p>
    </div>
  </div>

  {%- comment -%} Phone sticky bar: price line + call, Add to cart, Request install (replaces the site tab bar on product pages). {%- endcomment -%}
  <div class="rdp-sticky ptp__sticky" data-ptp-sticky>
    <div class="rdp-sticky__top">
      <span class="ptp__sticky-price">
        <strong class="ptp__sticky-set" data-ptp-sticky-total data-pt-price data-pt-variant-id="{{ variant_id }}" data-pt-multiplier="{{ set_count }}">${{ set_price | money_without_currency }}</strong>
        <span class="ptp__sticky-per">· <span data-pt-price data-pt-variant-id="{{ variant_id }}" data-pt-multiplier="1">${{ product.price | money_without_currency }}</span> / {{ unit_one }}{%- if sticky_savings > 0 -%} <strong class="ptp__sticky-save">· Save ${{ sticky_savings | money_without_currency }}</strong>{%- endif -%}</span>
      </span>
      {%- if section.settings.show_installed_price and product.available -%}
        <span class="rdp-sticky__inst"><span data-rdp-sticky-inst>${{ installed_total | money_without_currency }}</span> installed</span>
      {%- endif -%}
    </div>
    {%- if customer.b2b? or customer.tags contains 'wholesale' -%}
      <div class="ptp__sticky-trade" data-pt-trade-info data-pt-variant-id="{{ variant_id }}">
        Your cost: <span data-pt-trade-amount>—</span>/{{ unit_one }} · <strong><span data-pt-trade-pct>—</span>% off</strong>
      </div>
    {%- endif -%}
    <div class="rdp-sticky__actions ptp__sticky-actions">
      <a class="rdp-sticky__call ptp__sticky-call" href="tel:+1{{ sticky_phone_dig }}" aria-label="Call us">{% render 'pt-icon', name: 'phone', size: 20 %}</a>
      {%- if call_to_book -%}
        <a class="rdp-sticky__book ptp__sticky-book ptp__call-book" href="tel:{{ stock_tel }}" data-pt-call-to-book>{{ 'products.stock.call_cta' | t }}</a>
      {%- elsif product.available -%}
        <button type="submit" form="{{ product_form_id }}" class="rdp-sticky__add ptp__sticky-add" data-ptp-sticky-add>Add to cart</button>
        <button type="button" class="rdp-sticky__book ptp__sticky-book{% if sold_out %} ptp__book-btn--out{% endif %}"{% if sold_out %} disabled aria-disabled="true"{% endif %} {{ rdp_book_attrs }}>
          {%- if sold_out -%}Sold out{%- else -%}Request install{%- endif -%}
        </button>
      {%- else -%}
        <a class="rdp-sticky__book ptp__sticky-book" href="#rdp-bis" data-rdp-bis-jump>Get notified</a>
      {%- endif -%}
    </div>
  </div>

  {%- if customer.tags contains 'staff' or customer.b2b? or customer.tags contains 'wholesale' -%}
    {%- render 'pt-quote-modal' -%}
  {%- endif -%}
</product-info>

<script>
(function () {
  var root = document.querySelector('[data-rdp]');
  if (!root) return;
  root.classList.add('rdp-js');
  var sec = root;
  var mqDesk = window.matchMedia('(min-width: 990px)');

  /* ── Numbers (integer cents) ──────────────────────────────────────── */
  var D = root.dataset;
  var unitC = parseInt(D.rdpUnitCents, 10) || 0;
  var instC = parseInt(D.rdpInstallCents, 10) || 0;
  var instWasC = parseInt(D.rdpInstallWasCents, 10) || 0;
  var levyC = parseInt(D.rdpLevyCents, 10) || 0;
  var levyApplies = D.rdpLevyApplies === 'true';
  var levyInPrice = D.rdpLevyInPrice === 'true';
  var one = D.rdpUnitOne || 'tire', many = D.rdpUnitMany || 'tires';
  var isWheel = one === 'wheel';
  function money(c) { return '$' + (Math.round(c) / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
  function setText(sel, txt) { Array.prototype.forEach.call(root.querySelectorAll(sel), function (el) { el.textContent = txt; }); }

  var qtyInput = root.querySelector('[data-ptp-qty]');
  /* On-hand cap: 0 = no cap (untracked / continue-selling). */
  var maxQty = qtyInput ? (parseInt(qtyInput.dataset.ptpMax, 10) || 0) : (parseInt(D.rdpMax, 10) || 0);
  function curQty() {
    var v = qtyInput ? parseInt(qtyInput.value, 10) : 0;
    if (!v || v < 1) v = 1;
    if (maxQty > 0 && v > maxQty) v = maxQty;
    return v;
  }

  function paint() {
    var q = curQty();
    var items = unitC * q, inst = instC * q, levy = levyC * q;
    var sub = items + inst + levy;
    var gst = Math.round(sub * 5 / 100);
    var total = sub + gst;
    var setLabel = q === 4 ? 'for a set of 4' : q === 1 ? 'for 1 ' + one : 'for ' + q + ' ' + many;
    var qtyWord = q === 4 ? 'set of 4' : q === 1 ? '1 ' + one : q + ' ' + many;
    setText('[data-rdp-set]', money(items));
    setText('[data-rdp-set-label]', setLabel);
    setText('[data-ptp-cart-total]', money(items));
    setText('[data-ptp-sticky-total]', money(items));
    Array.prototype.forEach.call(root.querySelectorAll('[data-rdp-set],[data-ptp-sticky-total]'), function (el) { el.setAttribute('data-pt-multiplier', String(q)); });
    setText('[data-rdp-total]', money(total));
    setText('[data-rdp-sticky-inst]', money(total));
    setText('[data-rdp-qtyword]', qtyWord);
    setText('[data-rdp-b-qty]', String(q));
    setText('[data-rdp-b-items]', money(items));
    setText('[data-rdp-b-install]', money(inst));
    /* Install promo line (whole dollars, as Liquid prints it) */
    function dollars(c) { return money(c).replace(/\.00$/, ''); }
    setText('[data-rdp-promo-now]', dollars(inst));
    setText('[data-rdp-promo-was]', dollars(instWasC * q));
    setText('[data-rdp-promo-qty]', String(q));
    if (levyApplies && !levyInPrice) setText('[data-rdp-b-levy]', money(levy));
    setText('[data-rdp-b-gst]', money(gst));
    setText('[data-rdp-b-total]', money(total));
    if (isWheel) setText('[data-rdp-note]', 'Includes mount & balance for ' + q + ' ' + (q === 1 ? 'wheel' : 'wheels'));
    var box = root.querySelector('[data-rdp-total-box]');
    if (box) {
      box.setAttribute('data-set-count', String(q));
      box.setAttribute('data-set-cents', String(items));
      box.setAttribute('data-install-cents', String(inst));
      if (instWasC > 0 && box.hasAttribute('data-install-was-cents')) box.setAttribute('data-install-was-cents', String(instWasC * q));
      box.setAttribute('data-levy-cents', String(levy));
      box.setAttribute('data-gst-cents', String(gst));
      box.setAttribute('data-total-cents', String(total));
    }
    Array.prototype.forEach.call(root.querySelectorAll('.ptp__book-btn[data-product-handle], .ptp__sticky-book[data-product-handle]'), function (b) { b.setAttribute('data-qty', String(q)); });
  }

  /* The booking form opens with the stepper's quantity (it reads the last-used qty). */
  window.ptpBookQty = function (btn) {
    var q = curQty();
    if (btn) btn.setAttribute('data-qty', String(q));
    try { localStorage.setItem('pt-booking-qty', String(q)); } catch (e) {}
  };

  if (qtyInput) {
    var m = root.querySelector('[data-ptp-qty-minus]'), p = root.querySelector('[data-ptp-qty-plus]');
    function clamp() {
      var v = curQty();
      qtyInput.value = v;
      if (p) p.disabled = (maxQty > 0 && v >= maxQty);
      if (m) m.disabled = v <= 1;
      return v;
    }
    if (m) m.addEventListener('click', function () { var v = clamp(); if (v > 1) { qtyInput.value = v - 1; clamp(); paint(); } });
    if (p) p.addEventListener('click', function () { var v = clamp(); if (maxQty === 0 || v < maxQty) { qtyInput.value = v + 1; clamp(); paint(); } });
    qtyInput.addEventListener('change', function () { clamp(); paint(); });
    qtyInput.addEventListener('input', function () { if (qtyInput.value !== '') { paint(); } });
    clamp();
    paint();
  }

  /* Price breakdown toggle */
  Array.prototype.forEach.call(root.querySelectorAll('[data-rdp-break-toggle]'), function (b) {
    var panel = document.getElementById(b.getAttribute('aria-controls'));
    if (!panel) return;
    b.addEventListener('click', function () {
      var open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      b.textContent = open ? 'Hide price breakdown' : 'See price breakdown';
    });
  });

  /* ── Cart count + toast + AJAX add to cart ───────────────────────── */
  function updateCartCount() {
    fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var count = cart.item_count;
        document.querySelectorAll('.pt-header__cart-count').forEach(function (el) { el.textContent = count; el.hidden = count === 0; });
      })
      .catch(function () {});
  }
  function showToast(msg, type) {
    var t = document.createElement('div');
    t.className = 'rdp-toast' + (type === 'error' ? ' rdp-toast--error' : '');
    t.setAttribute('role', 'status');
    t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(function () { requestAnimationFrame(function () { t.classList.add('rdp-toast--in'); }); });
    setTimeout(function () { t.classList.remove('rdp-toast--in'); setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 280); }, 3000);
  }
  (function () {
    var form = root.querySelector('[data-type="add-to-cart-form"]');
    if (!form) return;
    var addBtn = form.querySelector('.ptp__add-btn');
    if (!addBtn) return;
    function idle() { return 'Add to cart — <span data-ptp-cart-total>' + money(unitC * curQty()) + '</span>'; }
    function restore() { addBtn.innerHTML = idle(); }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (addBtn.disabled) return;
      var variantId = (form.querySelector('[name="id"]') || {}).value;
      var qty = curQty();
      if (!variantId) return;
      addBtn.disabled = true;
      addBtn.textContent = 'Adding…';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: qty })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.status) {
            addBtn.disabled = false;
            addBtn.textContent = data.description || 'Could not add to cart';
            showToast(data.description || 'Could not add to cart', 'error');
            setTimeout(restore, 3000);
          } else {
            addBtn.textContent = 'Added to cart';
            updateCartCount();
            showToast(qty + ' ' + (qty === 1 ? one : many) + ' added to your cart');
            setTimeout(function () { addBtn.disabled = false; restore(); }, 2200);
          }
        })
        .catch(function () {
          addBtn.disabled = false;
          addBtn.textContent = 'Something went wrong';
          showToast('Something went wrong. Please try again.', 'error');
          setTimeout(restore, 3000);
        });
    });
  })();

  /* ── Garage fit bar (wheel-fitment API; hidden unless it really matches) ── */
  (function () {
    var fit = root.querySelector('[data-ptp-fitment]');
    if (!fit) return;
    var productSize = (fit.getAttribute('data-ptp-product-tire-size') || '').trim();
    var productBolt = (fit.getAttribute('data-ptp-product-bolt') || '').trim();
    var productCb = parseFloat(fit.getAttribute('data-ptp-product-cb') || '');
    if (!productSize && !productBolt) return;
    var veh = null;
    try {
      var keys = Object.keys(localStorage).filter(function (k) { return k.indexOf('pt-garage-') === 0; });
      for (var i = 0; i < keys.length; i++) {
        var list = JSON.parse(localStorage.getItem(keys[i]));
        var def = (list || []).find(function (v) { return v.isDefault; });
        if (def) { veh = def; break; }
      }
    } catch (e) {}
    if (!veh || !veh.year || !veh.make || !veh.model) return;
    function normSize(s) { return (s || '').toUpperCase().replace(/\s+/g, '').replace(/^[A-Z]{1,2}(?=\d)/, ''); }
    function widthOf(n) { var mm = n.match(/^(\d{3})/); return mm ? mm[1] : null; }
    function boltKey(s) {
      var mm = String(s || '').toLowerCase().replace(/\s+/g, '').replace(/×/g, 'x').match(/^(\d+)[x\-](\d+(?:\.\d+)?)$/);
      return mm ? mm[1] + 'x' + (Math.round(parseFloat(mm[2]) * 10) / 10) : '';
    }
    var label = veh.year + ' ' + veh.make + ' ' + veh.model + (veh.trim ? ' ' + veh.trim : '');
    function show(prefix, cls, note) {
      fit.querySelector('[data-ptp-fitment-vehicle]').textContent = label;
      var pre = fit.querySelector('[data-ptp-fitment-prefix]');
      if (pre) pre.textContent = prefix;
      var nt = fit.querySelector('[data-ptp-fitment-note]');
      if (nt) nt.textContent = note || '';
      fit.classList.add(cls);
      fit.hidden = false;
    }
    function apply(data) {
      if (!data) return;
      if (productSize) {
        var sizes = data.tire_sizes;
        if (!Array.isArray(sizes) || !sizes.length) return;
        var pn = normSize(productSize), pw = widthOf(pn), exact = false, same = false;
        for (var i = 0; i < sizes.length; i++) {
          var n = normSize(sizes[i]);
          if (n === pn) { exact = true; break; }
          if (pw && widthOf(n) === pw) same = true;
        }
        if (exact) show('Fits your', 'ptp__fitment--fits');
        else if (same) show('Verify fit for your', 'ptp__fitment--may-fit');
        return;
      }
      var vb = boltKey(data.bolt_pattern);
      if (!vb) return;
      var match = productBolt.split(/[\/,]/).some(function (b) { return boltKey(b) === vb; });
      if (!match) return;
      var vcb = parseFloat(data.center_bore);
      if (isFinite(vcb) && isFinite(productCb)) {
        if (productCb < vcb - 0.05) return; /* the bore is too small for this hub */
        if (productCb > vcb + 0.05) { show('Bolt pattern fits your', 'ptp__fitment--fits', ' · we fit hub rings at install'); return; }
      }
      show('Bolt pattern fits your', 'ptp__fitment--fits');
    }
    var cacheKey = 'pt-wf-cache:' + veh.year + ':' + veh.make + ':' + veh.model;
    var cached = null;
    try { var raw = sessionStorage.getItem(cacheKey); cached = raw ? JSON.parse(raw) : null; } catch (e) {}
    if (cached && Array.isArray(cached.tire_sizes)) { apply(cached); return; }
    fetch('https://app.princetires.ca/api/wheel-fitment?year=' + encodeURIComponent(veh.year) + '&make=' + encodeURIComponent(veh.make) + '&model=' + encodeURIComponent(veh.model))
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || !Array.isArray(data.tire_sizes)) return;
        try { sessionStorage.setItem(cacheKey, JSON.stringify(data)); } catch (e) {}
        apply(data);
      })
      .catch(function () {});
  })();

  /* ── Gallery: thumbs (desktop), swipe + dots (phone) ─────────────── */
  (function () {
    var gal = root.querySelector('[data-rdp-gal]');
    if (!gal) return;
    var track = gal.querySelector('[data-rdp-track]');
    var slides = gal.querySelectorAll('[data-rdp-slide]');
    var thumbs = gal.querySelectorAll('[data-ptp-thumb-idx]');
    var dots = gal.querySelectorAll('[data-rdp-dot]');
    var count = gal.querySelector('[data-rdp-gal-count]');
    if (!track || slides.length < 2) return;
    var cur = 0;
    function mark(i) {
      cur = i;
      Array.prototype.forEach.call(slides, function (s, k) { s.classList.toggle('is-on', k === i); });
      Array.prototype.forEach.call(thumbs, function (t, k) { t.classList.toggle('ptp__gallery-thumb--active', k === i); t.setAttribute('aria-pressed', k === i ? 'true' : 'false'); });
      Array.prototype.forEach.call(dots, function (d, k) { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
      if (count) count.textContent = 'Image ' + (i + 1) + ' of ' + slides.length;
    }
    function go(i) {
      closeVideo();
      if (mqDesk.matches) { mark(i); return; }
      track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' });
      mark(i);
    }
    Array.prototype.forEach.call(thumbs, function (t) { t.addEventListener('click', function () { go(parseInt(t.dataset.ptpThumbIdx, 10) || 0); }); });
    Array.prototype.forEach.call(dots, function (d) { d.addEventListener('click', function () { go(parseInt(d.dataset.rdpDot, 10) || 0); }); });
    var tmr = null;
    track.addEventListener('scroll', function () {
      if (mqDesk.matches) return;
      clearTimeout(tmr);
      tmr = setTimeout(function () {
        var i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        if (i !== cur && i >= 0 && i < slides.length) mark(i);
      }, 80);
    }, { passive: true });
    function onMode() { if (!mqDesk.matches) track.scrollLeft = track.clientWidth * cur; }
    if (mqDesk.addEventListener) mqDesk.addEventListener('change', onMode);
    var video = gal.querySelector('[data-ptp-video]');
    function closeVideo() {
      if (!video || video.hidden) return;
      video.hidden = true;
      var w = video.querySelector('[data-ptp-video-wrap]');
      if (w) w.innerHTML = '';
      gal.querySelector('.rdp-gal__main').style.display = '';
    }
    gal.__rdpClose = closeVideo;
  })();

  /* Video (custom.video_url): YouTube / Vimeo / direct */
  (function () {
    var gal = root.querySelector('[data-rdp-gal]');
    var vthumbs = root.querySelectorAll('[data-ptp-video-thumb]');
    var overlay = root.querySelector('[data-ptp-video]');
    if (!gal || !vthumbs.length || !overlay) return;
    var wrap = overlay.querySelector('[data-ptp-video-wrap]');
    var closeBtn = overlay.querySelector('[data-ptp-video-close]');
    var main = gal.querySelector('.rdp-gal__main');
    function embed(url) {
      var yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
      if (yt) return 'https://www.youtube-nocookie.com/embed/' + yt[1] + '?autoplay=1&rel=0';
      var vm = url.match(/vimeo\.com\/(\d+)/);
      if (vm) return 'https://player.vimeo.com/video/' + vm[1] + '?autoplay=1';
      return url;
    }
    Array.prototype.forEach.call(vthumbs, function (b) {
      b.addEventListener('click', function () {
        var ifr = document.createElement('iframe');
        ifr.src = embed(b.getAttribute('data-video-url') || '');
        ifr.setAttribute('allow', 'autoplay; fullscreen');
        ifr.setAttribute('allowfullscreen', '');
        ifr.title = 'Product video';
        wrap.innerHTML = '';
        wrap.appendChild(ifr);
        if (main) main.style.display = 'none';
        overlay.hidden = false;
        if (closeBtn) closeBtn.focus();
      });
    });
    function closeV() {
      if (overlay.hidden) return;
      overlay.hidden = true;
      wrap.innerHTML = '';
      if (main) main.style.display = '';
    }
    if (closeBtn) closeBtn.addEventListener('click', closeV);
    Array.prototype.forEach.call(root.querySelectorAll('[data-ptp-thumb-idx],[data-rdp-dot]'), function (t) { t.addEventListener('click', closeV); });
  })();

  /* ── Phones: the visualizer stays folded until "See these on your car"
     is tapped (WheelProductMobile shows only the link). Without JS both show. */
  (function () {
    var link = root.querySelector('[data-rdp-vizlink]');
    var viz = root.querySelector('#rdp-viz');
    if (!link || !viz) return;
    link.addEventListener('click', function (e) {
      e.preventDefault();
      viz.classList.add('is-open');
      link.setAttribute('aria-expanded', 'true');
      viz.scrollIntoView({ behavior: 'smooth', block: 'start' });
      var f = viz.querySelector('input, select, button');
      if (f) { try { f.focus({ preventScroll: true }); } catch (err) { f.focus(); } }
    });
  })();

  /* ── Details: cards + tabs on desktop, dropdowns on phones ───────── */
  (function () {
    var items = root.querySelectorAll('[data-rdp-d]');
    var tabs = root.querySelectorAll('[data-rdp-tab]');
    Array.prototype.forEach.call(items, function (it) {
      var btn = it.querySelector('.rdp-d__btn');
      if (!btn) return;
      btn.addEventListener('click', function () {
        if (mqDesk.matches) return;
        var open = !it.classList.contains('is-open');
        it.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
    function syncMode() {
      Array.prototype.forEach.call(items, function (it) {
        var btn = it.querySelector('.rdp-d__btn');
        if (!btn) return;
        var inCards = !!it.closest('[data-rdp-group="cards"]');
        if (mqDesk.matches && inCards) btn.setAttribute('aria-expanded', 'true');
        else btn.setAttribute('aria-expanded', it.classList.contains('is-open') ? 'true' : 'false');
      });
    }
    function pick(tab, focus) {
      var key = tab.getAttribute('data-rdp-tab');
      Array.prototype.forEach.call(tabs, function (t) {
        var on = t === tab;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
      });
      Array.prototype.forEach.call(root.querySelectorAll('[data-rdp-group="tabs"] [data-rdp-d]'), function (it) {
        it.classList.toggle('is-tab', it.getAttribute('data-rdp-d') === key);
      });
      if (focus) tab.focus();
    }
    Array.prototype.forEach.call(tabs, function (t, i) {
      t.addEventListener('click', function () { pick(t); });
      t.addEventListener('keydown', function (e) {
        var n = tabs.length, j = -1;
        if (e.key === 'ArrowRight') j = (i + 1) % n;
        else if (e.key === 'ArrowLeft') j = (i - 1 + n) % n;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = n - 1;
        if (j > -1) { e.preventDefault(); pick(tabs[j], true); }
      });
    });
    // A merchant can switch the Description tab off: then nothing is
    // rendered selected, so select the first enabled tab.
    if (tabs.length && !root.querySelector('[data-rdp-tab].is-on')) pick(tabs[0]);
    syncMode();
    if (mqDesk.addEventListener) mqDesk.addEventListener('change', syncMode);
  })();

  /* Weather note: summer tires below 7°C, winter tires above 15°C */
  (function () {
    var warn = root.querySelector('[data-ptp-weather-warn]');
    if (!warn) return;
    var season = warn.dataset.tireSeason;
    if (season !== 'summer' && season !== 'winter') return;
    var msgEl = warn.querySelector('[data-ptp-weather-msg]');
    fetch('https://api.open-meteo.com/v1/forecast?latitude=51.0447&longitude=-114.0719&current=temperature_2m&timezone=America/Edmonton')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.current) return;
        var temp = Math.round(data.current.temperature_2m);
        var msg = '';
        if (season === 'summer' && temp < 7) msg = "It's " + temp + "°C in Calgary right now. Summer tires are not recommended below 7°C. <a href='/collections/winter-tires'>Shop winter tires</a>";
        else if (season === 'winter' && temp > 15) msg = "It's " + temp + "°C in Calgary. Winter tires wear faster in warm weather. <a href='/collections/all-season-tires'>Shop all-season tires</a>";
        if (msg) { msgEl.innerHTML = msg; warn.hidden = false; }
      })
      .catch(function () {});
  })();

  /* Copy link (live behaviour: the link icon turns into a green tick for 2 s) */
  (function () {
    var b = root.querySelector('[data-ptp-copy-url]');
    if (!b) return;
    var orig = b.innerHTML;
    b.addEventListener('click', function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(window.location.href).then(function () {
        b.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';
        b.setAttribute('aria-label', 'Link copied');
        setTimeout(function () { b.innerHTML = orig; b.setAttribute('aria-label', 'Copy link'); }, 2000);
      });
    });
  })();

  /* Performance ratings: bars grow and numbers count up the first time they are on
     screen (live behaviour). Inside the Specifications dropdown on phones, so it waits
     until that is open and scrolled to. */
  (function () {
    var perf = root.querySelector('[data-ptp-perf]');
    if (!perf) return;
    var done = false;
    function run() {
      if (done) return;
      done = true;
      Array.prototype.forEach.call(perf.querySelectorAll('[data-ptp-bar]'), function (bar, i) {
        setTimeout(function () { bar.style.width = Math.max(0, Math.min(100, parseFloat(bar.getAttribute('data-ptp-bar')) || 0)) + '%'; }, i * 250);
      });
      Array.prototype.forEach.call(perf.querySelectorAll('[data-ptp-count]'), function (el, i) {
        var target = parseInt(el.getAttribute('data-ptp-count'), 10) || 0;
        setTimeout(function () {
          var start = null;
          function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / 2000, 1);
            el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }, i * 250);
      });
    }
    if (!('IntersectionObserver' in window) || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
      perf.classList.add('rdp-perf--still');
      Array.prototype.forEach.call(perf.querySelectorAll('[data-ptp-bar]'), function (bar) { bar.style.width = Math.max(0, Math.min(100, parseFloat(bar.getAttribute('data-ptp-bar')) || 0)) + '%'; });
      Array.prototype.forEach.call(perf.querySelectorAll('[data-ptp-count]'), function (el) { el.textContent = parseInt(el.getAttribute('data-ptp-count'), 10) || 0; });
      return;
    }
    var io = new IntersectionObserver(function (es) {
      if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); run(); }
    }, { threshold: 0.3 });
    io.observe(perf);
  })();

  /* Sticky "Get notified" (sold out) jumps to the form */
  (function () {
    var j = root.querySelector('[data-rdp-bis-jump]');
    if (!j) return;
    j.addEventListener('click', function (e) {
      var em = root.querySelector('[data-ptp-bis-email]');
      if (!em) return;
      e.preventDefault();
      em.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function () { em.focus({ preventScroll: true }); }, 350);
    });
  })();

  /* Back-in-stock: POST to the app; success shows only when it says ok. */
  (function () {
    var bisSubmit = sec.querySelector('[data-ptp-bis-submit]');
    if (!bisSubmit) return;
    var bisEmail = sec.querySelector('[data-ptp-bis-email]');
    var bisSuccess = sec.querySelector('[data-ptp-bis-success]');
    var bisForm = sec.querySelector('.ptp__bis-form');
    var bisError = sec.querySelector('[data-ptp-bis-error]');
    var bisWebsite = sec.querySelector('[data-ptp-bis-website]');
    var bisLabel = bisSubmit.textContent;
    var BIS_FAIL = 'Sorry, that didn’t go through. Please call (403) 452-4283.';
    function bisShowError(msg) {
      if (bisError) { bisError.textContent = msg || BIS_FAIL; bisError.hidden = false; }
      bisSubmit.textContent = bisLabel;
      bisSubmit.disabled = false;
    }
    bisEmail.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); bisSubmit.click(); }
    });
    bisSubmit.addEventListener('click', function () {
      if (bisSubmit.disabled) return;
      var email = bisEmail.value.trim();
      if (!email || email.indexOf('@') === -1) { bisEmail.setAttribute('aria-invalid', 'true'); bisEmail.focus(); return; }
      bisEmail.removeAttribute('aria-invalid');
      if (bisError) bisError.hidden = true;
      bisSubmit.textContent = '...';
      bisSubmit.disabled = true;
      var payload = {
        email: email,
        handle: {{ product.handle | json }},
        title: {{ product.title | json }},
        sku: {{ product.selected_or_first_available_variant.sku | default: '' | json }},
        url: window.location.origin + {{ product.url | json }},
        website: bisWebsite ? bisWebsite.value : ''
      };
      fetch('https://app.princetires.ca/api/stock-notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function (res) {
        return res.json().catch(function () { return null; }).then(function (data) {
          if (res.status === 200 && data && data.ok === true) {
            bisForm.style.display = 'none';
            bisSuccess.hidden = false;
            return;
          }
          bisShowError((res.status === 422 || res.status === 429) && data && typeof data.error === 'string' && data.error ? data.error : '');
        });
      }).catch(function () { bisShowError(''); });
    });
  })();

  document.addEventListener('DOMContentLoaded', function () {
    if (typeof enableZoomOnHover === 'function') enableZoomOnHover(2);
  });
})();
</script>

