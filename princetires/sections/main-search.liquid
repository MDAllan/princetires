{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  /* ── DESIGN TOKENS ──────────────────────────────
     Source: UI/UX Pro Max — Automotive/Ecommerce
     Background: #F8FAFC  Card: #FFFFFF
     Text: #0F172A        Muted: #64748B
     Border: #E2E8F0      Accent: #DC2626
  ─────────────────────────────────────────────── */

  .template-search {
    background: #F8FAFC;
    min-height: 60vh;
  }

  /* ── SEARCH BAR (compact, results state) ────── */
  .pt-searchbar {
    background: #ffffff;
    border-bottom: 1px solid #E2E8F0;
    padding: 1rem 0;
  }
  /* Force results visible — override Dawn scroll animations */
  .pt-result-list .pt-result,
  .pt-result-list .pt-result * {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
  .pt-searchbar__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .pt-searchbar__label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #DC2626;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pt-searchbar__form {
    flex: 1;
    max-width: 560px;
  }
  .pt-searchbar .search { margin: 0; }
  /* layout/theme.liquid does not load Dawn's base.css, so its .field
     positioning never arrives: this block is self-contained on purpose. */
  .pt-searchbar .field {
    position: relative;
    display: flex;
    width: 100%;
  }
  .pt-searchbar .field__input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    height: 42px !important;
    margin: 0;
    padding: 0 9.2rem 0 1.4rem !important;
    border: 1px solid #E2E8F0;
    -webkit-appearance: none;
    appearance: none;
    background: #F8FAFC !important;
    border-color: #E2E8F0 !important;
    color: #0F172A !important;
    font-size: 16px !important; /* under 16px makes iOS Safari zoom on focus */
    border-radius: 4px !important;
  }
  .pt-searchbar .field__input::-webkit-search-cancel-button { display: none; }
  .pt-searchbar .field__input:focus {
    border-color: #94A3B8 !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(220,38,38,0.08) !important;
  }
  .pt-searchbar .field__label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .pt-searchbar .field__button {
    position: absolute;
    top: 0;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }
  .pt-searchbar .field__button .svg-wrapper,
  .pt-searchbar .field__button svg { width: 18px; height: 18px; }
  .pt-searchbar .search__button {
    right: 0;
    width: 46px;
    background: #DC2626 !important;
    border-radius: 0 4px 4px 0 !important;
    transition: background 0.15s;
  }
  .pt-searchbar .search__button:hover { background: #B91C1C !important; }
  .pt-searchbar .search__button svg,
  .pt-searchbar .search__button .icon { fill: #fff !important; color: #fff !important; }
  .pt-searchbar .reset__button {
    right: 46px;
    width: 42px;
    background: transparent !important;
    color: #94A3B8 !important;
  }
  .pt-searchbar .reset__button.hidden { display: none; }
  .pt-searchbar .predictive-search {
    top: calc(100% + 4px);
    left: 0;
    width: 100%;
    max-height: 70vh;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
    z-index: 20;
  }
  .pt-searchbar__count {
    font-size: 1.4rem;
    color: #64748B;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pt-searchbar__count em {
    color: #DC2626;
    font-style: normal;
    font-weight: 700;
  }
  .pt-searchbar__count strong {
    color: #0F172A;
    font-weight: 700;
  }

  /* ── WHEELS BANNER (wheel-word searches) ───── */
  .pt-wheels-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; margin: 1.2rem 1rem 0; padding: 1.4rem 1.6rem; border: 2px solid #DC2626; border-radius: 8px; background: #FEF2F2; color: #0F172A; font-size: 1.5rem; line-height: 1.4; }
  .pt-wheels-cta__btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.8rem; background: #DC2626; color: #fff; font-size: 1.5rem; font-weight: 700; border-radius: 6px; text-decoration: none; }
  .pt-wheels-cta__btn:hover { background: #B91C1C; color: #fff; }
  /* Same width as the sidebar + results row below it (page width minus its 2rem padding). */
  @media (min-width: 990px) { .pt-wheels-cta { box-sizing: border-box; width: calc(100% - 4rem); max-width: calc(var(--page-width, 1200px) - 4rem); margin: 1.2rem auto 0; } }
  .pt-mode-note { margin: 0; padding: 1rem 1.6rem; background: #FFFBEB; border-bottom: 1px solid #FDE68A; color: #92400E; font-size: 1.4rem; line-height: 1.4; }
  .pt-searchbar__count[hidden] { display: none; }
  /* base.css isn't loaded on this template: Dawn's screen-reader-only text
     (e.g. "10 results: 10 products" in the dropdown) needs this to stay hidden. */
  .pt-searchbar .visually-hidden,
  .template-search .visually-hidden { position: absolute !important; overflow: hidden; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; clip: rect(0 0 0 0); word-wrap: normal !important; }
  /* Dawn fixes the vertical filter form at 26rem; the sidebar is 240px. */
  .pt-sidebar facet-filters-form,
  .pt-sidebar .facets__form-vertical { width: 100% !important; max-width: 100%; box-sizing: border-box; }

  /* ── PAGE LAYOUT (sidebar + results) ───────── */
  .pt-layout {
    display: flex;
    align-items: flex-start;
    gap: 0;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  /* ── LEFT SIDEBAR (Dawn vertical facets) ────── */
  .pt-sidebar {
    width: 240px;
    flex-shrink: 0;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-top: none;
    padding: 0;
    position: sticky;
    top: 72px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }
  /* Override Dawn's vertical facets styles */
  .pt-sidebar .facets-vertical .facets__heading {
    font-size: 0.6875rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #94A3B8 !important;
    padding: 1.25rem 1.25rem 0.5rem !important;
    display: block !important;
    border-bottom: none !important;
  }
  .pt-sidebar details {
    border-bottom: 1px solid #F1F5F9;
  }
  .pt-sidebar .facets__summary {
    padding: 0.875rem 1.25rem !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    color: #374151 !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    list-style: none !important;
    transition: color 0.15s !important;
  }
  .pt-sidebar .facets__summary:hover { color: #DC2626 !important; }
  .pt-sidebar details[open] > .facets__summary {
    color: #0F172A !important;
    background: #F8FAFC !important;
  }
  .pt-sidebar .facets__summary .icon-caret,
  .pt-sidebar .facets__summary svg.icon {
    width: 0.875rem !important;
    height: 0.875rem !important;
    color: #94A3B8 !important;
    fill: #94A3B8 !important;
    transition: transform 0.2s !important;
    flex-shrink: 0 !important;
  }
  .pt-sidebar details[open] > .facets__summary .icon-caret {
    transform: rotate(180deg) !important;
  }
  /* Active filter red dot */
  .pt-sidebar .facets__summary .facets__selected:not(.hidden)::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #DC2626;
    border-radius: 50%;
    margin-right: 6px;
    flex-shrink: 0;
  }
  /* Filter options inside open dropdown */
  .pt-sidebar .facets__display-vertical {
    padding: 0 1.25rem 1rem !important;
  }
  .pt-sidebar .facet-checkbox__text,
  .pt-sidebar .facets__label {
    font-size: 0.875rem !important;
    color: #374151 !important;
    cursor: pointer;
  }
  .pt-sidebar .facet-checkbox:checked ~ .facet-checkbox__text,
  .pt-sidebar input[type="checkbox"]:checked + label {
    color: #DC2626 !important;
    font-weight: 600 !important;
  }
  /* Active filter chips in sidebar */
  .pt-sidebar .active-facets { padding: 0.75rem 1.25rem; }
  .pt-sidebar .active-facets__button-inner {
    font-size: 0.75rem !important;
    background: #0F172A !important;
    color: #ffffff !important;
    border-color: #0F172A !important;
    border-radius: 4px !important;
  }
  .pt-sidebar .active-facets__button:hover .active-facets__button-inner {
    background: #DC2626 !important;
    border-color: #DC2626 !important;
  }
  /* Sort + count in sidebar */
  .pt-sidebar .facets-vertical-sort {
    padding: 1rem 1.25rem 0;
    border-bottom: 1px solid #F1F5F9;
  }
  .pt-sidebar .product-count-vertical {
    padding: 0.625rem 1.25rem 1rem;
  }
  .pt-sidebar .product-count__text {
    font-size: 0.8125rem !important;
    color: #64748B !important;
    font-weight: 500 !important;
  }
  .pt-sidebar .facet-filters__sort .select__select {
    font-size: 0.8125rem !important;
    border-color: #E2E8F0 !important;
    border-radius: 4px !important;
    color: #374151 !important;
    background: #F8FAFC !important;
    cursor: pointer !important;
  }

  /* Desktop sidebar sizes for the 62.5% root (1rem = 10px) */
  .pt-sidebar .hidden { display: none !important; }
  .pt-sidebar .facets-vertical .facets__heading,
  .pt-sidebar .facets__heading--vertical { font-size: 1.2rem !important; font-weight: 800 !important; letter-spacing: 0.14em; text-transform: uppercase; color: #94A3B8 !important; padding: 1.4rem 0 0.6rem !important; margin: 0; }
  .pt-sidebar .active-facets-vertical-filter { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .pt-sidebar .active-facets-vertical-filter .active-facets__button-remove { font-size: 1.3rem; color: #DC2626; padding-right: 1.6rem; }
  .pt-sidebar .active-facets-desktop:not(:has(.active-facets__button--light)) .active-facets__button-wrapper { display: none; }
  .pt-sidebar .active-facets-desktop { display: flex; flex-wrap: wrap; gap: 0.6rem; padding: 0 1.6rem 1rem; }
  .pt-sidebar .active-facets-desktop .active-facets-vertical-filter { flex: 1 1 100%; }
  .pt-sidebar .active-facets__button-inner { font-size: 1.2rem !important; padding: 0.5rem 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem; }
  .pt-sidebar .active-facets__button-inner .svg-wrapper,
  .pt-sidebar .active-facets__button-inner svg { width: 1.1rem; height: 1.1rem; }
  .pt-sidebar .facets__summary { padding: 1.2rem 1.6rem !important; font-size: 1.4rem !important; }
  .pt-sidebar .facets__summary > div { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; width: 100%; }
  .pt-sidebar .facets__summary .icon-caret,
  .pt-sidebar .facets__summary svg.icon { width: 1.2rem !important; height: 1.2rem !important; }
  .pt-sidebar .facets__display-vertical { padding: 0.4rem 1.6rem 1.4rem !important; }
  .pt-sidebar .facets__list--vertical { margin: 0; padding: 0; list-style: none; }
  .pt-sidebar .facets__item { margin: 0; }
  .pt-sidebar .facets__label.facet-checkbox { display: flex; align-items: center; gap: 0.8rem; padding: 0.5rem 0; position: relative; }
  .pt-sidebar .facet-checkbox input[type="checkbox"] { position: absolute; opacity: 0; width: 1.6rem; height: 1.6rem; margin: 0; }
  .pt-sidebar .facet-checkbox > svg { flex: 0 0 1.6rem; width: 1.6rem; height: 1.6rem; }
  .pt-sidebar .facet-checkbox > .svg-wrapper { position: absolute; left: 0.2rem; top: 50%; transform: translateY(-50%); width: 1.2rem; height: 1.2rem; visibility: hidden; }
  .pt-sidebar .facet-checkbox > .svg-wrapper svg { width: 1.2rem; height: 1.2rem; }
  .pt-sidebar .facet-checkbox input:checked ~ .svg-wrapper { visibility: visible; }
  .pt-sidebar .facet-checkbox.disabled { opacity: 0.45; cursor: default; }
  .pt-sidebar .facet-checkbox__text,
  .pt-sidebar .facets__label { font-size: 1.4rem !important; }
  .pt-sidebar .button-show-more { font-size: 1.3rem; margin-top: 0.6rem; background: none; border: 0; padding: 0; color: #DC2626; cursor: pointer; }
  .pt-sidebar .facets__header-vertical .facets__selected { font-size: 1.3rem; color: #64748B; }
  .pt-sidebar .facets__price { display: flex; align-items: flex-end; gap: 0.8rem; margin-top: 0.8rem; }
  .pt-sidebar .facets__price .field-currency { font-size: 1.4rem; padding-bottom: 2.6rem; }
  .pt-sidebar .facets__price .field { display: flex; flex-direction: column-reverse; flex: 1 1 0; min-width: 0; }
  .pt-sidebar .facets__price .field__input { width: 100%; min-width: 0; height: 3.6rem; padding: 0 0.8rem; font-size: 1.4rem; border: 1px solid #E2E8F0; border-radius: 4px; background: #F8FAFC; }
  .pt-sidebar .facets__price .field__label { font-size: 1.2rem; color: #64748B; margin-bottom: 0.4rem; }
  .pt-sidebar .pt-tire-dims__panel { padding: 0.4rem 1.6rem 1.4rem; }
  .pt-sidebar .facets__summary-label { display: inline-flex; align-items: center; gap: 0.4rem; }

  /* ── TIRES / WHEELS TOGGLE ──────────────────── */
  .pt-mode { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; padding: 1.2rem 1.6rem; background: #fff; border-bottom: 1px solid #F1F5F9; }
  .pt-mode__label { font-size: 1.3rem; color: #64748B; margin-right: 0.4rem; }
  .pt-mode__btn { display: inline-flex; align-items: center; min-height: 40px; padding: 0 1.8rem; border: 1px solid #E2E8F0; border-radius: 999px; background: #fff; color: #0F172A; font-size: 1.5rem; font-weight: 700; text-decoration: none; }
  .pt-mode__btn:hover { border-color: #DC2626; color: #DC2626; }
  .pt-mode__btn.is-on { background: #DC2626; border-color: #DC2626; color: #fff; }
  .pt-mode__all { font-size: 1.3rem; color: #64748B; text-decoration: underline; margin-left: auto; }
  .pt-results-area #product-grid { position: relative; }

  /* ── RESULTS AREA ───────────────────────────── */
  .pt-results-area {
    flex: 1;
    min-width: 0;
    border-left: 1px solid #E2E8F0;
  }
  .pt-result-list {
    background: #ffffff;
  }

  /* ── PRODUCT ROW (Google-style) ─────────────── */
  .pt-result {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid #F1F5F9;
    background: #ffffff;
    transition: background 0.15s;
    text-decoration: none;
    position: relative;
  }
  .pt-result:last-child { border-bottom: none; }
  .pt-result:hover { background: #FAFBFC; }

  /* Thumbnail */
  .pt-result__thumb {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border: 1px solid #F1F5F9;
    border-radius: 6px;
    overflow: hidden;
    background: #F8FAFC;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pt-result__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pt-result__thumb-placeholder {
    color: #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  /* Body */
  .pt-result__body {
    flex: 1;
    min-width: 0;
  }
  .pt-result__vendor {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748B;
    margin-bottom: 0.25rem;
  }
  .pt-result__title {
    font-size: 1rem;
    font-weight: 700;
    color: #0F172A;
    text-decoration: none;
    line-height: 1.35;
    display: block;
    margin-bottom: 0.375rem;
    transition: color 0.15s;
  }
  .pt-result__title:hover { color: #DC2626; }
  .pt-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }
  .pt-result__tag {
    display: inline-block;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #475569;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }
  .pt-result__tag--season-winter { background: #EFF6FF; border-color: #BFDBFE; color: #1D4ED8; }
  .pt-result__tag--season-summer { background: #FFF7ED; border-color: #FED7AA; color: #C2410C; }
  .pt-result__tag--season-allseason { background: #F0FDF4; border-color: #BBF7D0; color: #15803D; }

  /* Right column: price + CTA */
  .pt-result__right {
    flex-shrink: 0;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.625rem;
    min-width: 120px;
  }
  .pt-result__price-was {
    font-size: 0.8125rem;
    color: #94A3B8;
    text-decoration: line-through;
    display: block;
    line-height: 1;
  }
  .pt-result__price-now {
    font-size: 1.125rem;
    font-weight: 800;
    color: #0F172A;
    display: block;
    line-height: 1;
  }
  .pt-result__price-sale { color: #DC2626; }
  .pt-result__availability {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #16A34A;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pt-result__availability--out { color: #94A3B8; }
  .pt-result__availability--order { color: #15803d; }
  .pt-result__availability--low { color: #b45309; }
  .pt-result__btn {
    display: inline-block;
    background: #0F172A;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5625rem 1rem;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .pt-result__btn:hover {
    background: #DC2626;
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* ── EMPTY STATES ───────────────────────────── */
  .pt-empty {
    background: #ffffff;
    text-align: center;
    padding: 5rem 2rem;
  }
  .pt-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: #FEF2F2;
    border-radius: 50%;
    color: #DC2626;
    margin-bottom: 1.25rem;
  }
  .pt-empty__heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.5rem;
  }
  .pt-empty__sub {
    color: #64748B;
    font-size: 0.9375rem;
    margin: 0 0 2rem;
    line-height: 1.65;
  }
  .pt-empty__cta {
    display: inline-block;
    background: #DC2626;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.75rem 1.75rem;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .pt-empty__cta:hover { background: #B91C1C; color: #ffffff; }
  .pt-empty__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .pt-empty__hints { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #E2E8F0; }
  .pt-empty__hints-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #94A3B8;
    margin: 0 0 0.75rem;
  }
  .pt-empty__hint-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .pt-empty__hint-link {
    display: inline-block;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #475569;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s;
    cursor: pointer;
  }
  .pt-empty__hint-link:hover { background: #FEF2F2; border-color: #FECACA; color: #DC2626; }

  /* ── PAGINATION ─────────────────────────────── */
  .pt-pagination { padding: 2rem 1.5rem; background: #ffffff; border-top: 1px solid #F1F5F9; }

  /* ── MOBILE ─────────────────────────────────── */
  @media screen and (max-width: 989px) {
    .pt-layout { padding: 0 1rem 3rem; gap: 0; }
