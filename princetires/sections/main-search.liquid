{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  # search.terms arrives HTML-escaped (&amp; &quot; &#39; ...). Decode it before
  # url_encode, or a query like  rtx & 17"  turns into  rtx &amp; 17&quot;  on the next page.
  assign pt_q_raw = search.terms | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&#x27;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
  assign pt_q_enc = pt_q_raw | url_encode
  assign search_url = '?q=' | append: pt_q_enc | append: '&type=product&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  /* Phones: no empty band between the search box and the Filter row. */
  @media screen and (max-width: 749px) {
    .template-search.section-{{ section.id }}-padding { padding-top: 0.4rem; }
  }
{%- endstyle -%}

<div class="pt-searchbar" role="search">
    <div class="pt-searchbar__inner">
      <span class="pt-searchbar__label">Prince Tires</span>
      <div class="pt-searchbar__form">
        {%- if settings.predictive_search_enabled -%}<predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">{%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" class="search">
            <div class="field">
              <input class="search__input field__input" id="Search-In-Template" type="search" name="q"
                value="{{ search.terms | escape }}" placeholder="Refine your search…"
                {%- if settings.predictive_search_enabled -%}role="combobox" aria-expanded="false" aria-owns="predictive-search-results" aria-controls="predictive-search-results" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false"{%- endif -%}>
              <label class="field__label" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
              <input name="options[prefix]" type="hidden" value="last">
              <input name="type" type="hidden" value="product">
              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>{%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}</div>
                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}
              <button type="reset" class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}" aria-label="{{ 'general.search.reset' | t }}"><span class="svg-wrapper">{{- 'icon-reset.svg' | inline_asset_content -}}</span></button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}"><span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span></button>
            </div>
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}</predictive-search>{%- endif -%}
      </div>
      {%- if search.performed and search.results_count > 0 -%}
        <span class="pt-searchbar__count" role="status" aria-live="polite">
          <em>{{ search.results_count }}</em> <span class="pt-searchbar__unit">result{% if search.results_count != 1 %}s{% endif %}</span> for <strong>&ldquo;{{ search.terms | escape }}&rdquo;</strong>
        </span>
      {%- endif -%}
    </div>
  </div>

{%- comment -%}
  Wheel-word searches. Every wheel matches "wheels" equally and Shopify stops at
  1,000 results, so a search is the wrong place to browse wheels.
  - A bare wheel word, optionally with season words ("wheels", "mags",
    "winter wheels") → straight to /collections/wheels.
  - Wheel word plus other words ("rtx wheels") → stay here, show the banner.
  - Accessories/services ("wheel locks", "wheel balancing") → neither.
  Same pattern as pt-header-search-enhance and pt-collection-grid.
{%- endcomment -%}
{%- liquid
  assign pt_q = search.terms | downcase | strip
  assign pt_q_words = pt_q | replace: '-', ' ' | replace: ',', ' ' | replace: '+', ' ' | split: ' '
  assign pt_wheel_q = false
  assign pt_other_word = false
  for w in pt_q_words
    case w
      when 'wheel', 'wheels', 'rim', 'rims', 'mag', 'mags'
        assign pt_wheel_q = true
      when 'winter', 'snow', 'all', 'season', 'weather', ''
        continue
      else
        assign pt_other_word = true
    endcase
  endfor
  if pt_q contains 'balanc' or pt_q contains 'align' or pt_q contains 'lock' or pt_q contains 'nut' or pt_q contains 'lug' or pt_q contains 'spacer' or pt_q contains 'cap' or pt_q contains 'sensor' or pt_q contains 'tpms'
    assign pt_wheel_q = false
  endif
  assign pt_wheel_direct = false
  if pt_wheel_q and pt_other_word == false
    assign pt_wheel_direct = true
  endif
  assign pt_wheels = collections['wheels']
-%}
{%- if search.performed and pt_wheel_q and pt_wheels.all_products_count > 0 -%}
  {%- if pt_wheel_direct -%}
    <script>location.replace({{ pt_wheels.url | json }});</script>
    <div class="pt-wheels-cta" role="note">
      <span>Taking you to all wheels&hellip;</span>
      <a class="pt-wheels-cta__btn" href="{{ pt_wheels.url }}">Shop all wheels &rarr;</a>
    </div>
  {%- else -%}
    <div class="pt-wheels-cta" role="note">
      <span>Looking for wheels? Browse all our wheels with bolt pattern, size and offset filters.</span>
      <a class="pt-wheels-cta__btn" href="{{ pt_wheels.url }}">Shop all wheels &rarr;</a>
    </div>
  {%- endif -%}
{%- endif -%}

{% paginate search.results by 24 %}
{%- comment -%}
  Tires / Wheels mode (search page only). Decides which filters show, in what order.
  1) An active Product type filter (set by the toggle below) wins.
  2) Otherwise use the Product type filter counts, which cover ALL results (not
     just this page), so the mode is the same on every page of one search.
     A wheel-word search ("rtx wheels") is wheels whenever any wheel matches.
  3) No Product type filter at all → count the products on this page.
  4) Neither (accessories, services) → blank = Dawn's unchanged filter list.
  The toggle pill is highlighted only when a Product type filter is really applied.
  Tire/wheel type tests match the result rows below.
{%- endcomment -%}
{%- liquid
  assign pt_mode = ''
  assign pt_active_mode = ''
  assign pt_wheel_n = 0
  assign pt_tire_n = 0
  assign pt_wheels_qs = ''
  assign pt_tires_qs = ''
  assign pt_type_active = false
  assign pt_has_type_filter = false
  assign pt_has_wheel_vals = false
  assign pt_has_tire_vals = false
  assign pt_any_active = false
  for f in search.filters
    if f.active_values.size > 0
      assign pt_any_active = true
    elsif f.type == 'price_range'
      if f.min_value.value != blank or f.max_value.value != blank
        assign pt_any_active = true
      endif
    endif
    if f.param_name != 'filter.p.product_type'
      continue
    endif
    assign pt_has_type_filter = true
    for v in f.values
      assign pt_vt = v.value
      assign pt_v_wheel = false
      assign pt_v_tire = false
      if pt_vt contains 'Rims'
        unless pt_vt contains 'Assembly'
          assign pt_v_wheel = true
        endunless
      else
        case pt_vt
          when 'All-Terrain', 'Heavy-Duty', 'Highway-Terrain', 'Light Truck', 'Mud-Terrain', 'Passenger', 'Performance', 'Rugged-Terrain', 'Winter'
            assign pt_v_tire = true
        endcase
        if pt_vt contains 'Tire'
          assign pt_v_tire = true
        endif
      endif
      # each value encoded on its own, then appended (never encode the joined string)
      assign pt_v_enc = pt_vt | url_encode
      # Values stay listed (count 0) when other filters exclude them, so "has
      # values" means the unfiltered search had that kind of product.
      if pt_v_wheel
        assign pt_has_wheel_vals = true
        assign pt_wheel_n = pt_wheel_n | plus: v.count
        assign pt_wheels_qs = pt_wheels_qs | append: '&filter.p.product_type=' | append: pt_v_enc
      elsif pt_v_tire
        assign pt_has_tire_vals = true
        assign pt_tire_n = pt_tire_n | plus: v.count
        assign pt_tires_qs = pt_tires_qs | append: '&filter.p.product_type=' | append: pt_v_enc
      endif
      if v.active
        assign pt_type_active = true
        if pt_v_wheel
          if pt_active_mode == '' or pt_active_mode == 'wheels'
            assign pt_active_mode = 'wheels'
          else
            assign pt_active_mode = 'mixed'
          endif
        elsif pt_v_tire
          if pt_active_mode == '' or pt_active_mode == 'tires'
            assign pt_active_mode = 'tires'
          else
            assign pt_active_mode = 'mixed'
          endif
        endif
      endif
    endfor
  endfor
  if pt_active_mode == 'wheels' or pt_active_mode == 'tires'
    assign pt_mode = pt_active_mode
  elsif pt_has_type_filter
    if pt_wheel_q and pt_wheel_n > 0
      assign pt_mode = 'wheels'
    elsif pt_wheel_n > pt_tire_n
      assign pt_mode = 'wheels'
    elsif pt_tire_n > 0
      assign pt_mode = 'tires'
    endif
  else
    assign pt_pw = 0
    assign pt_pt = 0
    for item in search.results
      if item.object_type != 'product'
        continue
      endif
      assign pt_ty = item.type
      if pt_ty contains 'Assembly'
        continue
      endif
      if pt_ty contains 'Rims' or item.tags contains 'Wheels'
        assign pt_pw = pt_pw | plus: 1
      else
        case pt_ty
          when 'All-Terrain', 'Heavy-Duty', 'Highway-Terrain', 'Light Truck', 'Mud-Terrain', 'Passenger', 'Performance', 'Rugged-Terrain', 'Winter'
            assign pt_pt = pt_pt | plus: 1
          else
            if pt_ty contains 'Tire' or item.metafields.custom.tire_size != blank
              assign pt_pt = pt_pt | plus: 1
            endif
        endcase
      endif
    endfor
    if pt_pw > pt_pt
      assign pt_mode = 'wheels'
    elsif pt_pt > 0
      assign pt_mode = 'tires'
    endif
  endif
  # Filters apply but nothing matches: keep wheel searches in wheels mode.
  if pt_mode == blank and pt_wheel_q and pt_any_active
    assign pt_mode = 'wheels'
  endif
  assign pt_base = routes.search_url | append: '?q=' | append: pt_q_enc | append: '&type=product&options%5Bprefix%5D=last'
  # Filters that mean the same for tires and wheels survive a Tires/Wheels switch.
  assign pt_keep_qs = ''
  for f in search.filters
    if f.param_name == 'filter.p.m.custom.rim_diameter' or f.param_name == 'filter.v.availability'
      for v in f.active_values
        assign pt_kv = v.value | url_encode
        assign pt_keep_qs = pt_keep_qs | append: '&' | append: v.param_name | append: '=' | append: pt_kv
      endfor
    elsif f.type == 'price_range'
      if f.min_value.value != blank
        assign pt_kv = f.min_value.value | money_without_currency | replace: ',', ''
        assign pt_keep_qs = pt_keep_qs | append: '&' | append: f.min_value.param_name | append: '=' | append: pt_kv
      endif
      if f.max_value.value != blank
        assign pt_kv = f.max_value.value | money_without_currency | replace: ',', ''
        assign pt_keep_qs = pt_keep_qs | append: '&' | append: f.max_value.param_name | append: '=' | append: pt_kv
      endif
    endif
  endfor
  # The toggle shows whenever this search has both tires and wheels, even while
  # other filters narrow the list to one kind. On a tires-only search the normal
  # Product type filter (Passenger, Light Truck, ...) shows instead.
  assign pt_show_toggle = false
  if pt_has_wheel_vals and pt_has_tire_vals
    assign pt_show_toggle = true
  endif
  assign pt_show_type = false
  if pt_mode == 'tires' and pt_has_wheel_vals == false
    assign pt_show_type = true
  endif
-%}
<div class="template-search section-{{ section.id }}-padding">
  {%- if search.performed -%}

    <div class="pt-layout">

      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {%- if search.filters != empty -%}
          <aside class="pt-sidebar facets-wrapper" id="main-search-filters" data-id="{{ section.id }}" aria-label="Filters">
            {% render 'facets',
              results: search,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: 'vertical',
              paginate: paginate,
              pt_mode: pt_mode,
              pt_show_type: pt_show_type
            %}
          </aside>
        {%- endif -%}
      {%- endif -%}

      <div class="pt-results-area" id="ProductGridContainer">
        {%- comment -%} Re-rendered by Dawn's AJAX filters: carries the mode and the new result count for the script at the bottom. {%- endcomment -%}
        <div hidden data-pt-mode="{{ pt_mode }}" data-pt-type="{{ pt_show_type }}" data-pt-count="{{ search.results_count }}" class="pt-mode-flag"></div>
        {%- if pt_show_toggle -%}
          <nav class="pt-mode" aria-label="Show tires or wheels">
            <span class="pt-mode__label">Show:</span>
            <a href="{{ pt_base }}{{ pt_tires_qs }}{{ pt_keep_qs }}" class="pt-mode__btn{% if pt_active_mode == 'tires' %} is-on{% endif %}"{% if pt_active_mode == 'tires' %} aria-current="true"{% endif %}>Tires</a>
            <a href="{{ pt_base }}{{ pt_wheels_qs }}{{ pt_keep_qs }}" class="pt-mode__btn{% if pt_active_mode == 'wheels' %} is-on{% endif %}"{% if pt_active_mode == 'wheels' %} aria-current="true"{% endif %}>Wheels</a>
            {%- if pt_type_active -%}
              <a href="{{ pt_base }}{{ pt_keep_qs }}" class="pt-mode__all">Show all results</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
        {%- if pt_wheel_q and pt_mode == 'tires' and pt_wheel_n == 0 and pt_any_active and search.results_count > 0 -%}
          <p class="pt-mode-note" role="status">No wheels match these filters, so tires are shown instead.</p>
        {%- endif -%}

        {%- if search.results.size == 0 and search.filters != empty -%}
          <div id="product-grid" class="collection" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="pt-empty">
              <div class="pt-empty__icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              </div>
              <h2 class="pt-empty__heading">No products match these filters</h2>
              <p class="pt-empty__sub">{{ 'sections.collection_template.use_fewer_filters_html' | t: link: search_url, class: 'underlined-link link' }}</p>
            </div>
          </div>

        {%- elsif search.results.size == 0 -%}
          <div id="product-grid" class="collection" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="pt-empty">
              <div class="pt-empty__icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </div>
              <h2 class="pt-empty__heading">No products found for &ldquo;{{ search.terms | escape }}&rdquo;</h2>
              <p class="pt-empty__sub">Try a different brand, size, or season &mdash; or browse our full inventory.</p>
              <div class="pt-empty__ctas">
                <a href="{{ routes.collections_url }}/tires" class="pt-empty__cta">Browse all tires</a>
                <a href="{{ routes.collections_url }}/wheels" class="pt-empty__cta">Browse all wheels</a>
              </div>
              <div class="pt-empty__hints">
                <p class="pt-empty__hints-title">Browse by category</p>
                <div class="pt-empty__hint-links">
                  <a href="{{ routes.collections_url }}/winter-tires" class="pt-empty__hint-link">Winter Tires</a>
                  <a href="{{ routes.collections_url }}/all-season-tires" class="pt-empty__hint-link">All-Season</a>
                  <a href="{{ routes.collections_url }}/summer-tires" class="pt-empty__hint-link">Summer Tires</a>
                  <a href="{{ routes.collections_url }}/tires" class="pt-empty__hint-link">All Tires</a>
                </div>
              </div>
            </div>
          </div>

        {%- else -%}
          <div id="product-grid" class="collection" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="pt-result-list">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}

                  {%- assign lazy = false -%}
                  {%- if forloop.index > 4 -%}{%- assign lazy = true -%}{%- endif -%}

                  {%- comment -%}
                    Season detection — prefer the canonical custom.seasonality
                    metafield (set by import + admin). Tag loop is fallback;
                    imported products often carry stray "Summer" supplier-feed
                    tags that overwrote the correct All-Weather/All-Season in
                    the old in-loop reassignment.
                  {%- endcomment -%}
                  {%- comment -%}
                    Wheels: product type "Alloy/Steel/Trailer Rims" or the "Wheels"
                    tag (tag is on wheels only). NB: Liquid's field is product.type;
                    product.product_type is always nil. Wheels get no tire-season chip;
                    the "Winter Approved" tag shows a grey "Winter approved" chip.
                  {%- endcomment -%}
                  {%- liquid
                    assign pt_type = item.type
                    assign is_wheel = false
                    assign is_tire = false
                    # 2026-11-13: same wheel test as sections/pt-product.liquid (is_wheel)
                    # and snippets/pt-collection-card.liquid (card_is_wheel): no tire size
                    # AND (type has "Rims" OR tag Wheels OR a bolt pattern).
                    if item.metafields.custom.tire_size == blank
                      if pt_type contains 'Rims' or item.tags contains 'Wheels' or item.metafields.custom.bolt_pattern != blank
                        assign is_wheel = true
                      endif
                    endif
                    if pt_type contains 'Assembly'
                      assign is_wheel = false
                    elsif is_wheel == false
                      case pt_type
                        when 'All-Terrain', 'Heavy-Duty', 'Highway-Terrain', 'Light Truck', 'Mud-Terrain', 'Passenger', 'Performance', 'Rugged-Terrain', 'Winter'
                          assign is_tire = true
                      endcase
                      if pt_type contains 'Tire' or item.metafields.custom.tire_size != blank
                        assign is_tire = true
                      endif
                    endif
                  -%}
                  {%- assign season_tag = '' -%}
                  {%- assign season_class = '' -%}
                  {%- if is_wheel -%}
                    {%- comment -%} Wheels: never a tire season or 3PMSF chip; same tag match as the PDP's wheel_winter_ok. {%- endcomment -%}
                    {%- for tag in item.tags -%}
                      {%- assign tag_lower = tag | downcase -%}
                      {%- if tag_lower contains 'winter approved' or tag_lower contains 'winter-approved' -%}
                        {%- assign season_tag = 'Winter approved' -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                  {%- assign m_season = item.metafields.custom.seasonality | default: '' -%}
                  {%- if m_season != blank -%}
                    {%- assign season_tag = m_season -%}
                  {%- else -%}
                    {%- for tag in item.tags -%}
                      {%- assign tag_lower = tag | downcase -%}
                      {%- if tag_lower contains 'winter' -%}
                        {%- assign season_tag = 'Winter' -%}
                      {%- elsif tag_lower contains 'all-weather' or tag_lower contains 'all weather' -%}
                        {%- assign season_tag = 'All-Weather' -%}
                      {%- elsif tag_lower contains 'all-season' or tag_lower contains 'all season' or tag_lower contains 'allseason' -%}
                        {%- assign season_tag = 'All-Season' -%}
                      {%- elsif tag_lower contains '3pms' or tag_lower contains 'three peak' -%}
                        {%- assign season_tag = '3PMSF' -%}
                      {%- elsif tag_lower contains 'summer' -%}
                        {%- assign season_tag = 'Summer' -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- case season_tag -%}
                    {%- when 'Winter' -%}{%- assign season_class = 'pt-result__tag--season-winter' -%}
                    {%- when 'All-Weather' -%}{%- assign season_class = 'pt-result__tag--season-allseason' -%}
                    {%- when 'All-Season' -%}{%- assign season_class = 'pt-result__tag--season-allseason' -%}
                    {%- when 'Summer' -%}{%- assign season_class = 'pt-result__tag--season-summer' -%}
                    {%- when '3PMSF' -%}{%- assign season_class = 'pt-result__tag--season-winter' -%}
                  {%- endcase -%}
                  {%- endif -%}

                  <div class="pt-result">

                    <a href="{{ item.url }}" class="pt-result__thumb" tabindex="-1" aria-hidden="true">
                      {%- if item.featured_image -%}
                        {{ item.featured_image | image_url: width: 176, height: 176, crop: 'center' | image_tag:
                          class: 'pt-result__img',
                          loading: lazy,
                          width: 88,
                          height: 88,
                          alt: item.title | escape }}
                      {%- else -%}
                        <div class="pt-result__thumb-placeholder" aria-hidden="true">
                          <svg width="42" height="42" viewBox="0 0 64 64" fill="none">
                            <circle cx="32" cy="32" r="28" stroke="#CBD5E1" stroke-width="3"/>
                            <circle cx="32" cy="32" r="12" stroke="#CBD5E1" stroke-width="3"/>
                            <circle cx="32" cy="32" r="4" fill="#CBD5E1"/>
                            <line x1="32" y1="4" x2="32" y2="20" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="32" y1="44" x2="32" y2="60" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="4" y1="32" x2="20" y2="32" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="44" y1="32" x2="60" y2="32" stroke="#CBD5E1" stroke-width="2.5" stroke-linecap="round"/>
                          </svg>
                        </div>
                      {%- endif -%}
                    </a>

                    <div class="pt-result__body">
                      {%- if item.vendor != blank -%}
                        <div class="pt-result__vendor">{{ item.vendor }}</div>
                      {%- endif -%}
                      <a href="{{ item.url }}" class="pt-result__title">{{ item.title }}</a>
                      <div class="pt-result__tags">
                        {%- if season_tag != '' -%}
                          <span class="pt-result__tag {{ season_class }}">{{ season_tag }}</span>
                        {%- endif -%}
                        {%- unless item.available -%}
                          <span class="pt-result__tag" style="background:#F8FAFC;border-color:#E2E8F0;color:#94A3B8;">Out of stock</span>
                        {%- endunless -%}
                      </div>
                    </div>

                    <div class="pt-result__right">
                      <div>
                        {%- if item.compare_at_price > item.price -%}
                          <span class="pt-result__price-was">{{ item.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="pt-result__price-now{% if item.compare_at_price > item.price %} pt-result__price-sale{% endif %}">{{ item.price | money }}</span>
                      </div>
                      {%- if item.available -%}
                        {%- comment -%} Stock wording: snippets/pt-stock-state.liquid. 2026-11-13 owner rule: lead time only ("Ready today" / "Ready in 1–2 business days" / "Order in" / "Sold out"), no counts or "Low stock" colour. {%- endcomment -%}
                        {%- capture res_stock_raw -%}{% render 'pt-stock-state', product: item %}{%- endcapture -%}
                        {%- assign res_stock = res_stock_raw | strip | split: '|' -%}
                        {%- if is_wheel -%}
                          {%- comment -%}
                            Wheels: lead time only - no counts ("40+ available") or "Low stock"
                            (owner rule). "Ready today" only for Tier A, the same-day booking
                            floor in snippets/pt-supplier-tier.liquid; Tier B = next business day.
                          {%- endcomment -%}
                          {%- assign res_lead = 'products.stock.lead_out' | t -%}
                          {%- if res_stock[0] == 'own' -%}
                            {%- capture res_tier -%}{% render 'pt-supplier-tier', product: item %}{%- endcapture -%}
                            {%- assign res_tier = res_tier | strip -%}
                            {%- if res_tier == 'A' -%}
                              {%- assign res_lead = 'Ready today' -%}
                            {%- else -%}
                              {%- assign res_lead = 'Ready in 1–2 business days' -%}
                            {%- endif -%}
                          {%- elsif res_stock[0] == 'supplier' -%}
                            {%- assign res_lead = 'Ready in 1–2 business days' -%}
                          {%- endif -%}
                          <span class="pt-result__availability{% if res_stock[0] == 'supplier' %} pt-result__availability--order{% elsif res_stock[0] == 'out' %} pt-result__availability--out{% endif %}" data-pt-stock-kind="{{ res_stock[0] }}" data-pt-stock-state="lead">{{ res_lead }}</span>
                        {%- else -%}
                        <span class="pt-result__availability{% if res_stock[0] == 'supplier' %} pt-result__availability--order{% endif %}" data-pt-stock-kind="{{ res_stock[0] }}" data-pt-stock-state="{{ res_stock[1] }}">{{ res_stock[2] }}</span>
                        {%- endif -%}
                      {%- else -%}
                        <span class="pt-result__availability pt-result__availability--out">{{ 'products.stock.lead_out' | t }}</span>
                      {%- endif -%}
                      <a href="{{ item.url }}" class="pt-result__btn">{% if is_wheel %}View Wheel{% elsif is_tire %}View Tire{% else %}View Details{% endif %}</a>
                    </div>

                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="pt-pagination">{% render 'pagination', paginate: paginate %}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>

  {%- endif -%}
</div>
{% endpaginate %}
{%- if search.performed -%}
<script>
  /* Filters re-render via Dawn's facets.js (AJAX), which replaces
     #ProductGridContainer but not the search header or the filter list.
     - Keep the header count ("N results for ...") in step with the list.
     - If the new results flip the Tires/Wheels mode (or whether the Product
       type filter shows), the filter list itself must change, so reload the
       (already updated) URL instead of showing the old list.
     - After such a reload, Dawn's Back handler would re-render the reloaded
       URL; when Back lands on an entry Dawn has no state for, load it for real. */
  (function () {
    var grid = document.getElementById('ProductGridContainer');
    if (!grid || !window.MutationObserver) return;
    var flag = grid.querySelector('.pt-mode-flag');
    var key = function (f) { return f ? f.getAttribute('data-pt-mode') + '|' + f.getAttribute('data-pt-type') : ''; };
    var mode = key(flag);
    var initQs = location.search.slice(1);
    function syncCount(f) {
      var n = parseInt(f.getAttribute('data-pt-count'), 10);
      var el = document.querySelector('.pt-searchbar__count');
      if (!el || isNaN(n)) return;
      el.hidden = n === 0;
      var em = el.querySelector('em'), unit = el.querySelector('.pt-searchbar__unit');
      if (em) em.textContent = n;
      if (unit) unit.textContent = n === 1 ? 'result' : 'results';
    }
    new MutationObserver(function () {
      var f = grid.querySelector('.pt-mode-flag');
      if (!f) return;
      if (key(f) !== mode) { location.reload(); return; }
      syncCount(f);
    }).observe(grid, { childList: true });
    window.addEventListener('popstate', function (e) {
      if (!e.state && location.search.slice(1) !== initQs) location.reload();
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.main-search.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-search.settings.columns_mobile.options__2.label" }
      ]
    },
    { "type": "header", "content": "t:sections.main-search.settings.header__1.content" },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.main-search.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.main-search.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.main-search.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "default", "label": "t:sections.all.image_shape.options__1.label" },
        { "value": "arch", "label": "t:sections.all.image_shape.options__2.label" },
        { "value": "blob", "label": "t:sections.all.image_shape.options__3.label" },
        { "value": "chevronleft", "label": "t:sections.all.image_shape.options__4.label" },
        { "value": "chevronright", "label": "t:sections.all.image_shape.options__5.label" },
        { "value": "diamond", "label": "t:sections.all.image_shape.options__6.label" },
        { "value": "parallelogram", "label": "t:sections.all.image_shape.options__7.label" },
        { "value": "round", "label": "t:sections.all.image_shape.options__8.label" }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    { "type": "checkbox", "id": "show_secondary_image", "default": false, "label": "t:sections.main-search.settings.show_secondary_image.label" },
    { "type": "checkbox", "id": "show_vendor", "default": true, "label": "t:sections.main-search.settings.show_vendor.label" },
    { "type": "checkbox", "id": "show_rating", "default": false, "label": "t:sections.main-search.settings.show_rating.label", "info": "t:sections.main-search.settings.show_rating.info" },
    { "type": "header", "content": "t:sections.main-collection-product-grid.settings.header__1.content" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label", "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info" },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        { "value": "horizontal", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label" },
        { "value": "vertical", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label" },
        { "value": "drawer", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label" }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label" },
    { "type": "header", "content": "t:sections.main-search.settings.header__2.content" },
    { "type": "checkbox", "id": "article_show_date", "default": true, "label": "t:sections.main-search.settings.article_show_date.label" },
    { "type": "checkbox", "id": "article_show_author", "default": false, "label": "t:sections.main-search.settings.article_show_author.label" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}
{% endschema %}
