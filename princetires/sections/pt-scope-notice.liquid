{% comment %}
  Prince Tires — Scope notice (pt-scope-notice)

  Auto-renders a short "what we do / what we don't" note on any article whose
  title, excerpt or body mentions a service Prince Tires does NOT offer.

  Why this exists: three published articles discuss wheel alignment
  ("Tire Balancing vs. Alignment", "Wheel Alignment vs Tire Rotation vs
  Balancing", "Wheel Alignment After Winter"). They're useful, they rank, and
  they're exactly the kind of explainer AI assistants quote — so unpublishing
  them would cost more than it saves. The problem is that without a disclaimer
  they train Google and AI models to return Prince Tires for alignment queries
  the shop can't fulfil, and send walk-ins who have to be turned away.

  This keeps the traffic and the authority, and removes the false implication.
  It also covers any future article automatically, which is the real win —
  nobody has to remember to add a disclaimer.

  Matching is done on a lowercased haystack of title + excerpt + content.
{% endcomment %}

{%- liquid
  assign haystack = article.title | append: ' ' | append: article.excerpt | append: ' ' | append: article.content | strip_html | downcase

  assign show_notice = false
  assign matched = ''

  assign terms = section.settings.trigger_terms | default: 'alignment,aligning,align the wheels,wheel storage,tire storage,store my tires,mobile tire,mobile service,roadside' | split: ','
  for term in terms
    assign t = term | strip | downcase
    if t != blank and haystack contains t
      assign show_notice = true
      assign matched = t
      break
    endif
  endfor
-%}

{%- if show_notice and section.settings.enabled -%}
  {%- capture sw_phone %}{% render 'pt-nap', location: 'sw', field: 'phone' %}{% endcapture -%}
  {%- capture sw_phone_href %}{% render 'pt-nap', location: 'sw', field: 'phone_href' %}{% endcapture -%}

  <aside class="pt-scope" role="note">
    <div class="pt-scope__inner">
      <span class="pt-scope__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
      </span>
      <div class="pt-scope__body">
        <p class="pt-scope__title">{{ section.settings.heading }}</p>
        <p class="pt-scope__text">{{ section.settings.body }}</p>
        <p class="pt-scope__links">
          <a href="/pages/services">See what we do</a>
          <span aria-hidden="true">·</span>
          <a href="tel:{{ sw_phone_href | strip }}">{{ sw_phone | strip }}</a>
        </p>
      </div>
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  .pt-scope {
    max-width: 760px;
    margin: 2.4rem auto 3.2rem;
    padding: 0 1.6rem;
    font-family: 'Outfit', sans-serif;
  }
  .pt-scope__inner {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.3rem 1.5rem;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-left: 4px solid #F5820B;
    border-radius: 6px;
  }
  .pt-scope__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(245, 130, 11, 0.14);
    color: #b45309;
    flex-shrink: 0;
  }
  .pt-scope__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .pt-scope__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #7c2d12;
    line-height: 1.35;
  }
  .pt-scope__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #7c2d12;
    opacity: 0.92;
  }
  .pt-scope__links {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #b45309;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .pt-scope__links a {
    color: #b45309;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pt-scope__links a:hover { color: #7c2d12; }

  @media (max-width: 600px) {
    .pt-scope { margin: 2rem auto 2.4rem; padding: 0 1.2rem; }
    .pt-scope__inner { padding: 1.1rem 1.2rem; gap: 0.8rem; grid-template-columns: 32px 1fr; }
    .pt-scope__icon { width: 32px; height: 32px; }
    .pt-scope__icon svg { width: 17px; height: 17px; }
    .pt-scope__title { font-size: 1rem; }
    .pt-scope__text { font-size: 0.95rem; }
  }

  @media (prefers-color-scheme: dark) {
    .pt-scope__inner {
      background: rgba(245, 130, 11, 0.08);
      border-color: rgba(245, 130, 11, 0.32);
    }
    .pt-scope__title,
    .pt-scope__text { color: #fdba74; }
    .pt-scope__links,
    .pt-scope__links a { color: #fdba74; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scope notice",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enabled",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Shows automatically on any article that mentions a service Prince Tires does not offer. Articles that don't mention one render nothing at all."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A note on what we do"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Prince Tires is a tire specialist. We sell and install tires, balance, rotate, repair punctures and service TPMS sensors at both our Calgary shops — but we don't perform wheel alignment, tire storage or mobile service. This article is here to help you understand the job; you'll need an alignment shop for the work itself."
    },
    {
      "type": "textarea",
      "id": "trigger_terms",
      "label": "Trigger terms (comma separated)",
      "default": "alignment,aligning,align the wheels,wheel storage,tire storage,store my tires,mobile tire,mobile service,roadside",
      "info": "If an article's title, excerpt or body contains any of these, the notice appears. Add a term whenever you write about something you don't offer."
    }
  ],
  "presets": [
    {
      "name": "Scope notice"
    }
  ]
}
{% endschema %}
