{%- liquid
  assign hero_heading = section.settings.hero_heading | default: 'Book a service'
  assign hero_sub     = section.settings.hero_sub     | default: 'Tell us what you need, pick a time. We confirm by email within the day.'
-%}

{%- comment -%}
  Logged-in customer payload — picked up by the booking page JS to prefill
  the contact + vehicle fields. Cache-then-refresh: localStorage garage gives
  an instant vehicle prefill; /apps/api/vehicles silently overrides if the
  server has a newer default. Sensitive data is omitted (only name/email/phone).
{%- endcomment -%}
{%- if customer -%}
  <script id="bp-customer-data" type="application/json">
  {
    "name": {{ customer.name | json }},
    "email": {{ customer.email | json }},
    "phone": {{ customer.phone | json }},
    "customerId": {{ customer.id | json }}
  }
  </script>
{%- endif -%}

<section class="pt-bp">
  <header class="pt-bp__hero">
    <p class="pt-bp__eyebrow">Calgary &middot; Same-day available</p>
    <h1 class="pt-bp__title">{{ hero_heading }}</h1>
    <p class="pt-bp__sub">{{ hero_sub }}</p>
  </header>

  <div class="pt-bp__shell">
    <div class="pt-bp__card">

      {%- comment -%} Saved-vehicle banner — shows when customer just came from tire search {%- endcomment -%}
      <div class="bp-saved" id="bp-saved" hidden>
        <div class="bp-saved__main">
          <span class="bp-saved__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
          </span>
          <div class="bp-saved__copy">
            <p class="bp-saved__title">Welcome back &mdash; installing tires for <strong id="bp-saved-vehicle"></strong>?</p>
            <p class="bp-saved__sub">Tire size: <span id="bp-saved-size"></span></p>
          </div>
        </div>
        <div class="bp-saved__actions">
          <button type="button" class="bp-saved__cta" id="bp-saved-go">Yes, book install &rarr;</button>
          <button type="button" class="bp-saved__dismiss" id="bp-saved-clear" aria-label="Not the right car? Clear">Not this car</button>
        </div>
      </div>

      {%- comment -%} Stepper {%- endcomment -%}
      <div class="bk-stepper" id="bp-stepper" aria-label="Booking steps">
        <div class="bk-step" data-bp-step="1"><div class="bk-step-circle bk-step-circle--active">1</div></div>
        <div class="bk-step-line"></div>
        <div class="bk-step" data-bp-step="2"><div class="bk-step-circle">2</div></div>
        <div class="bk-step-line"></div>
        <div class="bk-step" data-bp-step="3"><div class="bk-step-circle">3</div></div>
        <div class="bk-step-line"></div>
        <div class="bk-step" data-bp-step="4"><div class="bk-step-circle">4</div></div>
      </div>

      {%- comment -%} Step 1 — What do you need? {%- endcomment -%}
      <div class="bk-page" id="bp-page-1">
        <p class="bk-label">What can we help with?</p>
        <div class="bp-pathways">
          <button class="bp-pathway" data-bp-path="buy" type="button">
            <span class="bp-pathway__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            </span>
            <span class="bp-pathway__title">I'm buying tires</span>
            <span class="bp-pathway__sub">Find tires by size or vehicle</span>
          </button>
          <button class="bp-pathway" data-bp-path="own" type="button">
            <span class="bp-pathway__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
            </span>
            <span class="bp-pathway__title">I have my own tires</span>
            <span class="bp-pathway__sub">Install or seasonal swap</span>
          </button>
          <button class="bp-pathway" data-bp-path="other" type="button">
            <span class="bp-pathway__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <span class="bp-pathway__title">Other service</span>
            <span class="bp-pathway__sub">Rotation, balance, flat repair, TPMS</span>
          </button>
        </div>

        {%- comment -%} 1A — Buying tires: tabbed size + vehicle search {%- endcomment -%}
        <div class="bp-substep" id="bp-buy" hidden>
          <p class="bk-label" style="margin-top:1.6rem">Find tires that fit</p>
          {% render 'pt-tire-search' %}
          <p class="bp-help bp-help--muted" style="margin-top:1rem">After you've picked tires, come back here and choose <strong>I have my own tires</strong> &rarr; <strong>off rims</strong> to book installation.</p>
        </div>

        {%- comment -%} 1B — Have own tires: on rims vs off rims {%- endcomment -%}
        <div class="bp-substep" id="bp-own" hidden>
          <p class="bk-label" style="margin-top:1.6rem">Are your tires already on rims?</p>
          <div class="bp-mountstate">
            <button class="bp-mount-card" data-bp-svc="installation_on" type="button">
              <span class="bp-mount-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              </span>
              <span class="bp-mount-title">On rims</span>
              <span class="bp-mount-sub">Seasonal swap. Tires already mounted on their own rims.</span>
              <span class="bp-mount-price">From <strong>$60 / car</strong></span>
            </button>
            <button class="bp-mount-card" data-bp-svc="installation_off" type="button">
              <span class="bp-mount-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
              </span>
              <span class="bp-mount-title">Off rims (loose)</span>
              <span class="bp-mount-sub">New install. We mount, balance, and torque per tire.</span>
              <span class="bp-mount-price">From <strong>$25 / tire</strong></span>
            </button>
          </div>
        </div>

        {%- comment -%} 1C — Other service: 4 tiles {%- endcomment -%}
        <div class="bp-substep" id="bp-other" hidden>
          <p class="bk-label" style="margin-top:1.6rem">Pick the service</p>
          <div class="bp-other-grid" id="bp-other-grid"></div>
        </div>

        <button class="bk-next-btn" id="bp-next-1" type="button" disabled style="margin-top:1.4rem">Next: vehicle &rarr;</button>
      </div>

      {%- comment -%} Step 2 — Vehicle + qty + addons {%- endcomment -%}
      <div class="bk-page" id="bp-page-2" hidden>
        <div class="bp-auto-pick" id="bp-auto-pick" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Auto-picked <strong id="bp-auto-tier"></strong> from <span id="bp-auto-vehicle"></span>. Tap below to change.</span>
        </div>
        <p class="bk-label">Vehicle type</p>
        <div class="bk-vehicle-grid" id="bp-vehicles"></div>

        <div id="bp-qty-section" hidden>
          <p class="bk-label" id="bp-qty-label" style="margin-top:1.4rem">How many tires?</p>
          <select class="bk-qty-select" id="bp-qty-select"></select>
        </div>

        <div id="bp-addons-section" hidden>
          <p class="bk-label" style="margin-top:1.4rem">Add-ons</p>
          <div class="bk-addons" id="bp-addons"></div>
        </div>

        <div class="sb-price-box" id="bp-price-box" hidden>
          <div class="sb-price-row"><span class="sb-price-label">Subtotal</span><span class="sb-price-sub" id="bp-price-sub"></span></div>
          <div class="sb-price-row"><span class="sb-price-label">GST (5%)</span><span class="sb-price-gst" id="bp-price-gst"></span></div>
          <div class="sb-price-divider"></div>
          <div class="sb-price-row"><span class="sb-price-label sb-price-total-label">Estimated total</span><span class="sb-price-amount" id="bp-price-amount"></span></div>
          <p class="sb-price-note" id="bp-price-note"></p>
        </div>

        <div class="bk-nav-row">
          <button class="bk-back-btn" data-bp-goto="1" type="button">&larr; Back</button>
          <button class="bk-next-btn" id="bp-next-2" data-bp-goto="3" type="button" disabled>Pick a time &rarr;</button>
        </div>
      </div>

      {%- comment -%} Step 3 — Date + time {%- endcomment -%}
      <div class="bk-page" id="bp-page-3" hidden>
        <div class="bk-week-nav">
          <button class="bk-week-arrow" id="bp-prev-week" type="button">&#8249;</button>
          <span class="bk-week-label" id="bp-week-label"></span>
          <button class="bk-week-arrow" id="bp-next-week" type="button">&#8250;</button>
        </div>
        <div class="bk-day-strip" id="bp-day-strip"></div>

        <p class="bk-label">Time</p>
        <div class="bk-time-grid" id="bp-time-grid"></div>
        <p class="bk-hours-note">Mon–Sat 9:30–5:30 &middot; Sun 10:00–3:30</p>

        <div class="bk-nav-row">
          <button class="bk-back-btn" data-bp-goto="2" type="button">&larr; Back</button>
          <button class="bk-next-btn" id="bp-next-3" data-bp-goto="4" type="button" disabled>Your details &rarr;</button>
        </div>
      </div>

      {%- comment -%} Step 4 — Contact + confirm {%- endcomment -%}
      <div class="bk-page" id="bp-page-4" hidden>
        <div class="bk-summary" id="bp-summary"></div>

        <div class="bk-form">
          <div class="bk-form-row">
            <div class="bk-field" id="bp-field-name">
              <label for="bp-name">Name</label>
              <input type="text" id="bp-name" placeholder="Jane Smith" autocomplete="name">
            </div>
            <div class="bk-field" id="bp-field-phone">
              <label for="bp-phone">Phone</label>
              <input type="tel" id="bp-phone" placeholder="(403) 555-0123" autocomplete="tel">
            </div>
          </div>
          <div class="bk-field" id="bp-field-email">
            <label for="bp-email">Email</label>
            <input type="email" id="bp-email" placeholder="jane@email.com" autocomplete="email">
          </div>
          <div class="bk-field">
            <label for="bp-vehicle-info">Vehicle (year, make, model)</label>
            <input type="text" id="bp-vehicle-info" placeholder="2018 Honda Civic LX" autocomplete="off">
          </div>
          <div class="bk-field">
            <label for="bp-notes">Notes <span class="bk-optional">(optional)</span></label>
            <textarea id="bp-notes" rows="2" placeholder="Anything we should know..."></textarea>
          </div>
        </div>

        <div class="bk-form-error" id="bp-form-error" hidden></div>

        <div class="bk-nav-row">
          <button class="bk-back-btn" data-bp-goto="3" type="button">&larr; Back</button>
          <button class="bk-confirm-btn" id="bp-confirm-btn" type="button">Confirm booking</button>
        </div>
      </div>

      {%- comment -%} Done {%- endcomment -%}
      <div class="bk-page" id="bp-page-done" hidden>
        <div class="bk-done-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
        </div>
        <h2 class="bk-done-title">You're booked!</h2>
        <p class="bk-done-sub">See you at Prince Tires — 111 42 Ave SW, Calgary.</p>
        <div class="bk-done-card" id="bp-done-card"></div>
        <div class="bk-done-actions">
          <button class="bk-cal-btn" id="bp-cal-btn" type="button">Add to calendar</button>
          <a class="bk-done-btn" href="{{ routes.root_url }}">Back to home</a>
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.pt-bp {
  background: linear-gradient(180deg, #fff 0%, #f7f7f7 100%);
  font-family: 'Outfit', sans-serif;
  color: #111;
  min-height: 100vh;
  padding-bottom: 5rem;
}

.pt-bp__hero {
  text-align: center;
  padding: 4rem 1.6rem 2rem;
  max-width: 720px;
  margin: 0 auto;
}
.pt-bp__eyebrow {
  color: #DA291C;
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 0 0 0.6rem;
}
.pt-bp__title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(2.6rem, 5vw, 3.8rem);
  font-weight: 700;
  line-height: 1.05;
  margin: 0 0 0.6rem;
  color: #0a0a0a;
  letter-spacing: -0.01em;
}
.pt-bp__sub {
  color: #4b5563;
  font-size: 1.2rem;
  margin: 0;
  line-height: 1.5;
}

.pt-bp__shell {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 1.4rem;
}
.pt-bp__card {
  background: #fff;
  border: 1px solid #f3f4f6;
  border-radius: 14px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  padding: 2rem 1.8rem 1.8rem;
}

@media (max-width: 600px) {
  .pt-bp__hero { padding: 2.6rem 1rem 1.4rem; }
  .pt-bp__shell { padding: 0 0.8rem; }
  .pt-bp__card { padding: 1.4rem 1.2rem 1.2rem; border-radius: 10px; }
}

/* ── Saved-vehicle banner ── */
.pt-bp .bp-saved[hidden] { display: none !important; }
.pt-bp .bp-saved {
  background: #fef9e7;
  border: 1.5px solid #fde68a;
  border-radius: 10px;
  padding: 1rem 1.1rem;
  margin-bottom: 1.4rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  animation: pt-bp-saved-in 0.25s ease;
}
@keyframes pt-bp-saved-in {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: none; }
}
.pt-bp .bp-saved__main {
  display: flex;
  gap: 0.7rem;
  align-items: flex-start;
}
.pt-bp .bp-saved__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: #fde68a;
  color: #92400e;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.pt-bp .bp-saved__copy { flex: 1; min-width: 0; }
.pt-bp .bp-saved__title {
  margin: 0;
  font-size: 1rem;
  color: #78350f;
  line-height: 1.4;
  font-weight: 500;
}
.pt-bp .bp-saved__title strong { color: #451a03; font-weight: 700; }
.pt-bp .bp-saved__sub {
  margin: 0.2rem 0 0;
  font-size: 0.88rem;
  color: #b45309;
  font-family: ui-monospace, SFMono-Regular, monospace;
}
.pt-bp .bp-saved__actions {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
}
.pt-bp .bp-saved__cta {
  flex: 0 0 auto;
  padding: 0 1rem;
  height: 38px;
  border: none;
  border-radius: 8px;
  background: #dc2626;
  color: #fff;
  font-family: inherit;
  font-size: 0.92rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s, transform 0.08s;
}
.pt-bp .bp-saved__cta:hover { background: #b91c1c; }
.pt-bp .bp-saved__cta:active { transform: translateY(1px); }
.pt-bp .bp-saved__dismiss {
  background: transparent;
  border: none;
  color: #92400e;
  font-family: inherit;
  font-size: 0.85rem;
  cursor: pointer;
  text-decoration: underline;
  padding: 0.4rem 0.6rem;
}
.pt-bp .bp-saved__dismiss:hover { color: #451a03; }

.pt-bp .bp-auto-pick[hidden] { display: none !important; }
.pt-bp .bp-auto-pick {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #166534;
  border-radius: 8px;
  padding: 0.55rem 0.75rem;
  margin-bottom: 0.9rem;
  font-size: 0.88rem;
  line-height: 1.4;
}
.pt-bp .bp-auto-pick svg { flex-shrink: 0; color: #16a34a; }
.pt-bp .bp-auto-pick strong { color: #15803d; }

.pt-bp .bk-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  margin-bottom: 1.6rem;
}
.pt-bp .bk-step-circle {
  width: 28px; height: 28px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center; justify-content: center;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 0.95rem;
  font-weight: 600;
  border: 1.5px solid #e5e7eb;
}
.pt-bp .bk-step-circle--active { background: #dc2626; color: #fff; border-color: #dc2626; }
.pt-bp .bk-step-circle--done   { background: #16a34a; color: #fff; border-color: #16a34a; }
.pt-bp .bk-step-line { flex: 0 0 32px; height: 2px; background: #e5e7eb; }

.pt-bp .bk-label {
  font-size: 0.95rem;
  font-weight: 600;
  color: #374151;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0 0 0.7rem;
}

.pt-bp .bp-pathways { display: grid; grid-template-columns: 1fr; gap: 0.6rem; }
.pt-bp .bp-pathway {
  background: #fafafa;
  border: 1.5px solid #e5e7eb;
  border-radius: 12px;
  padding: 1rem 1.1rem;
  display: grid;
  grid-template-columns: 36px 1fr;
  grid-template-rows: auto auto;
  column-gap: 0.9rem;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.18s, background 0.18s, transform 0.08s;
}
.pt-bp .bp-pathway:hover { border-color: #dc2626; background: #fff; }
.pt-bp .bp-pathway:active { transform: translateY(1px); }
.pt-bp .bp-pathway--active { border-color: #dc2626; background: #fef2f2; }
.pt-bp .bp-pathway__icon {
  grid-row: 1 / 3;
  display: inline-flex;
  align-items: center; justify-content: center;
  width: 36px; height: 36px;
  border-radius: 50%;
  background: #fef2f2;
  color: #dc2626;
}
.pt-bp .bp-pathway__title { grid-column: 2; font-size: 1.1rem; font-weight: 600; color: #0a0a0a; }
.pt-bp .bp-pathway__sub   { grid-column: 2; font-size: 0.95rem; color: #6b7280; font-weight: 400; }

.pt-bp .bp-substep {
  border-top: 1px solid #f3f4f6;
  margin-top: 1.2rem;
  padding-top: 0.4rem;
}
.pt-bp .bp-help { color: #6b7280; font-size: 0.95rem; margin: 0 0 0.8rem; line-height: 1.5; }
.pt-bp .bp-help--muted { color: #9ca3af; font-size: 0.88rem; }
.pt-bp .bp-help code { background: #f3f4f6; padding: 1px 6px; border-radius: 4px; color: #374151; font-family: ui-monospace, SFMono-Regular, monospace; }

.pt-bp .bp-search { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
.pt-bp .bp-search__input {
  flex: 1;
  padding: 0 1rem;
  height: 46px;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  font-family: inherit;
  font-size: 1.05rem;
  color: #111;
  background: #f9fafb;
  outline: none;
  transition: border-color 0.18s, background 0.18s;
}
.pt-bp .bp-search__input:focus { border-color: #dc2626; background: #fff; box-shadow: 0 0 0 3px rgba(220,38,38,0.08); }
.pt-bp .bp-search__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0 1.2rem;
  height: 46px;
  border: none;
  border-radius: 8px;
  background: #dc2626;
  color: #fff;
  font-family: inherit;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s, transform 0.08s;
}
.pt-bp .bp-search__btn:hover { background: #b91c1c; }
.pt-bp .bp-search__btn:active { transform: translateY(1px); }

.pt-bp .bp-mountstate { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
@media (max-width: 480px) { .pt-bp .bp-mountstate { grid-template-columns: 1fr; } }
.pt-bp .bp-mount-card {
  background: #fafafa;
  border: 1.5px solid #e5e7eb;
  border-radius: 12px;
  padding: 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.18s, background 0.18s;
}
.pt-bp .bp-mount-card:hover, .pt-bp .bp-mount-card--active { border-color: #dc2626; background: #fef2f2; }
.pt-bp .bp-mount-icon {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: #fef2f2;
  color: #dc2626;
  display: inline-flex;
