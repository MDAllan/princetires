<script>
(function () {
  // Canonical pricing — keep in sync with snippets/pt-service-booking-modal.liquid
  var BOOKING_API = 'https://app.princetires.ca/api/book';
  var AVAILABILITY_API = 'https://app.princetires.ca/api/availability';
  var SERVICES_API = 'https://app.princetires.ca/api/services';

  // ── Logged-in customer prefill ──────────────────────────────────────────
  // Reads the JSON payload Liquid injects above when "customer" is set,
  // then fills name/phone/email and the vehicle text input. Vehicle prefill uses
  // cache-then-refresh: localStorage garage first (instant), then the App
  // Proxy /apps/api/vehicles silently corrects if the server has a newer
  // default. Manual edits are preserved (each field only fills when blank).
  var customerData = (function () {
    var el = document.getElementById('bp-customer-data');
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  })();

  function fillIfEmpty(id, value) {
    if (!value) return;
    var el = document.getElementById(id);
    if (el && !el.value) el.value = value;
  }

  function vehicleLabel(v) {
    return [v.year, v.make, v.model, v.trim].filter(Boolean).join(' ');
  }

  function prefillCustomer() {
    if (!customerData) return;
    fillIfEmpty('bp-name', customerData.name);
    fillIfEmpty('bp-phone', customerData.phone);
    fillIfEmpty('bp-email', customerData.email);
  }

  function prefillVehicleFromCache() {
    if (!customerData || !customerData.customerId) return;
    try {
      var raw = localStorage.getItem('pt-garage-' + customerData.customerId);
      var vehicles = raw ? JSON.parse(raw) : [];
      var def = vehicles.find(function (v) { return v.isDefault; }) || vehicles[0];
      if (def) fillIfEmpty('bp-vehicle-info', vehicleLabel(def));
    } catch (e) {}
  }

  function prefillVehicleFromApi() {
    if (!customerData) return; // not logged in — no App Proxy session anyway
    fetch('/apps/api/vehicles', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || !Array.isArray(data.vehicles)) return;
        var def = data.vehicles.find(function (v) { return v.isDefault; }) || data.vehicles[0];
        if (!def) return;
        var label = vehicleLabel(def);
        var el = document.getElementById('bp-vehicle-info');
        // Only overwrite if the field is empty OR still matches what we
        // pre-filled from localStorage (so manual edits never get clobbered).
        if (el && (!el.value || el.dataset.bpAutofilled === '1')) {
          el.value = label;
          el.dataset.bpAutofilled = '1';
        }
      })
      .catch(function () {});
  }

  // Mark the field as "autofilled" if we set it from cache so the API
  // refresh can safely overwrite. Any keystroke clears the flag.
  function trackVehicleField() {
    var el = document.getElementById('bp-vehicle-info');
    if (!el) return;
    var initial = el.value;
    if (initial) el.dataset.bpAutofilled = '1';
    el.addEventListener('input', function () { delete el.dataset.bpAutofilled; });
  }

  prefillCustomer();
  prefillVehicleFromCache();
  trackVehicleField();
  prefillVehicleFromApi();
  // ────────────────────────────────────────────────────────────────────────

  // ── Pricing (fallback) ──────────────────────────────────────────────────
  // bpApplyCatalog() overlays these with live values from GET /api/services
  // (editable in the admin app). Modes: per_unit_by_vehicle | flat_by_vehicle
  // | per_unit_flat. See docs/phase-3.5-service-catalog.md.
  var bpPricing = {
    installation_off: { mode: 'per_unit_by_vehicle', unit: 'tire',
      byVehicle: { passenger: 25, suv: 30, van: 30, electric: 30, truck: 35, largetruck: 40, dually: 45, trailer: 30 },
      lowProfileFloor: 40, flatOverride: { trailer: 120 } },
    installation_on: { mode: 'flat_by_vehicle', unit: 'car',
      byVehicle: { passenger: 60, suv: 60, van: 60, electric: 60, truck: 80, largetruck: 80, dually: 90, trailer: 120 } },
    balancing: { mode: 'per_unit_flat', unit: 'wheel', amount: 20 },
    rotation: { mode: 'flat_by_vehicle', unit: 'car',
      byVehicle: { passenger: 60, suv: 60, van: 60, electric: 60, truck: 60, largetruck: 100, dually: 100, trailer: 60 } },
    flat_repair: { mode: 'per_unit_flat', unit: 'tire', amount: 50 },
    tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 75 },
    addon_tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 75 },
    addon_disposal: { mode: 'per_unit_flat', unit: 'tire', amount: 5 }
  };

  var SERVICES = {
    installation_off: { name: 'Tire Installation (off rims)' },
    installation_on:  { name: 'Seasonal Swap (on rims)' },
    balancing:        { name: 'Wheel Balancing' },
    rotation:         { name: 'Tire Rotation' },
    flat_repair:      { name: 'Flat Repair' },
    tpms:             { name: 'TPMS Service' }
  };
  var OTHER_SERVICES = [
    { id: 'rotation',    name: 'Tire Rotation',  priceLabel: 'from $60 / car' },
    { id: 'balancing',   name: 'Wheel Balancing', priceLabel: '$20 / wheel' },
    { id: 'flat_repair', name: 'Flat Repair',    priceLabel: '$50 / tire (patch)' },
    { id: 'tpms',        name: 'TPMS Service',   priceLabel: '$75 / sensor' }
  ];
  var VEHICLES = [
    { id: 'passenger', name: 'Sedan' },
    { id: 'suv', name: 'SUV / CUV' },
    { id: 'van', name: 'Van' },
    { id: 'electric', name: 'Electric' },
    { id: 'truck', name: 'Truck' },
    { id: 'dually', name: 'Dually' },
    { id: 'largetruck', name: 'Large / Cube / 21"+' },
    { id: 'trailer', name: 'Trailer' }
  ];

  var st = {
    pathway: '',
    service: '',
    vehicle: 'passenger',
    qty: 4,
    addons: { tpms: false, disposal: false, lowProfile: false },
    date: null,
    time: null
  };
  var wk = 0;

  function fmtMoney(n) { return '$' + (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2)); }

  // Best-guess vehicle tier from a saved tire-search record.
  // Returns one of the canonical tier ids (passenger/suv/van/electric/truck/dually/largetruck/trailer).
  // Customer can always override on step 2 if the guess is wrong.
  function detectTier(saved) {
    if (!saved) return 'passenger';
    var mk = (saved.make || '').toLowerCase();
    var md = (saved.model || '').toLowerCase();
    var trim = (saved.trim || '').toLowerCase();
    var size = (saved.tireSize || '').toUpperCase();
    var modelTrim = (md + ' ' + trim).trim();

    // EV makes / models (highest priority — Tesla Model Y is "SUV" form factor but priced at electric tier)
    var evMakes = ['tesla', 'rivian', 'lucid', 'polestar'];
    var evModels = ['bolt', 'leaf', 'ioniq', 'mustang mach', 'mach-e', 'id.4', 'id.3', 'taycan', 'e-tron', 'lightning', 'lyriq', 'eqs', 'eqe', 'i4', 'ix'];
    if (evMakes.indexOf(mk) > -1) return 'electric';
    for (var i = 0; i < evModels.length; i++) { if (modelTrim.indexOf(evModels[i]) > -1) return 'electric'; }

    // Dually & heavy-duty trucks (F-350, Ram 3500, etc.)
    if (/\b(dually|3500|f-?350|sierra 3500)\b/.test(modelTrim)) return 'dually';

    // Cube vans + big trucks (F-250, Ram 2500, Sprinter cube, ProMaster cargo)
    if (/\b(2500|f-?250|sierra 2500|sprinter|promaster|cube|cab.{0,3}chassis)\b/.test(modelTrim)) return 'largetruck';

    // Trailer
    if (/\btrailer\b/.test(modelTrim) || size.indexOf('ST') === 0) return 'trailer';

    // Half-ton & midsize pickups
    var truckRx = /\b(f-?150|1500|sierra 1500|silverado 1500|ram 1500|tundra|tacoma|titan|frontier|colorado|canyon|ridgeline|ranger|maverick|gladiator|pickup|truck)\b/;
    if (truckRx.test(modelTrim)) return 'truck';

    // Vans / minivans (passenger vans like Sienna/Odyssey — different from Sprinter)
    var vanRx = /\b(sienna|odyssey|pacifica|carnival|quest|caravan|town.country|transit connect)\b/;
    if (vanRx.test(modelTrim)) return 'van';

    // SUVs / CUVs
    var suvRx = /\b(suv|explorer|tahoe|yukon|suburban|highlander|4runner|pathfinder|pilot|rav4|cr-?v|rogue|murano|escape|edge|bronco|equinox|traverse|blazer|wrangler|cherokee|grand cherokee|durango|tucson|santa fe|palisade|sportage|sorento|telluride|forester|outback|crosstrek|ascent|armada|expedition|sequoia|mdx|rdx|qx|gx|lx|rx|nx|gle|glc|gls|x3|x5|x7|q5|q7|q8)\b/;
    if (suvRx.test(modelTrim)) return 'suv';

    // Tire-size hints (low-profile sport cars often need largetruck pricing)
    var rimM = size.match(/R(\d+)/);
    if (rimM && parseInt(rimM[1]) >= 21) return 'largetruck';

    // Default: sedan/coupe/hatch
    return 'passenger';
  }

  // Generic, catalog-driven price calc. Reads bpPricing (overlaid by
  // bpApplyCatalog from GET /api/services). Verified to produce the same
  // numbers as the prior hardcoded per-service logic.
  function calcPrice() {
    var s = st.service, v = st.vehicle, q = st.qty;
    var p = bpPricing[s];
    if (!p) return null;
    var subtotal = 0, parts = [];
    var unit = p.unit || 'unit';

    if (p.mode === 'per_unit_by_vehicle') {
      if (p.flatOverride && p.flatOverride[v] != null) {
        subtotal = p.flatOverride[v];
        parts.push('flat $' + subtotal + ' (' + v + ')');
      } else {
        var base = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 30;
        var per = (st.addons.lowProfile && p.lowProfileFloor)
          ? Math.max(base, p.lowProfileFloor) : base;
        subtotal = per * q;
        parts.push('$' + per + '/' + unit + ' × ' + q);
        if (st.addons.lowProfile && per > base) parts.push('low-profile');
      }
    } else if (p.mode === 'flat_by_vehicle') {
      subtotal = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 0;
      parts.push('flat $' + subtotal + ' per ' + unit);
    } else if (p.mode === 'per_unit_flat') {
      subtotal = (p.amount || 0) * q;
      parts.push('$' + (p.amount || 0) + '/' + unit + ' × ' + q);
    } else { return null; }

    if (s === 'installation_off' || s === 'installation_on') {
      if (st.addons.tpms && bpPricing.addon_tpms) {
        subtotal += (bpPricing.addon_tpms.amount || 0) * q;
        parts.push('TPMS ×' + q);
      }
    }
    if (s === 'installation_off') {
      if (st.addons.disposal && bpPricing.addon_disposal) {
        subtotal += (bpPricing.addon_disposal.amount || 0) * q;
        parts.push('disposal');
      }
    }

    var gst = subtotal * 0.05;
    return {
      subtotal: fmtMoney(subtotal),
      gst: fmtMoney(gst),
      amount: fmtMoney(subtotal + gst),
      note: parts.join(' + ') + ' · est. before confirming',
      raw: { subtotal: subtotal, gst: gst, total: subtotal + gst }
    };
  }

  // ── Stage 2: derive a chip price label from a catalog service ─────────────
  function bpPriceLabel(svc) {
    var pr = svc.prices || {};
    var u = svc.unit || 'unit';
    if (svc.pricingMode === 'per_unit_flat') {
      return '$' + (pr.amount != null ? pr.amount : '?') + ' / ' + u;
    }
    var vals = [];
    if (pr.byVehicle) {
      Object.keys(pr.byVehicle).forEach(function (k) {
        var n = pr.byVehicle[k];
        if (typeof n === 'number') vals.push(n);
      });
    }
    if (!vals.length) return '';
    return 'from $' + Math.min.apply(null, vals) + ' / ' + u;
  }

  // ── Stage 2: overlay the live catalog from GET /api/services ──────────────
  // Replaces fallback pricing + labels with admin-managed values. Defensive:
  // empty/bad data leaves the hardcoded fallback in place.
  function bpApplyCatalog(services) {
    if (!Array.isArray(services) || !services.length) return;
    var others = [];
    services.forEach(function (svc) {
      if (!svc || !svc.slug) return;
      var pr = svc.prices || {};
      bpPricing[svc.slug] = {
        mode: svc.pricingMode,
        unit: svc.unit,
        byVehicle: pr.byVehicle || null,
        amount: pr.amount,
        lowProfileFloor: pr.lowProfileFloor,
        flatOverride: pr.flatOverride || null
      };
      if (svc.kind === 'service') {
        SERVICES[svc.slug] = { name: svc.name };
        // installation_on/off are the "own tires" pathway; everything else
        // (including newly-added services) is an "other service" tile.
        if (svc.slug !== 'installation_off' && svc.slug !== 'installation_on') {
          others.push({ id: svc.slug, name: svc.name, priceLabel: bpPriceLabel(svc) });
        }
      }
    });
    // Rebuild the other-service list from the catalog so services added or
    // removed in the admin flow through to this page.
    if (others.length) OTHER_SERVICES = others;
    // Refresh the static mount-price labels (installation_on / installation_off).
    var mountLabel = function (slug) {
      var el = document.querySelector('.bp-mount-card[data-bp-svc="' + slug + '"] .bp-mount-price');
      if (!el) return;
      var p = bpPricing[slug];
      var vals = (p && p.byVehicle)
        ? Object.keys(p.byVehicle).map(function (k) { return p.byVehicle[k]; }).filter(function (n) { return typeof n === 'number'; })
        : [];
      if (vals.length) el.innerHTML = 'From <strong>$' + Math.min.apply(null, vals) + ' / ' + (p.unit || 'car') + '</strong>';
    };
    mountLabel('installation_on');
    mountLabel('installation_off');
    // Repaint anything already on screen.
    var og = document.getElementById('bp-other-grid');
    if (og && og.children.length) renderOtherGrid();
    var as = document.getElementById('bp-addons-section');
    if (as && !as.hidden) renderAddons();
    if (st.service) updatePrice();
  }

  function goTo(step) {
    [1,2,3,4].forEach(function (s) {
      var el = document.getElementById('bp-page-' + s);
      if (el) el.hidden = s !== step;
    });
    document.getElementById('bp-page-done').hidden = true;
    [1,2,3,4].forEach(function (s) {
      var ci = document.querySelector('[data-bp-step="' + s + '"] .bk-step-circle');
      if (!ci) return;
      ci.className = 'bk-step-circle';
      if (s < step) { ci.classList.add('bk-step-circle--done'); ci.innerHTML = '✓'; }
      else if (s === step) { ci.classList.add('bk-step-circle--active'); ci.textContent = s; }
      else { ci.textContent = s; }
    });
    if (step === 2) { renderVehicles(); renderAutoPickHint(); }
    if (step === 3) { if (!st.date) { var t = new Date(); t.setHours(0,0,0,0); st.date = t; } renderWeek(); renderTimes(); }
    if (step === 4) renderSummary();
    try { window.scrollTo({ top: document.querySelector('.pt-bp__card').offsetTop - 20, behavior: 'smooth' }); } catch (e) {}
  }

  function pickPathway(path) {
    st.pathway = path;
    document.querySelectorAll('.bp-pathway').forEach(function (b) {
      b.classList.toggle('bp-pathway--active', b.dataset.bpPath === path);
    });
    document.getElementById('bp-buy').hidden = path !== 'buy';
    document.getElementById('bp-own').hidden = path !== 'own';
    document.getElementById('bp-other').hidden = path !== 'other';
    if (path === 'other') renderOtherGrid();
    st.service = '';
    document.querySelectorAll('.bp-mount-card').forEach(function (c) { c.classList.remove('bp-mount-card--active'); });
    updateNextBtn();
  }

  function renderOtherGrid() {
    var grid = document.getElementById('bp-other-grid');
    grid.innerHTML = OTHER_SERVICES.map(function (s) {
      var active = st.service === s.id ? ' bp-other-chip--active' : '';
      return '<button type="button" class="bp-other-chip' + active + '" data-bp-svc="' + s.id + '">' +
        '<span class="bp-other-chip__name">' + s.name + '</span>' +
        '<span class="bp-other-chip__price">' + s.priceLabel + '</span>' +
        '</button>';
    }).join('');
    grid.querySelectorAll('.bp-other-chip').forEach(function (el) {
      el.addEventListener('click', function () {
        st.service = this.dataset.bpSvc;
        renderOtherGrid();
        updateNextBtn();
      });
    });
  }

  function updateNextBtn() {
    var btn = document.getElementById('bp-next-1');
    if (!btn) return;
    if (st.pathway === 'buy') { btn.hidden = true; return; }
    btn.hidden = false;
    btn.disabled = !st.service;
  }

  function renderVehicles() {
    var grid = document.getElementById('bp-vehicles');
    var noTrailer = ['balancing', 'rotation'];
    var vehs = noTrailer.indexOf(st.service) > -1 ? VEHICLES.filter(function (v) { return v.id !== 'trailer'; }) : VEHICLES;
    grid.innerHTML = vehs.map(function (v) {
      var active = st.vehicle === v.id ? ' bk-vehicle-card--active' : '';
      return '<button type="button" class="bk-vehicle-card' + active + '" data-veh="' + v.id + '">' + v.name + '</button>';
    }).join('');
    grid.querySelectorAll('.bk-vehicle-card').forEach(function (el) {
      el.addEventListener('click', function () {
        st.vehicle = this.dataset.veh;
        // Manual pick overrides the auto-detection — clear the hint so we don't lie to the customer
        st.autoPickedFromSaved = false;
        renderAutoPickHint();
        renderVehicles();
        updatePrice();
        document.getElementById('bp-next-2').disabled = false;
      });
    });

    var noQty = (st.service === 'installation_on' || st.service === 'rotation');
    document.getElementById('bp-qty-section').hidden = noQty;
    if (!noQty) renderQty();

    var hasAddons = (st.service === 'installation_off' || st.service === 'installation_on');
    document.getElementById('bp-addons-section').hidden = !hasAddons;
    if (hasAddons) renderAddons();

    updatePrice();
    document.getElementById('bp-next-2').disabled = false;
  }

  function renderAutoPickHint() {
    var el = document.getElementById('bp-auto-pick');
    if (!el) return;
    if (!st.autoPickedFromSaved) { el.hidden = true; return; }
    var v = VEHICLES.find(function (x) { return x.id === st.vehicle; });
    var savedRaw = (function () { try { return localStorage.getItem('pt-tire-search-vehicle'); } catch (e) { return null; } })();
    var saved = savedRaw ? JSON.parse(savedRaw) : null;
    if (!saved || !v) { el.hidden = true; return; }
    var label = [saved.year, saved.make, saved.model, saved.trim].filter(Boolean).join(' ');
    document.getElementById('bp-auto-tier').textContent = v.name;
    document.getElementById('bp-auto-vehicle').textContent = label || 'your saved vehicle';
    el.hidden = false;
  }

  function renderQty() {
    var sel = document.getElementById('bp-qty-select');
    var lbl = document.getElementById('bp-qty-label');
    if (!sel) return;
    var s = st.service;
    var isTpms = s === 'tpms';
    var isBalancing = s === 'balancing';
    var isRepair = s === 'flat_repair';
    var max = (isTpms || isBalancing || isRepair) ? 4 : 8;
    lbl.textContent = isTpms ? 'How many sensors?'
                    : isBalancing ? 'How many wheels?'
                    : isRepair ? 'How many tires to patch?'
                    : 'How many tires?';
    if (sel.dataset.max !== String(max)) {
      sel.dataset.max = String(max);
      var unit = isTpms ? ' sensor' : isBalancing ? ' wheel' : ' tire';
      var html = '';
      for (var i = 1; i <= max; i++) {
        html += '<option value="' + i + '"' + (i === st.qty ? ' selected' : '') + '>' + i + unit + (i > 1 ? 's' : '') + '</option>';
      }
      sel.innerHTML = html;
    }
    sel.value = String(Math.min(st.qty, max));
    if (!sel._wired) {
      sel._wired = true;
      sel.addEventListener('change', function () { st.qty = parseInt(this.value); updatePrice(); });
    }
  }

  function renderAddons() {
    var container = document.getElementById('bp-addons');
    var rows = [];
    var isOff = st.service === 'installation_off';
    var isOn  = st.service === 'installation_on';
    if (isOff || isOn) rows.push({ id: 'tpms', name: 'New TPMS sensors', priceLabel: '+$' + ((bpPricing.addon_tpms && bpPricing.addon_tpms.amount) || 75) + '/sensor' });
    if (isOff) {
      rows.push({ id: 'disposal', name: 'Tire disposal', priceLabel: '+$' + ((bpPricing.addon_disposal && bpPricing.addon_disposal.amount) || 5) + '/tire' });
      rows.push({ id: 'lowProfile', name: 'Low-profile or run-flat tires', priceLabel: '$' + ((bpPricing.installation_off && bpPricing.installation_off.lowProfileFloor) || 40) + '/tire min' });
    }
    container.innerHTML = rows.map(function (a) {
      var active = st.addons[a.id] ? ' bk-addon--active' : '';
      var checked = st.addons[a.id] ? ' checked' : '';
      return '<label class="bk-addon' + active + '">' +
        '<input type="checkbox" data-bp-addon="' + a.id + '"' + checked + '>' +
        '<span class="bk-addon-name">' + a.name + '</span>' +
        '<span class="bk-addon-price">' + a.priceLabel + '</span>' +
        '</label>';
    }).join('');
    container.querySelectorAll('input[data-bp-addon]').forEach(function (el) {
      el.addEventListener('change', function () {
        st.addons[this.dataset.bpAddon] = this.checked;
        this.closest('.bk-addon').classList.toggle('bk-addon--active', this.checked);
        updatePrice();
      });
    });
  }

  function updatePrice() {
    var box = document.getElementById('bp-price-box');
    var pr = calcPrice();
    if (!pr) { box.hidden = true; return; }
    box.hidden = false;
    document.getElementById('bp-price-sub').textContent = pr.subtotal;
    document.getElementById('bp-price-gst').textContent = pr.gst;
    document.getElementById('bp-price-amount').textContent = pr.amount;
    document.getElementById('bp-price-note').textContent = pr.note;
  }

  function slotMins(slot) {
    var m = slot.match(/(\d+):(\d+)\s*(AM|PM)/i);
    if (!m) return 0;
    var h = parseInt(m[1]), mn = parseInt(m[2]);
    if (m[3].toUpperCase() === 'PM' && h !== 12) h += 12;
    if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
    return h * 60 + mn;
  }

  function renderWeek() {
    var today = new Date(); today.setHours(0,0,0,0);
    var start = new Date(today);
    start.setDate(start.getDate() - start.getDay() + 1 + wk * 7);
    var dn = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    var mn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var end = new Date(start); end.setDate(end.getDate() + 6);
    document.getElementById('bp-week-label').textContent = start.getDate() + ' ' + mn[start.getMonth()] + ' – ' + end.getDate() + ' ' + mn[end.getMonth()];
    document.getElementById('bp-prev-week').disabled = wk <= 0;

    var html = '';
    for (var i = 0; i < 7; i++) {
      var d = new Date(start); d.setDate(d.getDate() + i);
      var isPast = d < today;
      var isToday = d.getTime() === today.getTime();
      var isActive = st.date && d.toDateString() === st.date.toDateString();
      var cls = 'bk-day-card' + (isPast ? ' bk-day-card--past' : '') + (isToday ? ' bk-day-card--today' : '') + (isActive ? ' bk-day-card--active' : '');
      var iso = d.getFullYear() + '-' + (d.getMonth()+1<10?'0':'') + (d.getMonth()+1) + '-' + (d.getDate()<10?'0':'') + d.getDate();
      html += '<button type="button" class="' + cls + '" data-date="' + iso + '"><span class="bk-day-name">' + dn[i] + '</span><span class="bk-day-num">' + d.getDate() + '</span></button>';
    }
    document.getElementById('bp-day-strip').innerHTML = html;
    document.querySelectorAll('#bp-day-strip .bk-day-card:not(.bk-day-card--past)').forEach(function (el) {
      el.addEventListener('click', function () {
        st.date = new Date(this.dataset.date + 'T12:00:00');
        st.time = null;
        document.getElementById('bp-next-3').disabled = true;
        renderWeek();
        renderTimes();
      });
    });
  }

  async function renderTimes() {
    var grid = document.getElementById('bp-time-grid');
    if (!st.date) { grid.innerHTML = '<p style="color:#9ca3af;font-size:0.92rem;grid-column:1/-1;text-align:center">Pick a day above.</p>'; return; }
    var isSun = st.date.getDay() === 0;
    var startH = isSun ? 10 : 9, startM = isSun ? 0 : 30, endH = isSun ? 15 : 17, endM = 30;
    var slots = [];
    for (var h = startH; h <= endH; h++) {
      for (var m = (h === startH ? startM : 0); m < 60; m += 30) {
        if (h === endH && m > endM) break;
        var hr = h > 12 ? h - 12 : h;
        slots.push(hr + ':' + (m < 10 ? '0' : '') + m + ' ' + (h >= 12 ? 'PM' : 'AM'));
      }
    }
    grid.innerHTML = '<p style="color:#9ca3af;font-size:0.92rem;grid-column:1/-1;text-align:center">Checking availability...</p>';

    var booked = [], allDayBlocked = false;
    try {
      var d = st.date;
      var dateParam = d.getFullYear() + '-' + (d.getMonth()+1<10?'0':'') + (d.getMonth()+1) + '-' + (d.getDate()<10?'0':'') + d.getDate();
      var r = await fetch(AVAILABILITY_API + '?date=' + dateParam);
      var data = await r.json();
      booked = data.booked || [];
      allDayBlocked = data.allDayBlocked || false;
    } catch (e) {}

    if (allDayBlocked) {
      grid.innerHTML = '<p style="color:#dc2626;font-size:0.95rem;grid-column:1/-1;text-align:center;padding:0.5rem 0">Not available this day — please pick another.</p>';
      return;
    }

    var blockReason = {};
    var now = new Date();
    var nowMins = now.getHours() * 60 + now.getMinutes();
    var today = new Date(); today.setHours(0,0,0,0);
    var isToday = st.date.toDateString() === today.toDateString();
    if (isToday) {
      slots.forEach(function (s) {
        var sm = slotMins(s);
        if (sm <= nowMins) blockReason[s] = 'Time has passed';
        else if (sm < nowMins + 120) blockReason[s] = 'Book at least 2 hrs ahead';
      });
    }

    grid.innerHTML = slots.map(function (s) {
      var isCalBooked = booked.indexOf(s) > -1;
      var isBlocked = isCalBooked || !!blockReason[s];
      var titleAttr = isCalBooked ? 'Already booked' : (blockReason[s] || '');
      return '<button type="button" class="bk-time-slot' +
        (st.time === s ? ' bk-time-slot--active' : '') +
        (isBlocked ? ' bk-time-slot--booked' : '') +
        '" data-time="' + s + '"' + (isBlocked ? ' disabled title="' + titleAttr + '"' : '') + '>' + s + '</button>';
    }).join('');
    grid.querySelectorAll('.bk-time-slot:not(.bk-time-slot--booked)').forEach(function (el) {
      el.addEventListener('click', function () {
        st.time = this.dataset.time;
        renderTimes();
        document.getElementById('bp-next-3').disabled = false;
      });
    });
  }

  function renderSummary() {
    var svc = SERVICES[st.service];
    var veh = VEHICLES.find(function (v) { return v.id === st.vehicle; });
    var pr = calcPrice();
    var ds = st.date ? st.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + st.time : '';
    var h = '';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
    if (st.service === 'installation_off' && st.addons.lowProfile) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Tire type</span><span class="bk-summary-val">Low-profile / run-flat</span></div>';
    }
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Date &amp; time</span><span class="bk-summary-val">' + ds + '</span></div>';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Vehicle</span><span class="bk-summary-val">' + (veh ? veh.name : '') + '</span></div>';
    if (pr) h += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
    document.getElementById('bp-summary').innerHTML = h;
  }

  async function submitBooking() {
    var name = document.getElementById('bp-name').value.trim();
    var phone = document.getElementById('bp-phone').value.trim();
    var email = document.getElementById('bp-email').value.trim();
    var vehInfo = document.getElementById('bp-vehicle-info').value.trim();
    var notes = document.getElementById('bp-notes').value.trim();
    var errEl = document.getElementById('bp-form-error');

    ['bp-field-name','bp-field-phone','bp-field-email'].forEach(function (id) { document.getElementById(id).classList.remove('bk-field--error'); });
    errEl.hidden = true;

    var missing = [];
    if (!name)  { document.getElementById('bp-field-name').classList.add('bk-field--error'); missing.push('full name'); }
    if (!phone) { document.getElementById('bp-field-phone').classList.add('bk-field--error'); missing.push('phone number'); }
    if (!email || email.indexOf('@') < 1) { document.getElementById('bp-field-email').classList.add('bk-field--error'); missing.push('email address'); }
    if (missing.length) { errEl.textContent = 'Please fill in your ' + missing.join(', ') + '.'; errEl.hidden = false; return; }
    if (!st.date || !st.time) { errEl.textContent = 'Please select a date and time before confirming.'; errEl.hidden = false; return; }

    var btn = document.getElementById('bp-confirm-btn');
    btn.disabled = true; btn.textContent = 'Booking...';

    var pr = calcPrice();
    var d = st.date;
    var dateStr = d.getFullYear() + '-' + (d.getMonth()+1<10?'0':'') + (d.getMonth()+1) + '-' + (d.getDate()<10?'0':'') + d.getDate();
    var svc = SERVICES[st.service];

    var payload = {
      bookType: 'service',
      serviceName: svc ? svc.name : 'Service',
      serviceId: st.service,
      mountState: st.service === 'installation_off' ? 'off' : st.service === 'installation_on' ? 'on' : '',
      qty: st.qty,
      tpms: st.addons.tpms || false,
      disposal: st.addons.disposal || false,
      lowProfile: st.addons.lowProfile || false,
      name: name, phone: phone, email: email,
      notes: (notes ? notes + ' · ' : '') + (vehInfo || ''),
      vehicleType: st.vehicle,
      date: dateStr,
      time: st.time,
      subtotal: pr ? pr.raw.subtotal : 0,
      gst:      pr ? pr.raw.gst      : 0,
      total:    pr ? pr.raw.total    : 0
    };

    try {
      var res;
      try {
        res = await fetch(BOOKING_API, { method: 'POST', mode: 'cors', credentials: 'omit', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } catch (netErr) {
        throw new Error("Couldn't reach the booking server. Try a different browser or call (403) 452-4283.");
      }
      if (!res.ok) {
        var ed = await res.json().catch(function () { return {}; });
        if (res.status === 429) throw new Error('Too many bookings from this device — please wait a minute and try again.');
        if (res.status === 409) throw new Error('That time slot was just booked. Please pick another time.');
        if (res.status >= 500) throw new Error('Our booking server hit a snag (HTTP ' + res.status + '). Please call (403) 452-4283.');
        throw new Error(ed.error || ('Booking failed (HTTP ' + res.status + ')'));
      }

      var doneCard = document.getElementById('bp-done-card');
      var ds = st.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + st.time;
      var doneH = '';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Date &amp; time</span><span class="bk-summary-val">' + ds + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Address</span><span class="bk-summary-val">111 42 Ave SW, Calgary, AB</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Phone</span><span class="bk-summary-val">(403) 452-4283</span></div>';
      if (pr) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
      doneCard.innerHTML = doneH;

      [1,2,3,4].forEach(function (s) { document.getElementById('bp-page-' + s).hidden = true; });
      document.getElementById('bp-page-done').hidden = false;
      document.getElementById('bp-stepper').style.opacity = '0';
    } catch (err) {
      btn.disabled = false; btn.textContent = 'Confirm booking';
      errEl.textContent = err.message || 'Something went wrong. Please try again or call (403) 452-4283.';
      errEl.hidden = false;
    }
  }

  function downloadICS() {
    if (!st.date || !st.time) return;
    var svc = SERVICES[st.service];
    var tm = st.time.match(/(\d+):(\d+)\s*(AM|PM)/i);
    var h = parseInt(tm[1]), m = parseInt(tm[2]);
    if (tm[3].toUpperCase() === 'PM' && h < 12) h += 12;
    if (tm[3].toUpperCase() === 'AM' && h === 12) h = 0;
    var d = st.date;
    var dstr = d.getFullYear() + '' + (d.getMonth()+1<10?'0':'') + (d.getMonth()+1) + (d.getDate()<10?'0':'') + d.getDate();
    var ts = (h<10?'0':'') + h + (m<10?'0':'') + m + '00';
    var eh = h + 1;
    var te = (eh<10?'0':'') + eh + (m<10?'0':'') + m + '00';
    var ics = 'BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\nDTSTART;TZID=America/Edmonton:' + dstr + 'T' + ts + '\nDTEND;TZID=America/Edmonton:' + dstr + 'T' + te + '\nSUMMARY:' + (svc ? svc.name : 'Service') + ' at Prince Tires\nLOCATION:111 42 Ave SW, Calgary, AB T2G 0A4\nEND:VEVENT\nEND:VCALENDAR';
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
    a.download = 'prince-tires-service.ics';
    a.click();
  }

  // Wire up
  document.querySelectorAll('.bp-pathway').forEach(function (b) {
    b.addEventListener('click', function () { pickPathway(this.dataset.bpPath); });
  });
  document.querySelectorAll('.bp-mount-card').forEach(function (b) {
    b.addEventListener('click', function () {
      st.service = this.dataset.bpSvc;
      document.querySelectorAll('.bp-mount-card').forEach(function (c) { c.classList.toggle('bp-mount-card--active', c === b); });
      updateNextBtn();
    });
  });
  // Buying-tires search is handled by the embedded pt-tire-search snippet (its own JS).
  document.getElementById('bp-next-1').addEventListener('click', function () { if (!this.disabled) goTo(2); });
  document.querySelectorAll('[data-bp-goto]').forEach(function (b) {
    b.addEventListener('click', function () {
      var s = parseInt(this.dataset.bpGoto);
      if (s) goTo(s);
    });
  });
  document.getElementById('bp-prev-week').addEventListener('click', function () { if (wk > 0) { wk--; renderWeek(); } });
  document.getElementById('bp-next-week').addEventListener('click', function () { wk++; renderWeek(); });
  document.getElementById('bp-confirm-btn').addEventListener('click', submitBooking);
  document.getElementById('bp-cal-btn').addEventListener('click', downloadICS);

  // Deep-link via ?service=installation_off / ?service=balancing / etc.
  try {
    var qs = new URLSearchParams(window.location.search);
    var pre = qs.get('service');
    if (pre && SERVICES[pre]) {
      st.service = pre;
      if (pre === 'installation_off' || pre === 'installation_on') {
        pickPathway('own');
        var card = document.querySelector('.bp-mount-card[data-bp-svc="' + pre + '"]');
        if (card) card.classList.add('bp-mount-card--active');
      } else {
        pickPathway('other');
        renderOtherGrid();
      }
      updateNextBtn();
    }
  } catch (e) {}

  // Saved-vehicle banner — surfaces if customer just came from the tire search
  // and the saved record is recent (24 h). Doesn't auto-fill the vehicle tier
  // (that risks wrong-price quotes); just confirms which tires they're booking
  // install for and pre-fills the vehicle text input on step 4.
  try {
    var savedRaw = localStorage.getItem('pt-tire-search-vehicle');
    if (savedRaw) {
      var saved = JSON.parse(savedRaw);
      var ageMs = Date.now() - new Date(saved.savedAt || 0).getTime();
      var FRESH_MS = 24 * 60 * 60 * 1000;
      if (saved && saved.tireSize && ageMs < FRESH_MS) {
        var label = [saved.year, saved.make, saved.model, saved.trim].filter(Boolean).join(' ');
        document.getElementById('bp-saved-vehicle').textContent = label;
        document.getElementById('bp-saved-size').textContent = saved.tireSize;
        document.getElementById('bp-saved').hidden = false;

        // Pre-fill the contact step's vehicle text input
        var vehicleInput = document.getElementById('bp-vehicle-info');
        if (vehicleInput && !vehicleInput.value) vehicleInput.value = label;

        // CTA → off-rims install, auto-detect tier from saved make/model + tire size,
        // and jump straight to step 3 (date/time). Customer can step back to 2 if the
        // auto-pick was wrong; we surface a "we picked X from your Honda Civic"
        // confirmation strip on step 2 so the override is one tap away.
        document.getElementById('bp-saved-go').addEventListener('click', function () {
          st.service = 'installation_off';
          st.vehicle = detectTier(saved);
          st.qty = 4;
          st.autoPickedFromSaved = true;
          pickPathway('own');
          var card = document.querySelector('.bp-mount-card[data-bp-svc="installation_off"]');
          if (card) card.classList.add('bp-mount-card--active');
          updateNextBtn();
          goTo(3);
        });

        document.getElementById('bp-saved-clear').addEventListener('click', function () {
          try { localStorage.removeItem('pt-tire-search-vehicle'); } catch (e) {}
          document.getElementById('bp-saved').hidden = true;
          if (vehicleInput) vehicleInput.value = '';
        });
      }
    }
  } catch (e) {}

  // ── Stage 2: pull the live service catalog on page load. bpApplyCatalog
  //    overlays the fallback pricing + labels above; silent fallback on
  //    failure. See docs/phase-3.5-service-catalog.md.
  fetch(SERVICES_API)
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (data) { if (data && data.services) bpApplyCatalog(data.services); })
    .catch(function () {});
})();
</script>

