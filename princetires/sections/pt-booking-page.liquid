<script>
(function () {
  // Canonical pricing — keep in sync with snippets/pt-service-booking-modal.liquid
  var BOOKING_API = 'https://app.princetires.ca/api/book';
  var AVAILABILITY_API = 'https://app.princetires.ca/api/availability';
  var SERVICES_API = 'https://app.princetires.ca/api/services';

  // ── Draft autosave ──────────────────────────────────────────────────────
  // Persist the in-progress booking to sessionStorage on every step change +
  // debounced text edits. Cleared on successful booking. TTL 24h so a stale
  // draft from a previous session doesn't hijack a fresh visit. Tab-scoped
  // (sessionStorage) so opening a second tab doesn't inherit a half-finished
  // booking from another tab. Best-practice pattern per Reform's multi-step
  // form guide: single JSON checkpoint on step change, restore last step.
  var BP_DRAFT_KEY = 'pt-booking-draft-v1';
  var BP_DRAFT_TTL_MS = 24 * 60 * 60 * 1000;

  function bpReadContactFields() {
    function v(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }
    return { name: v('bp-name'), phone: v('bp-phone'), email: v('bp-email'),
             vehInfo: v('bp-vehicle-info'), notes: v('bp-notes') };
  }
  function bpWriteContactFields(c) {
    if (!c) return;
    [['bp-name',c.name],['bp-phone',c.phone],['bp-email',c.email],
     ['bp-vehicle-info',c.vehInfo],['bp-notes',c.notes]].forEach(function(p) {
      var el = document.getElementById(p[0]);
      // Only fill blank fields — never clobber whatever the customer just typed
      // (this matters when logged-in prefill or garage-vehicle prefill has
      // already filled a value before restore runs).
      if (el && !el.value && p[1]) el.value = p[1];
    });
  }
  function bpCurrentStep() {
    for (var s = 1; s <= 4; s++) {
      var el = document.getElementById('bp-page-' + s);
      if (el && !el.hidden) return s;
    }
    return 1;
  }
  function bpSaveDraft() {
    try {
      // Skip empty-state saves — a fresh page 1 load with no pathway / no
      // contact input has nothing worth restoring, and writing an empty
      // draft would clobber a legitimate draft that happens to be in
      // sessionStorage (e.g. during a fast back→reload sequence, the
      // beforeunload of the empty state would wipe the good state).
      var c = bpReadContactFields();
      var hasState   = !!(st.pathway || st.service || st.date || st.time);
      var hasContact = !!(c.name || c.phone || c.email || c.vehInfo || c.notes);
      if (!hasState && !hasContact) return;
      var p = {
        v: 1,
        savedAt: Date.now(),
        step: bpCurrentStep(),
        state: {
          pathway: st.pathway, service: st.service, vehicle: st.vehicle,
          qty: st.qty, addons: st.addons,
          date: st.date ? st.date.toISOString() : null,
          time: st.time, locationId: st.locationId
        },
        contact: c
      };
      sessionStorage.setItem(BP_DRAFT_KEY, JSON.stringify(p));
    } catch (e) { /* private mode / quota — silently skip */ }
  }
  function bpClearDraft() {
    try { sessionStorage.removeItem(BP_DRAFT_KEY); } catch (e) {}
  }
  function bpRestoreDraft() {
    var raw;
    try { raw = sessionStorage.getItem(BP_DRAFT_KEY); } catch (e) { return null; }
    if (!raw) return null;
    try {
      var p = JSON.parse(raw);
      if (!p || p.v !== 1) return null;
      if (Date.now() - (p.savedAt || 0) > BP_DRAFT_TTL_MS) { bpClearDraft(); return null; }
      return p;
    } catch (e) { return null; }
  }
  function bpApplyDraft(draft) {
    if (!draft || !draft.state) return 1;
    var s = draft.state;
    if (s.pathway) st.pathway = s.pathway;
    if (s.service) st.service = s.service;
    if (s.vehicle) st.vehicle = s.vehicle;
    if (typeof s.qty === 'number' && s.qty >= 1 && s.qty <= 8) st.qty = s.qty;
    if (s.addons) st.addons = Object.assign({}, st.addons, s.addons);
    if (s.date) { var d = new Date(s.date); if (!isNaN(d.getTime())) st.date = d; }
    if (s.time) st.time = s.time;
    if (s.locationId) st.locationId = s.locationId;
    bpWriteContactFields(draft.contact);
    return Math.max(1, Math.min(4, draft.step || 1));
  }
  // Debounced text-input save so we don't hammer sessionStorage on every keystroke.
  var bpSaveTimer = null;
  function bpSaveDraftDebounced() {
    if (bpSaveTimer) clearTimeout(bpSaveTimer);
    bpSaveTimer = setTimeout(bpSaveDraft, 500);
  }

  // ── Locations (Phase 4 picker) ──────────────────────────────────────────
  // Read the global #pt-locations-data island (rendered site-wide in the
  // layout from pt-nap), keep only the shops that accept online bookings.
  // <2 bookable -> no picker, identical SW-only behaviour. >=2 -> a chooser.
  var LOCATIONS = PTBookingCore.loadLocations().bookable;
  function locById(id) {
    return PTBookingCore.bySlug(LOCATIONS, id) || LOCATIONS[0] || null;
  }
  function defaultLocationId() {
    if (!LOCATIONS.length) return '';
    // is_primary -> first (the ?location deep-link overrides separately below).
    var loc = PTBookingCore.pickLocation(LOCATIONS, null);
    return (loc && loc.slug) || '';
  }

  // ── Logged-in customer prefill ──────────────────────────────────────────
  // Reads the JSON payload Liquid injects above when "customer" is set,
  // then fills name/phone/email and the vehicle text input. Vehicle prefill uses
  // cache-then-refresh: localStorage garage first (instant), then the App
  // Proxy /apps/api/vehicles silently corrects if the server has a newer
  // default. Manual edits are preserved (each field only fills when blank).
  var customerData = (function () {
    var el = document.getElementById('bp-customer-data');
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  })();

  function fillIfEmpty(id, value) {
    if (!value) return;
    var el = document.getElementById(id);
    if (el && !el.value) el.value = value;
  }

  function vehicleLabel(v) {
    return [v.year, v.make, v.model, v.trim].filter(Boolean).join(' ');
  }

  function prefillCustomer() {
    if (!customerData) return;
    fillIfEmpty('bp-name', customerData.name);
    fillIfEmpty('bp-phone', customerData.phone);
    fillIfEmpty('bp-email', customerData.email);
  }

  function prefillVehicleFromCache() {
    if (!customerData || !customerData.customerId) return;
    try {
      var raw = localStorage.getItem('pt-garage-' + customerData.customerId);
      var vehicles = raw ? JSON.parse(raw) : [];
      var def = vehicles.find(function (v) { return v.isDefault; }) || vehicles[0];
      if (def) fillIfEmpty('bp-vehicle-info', vehicleLabel(def));
    } catch (e) {}
  }

  function prefillVehicleFromApi() {
    if (!customerData) return; // not logged in — no App Proxy session anyway
    fetch('/apps/api/vehicles', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data || !Array.isArray(data.vehicles)) return;
        var def = data.vehicles.find(function (v) { return v.isDefault; }) || data.vehicles[0];
        if (!def) return;
        var label = vehicleLabel(def);
        var el = document.getElementById('bp-vehicle-info');
        // Only overwrite if the field is empty OR still matches what we
        // pre-filled from localStorage (so manual edits never get clobbered).
        if (el && (!el.value || el.dataset.bpAutofilled === '1')) {
          el.value = label;
          el.dataset.bpAutofilled = '1';
        }
      })
      .catch(function () {});
  }

  // Mark the field as "autofilled" if we set it from cache so the API
  // refresh can safely overwrite. Any keystroke clears the flag.
  function trackVehicleField() {
    var el = document.getElementById('bp-vehicle-info');
    if (!el) return;
    var initial = el.value;
    if (initial) el.dataset.bpAutofilled = '1';
    el.addEventListener('input', function () { delete el.dataset.bpAutofilled; });
  }

  prefillCustomer();
  prefillVehicleFromCache();
  trackVehicleField();
  prefillVehicleFromApi();
  // ────────────────────────────────────────────────────────────────────────

  // ── Pricing (fallback) ──────────────────────────────────────────────────
  // bpApplyCatalog() overlays these with live values from GET /api/services
  // (editable in the admin app). Modes: per_unit_by_vehicle | flat_by_vehicle
  // | per_unit_flat. See docs/phase-3.5-service-catalog.md.
  var bpPricing = {
    installation_off: { mode: 'per_unit_by_vehicle', unit: 'tire',
      byVehicle: { passenger: 25, suv: 30, van: 30, electric: 30, truck: 35, largetruck: 40, dually: 45, trailer: 30 },
      lowProfileFloor: 40, flatOverride: { trailer: 120 } },
    installation_on: { mode: 'flat_by_vehicle', unit: 'car',
      byVehicle: { passenger: 60, suv: 60, van: 60, electric: 60, truck: 80, largetruck: 80, dually: 90, trailer: 120 } },
    balancing: { mode: 'per_unit_flat', unit: 'wheel', amount: 20 },
    road_force_balancing: { mode: 'per_unit_flat', unit: 'wheel', amount: 35 },
    rotation: { mode: 'flat_by_vehicle', unit: 'car',
      byVehicle: { passenger: 60, suv: 60, van: 60, electric: 60, truck: 60, largetruck: 100, dually: 100, trailer: 60 } },
    flat_repair: { mode: 'per_unit_flat', unit: 'tire', amount: 50 },
    tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 75 },
    addon_tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 75 },
    addon_disposal: { mode: 'per_unit_flat', unit: 'tire', amount: 5 },
    addon_road_force: { mode: 'per_unit_flat', unit: 'tire', amount: 15 }
  };

  var SERVICES = {
    installation_off:     { name: 'Tire Installation (off rims)' },
    installation_on:      { name: 'Seasonal Swap (on rims)' },
    balancing:            { name: 'Wheel Balancing' },
    road_force_balancing: { name: 'Road Force Balancing' },
    rotation:             { name: 'Tire Rotation' },
    flat_repair:          { name: 'Flat Repair' },
    tpms:                 { name: 'TPMS Service' }
  };
  var OTHER_SERVICES = [
    { id: 'rotation',             name: 'Tire Rotation',        priceLabel: 'from $60 / car' },
    { id: 'balancing',            name: 'Wheel Balancing',      priceLabel: '$20 / wheel' },
    { id: 'road_force_balancing', name: 'Road Force Balancing', priceLabel: '$35 / wheel' },
    { id: 'flat_repair',          name: 'Flat Repair',          priceLabel: '$50 / tire (patch)' },
    { id: 'tpms',                 name: 'TPMS Service',         priceLabel: '$75 / sensor' }
  ];
  // Which shops offer a catalog row ([] = every shop). The road force balancer
  // is at Edmonton Trail NE; bpApplyCatalog() overlays this from /api/services
  // (`locations`), so the fallback only has to be right until the catalog lands.
  var SERVICE_SHOPS = {
    road_force_balancing: ['ne'],
    addon_road_force: ['ne']
  };
  // Catalog add-ons this page can offer beyond TPMS / disposal, by slug. Only
  // filled from /api/services: an add-on the server does not know is dropped
  // from the booking, so it is never offered from a fallback.
  var ADDON_CATALOG = {};
  // The checkbox ids st.addons uses for catalog add-ons, by slug.
  var ADDON_KEYS = { addon_road_force: 'roadForce' };
  var VEHICLES = [
    { id: 'passenger', name: 'Sedan' },
    { id: 'suv', name: 'SUV / CUV' },
    { id: 'van', name: 'Van' },
    { id: 'electric', name: 'Electric' },
    { id: 'truck', name: 'Truck' },
    { id: 'dually', name: 'Dually' },
    { id: 'largetruck', name: 'Large / Cube / 21"+' },
    { id: 'trailer', name: 'Trailer' }
  ];

  var st = {
    pathway: '',
    service: '',
    vehicle: 'passenger',
    qty: 4,
    addons: { tpms: false, disposal: false, lowProfile: false, roadForce: false },
    date: null,
    time: null,
    locationId: defaultLocationId()
  };
  var wk = 0;

  function fmtMoney(n) { return '$' + (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2)); }

  // Best-guess vehicle tier from a saved tire-search record.
  // Returns one of the canonical tier ids (passenger/suv/van/electric/truck/dually/largetruck/trailer).
  // Customer can always override on step 2 if the guess is wrong.
  function detectTier(saved) {
    if (!saved) return 'passenger';
    var mk = (saved.make || '').toLowerCase();
    var md = (saved.model || '').toLowerCase();
    var trim = (saved.trim || '').toLowerCase();
    var size = (saved.tireSize || '').toUpperCase();
    var modelTrim = (md + ' ' + trim).trim();

    // EV makes / models (highest priority — Tesla Model Y is "SUV" form factor but priced at electric tier)
    var evMakes = ['tesla', 'rivian', 'lucid', 'polestar'];
    var evModels = ['bolt', 'leaf', 'ioniq', 'mustang mach', 'mach-e', 'id.4', 'id.3', 'taycan', 'e-tron', 'lightning', 'lyriq', 'eqs', 'eqe', 'i4', 'ix'];
    if (evMakes.indexOf(mk) > -1) return 'electric';
    for (var i = 0; i < evModels.length; i++) { if (modelTrim.indexOf(evModels[i]) > -1) return 'electric'; }

    // Dually & heavy-duty trucks (F-350, Ram 3500, etc.)
    if (/\b(dually|3500|f-?350|sierra 3500)\b/.test(modelTrim)) return 'dually';

    // Cube vans + big trucks (F-250, Ram 2500, Sprinter cube, ProMaster cargo)
    if (/\b(2500|f-?250|sierra 2500|sprinter|promaster|cube|cab.{0,3}chassis)\b/.test(modelTrim)) return 'largetruck';

    // Trailer
    if (/\btrailer\b/.test(modelTrim) || size.indexOf('ST') === 0) return 'trailer';

    // Half-ton & midsize pickups
    var truckRx = /\b(f-?150|1500|sierra 1500|silverado 1500|ram 1500|tundra|tacoma|titan|frontier|colorado|canyon|ridgeline|ranger|maverick|gladiator|pickup|truck)\b/;
    if (truckRx.test(modelTrim)) return 'truck';

    // Vans / minivans (passenger vans like Sienna/Odyssey — different from Sprinter)
    var vanRx = /\b(sienna|odyssey|pacifica|carnival|quest|caravan|town.country|transit connect)\b/;
    if (vanRx.test(modelTrim)) return 'van';

    // SUVs / CUVs
    var suvRx = /\b(suv|explorer|tahoe|yukon|suburban|highlander|4runner|pathfinder|pilot|rav4|cr-?v|rogue|murano|escape|edge|bronco|equinox|traverse|blazer|wrangler|cherokee|grand cherokee|durango|tucson|santa fe|palisade|sportage|sorento|telluride|forester|outback|crosstrek|ascent|armada|expedition|sequoia|mdx|rdx|qx|gx|lx|rx|nx|gle|glc|gls|x3|x5|x7|q5|q7|q8)\b/;
    if (suvRx.test(modelTrim)) return 'suv';

    // Tire-size hints (low-profile sport cars often need largetruck pricing)
    var rimM = size.match(/R(\d+)/);
    if (rimM && parseInt(rimM[1]) >= 21) return 'largetruck';

    // Default: sedan/coupe/hatch
    return 'passenger';
  }

  // Generic, catalog-driven price calc. Reads bpPricing (overlaid by
  // bpApplyCatalog from GET /api/services). Verified to produce the same
  // numbers as the prior hardcoded per-service logic.
  function calcPrice() {
    var s = st.service, v = st.vehicle, q = st.qty;
    var p = bpPricing[s];
    if (!p) return null;
    var subtotal = 0, parts = [];
    var unit = p.unit || 'unit';

    if (p.mode === 'per_unit_by_vehicle') {
      if (p.flatOverride && p.flatOverride[v] != null) {
        subtotal = p.flatOverride[v];
        parts.push('flat $' + subtotal + ' (' + v + ')');
      } else {
        var base = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 30;
        var per = (st.addons.lowProfile && p.lowProfileFloor)
          ? Math.max(base, p.lowProfileFloor) : base;
        subtotal = per * q;
        parts.push('$' + per + '/' + unit + ' × ' + q);
        if (st.addons.lowProfile && per > base) parts.push('low-profile');
      }
    } else if (p.mode === 'flat_by_vehicle') {
      subtotal = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 0;
      parts.push('flat $' + subtotal + ' per ' + unit);
    } else if (p.mode === 'per_unit_flat') {
      subtotal = (p.amount || 0) * q;
      parts.push('$' + (p.amount || 0) + '/' + unit + ' × ' + q);
    } else { return null; }

    if (s === 'installation_off' || s === 'installation_on') {
      if (st.addons.tpms && bpPricing.addon_tpms) {
        subtotal += (bpPricing.addon_tpms.amount || 0) * q;
        parts.push('TPMS ×' + q);
      }
    }
    if (s === 'installation_off') {
      if (st.addons.disposal && bpPricing.addon_disposal) {
        subtotal += (bpPricing.addon_disposal.amount || 0) * q;
        parts.push('disposal');
      }
    }
    // Road force upgrade on any job (per tire, from the catalog).
    if (s !== 'road_force_balancing' && st.addons.roadForce && ADDON_CATALOG.addon_road_force) {
      subtotal += (ADDON_CATALOG.addon_road_force.amount || 0) * q;
      parts.push('road force ×' + q);
    }

    var gst = subtotal * 0.05;
    return {
      subtotal: fmtMoney(subtotal),
      gst: fmtMoney(gst),
      amount: fmtMoney(subtotal + gst),
      note: parts.join(' + ') + ' · est. before confirming',
      raw: { subtotal: subtotal, gst: gst, total: subtotal + gst }
    };
  }

  // ── Stage 2: derive a chip price label from a catalog service ─────────────
  function bpPriceLabel(svc) {
    var pr = svc.prices || {};
    var u = svc.unit || 'unit';
    if (svc.pricingMode === 'per_unit_flat') {
      return '$' + (pr.amount != null ? pr.amount : '?') + ' / ' + u;
    }
    var vals = [];
    if (pr.byVehicle) {
      Object.keys(pr.byVehicle).forEach(function (k) {
        var n = pr.byVehicle[k];
        if (typeof n === 'number') vals.push(n);
      });
    }
    if (!vals.length) return '';
    return 'from $' + Math.min.apply(null, vals) + ' / ' + u;
  }

  // ── Stage 2: overlay the live catalog from GET /api/services ──────────────
  // Replaces fallback pricing + labels with admin-managed values. Defensive:
  // empty/bad data leaves the hardcoded fallback in place.
  function bpApplyCatalog(services) {
    if (!Array.isArray(services) || !services.length) return;
    var others = [];
    services.forEach(function (svc) {
      if (!svc || !svc.slug) return;
      var pr = svc.prices || {};
      bpPricing[svc.slug] = {
        mode: svc.pricingMode,
        unit: svc.unit,
        byVehicle: pr.byVehicle || null,
        amount: pr.amount,
        lowProfileFloor: pr.lowProfileFloor,
        flatOverride: pr.flatOverride || null
      };
      // Which shops offer it — the live answer replaces the fallback entry.
      SERVICE_SHOPS[svc.slug] = PTBookingCore.serviceShops(svc);
      if (svc.kind === 'service') {
        SERVICES[svc.slug] = { name: svc.name };
        // installation_on/off are the "own tires" pathway; everything else
        // (including newly-added services) is an "other service" tile.
        if (svc.slug !== 'installation_off' && svc.slug !== 'installation_on') {
          others.push({ id: svc.slug, name: svc.name, priceLabel: bpPriceLabel(svc) });
        }
      } else if (svc.kind === 'addon' && ADDON_KEYS[svc.slug] && typeof pr.amount === 'number') {
        ADDON_CATALOG[svc.slug] = { name: svc.name, amount: pr.amount, unit: svc.unit || 'tire' };
      }
    });
    // Rebuild the other-service list from the catalog so services added or
    // removed in the admin flow through to this page.
    if (others.length) OTHER_SERVICES = others;
    // The shop list may have just become restricted (or unrestricted).
    bpSyncLocation();
    // Refresh the static mount-price labels (installation_on / installation_off).
    var mountLabel = function (slug) {
      var el = document.querySelector('.bp-mount-card[data-bp-svc="' + slug + '"] .bp-mount-price');
      if (!el) return;
      var p = bpPricing[slug];
      var vals = (p && p.byVehicle)
        ? Object.keys(p.byVehicle).map(function (k) { return p.byVehicle[k]; }).filter(function (n) { return typeof n === 'number'; })
        : [];
      if (vals.length) el.innerHTML = 'From <strong>$' + Math.min.apply(null, vals) + ' / ' + (p.unit || 'car') + '</strong>';
    };
    mountLabel('installation_on');
    mountLabel('installation_off');
    // Repaint anything already on screen.
    var og = document.getElementById('bp-other-grid');
    if (og && og.children.length) renderOtherGrid();
    // The vehicle step decides whether the add-ons section shows at all (the
    // road force row exists only once the catalog has landed), so repaint the
    // whole step if the customer is already on it.
    var step2 = document.getElementById('bp-page-2');
    if (step2 && !step2.hidden) renderVehicles();
    if (st.service) updatePrice();
  }

  // ── Services offered at some shops only ───────────────────────────────────
  // The chosen service and every ticked catalog add-on each carry a shop list
  // (SERVICE_SHOPS, from /api/services). The picker offers only the shops that
  // satisfy all of them, and says why under the cards. Mirrors the server:
  // /api/book refuses a shop that is not in the list, so this is the courtesy.
  function bpRestrictions() {
    var lists = [];
    var named = [];
    if (st.service && SERVICE_SHOPS[st.service] && SERVICE_SHOPS[st.service].length) {
      lists.push(SERVICE_SHOPS[st.service]);
      named.push({ name: (SERVICES[st.service] || {}).name || 'This service', shops: SERVICE_SHOPS[st.service] });
    }
    Object.keys(ADDON_KEYS).forEach(function (slug) {
      var key = ADDON_KEYS[slug];
      if (st.addons[key] && ADDON_CATALOG[slug] && SERVICE_SHOPS[slug] && SERVICE_SHOPS[slug].length) {
        lists.push(SERVICE_SHOPS[slug]);
        named.push({ name: ADDON_CATALOG[slug].name, shops: SERVICE_SHOPS[slug] });
      }
    });
    return { lists: lists, named: named };
  }
  function bpAllowedLocations() {
    return PTBookingCore.allowedLocations(LOCATIONS, bpRestrictions().lists);
  }
  // Move the selection onto an allowed shop (and drop a picked time, since
  // availability is per shop), then repaint the picker.
  function bpSyncLocation() {
    var allowed = bpAllowedLocations();
    if (allowed.length && !PTBookingCore.bySlug(allowed, st.locationId)) {
      st.locationId = allowed[0].slug;
      st.time = null;
      var n3 = document.getElementById('bp-next-3');
      if (n3) n3.disabled = true;
      var timeStep = document.getElementById('bp-page-3');
      if (timeStep && !timeStep.hidden) renderTimes();
    }
    renderLocations();
  }
  // Badge text for a restricted service chip / add-on row, e.g. "Edmonton Trail NE only".
  function bpOnlyAt(slug) {
    var shops = SERVICE_SHOPS[slug];
    if (!shops || !shops.length) return '';
    return PTBookingCore.onlyAtLabel(shops, PTBookingCore.loadLocations().all);
  }

  // ── Location picker render + wiring ───────────────────────────────────────
  // Builds the chooser only when 2+ shops are bookable. With <2 it stays
  // hidden and st.locationId is simply the single bookable shop's slug (or '').
  function pickLocation(id) {
    if (!id || id === st.locationId) return;
    st.locationId = id;
    renderLocations();
    // Availability is location-specific — invalidate the picked slot and
    // re-query if the customer is already on (or past) the time step.
    st.time = null;
    var n3 = document.getElementById('bp-next-3');
    if (n3) n3.disabled = true;
    var timeStep = document.getElementById('bp-page-3');
    if (timeStep && !timeStep.hidden) renderTimes();
  }

  // "Prince Tires — Edmonton Trail NE" -> "Edmonton Trail NE", for copy that
  // already says Prince Tires.
  function shortShopName(l) {
    var n = l.public_name || l.name || 'Prince Tires';
    return n.replace(/^Prince Tires\s*[—–-]\s*/i, '');
  }

  // "Also open" line under the picker. Shown only while the PRIMARY shop is
  // selected and another shop is bookable: a customer who lands on the default
  // shop and finds it busy should learn there is a second one before giving up,
  // and a customer who already chose the other shop needs no nudge back. Name
  // and address come from the island, so a third shop needs no edit here.
  function renderLocNudge() {
    var el = document.getElementById('bp-loc-nudge');
    if (!el) return;
    var cur = LOCATIONS.find(function (l) { return l.slug === st.locationId; });
    var other = LOCATIONS.find(function (l) { return l.slug !== st.locationId; });
    if (!cur || !cur.is_primary || !other) { el.hidden = true; el.innerHTML = ''; return; }
    var name = shortShopName(other);
    var addr = other.address || other.address_full || '';
    el.innerHTML = 'Also open for bookings: <strong>' + name + '</strong>' + (addr ? ', ' + addr : '') + '.' +
      ' <button type="button" class="bp-loc-nudge__btn" data-bp-loc-switch="' + other.slug + '">' +
      'Check out our ' + name + ' location →</button>';
    el.hidden = false;
    var btn = el.querySelector('[data-bp-loc-switch]');
    if (btn) btn.addEventListener('click', function () { pickLocation(this.dataset.bpLocSwitch); });
  }

  // A restricted service narrows the cards to the shops that offer it and
  // explains why underneath; with one bookable shop that cannot do the job the
  // note alone is shown, so the customer learns where to go.
  function renderLocations() {
    var wrap = document.getElementById('bp-loc');
    var grid = document.getElementById('bp-loc-grid');
    var note = document.getElementById('bp-loc-note');
    if (!wrap || !grid) return;
    var r = bpRestrictions();
    var allowed = PTBookingCore.allowedLocations(LOCATIONS, r.lists);
    var all = PTBookingCore.loadLocations().all;
    var noteHtml = '';
    if (r.named.length) {
      noteHtml = r.named.map(function (n) {
        var label = PTBookingCore.onlyAtLabel(n.shops, all).replace(/ only$/, '');
        return '<strong>' + n.name + '</strong> is only available at our ' + label + ' shop.';
      }).join(' ');
      if (!allowed.length) {
        var only = PTBookingCore.bySlug(all, r.named[0].shops[0]);
        noteHtml += only && only.phone ? ' Call ' + only.phone + ' to book it.' : '';
      }
    }
    if (note) { note.innerHTML = noteHtml; note.hidden = !noteHtml; }
    if (LOCATIONS.length < 2 && !noteHtml) { wrap.hidden = true; return; }
    wrap.hidden = false;
    grid.innerHTML = allowed.map(function (l) {
      var active = st.locationId === l.slug ? ' bp-loc-card--active' : '';
      var name = l.public_name || l.name || 'Prince Tires';
      var addr = l.address || l.address_full || '';
      return '<button type="button" class="bp-loc-card' + active + '" data-bp-loc="' + l.slug + '">' +
        '<span class="bp-loc-card__name">' + name + '</span>' +
        '<span class="bp-loc-card__addr">' + addr + '</span>' +
        '</button>';
    }).join('');
    grid.querySelectorAll('.bp-loc-card').forEach(function (el) {
      el.addEventListener('click', function () { pickLocation(this.dataset.bpLoc); });
    });
    // No "also open" nudge while a service has pinned the shop — the other
    // shop cannot take this booking.
    if (r.lists.length) {
      var nudge = document.getElementById('bp-loc-nudge');
      if (nudge) { nudge.hidden = true; nudge.innerHTML = ''; }
    } else {
      renderLocNudge();
    }
  }

  function goTo(step) {
    [1,2,3,4].forEach(function (s) {
      var el = document.getElementById('bp-page-' + s);
      if (el) el.hidden = s !== step;
    });
    document.getElementById('bp-page-done').hidden = true;
    [1,2,3,4].forEach(function (s) {
      var ci = document.querySelector('[data-bp-step="' + s + '"] .bk-step-circle');
      if (!ci) return;
      ci.className = 'bk-step-circle';
      if (s < step) { ci.classList.add('bk-step-circle--done'); ci.innerHTML = '✓'; }
      else if (s === step) { ci.classList.add('bk-step-circle--active'); ci.textContent = s; }
      else { ci.textContent = s; }
    });
    if (step === 2) { renderVehicles(); renderAutoPickHint(); }
    if (step === 3) { if (!st.date) { st.date = bpEarliestDate(); wk = bpWeekOffset(st.date); } renderWeek(); renderTimes(); }
    if (step === 4) renderSummary();
    try { window.scrollTo({ top: document.querySelector('.pt-bp__card').offsetTop - 20, behavior: 'smooth' }); } catch (e) {}
    // Autosave checkpoint — every step change is the canonical "commit" point
    // for the draft (per Reform's multi-step form guide).
    bpSaveDraft();
  }

  function pickPathway(path) {
    st.pathway = path;
    document.querySelectorAll('.bp-pathway').forEach(function (b) {
      b.classList.toggle('bp-pathway--active', b.dataset.bpPath === path);
    });
    document.getElementById('bp-buy').hidden = path !== 'buy';
    document.getElementById('bp-own').hidden = path !== 'own';
    document.getElementById('bp-other').hidden = path !== 'other';
    if (path === 'other') renderOtherGrid();
    st.service = '';
    document.querySelectorAll('.bp-mount-card').forEach(function (c) { c.classList.remove('bp-mount-card--active'); });
    updateNextBtn();
    bpSyncLocation();
  }

  function renderOtherGrid() {
    var grid = document.getElementById('bp-other-grid');
    grid.innerHTML = OTHER_SERVICES.map(function (s) {
      var active = st.service === s.id ? ' bp-other-chip--active' : '';
      var only = bpOnlyAt(s.id);
      return '<button type="button" class="bp-other-chip' + active + '" data-bp-svc="' + s.id + '">' +
        '<span class="bp-other-chip__name">' + s.name + '</span>' +
        '<span class="bp-other-chip__price">' + s.priceLabel + '</span>' +
        (only ? '<span class="bp-other-chip__badge">' + only + '</span>' : '') +
        '</button>';
    }).join('');
    grid.querySelectorAll('.bp-other-chip').forEach(function (el) {
      el.addEventListener('click', function () {
        st.service = this.dataset.bpSvc;
        renderOtherGrid();
        updateNextBtn();
        bpSyncLocation();
      });
    });
  }

  function updateNextBtn() {
    var btn = document.getElementById('bp-next-1');
    if (!btn) return;
    if (st.pathway === 'buy') { btn.hidden = true; return; }
    btn.hidden = false;
    btn.disabled = !st.service;
  }

  function renderVehicles() {
    var grid = document.getElementById('bp-vehicles');
    var noTrailer = ['balancing', 'road_force_balancing', 'rotation'];
    var vehs = noTrailer.indexOf(st.service) > -1 ? VEHICLES.filter(function (v) { return v.id !== 'trailer'; }) : VEHICLES;
    grid.innerHTML = vehs.map(function (v) {
      var active = st.vehicle === v.id ? ' bk-vehicle-card--active' : '';
      return '<button type="button" class="bk-vehicle-card' + active + '" data-veh="' + v.id + '">' + v.name + '</button>';
    }).join('');
    grid.querySelectorAll('.bk-vehicle-card').forEach(function (el) {
      el.addEventListener('click', function () {
        st.vehicle = this.dataset.veh;
        // Manual pick overrides the auto-detection — clear the hint so we don't lie to the customer
        st.autoPickedFromSaved = false;
        renderAutoPickHint();
        renderVehicles();
        updatePrice();
        document.getElementById('bp-next-2').disabled = false;
      });
    });

    var noQty = (st.service === 'installation_on' || st.service === 'rotation');
    document.getElementById('bp-qty-section').hidden = noQty;
    if (!noQty) renderQty();

    // TPMS / disposal / low-profile ride on the two installs; the road force
    // upgrade is offered on every job (owner's call, 2026-10-22).
    var hasAddons = (st.service === 'installation_off' || st.service === 'installation_on') || bpRoadForceOffered();
    document.getElementById('bp-addons-section').hidden = !hasAddons;
    if (hasAddons) renderAddons();

    updatePrice();
    document.getElementById('bp-next-2').disabled = false;
  }

  function renderAutoPickHint() {
    var el = document.getElementById('bp-auto-pick');
    if (!el) return;
    if (!st.autoPickedFromSaved) { el.hidden = true; return; }
    var v = VEHICLES.find(function (x) { return x.id === st.vehicle; });
    var savedRaw = (function () { try { return localStorage.getItem('pt-tire-search-vehicle'); } catch (e) { return null; } })();
    var saved = savedRaw ? JSON.parse(savedRaw) : null;
    if (!saved || !v) { el.hidden = true; return; }
    var label = [saved.year, saved.make, saved.model, saved.trim].filter(Boolean).join(' ');
    document.getElementById('bp-auto-tier').textContent = v.name;
    document.getElementById('bp-auto-vehicle').textContent = label || 'your saved vehicle';
    el.hidden = false;
  }

  function renderQty() {
    var sel = document.getElementById('bp-qty-select');
    var lbl = document.getElementById('bp-qty-label');
    if (!sel) return;
    var s = st.service;
    var isTpms = s === 'tpms';
    var isBalancing = s === 'balancing' || s === 'road_force_balancing';
    var isRepair = s === 'flat_repair';
    var max = (isTpms || isBalancing || isRepair) ? 4 : 8;
    lbl.textContent = isTpms ? 'How many sensors?'
                    : isBalancing ? 'How many wheels?'
                    : isRepair ? 'How many tires to patch?'
                    : 'How many tires?';
    if (sel.dataset.max !== String(max)) {
      sel.dataset.max = String(max);
      var unit = isTpms ? ' sensor' : isBalancing ? ' wheel' : ' tire';
      var html = '';
      for (var i = 1; i <= max; i++) {
        html += '<option value="' + i + '"' + (i === st.qty ? ' selected' : '') + '>' + i + unit + (i > 1 ? 's' : '') + '</option>';
      }
      sel.innerHTML = html;
    }
    sel.value = String(Math.min(st.qty, max));
    if (!sel._wired) {
      sel._wired = true;
      sel.addEventListener('change', function () { st.qty = parseInt(this.value); updatePrice(); });
    }
  }

  function renderAddons() {
    var container = document.getElementById('bp-addons');
    var rows = [];
    var isOff = st.service === 'installation_off';
    var isOn  = st.service === 'installation_on';
    if (isOff || isOn) rows.push({ id: 'tpms', name: 'New TPMS sensors', priceLabel: '+$' + ((bpPricing.addon_tpms && bpPricing.addon_tpms.amount) || 75) + '/sensor' });
    if (isOff) {
      rows.push({ id: 'disposal', name: 'Tire disposal', priceLabel: '+$' + ((bpPricing.addon_disposal && bpPricing.addon_disposal.amount) || 5) + '/tire' });
      rows.push({ id: 'lowProfile', name: 'Low-profile or run-flat tires', priceLabel: '$' + ((bpPricing.installation_off && bpPricing.installation_off.lowProfileFloor) || 40) + '/tire min' });
    }
    // Road force upgrade on any job (except road force itself) — from the
    // catalog, and only when a bookable shop offers it.
    if (bpRoadForceOffered()) {
      var rf = ADDON_CATALOG.addon_road_force;
      rows.push({ id: 'roadForce', name: rf.name, priceLabel: '+$' + rf.amount + '/' + rf.unit, note: bpOnlyAt('addon_road_force') });
    } else {
      st.addons.roadForce = false;
    }
    container.innerHTML = rows.map(function (a) {
      var active = st.addons[a.id] ? ' bk-addon--active' : '';
      var checked = st.addons[a.id] ? ' checked' : '';
      return '<label class="bk-addon' + active + '">' +
        '<input type="checkbox" data-bp-addon="' + a.id + '"' + checked + '>' +
        '<span class="bk-addon-name">' + a.name + '</span>' +
        '<span class="bk-addon-price">' + a.priceLabel + '</span>' +
        (a.note ? '<span class="bk-addon-note">' + a.note + '</span>' : '') +
        '</label>';
    }).join('');
    container.querySelectorAll('input[data-bp-addon]').forEach(function (el) {
      el.addEventListener('change', function () {
        st.addons[this.dataset.bpAddon] = this.checked;
        this.closest('.bk-addon').classList.toggle('bk-addon--active', this.checked);
        updatePrice();
        // A ticked road force upgrade narrows the shop to Edmonton Trail.
        if (this.dataset.bpAddon === 'roadForce') bpSyncLocation();
      });
    });
  }

  function updatePrice() {
    var box = document.getElementById('bp-price-box');
    var pr = calcPrice();
    if (!pr) { box.hidden = true; return; }
    box.hidden = false;
    document.getElementById('bp-price-sub').textContent = pr.subtotal;
    document.getElementById('bp-price-gst').textContent = pr.gst;
    document.getElementById('bp-price-amount').textContent = pr.amount;
    document.getElementById('bp-price-note').textContent = pr.note;
  }

  function slotMins(slot) {
    var m = slot.match(/(\d+):(\d+)\s*(AM|PM)/i);
    if (!m) return 0;
    var h = parseInt(m[1]), mn = parseInt(m[2]);
    if (m[3].toUpperCase() === 'PM' && h !== 12) h += 12;
    if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
    return h * 60 + mn;
  }
  // The inverse, in exactly the label shape the availability API uses ("9:00 AM",
  // "12:30 PM"), so a built label always matches a returned one.
  function minsToSlot(mins) {
    var h = Math.floor(mins / 60), m = mins % 60;
    var hr = h > 12 ? h - 12 : h;
    return hr + ':' + (m < 10 ? '0' : '') + m + ' ' + (h >= 12 ? 'PM' : 'AM');
  }

  function renderWeek() {
    var today = new Date(); today.setHours(0,0,0,0);
    var start = new Date(today);
    start.setDate(start.getDate() - start.getDay() + 1 + wk * 7);
    var dn = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    var mn = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var end = new Date(start); end.setDate(end.getDate() + 6);
    document.getElementById('bp-week-label').textContent = start.getDate() + ' ' + mn[start.getMonth()] + ' – ' + end.getDate() + ' ' + mn[end.getMonth()];
    document.getElementById('bp-prev-week').disabled = wk <= 0;

    var html = '';
    for (var i = 0; i < 7; i++) {
      var d = new Date(start); d.setDate(d.getDate() + i);
      var isPast = d < today;
      var isToday = d.getTime() === today.getTime();
      var isActive = st.date && d.toDateString() === st.date.toDateString();
      var cls = 'bk-day-card' + (isPast ? ' bk-day-card--past' : '') + (isToday ? ' bk-day-card--today' : '') + (isActive ? ' bk-day-card--active' : '');
      var iso = PTBookingCore.localISO(d);
      html += '<button type="button" class="' + cls + '" data-date="' + iso + '"><span class="bk-day-name">' + dn[i] + '</span><span class="bk-day-num">' + d.getDate() + '</span></button>';
    }
    document.getElementById('bp-day-strip').innerHTML = html;
    document.querySelectorAll('#bp-day-strip .bk-day-card:not(.bk-day-card--past)').forEach(function (el) {
      el.addEventListener('click', function () {
        st.date = new Date(this.dataset.date + 'T12:00:00');
        st.time = null;
        document.getElementById('bp-next-3').disabled = true;
        renderWeek();
        renderTimes();
      });
    });
  }

  {%- comment -%}
    This Liquid block must stay ABOVE the JS comment block below, and no
    left-trimming tag may sit directly after a double-slash JS comment: such a
    tag eats the newline that ends the comment, so the next line of JavaScript
    gets swallowed into it. That is exactly what once commented out the function
    declaration below and took the entire booking script down with a
    SyntaxError, which killed every booking. The block ends in plain JS ("};"),
    never in a trimming tag.

    Hours PER SHOP. Every surface used to read SW's hours for every shop, so a
    customer who picked Edmonton Trail NE was shown SW's window: NE closes at
    6 PM Mon–Thu and Sat (SW at 5) and at 4 PM Sundays (SW at 2), so NE's late
    slots never existed online — which is precisely when a same-day booking is
    still legal there. The Friday split (closed 1:00–2:30, final close 5:00 at
    both shops) was ignored everywhere. The island cannot carry hours, so they
    are rendered here from the same store_hours metaobject pt-nap reads. A third
    shop is one slug added to _bp_slugs.
  {%- endcomment -%}
  {%- assign _bp_slugs = 'sw,ne' | split: ',' -%}
  {%- assign _bp_fields = 'hours_mon_sat_open,hours_mon_sat_close,hours_sun_open,hours_sun_close,hours_fri_open,hours_fri_close,hours_fri_reopen,hours_fri_final_close,booking_cutoff_minutes' | split: ',' -%}
  var BP_HOURS = {
  {%- for _s in _bp_slugs %}
    {{ _s | json }}: {
    {%- for _f in _bp_fields -%}
      {%- capture _v %}{% render 'pt-nap', location: _s, field: _f %}{% endcapture %}
      {{ _f | json }}: {{ _v | strip | json }},
    {%- endfor %}
    },
  {%- endfor %}
  };
  // ── Helper: first day a service booking can actually start ──────────────
  // Services need 2 hr lead (mirrors renderTimes() below). Once the day's last
  // slot is inside that window there is nothing left today, so opening the
  // calendar on today just shows a wall of greyed slots. Hours come from the
  // same store_hours metaobject renderTimes() reads.
  // The appointment window for a given day AT THE SELECTED SHOP, in minutes
  // from midnight: first slot, last slot (close − cutoff) and, on Fridays, the
  // lunch gap during which the shop is closed. Falls back to SW's hours for an
  // unknown slug and to the known SW window if the metaobject is unreadable.
  function bpHoursFor(d) {
    var H = BP_HOURS[st.locationId] || BP_HOURS.sw || {};
    var toMin = function (s) {
      var p = String(s || '').split(':');
      var v = parseInt(p[0], 10) * 60 + (parseInt(p[1], 10) || 0);
      return isNaN(v) ? null : v;
    };
    var dow = d.getDay(), open, close, gap = null;
    if (dow === 0) { open = toMin(H.hours_sun_open); close = toMin(H.hours_sun_close); }
    else if (dow === 5 && toMin(H.hours_fri_final_close) !== null) {
      open = toMin(H.hours_fri_open); close = toMin(H.hours_fri_final_close);
      var gc = toMin(H.hours_fri_close), gr = toMin(H.hours_fri_reopen);
      if (gc !== null && gr !== null && gr > gc) gap = [gc, gr];
    }
    else { open = toMin(H.hours_mon_sat_open); close = toMin(H.hours_mon_sat_close); }
    if (open === null) open = dow === 0 ? 600 : 540;
    if (close === null) close = dow === 0 ? 840 : 1020;
    var cut = parseInt(H.booking_cutoff_minutes, 10) || 30;
    return { open: open, last: close - cut, gap: gap };
  }
  function bpLastSlotMins(d) { return bpHoursFor(d).last; }
  function bpEarliestDate() {
    var now = new Date();
    var d = new Date(now); d.setHours(0, 0, 0, 0);
    var nowMins = now.getHours() * 60 + now.getMinutes();
    if (nowMins + 120 > bpLastSlotMins(d)) d.setDate(d.getDate() + 1);
    return d;
  }
  function bpWeekOffset(d) {
    function monday(x) {
      var m = new Date(x); m.setHours(0, 0, 0, 0);
      m.setDate(m.getDate() - m.getDay() + 1);
      return m;
    }
    var t = new Date(); t.setHours(0, 0, 0, 0);
    return Math.round((monday(d).getTime() - monday(t).getTime()) / 604800000);
  }

  // Monotonic render counter. Each day or shop click starts a new render; the
  // availability response for an EARLIER click can arrive after a later one and
  // must not paint over it. Without this, a slow answer for Saturday could land
  // under Friday's label: a grid that "shows availability" that is not real.
  var bpAvailSeq = 0;
  var bpMsg = function (text, tone) {
    var color = tone === 'warn' ? '#b91c1c' : '#4b5563';
    return '<p style="color:' + color + ';font-size:0.95rem;line-height:1.5;grid-column:1/-1;text-align:center;padding:0.5rem 0.25rem">' + text + '</p>';
  };

  async function renderTimes() {
    var grid = document.getElementById('bp-time-grid');
    if (!st.date) { grid.innerHTML = bpMsg('Pick a day above.'); return; }
    // Snapshot what THIS render is for. Everything below reads these, never
    // st.* again, so a response can only ever paint the day and shop it was
    // asked about.
    var date = st.date, loc = st.locationId, seq = ++bpAvailSeq;
    var H = bpHoursFor(date);
    var slots = [];
    for (var mins = H.open; mins <= H.last; mins += 30) slots.push(minsToSlot(mins));
    grid.innerHTML = bpMsg('Checking availability...');

    var avail = await PTBookingCore.fetchAvailability(AVAILABILITY_API, PTBookingCore.localISO(date), loc);
    if (seq !== bpAvailSeq) return; // a newer click owns the grid now
    // The platform refused or could not be reached. Say so, with the number
    // of the shop they picked — never an open grid that fails at the end.
    if (avail.unavailable) {
      var downShop = locById(loc);
      var downPhone = downShop && downShop.phone ? downShop.phone : '';
      grid.innerHTML = bpMsg('Online booking is temporarily unavailable. Please call ' + (downPhone || 'the shop') + ' to book, or try again in a few minutes.', 'warn');
      var n3down = document.getElementById('bp-next-3'); if (n3down) n3down.disabled = true;
      return;
    }
    var booked = avail.booked, allDayBlocked = avail.allDayBlocked;

    if (allDayBlocked) {
      grid.innerHTML = bpMsg('Not available this day — please pick another.', 'warn');
      return;
    }

    var blockReason = {};
    var now = new Date();
    var nowMins = now.getHours() * 60 + now.getMinutes();
    var today = new Date(); today.setHours(0,0,0,0);
    var isToday = date.toDateString() === today.toDateString();
    slots.forEach(function (s) {
      var sm = slotMins(s);
      if (H.gap && sm >= H.gap[0] && sm < H.gap[1]) blockReason[s] = 'Closed ' + minsToSlot(H.gap[0]) + ' – ' + minsToSlot(H.gap[1]);
      else if (isToday && sm <= nowMins) blockReason[s] = 'Time has passed';
      else if (isToday && sm < nowMins + 120) blockReason[s] = 'Book at least 2 hrs ahead';
    });

    // When nothing is bookable, say WHY in a sentence. A wall of greyed buttons
    // with hover-only reasons reads as "the site is broken", and on a phone the
    // reasons never show at all.
    var openSlots = slots.filter(function (s) { return booked.indexOf(s) < 0 && !blockReason[s]; });
    if (!openSlots.length) {
      var shop = locById(loc);
      var phone = shop && shop.phone ? shop.phone : '';
      // Same-day is over exactly when the day's LAST slot is inside the notice
      // window — the test bpEarliestDate already uses. Not "are all the blocked
      // slots clock-blocked": on a Friday the lunch-gap slots are blocked as
      // "Closed", and at NE (nothing booked) they made that test fail and the
      // page said "Fully booked" to a customer at 3 PM who was simply too late.
      // Fully booked at 9 AM stays "Fully booked"; too late at 3 PM says so even
      // if the day is also full, because no cancellation can help them now.
      var allTooLate = isToday && (nowMins + 120 > H.last);
      if (allTooLate) {
        grid.innerHTML = bpMsg(
          'Same-day appointments need 2 hours’ notice, and the last one today is ' + minsToSlot(H.last) + ' — ' +
          'today can’t be booked online any more. Pick another day' + (phone ? ', or call ' + phone + ' to ask about a walk-in.' : '.'),
          'warn'
        );
      } else {
        grid.innerHTML = bpMsg('Fully booked this day — please pick another day.', 'warn');
      }
      return;
    }

    grid.innerHTML = slots.map(function (s) {
      var isCalBooked = booked.indexOf(s) > -1;
      var isBlocked = isCalBooked || !!blockReason[s];
      var titleAttr = isCalBooked ? 'Already booked' : (blockReason[s] || '');
      return '<button type="button" class="bk-time-slot' +
        (st.time === s ? ' bk-time-slot--active' : '') +
        (isBlocked ? ' bk-time-slot--booked' : '') +
        '" data-time="' + s + '"' + (isBlocked ? ' disabled title="' + titleAttr + '"' : '') + '>' + s + '</button>';
    }).join('');
    grid.querySelectorAll('.bk-time-slot:not(.bk-time-slot--booked)').forEach(function (el) {
      el.addEventListener('click', function () {
        st.time = this.dataset.time;
        renderTimes();
        document.getElementById('bp-next-3').disabled = false;
      });
    });
  }

  function renderSummary() {
    var svc = SERVICES[st.service];
    var veh = VEHICLES.find(function (v) { return v.id === st.vehicle; });
    var pr = calcPrice();
    var ds = st.date ? st.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + st.time : '';
    var h = '';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
    if (st.service === 'installation_off' && st.addons.lowProfile) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Tire type</span><span class="bk-summary-val">Low-profile / run-flat</span></div>';
    }
    var picked = bpSelectedCatalogAddons();
    if (picked.length) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Add-on</span><span class="bk-summary-val">' + picked.map(function (a) { return a.name; }).join(', ') + '</span></div>';
    }
    var sumLoc = locById(st.locationId);
    if (sumLoc && LOCATIONS.length > 1) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Location</span><span class="bk-summary-val">' + PTBookingCore.shortShopName(sumLoc) + '</span></div>';
    }
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Date &amp; time</span><span class="bk-summary-val">' + ds + '</span></div>';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Vehicle</span><span class="bk-summary-val">' + (veh ? veh.name : '') + '</span></div>';
    if (pr) h += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
    document.getElementById('bp-summary').innerHTML = h;
  }

  // Can the road force upgrade be offered on the chosen job? Any service but
  // road force itself, once the catalog has it, and only while a bookable shop
  // offers it (the picker would otherwise have nothing to show).
  function bpRoadForceOffered() {
    if (!st.service || st.service === 'road_force_balancing' || !ADDON_CATALOG.addon_road_force) return false;
    return PTBookingCore.allowedLocations(LOCATIONS, [SERVICE_SHOPS.addon_road_force || []]).length > 0;
  }

  // The catalog add-ons ticked on this booking, in the shape /api/book takes
  // (customAddons).
  function bpSelectedCatalogAddons() {
    var out = [];
    if (st.service === 'road_force_balancing') return out;
    Object.keys(ADDON_KEYS).forEach(function (slug) {
      var a = ADDON_CATALOG[slug];
      if (a && st.addons[ADDON_KEYS[slug]]) out.push({ slug: slug, name: a.name, qty: st.qty, amount: a.amount });
    });
    return out;
  }

  async function submitBooking() {
    var name = document.getElementById('bp-name').value.trim();
    var phone = document.getElementById('bp-phone').value.trim();
    var email = document.getElementById('bp-email').value.trim();
    var vehInfo = document.getElementById('bp-vehicle-info').value.trim();
    var notes = document.getElementById('bp-notes').value.trim();
    var errEl = document.getElementById('bp-form-error');

    ['bp-field-name','bp-field-phone','bp-field-email'].forEach(function (id) { document.getElementById(id).classList.remove('bk-field--error'); });
    errEl.hidden = true;

    var missing = [];
    if (!name)  { document.getElementById('bp-field-name').classList.add('bk-field--error'); missing.push('full name'); }
    if (!phone) { document.getElementById('bp-field-phone').classList.add('bk-field--error'); missing.push('phone number'); }
    if (!email || email.indexOf('@') < 1) { document.getElementById('bp-field-email').classList.add('bk-field--error'); missing.push('email address'); }
    if (missing.length) { errEl.textContent = 'Please fill in your ' + missing.join(', ') + '.'; errEl.hidden = false; return; }
    if (!st.date || !st.time) { errEl.textContent = 'Please select a date and time before confirming.'; errEl.hidden = false; return; }

    var btn = document.getElementById('bp-confirm-btn');
    btn.disabled = true; btn.textContent = 'Booking...';

    var pr = calcPrice();
    var dateStr = PTBookingCore.localISO(st.date);
    var svc = SERVICES[st.service];

    var payload = {
      bookType: 'service',
      serviceName: svc ? svc.name : 'Service',
      serviceId: st.service,
      mountState: st.service === 'installation_off' ? 'off' : st.service === 'installation_on' ? 'on' : '',
      qty: st.qty,
      tpms: st.addons.tpms || false,
      disposal: st.addons.disposal || false,
      lowProfile: st.addons.lowProfile || false,
      customAddons: bpSelectedCatalogAddons(),
      name: name, phone: phone, email: email,
      notes: (notes ? notes + ' · ' : '') + (vehInfo || ''),
      vehicleType: st.vehicle,
      location_id: st.locationId || '',
      date: dateStr,
      time: st.time,
      subtotal: pr ? pr.raw.subtotal : 0,
      gst:      pr ? pr.raw.gst      : 0,
      total:    pr ? pr.raw.total    : 0
    };

    try {
      var res;
      // The shop they picked, for every "call us" below — never SW's number
      // for an NE customer.
      var shopPhone = (locById(st.locationId) || {}).phone || '(403) 452-4283';
      try {
        res = await fetch(BOOKING_API, { method: 'POST', mode: 'cors', credentials: 'omit', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } catch (netErr) {
        throw new Error("Couldn't reach the booking server. Try a different browser or call " + shopPhone + ".");
      }
      if (!res.ok) {
        var ed = await res.json().catch(function () { return {}; });
        if (res.status === 429) throw new Error('Too many bookings from this device — please wait a minute and try again.');
        if (res.status === 409) throw new Error('That time slot was just booked. Please pick another time.');
        // 402 is the platform switched off (a billing stop took the whole app
        // down for an hour on 2026-10-19); 5xx is it falling over. Neither is
        // fixed by retrying — give them the phone.
        if (res.status === 402 || res.status >= 500) throw new Error('Online booking is temporarily unavailable. Please call ' + shopPhone + ' to book — sorry for the trouble.');
        throw new Error(ed.error || ('Booking failed (HTTP ' + res.status + ')'));
      }

      var doneCard = document.getElementById('bp-done-card');
      var ds = st.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + st.time;
      var loc = locById(st.locationId);
      // Match the prior "street, city, region" form (e.g. "111 42 Ave SW, Calgary, AB").
      var doneAddr = '111 42 Ave SW, Calgary, AB';
      if (loc) {
        doneAddr = loc.address || loc.address_full || doneAddr;
        if (loc.address && loc.region) doneAddr = loc.address + ', ' + loc.region;
      }
      var donePhone = (loc && loc.phone) || '(403) 452-4283';
      var doneH = '';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Date &amp; time</span><span class="bk-summary-val">' + ds + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Address</span><span class="bk-summary-val">' + doneAddr + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Phone</span><span class="bk-summary-val">' + donePhone + '</span></div>';
      if (pr) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
      doneCard.innerHTML = doneH;

      // Done-page subhead — "Requested at Prince Tires — <address>. We'll confirm…" —
      // swapping in the selected shop's address (identical wording for SW-only).
      var doneSub = document.querySelector('.pt-bp .bk-done-sub');
      if (doneSub && loc) {
        doneSub.textContent = 'Requested at Prince Tires — ' + (loc.address || doneAddr) + '. We’ll confirm by email, usually within the day — your appointment isn’t final until you hear from us.';
      }

      [1,2,3,4].forEach(function (s) { document.getElementById('bp-page-' + s).hidden = true; });
      document.getElementById('bp-page-done').hidden = false;
      document.getElementById('bp-stepper').style.opacity = '0';
      // Booking succeeded — clear the draft so a fresh visit starts empty.
      bpClearDraft();
    } catch (err) {
      btn.disabled = false; btn.textContent = 'Send request';
      errEl.textContent = err.message || ('Something went wrong. Please try again or call ' + ((locById(st.locationId) || {}).phone || '(403) 452-4283') + '.');
      errEl.hidden = false;
    }
  }

  function downloadICS() {
    if (!st.date || !st.time) return;
    var svc = SERVICES[st.service];
    var icsLoc = locById(st.locationId);
    var icsAddr = (icsLoc && (icsLoc.address_full || icsLoc.address)) || '111 42 Ave SW, Calgary, AB T2G 0A4';
    var ics = PTBookingCore.buildICS({
      dateISO: PTBookingCore.localISO(st.date),
      time: st.time,
      durationMinutes: 60,
      summary: (svc ? svc.name : 'Service') + ' at Prince Tires',
      description: '',
      location: icsAddr
    });
    if (!ics) return;
    PTBookingCore.downloadICS(ics, 'prince-tires-service.ics');
  }

  // Wire up
  document.querySelectorAll('.bp-pathway').forEach(function (b) {
    b.addEventListener('click', function () { pickPathway(this.dataset.bpPath); });
  });
  document.querySelectorAll('.bp-mount-card').forEach(function (b) {
    b.addEventListener('click', function () {
      st.service = this.dataset.bpSvc;
      document.querySelectorAll('.bp-mount-card').forEach(function (c) { c.classList.toggle('bp-mount-card--active', c === b); });
      updateNextBtn();
      bpSyncLocation();
    });
  });
  // Buying-tires search is handled by the embedded pt-tire-search snippet (its own JS).
  document.getElementById('bp-next-1').addEventListener('click', function () { if (!this.disabled) goTo(2); });
  document.querySelectorAll('[data-bp-goto]').forEach(function (b) {
    b.addEventListener('click', function () {
      var s = parseInt(this.dataset.bpGoto);
      if (s) goTo(s);
    });
  });
  document.getElementById('bp-prev-week').addEventListener('click', function () { if (wk > 0) { wk--; renderWeek(); } });
  document.getElementById('bp-next-week').addEventListener('click', function () { wk++; renderWeek(); });
  document.getElementById('bp-confirm-btn').addEventListener('click', submitBooking);
  document.getElementById('bp-cal-btn').addEventListener('click', downloadICS);

  // Location deep-link via ?location=ne (NE landing page links here). Pre-selects
  // the requested shop when it's bookable; otherwise the is_primary default stays.
  var preLoc = PTBookingCore.queryLocationSlug();
  if (preLoc) {
    preLoc = preLoc.toLowerCase();
    var preLocHit = PTBookingCore.bySlug(LOCATIONS, preLoc);
    if (preLocHit) st.locationId = preLoc;
  }

  // Build the location picker (hidden unless 2+ shops are bookable).
  renderLocations();

  // Deep-link via ?service=installation_off / ?service=balancing / etc.
  var __bpUrlSvc = null;
  try {
    var qs = new URLSearchParams(window.location.search);
    var pre = qs.get('service');
    if (pre && SERVICES[pre]) {
      __bpUrlSvc = pre;
      st.service = pre;
      if (pre === 'installation_off' || pre === 'installation_on') {
        pickPathway('own');
        var card = document.querySelector('.bp-mount-card[data-bp-svc="' + pre + '"]');
        if (card) card.classList.add('bp-mount-card--active');
      } else {
        pickPathway('other');
        renderOtherGrid();
      }
      // pickPathway() cleared the service; put it back so the tile lights up
      // and Next enables, then let a restricted service (road force →
      // Edmonton Trail) narrow the picker right away.
      st.service = pre;
      if (pre !== 'installation_off' && pre !== 'installation_on') renderOtherGrid();
      updateNextBtn();
      bpSyncLocation();
    }
  } catch (e) {}

  // ── Draft restore ──────────────────────────────────────────────────────
  // Rehydrate the sessionStorage draft AFTER the URL ?service= handler:
  //   - If URL specifies a service, that's a fresh intent → skip restore.
  //   - Otherwise, replay the saved state (pathway + service + vehicle +
  //     qty + addons + date + time + location + contact fields) and jump
  //     the customer straight to the step they left off on.
  (function restoreBookingDraft() {
    if (__bpUrlSvc) return;
    var draft = bpRestoreDraft();
    if (!draft) return;
    var landStep = bpApplyDraft(draft);
    // Re-sync the parts of the UI that mirror state (active pill / card / chip).
    // pickPathway() zeroes st.service as a side-effect (it's designed as a fresh
    // pathway switch), so we cache-and-restore around the call.
    var svc = st.service;
    if (st.pathway) pickPathway(st.pathway);
    st.service = svc;
    if (st.service) {
      var mountCard = document.querySelector('.bp-mount-card[data-bp-svc="' + st.service + '"]');
      if (mountCard) mountCard.classList.add('bp-mount-card--active');
      // 'Other' service picker uses a chip grid rendered on demand — re-render
      // so the previously-picked chip lights up.
      if (st.pathway === 'other') renderOtherGrid();
    }
    bpSyncLocation();
    updateNextBtn();
    if (landStep > 1) goTo(landStep);
  })();

  // Autosave debounced input on the contact fields (step 4) — the primary
  // step-change checkpoint above catches everything else, but text fields
  // need per-keystroke saves so a mid-typing tab-close doesn't lose the input.
  ['bp-name','bp-phone','bp-email','bp-vehicle-info','bp-notes'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', bpSaveDraftDebounced);
  });
  // Safety-net backup fires — save on tab-hide + before unload so an
  // in-flight text edit is still captured if the browser tears down before
  // the debounce fires.
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') bpSaveDraft();
  });
  window.addEventListener('beforeunload', bpSaveDraft);

  // Saved-vehicle banner — surfaces if customer just came from the tire search
  // and the saved record is recent (24 h). Doesn't auto-fill the vehicle tier
  // (that risks wrong-price quotes); just confirms which tires they're booking
  // install for and pre-fills the vehicle text input on step 4.
  try {
    var savedRaw = localStorage.getItem('pt-tire-search-vehicle');
    if (savedRaw) {
      var saved = JSON.parse(savedRaw);
      var ageMs = Date.now() - new Date(saved.savedAt || 0).getTime();
      var FRESH_MS = 24 * 60 * 60 * 1000;
      if (saved && saved.tireSize && ageMs < FRESH_MS) {
        var label = [saved.year, saved.make, saved.model, saved.trim].filter(Boolean).join(' ');
        document.getElementById('bp-saved-vehicle').textContent = label;
        document.getElementById('bp-saved-size').textContent = saved.tireSize;
        document.getElementById('bp-saved').hidden = false;

        // Pre-fill the contact step's vehicle text input
        var vehicleInput = document.getElementById('bp-vehicle-info');
        if (vehicleInput && !vehicleInput.value) vehicleInput.value = label;

        // CTA → off-rims install, auto-detect tier from saved make/model + tire size,
        // and jump straight to step 3 (date/time). Customer can step back to 2 if the
        // auto-pick was wrong; we surface a "we picked X from your Honda Civic"
        // confirmation strip on step 2 so the override is one tap away.
        document.getElementById('bp-saved-go').addEventListener('click', function () {
          st.service = 'installation_off';
          st.vehicle = detectTier(saved);
          st.qty = 4;
          st.autoPickedFromSaved = true;
          pickPathway('own');
          var card = document.querySelector('.bp-mount-card[data-bp-svc="installation_off"]');
          if (card) card.classList.add('bp-mount-card--active');
          updateNextBtn();
          goTo(3);
        });

        document.getElementById('bp-saved-clear').addEventListener('click', function () {
          try { localStorage.removeItem('pt-tire-search-vehicle'); } catch (e) {}
          document.getElementById('bp-saved').hidden = true;
          if (vehicleInput) vehicleInput.value = '';
        });
      }
    }
  } catch (e) {}

  // ── Stage 2: pull the live service catalog on page load. bpApplyCatalog
  //    overlays the fallback pricing + labels above; silent fallback on
  //    failure. See docs/phase-3.5-service-catalog.md.
  fetch(SERVICES_API)
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (data) { if (data && data.services) bpApplyCatalog(data.services); })
    .catch(function () {});
})();
</script>

{% schema %}
{
  "name": "Booking page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Request a service"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Hero subheading",
      "default": "Tell us what you need, pick a time. We confirm by email within the day."
    }
  ],
  "presets": [
    { "name": "Booking page" }
  ]
}
{% endschema %}
