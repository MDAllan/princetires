  "name": "Booking page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Book a service"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Hero subheading",
      "default": "Tell us what you need, pick a time. We confirm by email within the day."
    }
  ],
  "presets": [
    { "name": "Booking page" }
  ]
}
