{%- comment -%}
  "Calgary trusts Prince Tires" band under the product page (templates/product.json).
  2026-11-13 redesign: the canvas look (heading left, four facts in black on the
  paper band). On WHEEL pages the 3rd fact is swapped (owner default #4):
  "Same day - Installation available" does not hold for wheels (almost all are
  1-2 business days), so wheels show "2 shops - SW and NE Calgary". Both wheel
  texts are settings. The wheel test is snippets/pt-is-wheel.liquid (same as
  the product page).
  Owner 11-13 (2nd pass, "add orange and green in the middle of the page"):
  each fact gets an orange icon tile (icon picked per fact in the settings,
  from the site icon set) and the fact itself is in brand green; the heading
  has an orange accent strip. Same four facts, no new claims.
  Owner 11-14 ("you are using less orange and green - I like the colours in
  the old design"): the live band's colours are back - the orange "Why choose
  us" eyebrow and every fact in orange (live: #F5820B 22px/700). Facts use
  #dc750a, the same hue a step darker, so the large text reaches 3:1 on white
  (#F5820B is 2.6:1); the eyebrow is small text, so it uses #a95a08 (5.1:1).
{%- endcomment -%}
{%- liquid
  assign sp_is_wheel = false
  if product != blank
    capture sp_w
      render 'pt-is-wheel', product: product
    endcapture
    if sp_w contains 'true'
      assign sp_is_wheel = true
    endif
  endif
  assign sp3_value = section.settings.stat_3_value
  assign sp3_label = section.settings.stat_3_label
  if sp_is_wheel and section.settings.wheel_stat_3_value != blank
    assign sp3_value = section.settings.wheel_stat_3_value
    assign sp3_label = section.settings.wheel_stat_3_label
  endif
  assign sp3_icon = section.settings.stat_3_icon
  if sp_is_wheel and section.settings.wheel_stat_3_value != blank
    assign sp3_icon = section.settings.wheel_stat_3_icon
  endif
-%}
<div class="pt-sp">
  <div class="pt-sp__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="pt-sp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="pt-sp__heading">{{ section.settings.heading | default: 'Calgary trusts Prince Tires' }}</h2>
    <div class="pt-sp__grid">
      {%- if section.settings.stat_1_value != blank -%}
        <div class="pt-sp__item">
          {%- if section.settings.stat_1_icon != blank and section.settings.stat_1_icon != 'none' -%}<span class="pt-sp__tile">{% render 'pt-icon', name: section.settings.stat_1_icon, size: 24 %}</span>{%- endif -%}
          <span class="pt-sp__text">
            <span class="pt-sp__value">{{ section.settings.stat_1_value | escape | replace: '★', '<span class="pt-sp__star">★</span>' }}</span>
            <span class="pt-sp__label">{{ section.settings.stat_1_label }}</span>
          </span>
        </div>
      {%- endif -%}
      {%- if section.settings.stat_2_value != blank -%}
        <div class="pt-sp__item">
          {%- if section.settings.stat_2_icon != blank and section.settings.stat_2_icon != 'none' -%}<span class="pt-sp__tile">{% render 'pt-icon', name: section.settings.stat_2_icon, size: 24 %}</span>{%- endif -%}
          <span class="pt-sp__text">
            <span class="pt-sp__value">{{ section.settings.stat_2_value | escape | replace: '★', '<span class="pt-sp__star">★</span>' }}</span>
            <span class="pt-sp__label">{{ section.settings.stat_2_label }}</span>
          </span>
        </div>
      {%- endif -%}
      {%- if sp3_value != blank -%}
        <div class="pt-sp__item">
          {%- if sp3_icon != blank and sp3_icon != 'none' -%}<span class="pt-sp__tile">{% render 'pt-icon', name: sp3_icon, size: 24 %}</span>{%- endif -%}
          <span class="pt-sp__text">
            <span class="pt-sp__value">{{ sp3_value | escape | replace: '★', '<span class="pt-sp__star">★</span>' }}</span>
            <span class="pt-sp__label">{{ sp3_label }}</span>
          </span>
        </div>
      {%- endif -%}
      {%- if section.settings.stat_4_value != blank -%}
        <div class="pt-sp__item">
          {%- if section.settings.stat_4_icon != blank and section.settings.stat_4_icon != 'none' -%}<span class="pt-sp__tile">{% render 'pt-icon', name: section.settings.stat_4_icon, size: 24 %}</span>{%- endif -%}
          <span class="pt-sp__text">
            <span class="pt-sp__value">{{ section.settings.stat_4_value | escape | replace: '★', '<span class="pt-sp__star">★</span>' }}</span>
            <span class="pt-sp__label">{{ section.settings.stat_4_label }}</span>
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pt-sp { background: #faf9f7; color: #111; border-top: 1px solid #ecebe7; border-bottom: 1px solid #ecebe7; font-family: 'Outfit', sans-serif; }
  .pt-sp__inner { max-width: 1320px; margin: 0 auto; padding: 2.4rem 1.6rem; }
  .pt-sp__heading {
    display: flex; align-items: center; gap: 1rem;
    font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 700; text-transform: none;
    letter-spacing: 0; margin: 0 0 1.6rem; line-height: 1.2; color: #111;
  }
  .pt-sp__heading::before { content: ""; flex: none; width: .4rem; height: 2rem; border-radius: 2px; background: #F5820B; }
  .pt-sp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .pt-sp__item {
    display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; min-width: 0;
    padding: 1.2rem; background: #fff; border: 1px solid #ecebe7; border-radius: 12px;
  }
  /* Orange icon tile in the live orange #F5820B (icons are decorative). */
  .pt-sp__tile {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 4rem; height: 4rem; border-radius: 10px; background: #fff7ed; border: 1px solid #fed7aa; color: #F5820B;
    --rd-icon-bg: #fff7ed;
  }
  .pt-sp__tile svg { display: block; }
  .pt-sp__text { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  /* Live's orange eyebrow: small text, so #F5820B's darker shade #a95a08 (5.1:1 on #faf9f7: 4.6:1). */
  .pt-sp__eyebrow { margin: 0 0 .4rem; font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #a95a08; }
  /* Facts in the live page's orange (owner 11-14). Large bold text (22px+/700):
     #dc750a = #F5820B a step darker, 3.2:1 on the white card (#F5820B itself is 2.6:1). */
  .pt-sp__value { font-family: 'Barlow Condensed', sans-serif; font-size: 2.4rem; font-weight: 700; color: #dc750a; line-height: 1.1; overflow-wrap: anywhere; }
  .pt-sp__star { color: #F5820B; }
  .pt-sp__label { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 400; color: #57534e; line-height: 1.35; }
  @media (min-width: 750px) {
    .pt-sp__inner { padding: 3.6rem 3.2rem; }
    .pt-sp__heading { font-size: 2.2rem; margin-bottom: 2rem; }
    .pt-sp__heading::before { height: 2.4rem; }
    .pt-sp__grid { grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); gap: 1.6rem; }
    .pt-sp__item { flex-direction: row; align-items: center; gap: 1.4rem; padding: 1.6rem 1.8rem; }
    .pt-sp__tile { width: 4.8rem; height: 4.8rem; border-radius: 12px; }
    .pt-sp__value { font-size: 2.8rem; }
    .pt-sp__label { font-size: 1.5rem; }
  }
{% endstylesheet %}

