{%- comment -%}
  Prince Tires — Wholesale page (2026-11-12: wholesale moved to the dealer portal)

  Wholesale ordering no longer happens on this website. It runs in the dealer
  portal at https://wholesale.princetires.ca (operations app). This section is
  now only a signpost. It is used by two templates:

    page.wholesale         → /pages/wholesale        = one page for everyone:
                             what the portal is, Dealer login, Apply.
    page.wholesale-portal  → /pages/wholesale-portal = old dashboard address:
                             short notice + immediate redirect to the portal login.

  Nothing here depends on a theme setting, a customer tag or a login.
  The old dashboard (delivery request, business profile, quote branding, tier
  card, fleet garage, VIN batch) was removed from this file on purpose.
  Rollback: docs/wholesale-to-portal.md.
{%- endcomment -%}

{%- liquid
  assign whp_login = 'https://wholesale.princetires.ca/dealer/login'
  assign whp_apply = '/pages/wholesale-register'
  assign whp_phone = section.settings.manager_phone | default: '(403) 452-4283'
  assign whp_phone_digits = whp_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
  assign whp_is_old_portal = false
  if template.suffix == 'wholesale-portal'
    assign whp_is_old_portal = true
  endif
-%}

<style>
  .whp { --whp-red:#DC2626; --whp-orange:#F97316; --whp-ink:#111111; --whp-mute:#4b5563; --whp-line:#e5e7eb; --whp-soft:#f7f7f7;
         font-family:'Outfit',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; color:var(--whp-ink); font-size:1.6rem; line-height:1.55;
         padding-top:{{ section.settings.padding_top | default: 0 }}px; padding-bottom:{{ section.settings.padding_bottom | default: 0 }}px; }
  .whp *, .whp *::before, .whp *::after { box-sizing:border-box; }
  .whp [hidden] { display:none !important; }
  .whp__wrap { max-width:1040px; margin:0 auto; padding:0 16px; }
  .whp h1, .whp h2, .whp h3 { font-family:'Barlow Condensed',sans-serif; font-weight:700; line-height:1.08; margin:0; letter-spacing:.01em; }

  .whp__notice { background:var(--whp-ink); color:#fff; border-bottom:4px solid var(--whp-orange); padding:20px 0; }
  .whp__notice strong { display:block; font-size:1.9rem; }
  .whp__notice span { display:block; font-size:1.5rem; color:#e5e7eb; margin-top:4px; }

  .whp__hero { background:var(--whp-ink); color:#fff; padding:48px 0 52px; border-bottom:4px solid var(--whp-red); }
  .whp__eyebrow { display:inline-block; font-size:1.3rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--whp-orange); margin:0 0 12px; }
  .whp__hero h1 { font-size:4.4rem; text-transform:uppercase; color:#fff; }
  .whp__lead { font-size:1.8rem; color:#e5e7eb; max-width:640px; margin:16px 0 0; }
  .whp__btns { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
  .whp__btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:52px; padding:12px 26px; border-radius:10px;
              font-family:inherit; font-size:1.7rem; font-weight:700; line-height:1.2; text-decoration:none; text-align:center; border:2px solid transparent;
              transition:background-color .15s ease, color .15s ease, border-color .15s ease; }
  .whp__btn svg { flex:none; }
  .whp__btn--primary { background:var(--whp-red); color:#fff; border-color:var(--whp-red); }
  .whp__btn--primary:hover { background:#b91c1c; border-color:#b91c1c; color:#fff; }
  .whp__btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .whp__btn--ghost:hover { background:#fff; color:var(--whp-ink); }
  .whp__btn--dark { background:var(--whp-ink); color:#fff; border-color:var(--whp-ink); }
  .whp__btn--dark:hover { background:#fff; color:var(--whp-ink); }
  .whp__btn:focus-visible { outline:3px solid var(--whp-orange); outline-offset:3px; }
  .whp__fine { font-size:1.4rem; color:#d1d5db; max-width:640px; margin:18px 0 0; }

  .whp__section { padding:44px 0; }
  .whp__section--soft { background:var(--whp-soft); border-top:1px solid var(--whp-line); border-bottom:1px solid var(--whp-line); }
  .whp__section h2 { font-size:3.2rem; text-transform:uppercase; margin-bottom:20px; }

  .whp__list { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:12px 28px; }
  .whp__list li { position:relative; padding-left:30px; font-size:1.6rem; }
  .whp__list li::before { content:''; position:absolute; left:0; top:.45em; width:16px; height:9px; border-left:3px solid var(--whp-red); border-bottom:3px solid var(--whp-red); transform:rotate(-45deg); }

  .whp__steps { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:16px; counter-reset:whp; }
  .whp__steps li { counter-increment:whp; background:#fff; border:1px solid var(--whp-line); border-top:4px solid var(--whp-red); border-radius:12px; padding:20px; }
  .whp__steps li::before { content:counter(whp); display:flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%;
                           background:var(--whp-ink); color:#fff; font-family:'Barlow Condensed',sans-serif; font-size:2rem; font-weight:700; margin-bottom:12px; }
  .whp__steps h3 { font-size:2.2rem; text-transform:uppercase; margin-bottom:6px; }
  .whp__steps p { margin:0; font-size:1.5rem; color:var(--whp-mute); }

  .whp__help { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .whp__card { border:1px solid var(--whp-line); border-radius:12px; padding:22px; background:#fff; }
  .whp__card h2 { font-size:2.4rem; margin-bottom:8px; }
  .whp__card p { margin:0 0 14px; font-size:1.5rem; color:var(--whp-mute); }
  .whp__card p:last-child { margin-bottom:0; }
  .whp__link { color:var(--whp-red); font-weight:700; text-decoration:underline; text-underline-offset:3px; display:inline-flex; align-items:center; min-height:44px; }
  .whp__link:hover { color:var(--whp-ink); }
  .whp__link:focus-visible { outline:3px solid var(--whp-orange); outline-offset:2px; }

  .whp__moved { padding:56px 0 72px; text-align:center; }
  .whp__moved h1 { font-size:3.8rem; text-transform:uppercase; }
  .whp__moved p { font-size:1.7rem; color:var(--whp-mute); max-width:520px; margin:14px auto 0; }
  .whp__moved .whp__btns { justify-content:center; }

  @media (max-width: 749px) {
    .whp__hero { padding:36px 0 40px; }
    .whp__hero h1 { font-size:3.4rem; }
    .whp__lead { font-size:1.65rem; }
    .whp__btns { flex-direction:column; }
    .whp__btn { width:100%; }
    .whp__section { padding:32px 0; }
    .whp__section h2 { font-size:2.7rem; }
    .whp__list, .whp__steps, .whp__help { grid-template-columns:1fr; }
    .whp__moved h1 { font-size:3rem; }
  }
  @media (prefers-reduced-motion: reduce) { .whp__btn { transition:none; } }
</style>

{%- if whp_is_old_portal -%}

  {%- comment -%}
    Old dashboard address. Send the visitor to the dealer portal login.
    Not in the theme editor, so the template can still be opened there.
    JS redirect first, meta refresh for browsers without JS, visible link as the last fallback.
  {%- endcomment -%}
  {%- unless request.design_mode -%}
    <script>window.location.replace({{ whp_login | json }});</script>
    <noscript><meta http-equiv="refresh" content="0;url={{ whp_login }}"></noscript>
  {%- endunless -%}
  <div class="whp" data-wholesale-moved>
    <div class="whp__wrap whp__moved">
      <h1>Wholesale has moved to the dealer portal</h1>
      <p>We are taking you to the Prince Tires dealer portal now. If nothing happens, use the button below.</p>
      <div class="whp__btns">
        <a class="whp__btn whp__btn--primary" href="{{ whp_login }}" rel="noopener">Go to dealer login</a>
        <a class="whp__btn whp__btn--dark" href="{{ whp_apply }}">Apply for a wholesale account</a>
      </div>
    </div>
  </div>

{%- else -%}

  <div class="whp" data-wholesale-landing>

    {%- comment -%} Shown once after the application form sends a new applicant back here with ?submitted=1 {%- endcomment -%}
    <div class="whp__notice" id="wholesale-submitted-banner" role="status" hidden>
      <div class="whp__wrap">
        <strong>Thanks. We got your application.</strong>
        <span>We review each business. When you are approved, we send you an invite link to the dealer portal.</span>
      </div>
    </div>
    <script>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          if (params.get('submitted') !== '1') return;
          var el = document.getElementById('wholesale-submitted-banner');
          if (el) el.hidden = false;
          params.delete('submitted');
          history.replaceState(null, '', window.location.pathname + (params.toString() ? '?' + params.toString() : ''));
        } catch (err) { /* no-op */ }
      })();
    </script>

    <header class="whp__hero">
      <div class="whp__wrap">
        <p class="whp__eyebrow">Wholesale for shops and dealers</p>
        <h1>Prince Tires dealer portal</h1>
        <p class="whp__lead">Wholesale ordering now happens in our dealer portal. Sign in to see your trade price and order from our Calgary warehouse.</p>
        <div class="whp__btns">
          <a class="whp__btn whp__btn--primary" href="{{ whp_login }}" rel="noopener">
            Dealer login
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a class="whp__btn whp__btn--ghost" href="{{ whp_apply }}">Apply for a wholesale account</a>
        </div>
        <p class="whp__fine">Your dealer login comes from the invite we send you. It is separate from a princetires.ca customer account.</p>
      </div>
    </header>

    <section class="whp__section" aria-labelledby="whp-what">
      <div class="whp__wrap">
        <h2 id="whp-what">What you get in the portal</h2>
        <ul class="whp__list">
          <li>The tire and wheel brands we import ourselves, in stock at our Calgary warehouse.</li>
          <li>Your trade price shown on every item.</li>
          <li>Order online from your phone or computer.</li>
          <li>Pickup at our Edmonton Trail shop, Unit 101, 3928 Edmonton Trail NE, Calgary. Delivery is coming soon.</li>
          <li>Pay when you pick up your order.</li>
          <li>Your orders and invoices in one place.</li>
        </ul>
      </div>
    </section>

    <section class="whp__section whp__section--soft" aria-labelledby="whp-how">
      <div class="whp__wrap">
        <h2 id="whp-how">How it works</h2>
        <ol class="whp__steps">
          <li>
            <h3>Apply</h3>
            <p>Tell us about your business. The form takes a few minutes.</p>
          </li>
          <li>
            <h3>We approve and send your invite</h3>
            <p>We review each application. When you are approved, we send you an invite link to set up your dealer login.</p>
          </li>
          <li>
            <h3>Order online, pick up at our Edmonton Trail shop</h3>
            <p>Sign in, find your tires or wheels, and place your order. Pick it up at our Edmonton Trail shop, Unit 101, 3928 Edmonton Trail NE, Calgary, during shop hours.</p>
          </li>
        </ol>
        <div class="whp__btns">
          <a class="whp__btn whp__btn--primary" href="{{ whp_apply }}">Apply for a wholesale account</a>
          <a class="whp__btn whp__btn--dark" href="{{ whp_login }}" rel="noopener">Dealer login</a>
        </div>
      </div>
    </section>

    <section class="whp__section" aria-label="Help with wholesale">
      <div class="whp__wrap whp__help">
        <div class="whp__card">
          <h2>Had a wholesale account on this website?</h2>
          <p>Wholesale ordering has moved to the dealer portal. You need the new dealer login from your invite. If you have not received an invite yet, call us and we will set you up.</p>
        </div>
        <div class="whp__card">
          <h2>Questions?</h2>
          <p>Call or email us and we will help with your application, your login or an order.</p>
          <p>
            <a class="whp__link" href="tel:{{ whp_phone_digits }}">Call {{ whp_phone | escape }}</a><br>
            <a class="whp__link" href="mailto:info@princetires.ca">info@princetires.ca</a>
          </p>
        </div>
      </div>
    </section>

  </div>

{%- endif -%}

{% schema %}
{
  "name": "Wholesale (dealer portal)",
  "settings": [
    {
      "type": "paragraph",
      "content": "Wholesale ordering runs in the dealer portal at wholesale.princetires.ca. This section only explains it and links there."
    },
    {
      "type": "text",
      "id": "manager_phone",
      "label": "Phone number shown under Questions",
      "default": "(403) 452-4283"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "text",
      "id": "shop_url",
      "label": "Not used any more (kept so the old page template still loads)",
      "default": "/pages/wholesale"
    }
  ],
  "presets": [
    {
      "name": "Wholesale (dealer portal)"
    }
  ]
}
{% endschema %}
