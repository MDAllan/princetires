{%- comment -%}
  PrinceTires — Brands overview (the only section on /pages/brands).
  Premium dark template matching pt-brand-detail.liquid. Same block schema
  as before so existing templates/page.brands.json keeps working.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#DA291C'
  assign show_filter = section.settings.show_filter
  assign tire_brands = section.blocks | where: 'type', 'brand'
  assign wheel_brands_count = 0
  assign tire_brands_count = 0
  for b in tire_brands
    if b.settings.brand_type == 'wheel'
      assign wheel_brands_count = wheel_brands_count | plus: 1
    else
      assign tire_brands_count = tire_brands_count | plus: 1
    endif
  endfor
-%}

<section class="ptbg" style="--brand-accent: {{ accent }};">
  <div class="ptbg__container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="ptbg__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ptbg__crumb">Home</a>
      <span class="ptbg__crumb-sep" aria-hidden="true">/</span>
      <span class="ptbg__crumb ptbg__crumb--current">Brands</span>
    </nav>

    {%- comment -%} Hero — asymmetric: eyebrow+H1 left, TL;DR right {%- endcomment -%}
    <header class="ptbg__hero" data-reveal>
      <div class="ptbg__hero-left">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ptbg__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h1 class="ptbg__title">{{ section.settings.heading | default: 'Tire & wheel brands in Calgary' | escape }}</h1>
      </div>
      <div class="ptbg__hero-right">
        {%- if section.settings.tldr != blank -%}
          <p class="ptbg__tldr">{{ section.settings.tldr | escape }}</p>
        {%- elsif section.settings.subtitle != blank -%}
          <p class="ptbg__tldr">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        <div class="ptbg__hero-meta">
          <a href="/pages/booking" class="ptbg__hero-cta">
            Book installation
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          {%- assign hero_phone = section.settings.cta_phone | default: '(403) 452-4283' -%}
          {%- assign hero_phone_clean = hero_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:+1{{ hero_phone_clean }}" class="ptbg__hero-call">Call {{ hero_phone }}</a>
        </div>
      </div>
    </header>

    {%- comment -%} Stats strip — 4 GEO-friendly numbers {%- endcomment -%}
    <div class="ptbg__stats" data-reveal>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_1_value | default: '60+' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_1_label | default: 'Tire & wheel brands stocked' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_2_value | default: '3,923' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_2_label | default: 'Active SKUs in inventory' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_3_value | default: '4.9' | escape }}<span class="ptbg__stat-suffix">★</span></span>
        <span class="ptbg__stat-label">{{ section.settings.stat_3_label | default: 'From 562+ Google reviews' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_4_value | default: 'Same-day' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_4_label | default: 'Installation in most cases' | escape }}</span>
      </div>
    </div>

    {%- comment -%} Tire brands grouped by tier — render 4 tiers in order: Premium, Premium-Adjacent, Best Value, Budget {%- endcomment -%}
    {%- if tire_brands_count > 0 -%}
      {%- assign tier_keys = 'premium,premium-adjacent,best-value,budget' | split: ',' -%}
      {%- for tier in tier_keys -%}
        {%- liquid
          assign tier_label = ''
          assign tier_blurb = ''
          case tier
            when 'premium'
              assign tier_label = 'Premium'
              assign tier_blurb = "The flagships. When safety, longevity, and ride quality come ahead of price."
            when 'premium-adjacent'
              assign tier_label = 'Premium-Adjacent'
              assign tier_blurb = "Names you know, often built by the same engineers as Tier 1. Real performance at a friendlier price."
            when 'best-value'
              assign tier_label = 'Best Value'
              assign tier_blurb = "Our curated mid-tier — what we recommend when a customer wants quality without paying premium money."
            when 'budget'
              assign tier_label = 'Budget'
              assign tier_blurb = "Honest, affordable options. We stand behind every install, balance, and torque the same way we do for premium tires."
          endcase

          assign tier_count = 0
          for b in section.blocks
            if b.settings.brand_type != 'wheel'
              assign b_tier = b.settings.tier | default: 'premium-adjacent'
              if b_tier == tier
                assign tier_count = tier_count | plus: 1
              endif
            endif
          endfor
        -%}
        {%- if tier_count > 0 -%}
          <section class="ptbg__tier" data-tier="{{ tier }}">
            <div class="ptbg__group-head" data-reveal>
              <span class="ptbg__group-eyebrow ptbg__group-eyebrow--{{ tier }}">{{ tier_label }}</span>
              <h2 class="ptbg__group-title">{{ tier_label }}</h2>
              <p class="ptbg__group-body">{{ tier_blurb }}</p>
            </div>

            {%- comment -%} Brand logo bar — clickable, filters the carousel below {%- endcomment -%}
            <div class="ptbg__brand-bar" role="tablist" aria-label="{{ tier_label }} brands" data-tier-tabs data-reveal>
              <button class="ptbg__brand-tab ptbg__brand-tab--active" type="button" role="tab" aria-selected="true" data-brand="all">All</button>
              {%- for block in section.blocks -%}
                {%- assign b_tier = block.settings.tier | default: 'premium-adjacent' -%}
                {%- if block.settings.brand_type != 'wheel' and b_tier == tier -%}
                  {%- assign b_name = block.settings.name -%}
                  {%- assign b_handle = b_name | handleize -%}
                  {%- assign b_link = block.settings.page_link -%}
                  {%- if b_link == blank -%}
                    {%- assign b_link = '/collections/' | append: b_handle -%}
                  {%- endif -%}
                  <button class="ptbg__brand-tab" type="button" role="tab" aria-selected="false" data-brand="{{ b_handle }}" data-href="{{ b_link }}" title="View {{ b_name | escape }}">
                    <span class="ptbg__brand-tab-logo">
                      {%- if block.settings.logo != blank -%}
                        {{ block.settings.logo | image_url: height: 56 | image_tag: loading: 'lazy', class: 'ptbg__brand-tab-img', alt: b_name }}
                      {%- else -%}
                        {%- assign asset_filename = 'brand-' | append: b_handle | append: '.webp' -%}
                        <img src="{{ asset_filename | asset_url }}" alt="{{ b_name | escape }}" class="ptbg__brand-tab-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline';">
                        <span class="ptbg__brand-tab-text" style="display:none">{{ b_name | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="ptbg__brand-tab-name">{{ b_name | escape }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- comment -%} Tire-product carousel — pulls top products from each brand's smart collection {%- endcomment -%}
            <div class="ptbg__products-wrap" data-reveal>
              <button class="ptbg__products-arrow ptbg__products-arrow--prev" type="button" aria-label="Previous" data-tier-prev>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <ul class="ptbg__products" role="list" data-tier-carousel>
                {%- for block in section.blocks -%}
                  {%- assign b_tier = block.settings.tier | default: 'premium-adjacent' -%}
                  {%- if block.settings.brand_type != 'wheel' and b_tier == tier -%}
                    {%- assign b_name = block.settings.name -%}
                    {%- assign b_handle = b_name | handleize -%}
                    {%- assign b_collection = collections[b_handle] -%}
                    {%- for product in b_collection.products limit: 3 -%}
                      <li class="ptbg__product" data-brand="{{ b_handle }}">
                        <a href="{{ product.url }}" class="ptbg__product-link" aria-label="Shop {{ product.title | escape }}">
                          <div class="ptbg__product-img">
                            {%- if product.featured_image != blank -%}
                              {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'ptbg__product-image', alt: product.title }}
                            {%- else -%}
                              <svg viewBox="0 0 24 24" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
                            {%- endif -%}
                          </div>
                          <div class="ptbg__product-meta">
                            <span class="ptbg__product-brand">{{ b_name | escape }}</span>
                            <h3 class="ptbg__product-title">{{ product.title | remove_first: '[' | replace: ']', '' | escape }}</h3>
                            <div class="ptbg__product-foot">
                              <span class="ptbg__product-price">{{ product.price | money_without_trailing_zeros }}</span>
                              <span class="ptbg__product-cta">Shop →</span>
                            </div>
                          </div>
                        </a>
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <button class="ptbg__products-arrow ptbg__products-arrow--next" type="button" aria-label="Next" data-tier-next>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Wheel brand row — smaller, denser grid {%- endcomment -%}
    {%- if wheel_brands_count > 0 -%}
      <div class="ptbg__group-head" data-reveal>
        <span class="ptbg__group-eyebrow">Wheel brands</span>
        <h2 class="ptbg__group-title">Wheel brands in our showroom</h2>
        <p class="ptbg__group-body">Off-road stance, Canadian-winter-rated finishes, premium daily-driver looks — all fitment-checked against your make &amp; model before purchase.</p>
      </div>
      <ul class="ptbg__grid ptbg__grid--wheels" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.brand_type == 'wheel' -%}
            {%- liquid
              assign name = block.settings.name
              assign handle = name | handleize
              assign card_link = block.settings.page_link
              if card_link == blank
                assign card_link = '/collections/wheels'
              endif
              assign cats = block.settings.categories | split: ',' | first: 3
            -%}
            <li class="ptbg__card ptbg__card--wheel" data-reveal {{ block.shopify_attributes }}>
              <a href="{{ card_link }}" class="ptbg__card-link" aria-label="Shop {{ name | escape }} wheels">
                <div class="ptbg__card-logo">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 360 | image_tag: loading: 'lazy', class: 'ptbg__logo-img', alt: name }}
                  {%- else -%}
                    {%- assign asset_filename = 'brand-' | append: handle | append: '.webp' -%}
                    <img src="{{ asset_filename | asset_url }}" alt="{{ name | escape }}" class="ptbg__logo-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                    <span class="ptbg__logo-initial" style="display:none">{{ name | slice: 0, 1 | upcase }}</span>
                  {%- endif -%}
                </div>
                <div class="ptbg__card-body">
                  <h3 class="ptbg__card-name">{{ name | escape }}</h3>
                  {%- if block.settings.tagline != blank -%}
                    <p class="ptbg__card-tagline">{{ block.settings.tagline | escape }}</p>
                  {%- endif -%}
                  {%- if cats.size > 0 -%}
                    <div class="ptbg__card-tags">
                      {%- for c in cats -%}
                        <span class="ptbg__tag">{{ c | strip | escape }}</span>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
                <span class="ptbg__card-arrow" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} Built for Calgary roads — 3 seasonal context cards {%- endcomment -%}
    <div class="ptbg__group-head ptbg__group-head--center" data-reveal>
      <span class="ptbg__group-eyebrow">Built for Calgary</span>
      <h2 class="ptbg__group-title">Brands we lean on for our weather</h2>
      <p class="ptbg__group-body ptbg__group-body--center">Calgary asks more from tires than almost any city in Canada. Chinooks swing temps 20°C in an afternoon. The October winter-tire deadline collides with potholes that show up by April. These are the matchups we run all year.</p>
    </div>
    <div class="ptbg__context" data-reveal>
      <article class="ptbg__ctx-card">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--winter">Winter</span>
        <h3 class="ptbg__ctx-title">Cold, ice, and chinook swings</h3>
        <p class="ptbg__ctx-body">Michelin X-Ice Snow and Bridgestone Blizzak WS90 are our two most-installed winter tires. Both stay flexible below -20°C, which matters on January mornings when the rubber on cheaper tires goes glassy.</p>
        <a href="/collections/winter-tires" class="ptbg__ctx-link">Shop winter tires<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="ptbg__ctx-card">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--allweather">All-weather</span>
        <h3 class="ptbg__ctx-title">One tire, all year</h3>
        <p class="ptbg__ctx-body">Michelin CrossClimate2 wears a 3PMSF snowflake and meets Alberta's winter-tire law. If you don't want to swap twice a year, this is the category we point most Calgary drivers to.</p>
        <a href="/collections/all-weather-tires" class="ptbg__ctx-link">Shop all-weather<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
      <article class="ptbg__ctx-card">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--at">All-terrain</span>
        <h3 class="ptbg__ctx-title">Trucks, trailers, and gravel</h3>
        <p class="ptbg__ctx-body">BFGoodrich KO3, Toyo Open Country A/T III, and Mickey Thompson Baja Boss A/T. Built for the gravel east of Calgary and the BC mountain runs along Highway 1 and 93 — both under Alberta's winter-tire mandate from October.</p>
        <a href="/collections/all-terrain-tires" class="ptbg__ctx-link">Shop all-terrain<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </article>
    </div>

    {%- comment -%} FAQ — pulled from section settings, max 6, emitted as FAQPage schema {%- endcomment -%}
    {%- liquid
      assign faq_qs = '' | split: ','
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          assign faq_qs = faq_qs | concat: q
        endif
      endfor
    -%}
    <div class="ptbg__faq" data-reveal>
      <div class="ptbg__faq-head">
        <span class="ptbg__group-eyebrow">Frequently asked</span>
        <h2 class="ptbg__group-title">Calgary driver FAQs</h2>
      </div>
      <div class="ptbg__faq-list">
        {%- for i in (1..6) -%}
          {%- liquid
            assign q_key = 'faq_' | append: i | append: '_q'
            assign a_key = 'faq_' | append: i | append: '_a'
            assign q = section.settings[q_key]
            assign a = section.settings[a_key]
          -%}
          {%- if q != blank and a != blank -%}
            <details class="ptbg__faq-item">
              <summary class="ptbg__faq-q">
                <span>{{ q | escape }}</span>
                <span class="ptbg__faq-chev" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </summary>
              <div class="ptbg__faq-a">
                <p>{{ a | escape | newline_to_br }}</p>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} CTA banner — accent gradient {%- endcomment -%}
    <div class="ptbg__cta" data-reveal>
      <div class="ptbg__cta-text">
        <h2 class="ptbg__cta-heading">{{ section.settings.cta_heading | default: "Don't see your brand?" | escape }}</h2>
        <p class="ptbg__cta-desc">{{ section.settings.cta_description | default: 'Tell us your year, make, and tire size and we will source it. Same-day on most stocked sizes, two business days on special orders.' | escape }}</p>
      </div>
      <div class="ptbg__cta-buttons">
        <a href="{{ section.settings.cta_primary_link | default: '/pages/booking' }}" class="ptbg__cta-btn ptbg__cta-btn--primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          {{ section.settings.cta_primary_label | default: 'Book installation' | escape }}
        </a>
        {%- assign cta_phone_clean = section.settings.cta_phone | default: '(403) 452-4283' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
        <a href="tel:+1{{ cta_phone_clean }}" class="ptbg__cta-btn ptbg__cta-btn--secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {{ section.settings.cta_phone | default: '(403) 452-4283' | escape }}
        </a>
      </div>
      <div class="ptbg__cta-nap">
        <strong>Prince Tires</strong> · 111 42 Ave SW, Calgary, AB T2G 0A4 · Mon–Sat 9:30–5:30, Sun 10:00–3:30
      </div>
    </div>

  </div>

  {%- comment -%} JSON-LD: LocalBusiness + FAQPage for GEO citation {%- endcomment -%}
  {%- liquid
    capture faq_questions_json
      assign faq_count = 0
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          if faq_count > 0
            echo ','
          endif
          echo '{"@type":"Question","name":'
          echo q | json
          echo ',"acceptedAnswer":{"@type":"Answer","text":'
          echo a | json
          echo '}}'
          assign faq_count = faq_count | plus: 1
        endif
      endfor
    endcapture
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoPartsStore",
        "@id": "{{ shop.url }}/#business",
        "name": "Prince Tires",
        "url": "{{ shop.url }}",
        "telephone": "+1-403-452-4283",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "111 42 Ave SW",
          "addressLocality": "Calgary",
          "addressRegion": "AB",
          "postalCode": "T2G 0A4",
          "addressCountry": "CA"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "09:30", "closes": "17:30" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "10:00", "closes": "15:30" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ section.settings.aggregate_rating | default: '4.9' }}",
          "reviewCount": "{{ section.settings.review_count | default: '562' }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      {%- if faq_count > 0 -%}
      ,{ "@type": "FAQPage", "mainEntity": [ {{ faq_questions_json }} ] }
      {%- endif -%}
    ]
  }
  </script>
</section>

{% stylesheet %}
  .ptbg {
    position: relative;
    background: #ffffff;
    color: #0a0a0a;
    padding: 4.5rem 0 6rem;
    isolation: isolate;
    font-family: 'Outfit', system-ui, sans-serif;
  }
  .ptbg__container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* Breadcrumb */
  .ptbg__breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: rgba(10,10,10,0.55); margin-bottom: 2.5rem; }
  .ptbg__crumb { color: inherit; text-decoration: none; transition: color 0.18s; }
  .ptbg__crumb:hover { color: #0a0a0a; }
  .ptbg__crumb--current { color: #0a0a0a; font-weight: 600; }
  .ptbg__crumb-sep { color: rgba(10,10,10,0.3); }

  /* Hero — asymmetric grid */
  .ptbg__hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(10,10,10,0.1);
    margin-bottom: 3rem;
  }
  .ptbg__hero-left { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .ptbg__hero-right { display: flex; flex-direction: column; gap: 1.5rem; }

  .ptbg__eyebrow {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--brand-accent);
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 999px;
  }
  .ptbg__eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
