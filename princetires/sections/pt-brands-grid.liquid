{%- comment -%}
  PrinceTires — Brands overview (the only section on /pages/brands).
  Premium dark template matching pt-brand-detail.liquid. Same block schema
  as before so existing templates/page.brands.json keeps working.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#DA291C'
  assign show_filter = section.settings.show_filter
  assign tire_brands = section.blocks | where: 'type', 'brand'
  assign wheel_brands_count = 0
  assign tire_brands_count = 0
  for b in tire_brands
    if b.settings.brand_type == 'wheel'
      assign wheel_brands_count = wheel_brands_count | plus: 1
    else
      assign tire_brands_count = tire_brands_count | plus: 1
    endif
  endfor
-%}

<section class="ptbg" data-cb="2026-05-12-2" style="--brand-accent: {{ accent }};">
  <div class="ptbg__container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="ptbg__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ptbg__crumb">Home</a>
      <span class="ptbg__crumb-sep" aria-hidden="true">/</span>
      <span class="ptbg__crumb ptbg__crumb--current">Brands</span>
    </nav>

    {%- comment -%} Hero — asymmetric: eyebrow+H1 left, TL;DR right {%- endcomment -%}
    <header class="ptbg__hero" data-reveal>
      <div class="ptbg__hero-left">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ptbg__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h1 class="ptbg__title">{{ section.settings.heading | default: '26 tire &amp; wheel brands stocked in Calgary' }}</h1>
      </div>
      <div class="ptbg__hero-right">
        {%- if section.settings.tldr != blank -%}
          <p class="ptbg__tldr">{{ section.settings.tldr | escape }}</p>
        {%- elsif section.settings.subtitle != blank -%}
          <p class="ptbg__tldr">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        <div class="ptbg__hero-meta">
          <a href="/?vehicle-search=1" class="ptbg__hero-cta">
            Find tires for my vehicle
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/pages/booking" class="ptbg__hero-cta ptbg__hero-cta--secondary">
            Book installation
          </a>
          {%- assign hero_phone = section.settings.cta_phone | default: '(403) 452-4283' -%}
          {%- assign hero_phone_clean = hero_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:+1{{ hero_phone_clean }}" class="ptbg__hero-call">Call {{ hero_phone }}</a>
        </div>
      </div>
    </header>

    {%- comment -%} Stats strip — 4 GEO-friendly numbers {%- endcomment -%}
    <div class="ptbg__stats" data-reveal>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_1_value | default: '60+' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_1_label | default: 'Tire & wheel brands stocked' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_2_value | default: '3,923' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_2_label | default: 'Active SKUs in inventory' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_3_value | default: '4.9' | escape }}<span class="ptbg__stat-suffix">★</span></span>
        <span class="ptbg__stat-label">{{ section.settings.stat_3_label | default: 'From 562+ Google reviews' | escape }}</span>
      </div>
      <div class="ptbg__stat">
        <span class="ptbg__stat-value">{{ section.settings.stat_4_value | default: 'Same-day' | escape }}</span>
        <span class="ptbg__stat-label">{{ section.settings.stat_4_label | default: 'Installation in most cases' | escape }}</span>
      </div>
    </div>

    {%- comment -%} Built for Calgary — use-case entry tiles (hoisted above the mosaic) {%- endcomment -%}
    <div class="ptbg__group-head ptbg__group-head--center" data-reveal>
      <span class="ptbg__group-eyebrow">Built for Calgary</span>
      <h2 class="ptbg__group-title">Find tires by what you drive in</h2>
      <p class="ptbg__group-body ptbg__group-body--center">Calgary asks more from tires than almost any city in Canada. Chinooks swing temps 20°C in an afternoon. The October winter-tire deadline collides with potholes that show up by April. Pick the use-case below, or scroll for all 26 brands.</p>
    </div>
    <div class="ptbg__context ptbg__context--four" data-reveal>
      <a href="/collections/winter-tires" class="ptbg__ctx-card ptbg__ctx-card--link">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--winter">Winter</span>
        <h3 class="ptbg__ctx-title">Cold, ice &amp; chinooks</h3>
        <p class="ptbg__ctx-body">Michelin X-Ice Snow, Bridgestone Blizzak WS90, and 24 other 3PMSF-rated winter tires built to stay flexible below -20°C.</p>
        <span class="ptbg__ctx-link">Shop winter tires<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
      <a href="/collections/all-weather-tires" class="ptbg__ctx-card ptbg__ctx-card--link">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--allweather">All-weather</span>
        <h3 class="ptbg__ctx-title">One tire, all year</h3>
        <p class="ptbg__ctx-body">Michelin CrossClimate2 and other 3PMSF all-weather tires that meet Alberta's winter-tire law — no swap twice a year.</p>
        <span class="ptbg__ctx-link">Shop all-weather<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
      <a href="/collections/all-terrain-tires" class="ptbg__ctx-card ptbg__ctx-card--link">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--at">All-terrain</span>
        <h3 class="ptbg__ctx-title">Trucks, trailers &amp; gravel</h3>
        <p class="ptbg__ctx-body">BFGoodrich KO3, Toyo Open Country A/T III, Mickey Thompson Baja Boss. Built for gravel east of Calgary and the Highway 1 / 93 mountain runs.</p>
        <span class="ptbg__ctx-link">Shop all-terrain<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
      <a href="/collections/all-season-tires" class="ptbg__ctx-card ptbg__ctx-card--link">
        <span class="ptbg__ctx-badge ptbg__ctx-badge--highway">Highway / Touring</span>
        <h3 class="ptbg__ctx-title">Daily commute &amp; long highway</h3>
        <p class="ptbg__ctx-body">Continental TrueContact Tour, Michelin Defender 2, Yokohama Geolandar — quiet, fuel-efficient tires for daily Deerfoot driving.</p>
        <span class="ptbg__ctx-link">Shop highway tires<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
      </a>
    </div>

    {%- comment -%} Tier jumper — anchor nav to scroll directly to a tier {%- endcomment -%}
    <nav class="ptbg__jumper" data-reveal aria-label="Jump to a brand tier">
      <span class="ptbg__jumper-label">Or jump to:</span>
      <ul class="ptbg__jumper-list" role="list">
        <li><a href="#tier-premium" class="ptbg__jumper-link"><span class="ptbg__jumper-dot ptbg__jumper-dot--premium"></span>Premium</a></li>
        <li><a href="#tier-premium-adjacent" class="ptbg__jumper-link"><span class="ptbg__jumper-dot ptbg__jumper-dot--padj"></span>Premium-Adjacent</a></li>
        <li><a href="#tier-best-value" class="ptbg__jumper-link"><span class="ptbg__jumper-dot ptbg__jumper-dot--bestvalue"></span>Best Value</a></li>
        <li><a href="#tier-budget" class="ptbg__jumper-link"><span class="ptbg__jumper-dot ptbg__jumper-dot--budget"></span>Budget</a></li>
        <li><a href="#tier-wheels" class="ptbg__jumper-link"><span class="ptbg__jumper-dot ptbg__jumper-dot--wheels"></span>Wheels</a></li>
      </ul>
    </nav>

    {%- comment -%}
      Pre-compute a flat handle→image-url map BEFORE the tier loop runs.
      Inline `collections[handle].products` lookups inside the nested tier loop
      only resolve for the first match per tier (Shopify render-time quirk on nested
      collection access). Hoisting to a top-level flat loop sidesteps that.
    {%- endcomment -%}
    {%- capture bento_image_map -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.brand_type != 'wheel' -%}
          {%- assign _h = block.settings.name | handleize -%}
          {%- assign _u = '' -%}
          {%- if block.settings.hero_image != blank -%}
            {%- assign _u = block.settings.hero_image | image_url: width: 720 -%}
          {%- else -%}
            {%- for _p in collections[_h].products limit: 1 -%}
              {%- if _p.featured_image -%}
                {%- assign _u = _p.featured_image | image_url: width: 720 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if _u != '' -%}{{ _h }}@@{{ _u }}||{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign bento_image_map = bento_image_map | strip -%}

    {%- comment -%} Tire brands grouped by tier — render 4 tiers in order: Premium, Premium-Adjacent, Best Value, Budget {%- endcomment -%}
    {%- if tire_brands_count > 0 -%}
      {%- assign tier_keys = 'premium,premium-adjacent,best-value,budget' | split: ',' -%}
      {%- for tier in tier_keys -%}
        {%- liquid
          assign tier_label = ''
          assign tier_blurb = ''
          case tier
            when 'premium'
              assign tier_label = 'Premium'
              assign tier_blurb = "The flagships. When safety, longevity, and ride quality come ahead of price. Typical 235/65R17 installed: $1,300–$1,500 / set of 4."
            when 'premium-adjacent'
              assign tier_label = 'Premium-Adjacent'
              assign tier_blurb = "Names you know, often built by the same engineers as Tier 1. Real performance at a friendlier price. Typical 235/65R17 installed: $1,000–$1,250 / set of 4."
            when 'best-value'
              assign tier_label = 'Best Value'
              assign tier_blurb = "Our curated mid-tier — what we recommend when a customer wants quality without paying premium money. Typical 235/65R17 installed: $800–$950 / set of 4."
            when 'budget'
              assign tier_label = 'Budget'
              assign tier_blurb = "Honest, affordable options. We stand behind every install, balance, and torque the same way we do for premium tires. Typical 235/65R17 installed: $580–$720 / set of 4."
          endcase

          assign tier_count = 0
          for b in section.blocks
            if b.settings.brand_type != 'wheel'
              assign b_tier = b.settings.tier | default: 'premium-adjacent'
              if b_tier == tier
                assign tier_count = tier_count | plus: 1
              endif
            endif
          endfor
        -%}
        {%- if tier_count > 0 -%}
          <section class="ptbg__tier" data-tier="{{ tier }}" id="tier-{{ tier }}">
            <div class="ptbg__group-head" data-reveal>
              <span class="ptbg__group-eyebrow ptbg__group-eyebrow--{{ tier }}">{{ tier_label }}</span>
              <h2 class="ptbg__group-title">{{ tier_label }}</h2>
              <p class="ptbg__group-body">{{ tier_blurb }}</p>
            </div>

            {%- comment -%} Bento mosaic — first cell is the featured hero with product imagery, rest are asymmetric wordmark cells {%- endcomment -%}
            <div class="ptbg-bento" data-reveal>
              {%- assign tier_idx = 0 -%}
              {%- for block in section.blocks -%}
                {%- assign b_tier = block.settings.tier | default: 'premium-adjacent' -%}
                {%- if block.settings.brand_type != 'wheel' and b_tier == tier -%}
                  {%- assign tier_idx = tier_idx | plus: 1 -%}
                  {%- assign b_name = block.settings.name -%}
                  {%- assign b_handle = b_name | handleize -%}
                  {%- assign b_link = block.settings.page_link -%}
                  {%- if b_link == blank -%}
                    {%- assign b_link = '/collections/' | append: b_handle -%}
                  {%- endif -%}

                  {%- comment -%} Per-brand accent color map. Falls back to section accent. {%- endcomment -%}
                  {%- assign brand_color = '' -%}
                  {%- case b_handle -%}
                    {%- when 'michelin'         -%}{%- assign brand_color = '#0B5DA7' -%}
                    {%- when 'bridgestone'      -%}{%- assign brand_color = '#E60012' -%}
                    {%- when 'continental'      -%}{%- assign brand_color = '#FFA500' -%}
                    {%- when 'bfgoodrich'       -%}{%- assign brand_color = '#003DA5' -%}
                    {%- when 'firestone'        -%}{%- assign brand_color = '#DA291C' -%}
                    {%- when 'general'          -%}{%- assign brand_color = '#C8102E' -%}
                    {%- when 'toyo'             -%}{%- assign brand_color = '#C8102E' -%}
                    {%- when 'yokohama'         -%}{%- assign brand_color = '#D81C2F' -%}
                    {%- when 'dunlop'           -%}{%- assign brand_color = '#E1B100' -%}
                    {%- when 'falken'           -%}{%- assign brand_color = '#1E4FA3' -%}
                    {%- when 'nexen'            -%}{%- assign brand_color = '#E60012' -%}
                    {%- when 'kumho'            -%}{%- assign brand_color = '#DA291C' -%}
                    {%- when 'mickey-thompson'  -%}{%- assign brand_color = '#FF6A13' -%}
                    {%- when 'cooper'           -%}{%- assign brand_color = '#FF6A13' -%}
                    {%- when 'tesche'           -%}{%- assign brand_color = '#2D2D2D' -%}
                    {%- when 'suretrac'         -%}{%- assign brand_color = '#006B3F' -%}
                    {%- when 'cargomax'         -%}{%- assign brand_color = '#1A3E72' -%}
                    {%- when 'sierra'           -%}{%- assign brand_color = '#7A5230' -%}
                    {%- when 'composal'         -%}{%- assign brand_color = '#009688' -%}
                    {%- when 'radar'            -%}{%- assign brand_color = '#DA291C' -%}
                    {%- when 'haida'            -%}{%- assign brand_color = '#C8102E' -%}
                    {%- when 'rotalla'          -%}{%- assign brand_color = '#FF6A13' -%}
                    {%- when 'mileking'         -%}{%- assign brand_color = '#FFA500' -%}
                  {%- endcase -%}
                  {%- if brand_color == '' -%}{%- assign brand_color = accent -%}{%- endif -%}

                  {%- assign cell_classes = 'ptbg-bento__cell' -%}
                  {%- if tier_idx == 1 -%}
                    {%- assign cell_classes = cell_classes | append: ' ptbg-bento__cell--featured' -%}
                  {%- endif -%}

                  <a href="{{ b_link }}"
                     class="{{ cell_classes }}"
                     data-brand="{{ b_handle }}"
                     style="--brand-color: {{ brand_color }}; --idx: {{ tier_idx | minus: 1 }};"
                     aria-label="View {{ b_name | escape }} tires">
                    <span class="ptbg-bento__wash" aria-hidden="true"></span>
                    <span class="ptbg-bento__glow" aria-hidden="true"></span>

                    {%- comment -%} Look up pre-computed image URL from bento_image_map (handle@@url||) {%- endcomment -%}
                    {%- assign _needle = b_handle | append: '@@' -%}
                    {%- assign _photo_url = '' -%}
                    {%- if bento_image_map contains _needle -%}
                      {%- assign _segments = bento_image_map | split: '||' -%}
                      {%- for _seg in _segments -%}
                        {%- if _seg contains _needle -%}
                          {%- assign _parts = _seg | split: '@@' -%}
                          {%- assign _photo_url = _parts | last | strip -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {%- if _photo_url != '' -%}
                      <span class="ptbg-bento__photo" aria-hidden="true">
                        <img src="{{ _photo_url }}" alt="{{ b_name | escape }} tires in stock at Prince Tires Calgary" loading="lazy" class="ptbg-bento__photo-img">
                      </span>
                    {%- endif -%}

                    <span class="ptbg-bento__inner">
                      <span class="ptbg-bento__top">
                        <span class="ptbg-bento__logo">
                          {%- if block.settings.logo != blank -%}
                            {{ block.settings.logo | image_url: height: 80 | image_tag: loading: 'lazy', class: 'ptbg-bento__logo-img', alt: b_name }}
                          {%- else -%}
                            {%- assign asset_filename = 'brand-' | append: b_handle | append: '.webp' -%}
                            <img src="{{ asset_filename | asset_url }}" alt="{{ b_name | escape }}" class="ptbg-bento__logo-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                            <span class="ptbg-bento__initial" style="display:none">{{ b_name | slice: 0, 1 | upcase }}</span>
                          {%- endif -%}
                        </span>
                        {%- if tier_idx == 1 -%}
                          <span class="ptbg-bento__chip">Featured</span>
                        {%- endif -%}
                      </span>

                      <span class="ptbg-bento__body">
                        <span class="ptbg-bento__wordmark">{{ b_name | escape }}</span>
                        {%- if tier_idx == 1 and block.settings.tagline != blank -%}
                          <span class="ptbg-bento__tagline">{{ block.settings.tagline | escape }}</span>
                        {%- endif -%}

                        <span class="ptbg-bento__foot">
                          {%- if block.settings.categories != blank -%}
                            {%- assign cats = block.settings.categories | split: ',' | first: 2 -%}
                            <span class="ptbg-bento__cats">
                              {%- for c in cats -%}
                                <span class="ptbg-bento__cat">{{ c | strip | escape }}</span>
                              {%- endfor -%}
                            </span>
                          {%- endif -%}
                          <span class="ptbg-bento__arrow" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </span>
                        </span>
                      </span>
                    </span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Wheel brand bento — same mosaic treatment as tires {%- endcomment -%}
    {%- if wheel_brands_count > 0 -%}
      <section class="ptbg__tier" data-tier="wheels" id="tier-wheels">
        <div class="ptbg__group-head" data-reveal>
          <span class="ptbg__group-eyebrow">Wheel brands</span>
          <h2 class="ptbg__group-title">Wheel brands in our showroom</h2>
          <p class="ptbg__group-body">Off-road stance, Canadian-winter-rated finishes, premium daily-driver looks — all fitment-checked against your make &amp; model before purchase.</p>
        </div>

        {%- comment -%}
          Pre-fetch wheel images. Each wheel brand picks a different product from the shared /collections/wheels
          collection (by forloop.index0), so each cell shows a unique wheel.
        {%- endcomment -%}
        {%- capture wheel_image_map -%}
          {%- assign _wheel_offset = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.brand_type == 'wheel' -%}
              {%- assign _wh = block.settings.name | handleize -%}
              {%- assign _wu = '' -%}
              {%- if block.settings.hero_image != blank -%}
                {%- assign _wu = block.settings.hero_image | image_url: width: 720 -%}
              {%- else -%}
                {%- assign _wb_col = collections[_wh] -%}
                {%- if _wb_col.products_count > 0 -%}
                  {%- for _wp in _wb_col.products limit: 1 -%}
                    {%- if _wp.featured_image -%}
                      {%- assign _wu = _wp.featured_image | image_url: width: 720 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- assign _idx = 0 -%}
                  {%- for _wp in collections.wheels.products limit: 12 -%}
                    {%- if _idx == _wheel_offset and _wp.featured_image and _wu == '' -%}
                      {%- assign _wu = _wp.featured_image | image_url: width: 720 -%}
                    {%- endif -%}
                    {%- assign _idx = _idx | plus: 1 -%}
                  {%- endfor -%}
                  {%- assign _wheel_offset = _wheel_offset | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
              {%- if _wu != '' -%}{{ _wh }}@@{{ _wu }}||{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign wheel_image_map = wheel_image_map | strip -%}

        <div class="ptbg-bento" data-reveal>
          {%- assign wheel_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.brand_type == 'wheel' -%}
              {%- assign wheel_idx = wheel_idx | plus: 1 -%}
              {%- assign wb_name = block.settings.name -%}
              {%- assign wb_handle = wb_name | handleize -%}
              {%- assign wb_link = block.settings.page_link -%}
              {%- if wb_link == blank -%}
                {%- assign wb_link = '/collections/wheels' -%}
              {%- endif -%}

              {%- assign w_color = '' -%}
              {%- case wb_handle -%}
                {%- when 'xf-off-road' -%}{%- assign w_color = '#FF6A13' -%}
                {%- when 'rtx'         -%}{%- assign w_color = '#1E4FA3' -%}
                {%- when 'envy'        -%}{%- assign w_color = '#6B2BAA' -%}
              {%- endcase -%}
              {%- if w_color == '' -%}{%- assign w_color = accent -%}{%- endif -%}

              {%- assign _w_needle = wb_handle | append: '@@' -%}
              {%- assign _w_photo = '' -%}
              {%- if wheel_image_map contains _w_needle -%}
                {%- assign _w_segs = wheel_image_map | split: '||' -%}
                {%- for _ws in _w_segs -%}
                  {%- if _ws contains _w_needle -%}
                    {%- assign _w_parts = _ws | split: '@@' -%}
                    {%- assign _w_photo = _w_parts | last | strip -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- assign w_classes = 'ptbg-bento__cell' -%}
              {%- if wheel_idx == 1 -%}
                {%- assign w_classes = w_classes | append: ' ptbg-bento__cell--featured' -%}
              {%- endif -%}

              <a href="{{ wb_link }}"
                 class="{{ w_classes }}"
                 data-brand="{{ wb_handle }}"
                 style="--brand-color: {{ w_color }}; --idx: {{ wheel_idx | minus: 1 }};"
                 aria-label="Shop {{ wb_name | escape }} wheels"
                 {{ block.shopify_attributes }}>
                <span class="ptbg-bento__wash" aria-hidden="true"></span>
                <span class="ptbg-bento__glow" aria-hidden="true"></span>

                {%- if _w_photo != '' -%}
                  <span class="ptbg-bento__photo" aria-hidden="true">
                    <img src="{{ _w_photo }}" alt="{{ wb_name | escape }} wheels in stock at Prince Tires Calgary" loading="lazy" class="ptbg-bento__photo-img">
                  </span>
                {%- endif -%}

                <span class="ptbg-bento__inner">
                  <span class="ptbg-bento__top">
                    <span class="ptbg-bento__logo">
                      {%- if block.settings.logo != blank -%}
                        {{ block.settings.logo | image_url: height: 80 | image_tag: loading: 'lazy', class: 'ptbg-bento__logo-img', alt: wb_name }}
                      {%- else -%}
                        {%- assign w_asset = 'brand-' | append: wb_handle | append: '.webp' -%}
                        <img src="{{ w_asset | asset_url }}" alt="{{ wb_name | escape }}" class="ptbg-bento__logo-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                        <span class="ptbg-bento__initial" style="display:none">{{ wb_name | slice: 0, 1 | upcase }}</span>
                      {%- endif -%}
                    </span>
                    {%- if wheel_idx == 1 -%}
                      <span class="ptbg-bento__chip">Featured</span>
                    {%- endif -%}
                  </span>

                  <span class="ptbg-bento__body">
                    <span class="ptbg-bento__wordmark">{{ wb_name | escape }}</span>
                    {%- if wheel_idx == 1 and block.settings.tagline != blank -%}
                      <span class="ptbg-bento__tagline">{{ block.settings.tagline | escape }}</span>
                    {%- endif -%}

                    <span class="ptbg-bento__foot">
                      {%- if block.settings.categories != blank -%}
                        {%- assign w_cats = block.settings.categories | split: ',' | first: 2 -%}
                        <span class="ptbg-bento__cats">
                          {%- for c in w_cats -%}
                            <span class="ptbg-bento__cat">{{ c | strip | escape }}</span>
                          {%- endfor -%}
                        </span>
                      {%- endif -%}
                      <span class="ptbg-bento__arrow" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                    </span>
                  </span>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} FAQ — pulled from section settings, max 12, emitted as FAQPage schema {%- endcomment -%}
    {%- liquid
      assign faq_qs = '' | split: ','
      for i in (1..12)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          assign faq_qs = faq_qs | concat: q
        endif
      endfor
    -%}
    <div class="ptbg__faq" data-reveal>
      <div class="ptbg__faq-head">
        <span class="ptbg__group-eyebrow">Frequently asked</span>
        <h2 class="ptbg__group-title">Calgary driver FAQs</h2>
      </div>
      <div class="ptbg__faq-list">
        {%- for i in (1..12) -%}
          {%- liquid
            assign q_key = 'faq_' | append: i | append: '_q'
            assign a_key = 'faq_' | append: i | append: '_a'
            assign q = section.settings[q_key]
            assign a = section.settings[a_key]
          -%}
          {%- if q != blank and a != blank -%}
            <details class="ptbg__faq-item">
              <summary class="ptbg__faq-q">
                <span>{{ q | escape }}</span>
                <span class="ptbg__faq-chev" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </summary>
              <div class="ptbg__faq-a">
                <p>{{ a | escape | newline_to_br }}</p>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} CTA banner — accent gradient {%- endcomment -%}
    <div class="ptbg__cta" data-reveal>
      <div class="ptbg__cta-text">
        <h2 class="ptbg__cta-heading">{{ section.settings.cta_heading | default: "Don't see your brand?" | escape }}</h2>
        <p class="ptbg__cta-desc">{{ section.settings.cta_description | default: 'Tell us your year, make, and tire size and we will source it. Same-day on most stocked sizes, two business days on special orders.' | escape }}</p>
      </div>
      <div class="ptbg__cta-buttons">
        <a href="{{ section.settings.cta_primary_link | default: '/pages/booking' }}" class="ptbg__cta-btn ptbg__cta-btn--primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          {{ section.settings.cta_primary_label | default: 'Book installation' | escape }}
        </a>
        {%- assign cta_phone_clean = section.settings.cta_phone | default: '(403) 452-4283' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
        <a href="tel:+1{{ cta_phone_clean }}" class="ptbg__cta-btn ptbg__cta-btn--secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {{ section.settings.cta_phone | default: '(403) 452-4283' | escape }}
        </a>
      </div>
      <div class="ptbg__cta-nap">
        <strong>Prince Tires</strong> · 111 42 Ave SW, Calgary, AB T2G 0A4 · Mon–Sat 9:30–5:30, Sun 10:00–3:30
      </div>
    </div>

  </div>

  {%- comment -%} Sticky mobile bottom CTA bar — only visible <768px {%- endcomment -%}
  <div class="ptbg__sticky-cta" aria-label="Quick actions">
    <a href="/?vehicle-search=1" class="ptbg__sticky-btn ptbg__sticky-btn--primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      Find my tires
    </a>
    <a href="/pages/booking" class="ptbg__sticky-btn">
      Book
    </a>
    {%- assign sticky_phone = section.settings.cta_phone | default: '(403) 452-4283' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
    <a href="tel:+1{{ sticky_phone }}" class="ptbg__sticky-btn" aria-label="Call Prince Tires">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Call
    </a>
  </div>

  {%- comment -%} JSON-LD: LocalBusiness + FAQPage + ItemList for GEO citation {%- endcomment -%}
  {%- liquid
    capture faq_questions_json
      assign faq_count = 0
      for i in (1..12)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          if faq_count > 0
            echo ','
          endif
          echo '{"@type":"Question","name":'
          echo q | json
          echo ',"acceptedAnswer":{"@type":"Answer","text":'
          echo a | json
          echo '}}'
          assign faq_count = faq_count | plus: 1
        endif
      endfor
    endcapture

    capture brand_list_json
      assign list_pos = 0
      for block in section.blocks
        assign bl_name = block.settings.name
        assign bl_handle = bl_name | handleize
        assign bl_link = block.settings.page_link
        if bl_link == blank
          assign bl_link = '/collections/' | append: bl_handle
        endif
        if list_pos > 0
          echo ','
        endif
        assign list_pos = list_pos | plus: 1
        echo '{"@type":"ListItem","position":'
        echo list_pos
        echo ',"name":'
        echo bl_name | json
        echo ',"url":"'
        echo shop.url
        echo bl_link
        echo '"}'
      endfor
    endcapture
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoPartsStore",
        "@id": "{{ shop.url }}/#business",
        "name": "Prince Tires",
        "url": "{{ shop.url }}",
        "telephone": "+1-403-452-4283",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "111 42 Ave SW",
          "addressLocality": "Calgary",
          "addressRegion": "AB",
          "postalCode": "T2G 0A4",
          "addressCountry": "CA"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "09:30", "closes": "17:30" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "10:00", "closes": "15:30" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ section.settings.aggregate_rating | default: '4.9' }}",
          "reviewCount": "{{ section.settings.review_count | default: '562' }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      }
      {%- if faq_count > 0 -%}
      ,{ "@type": "FAQPage", "mainEntity": [ {{ faq_questions_json }} ] }
      {%- endif -%}
      ,{
        "@type": "ItemList",
        "@id": "{{ shop.url }}/pages/brands#brands-list",
        "name": "Tire and wheel brands stocked at Prince Tires Calgary",
        "numberOfItems": {{ section.blocks.size }},
        "itemListOrder": "https://schema.org/ItemListOrderAscending",
        "itemListElement": [ {{ brand_list_json }} ]
      }
    ]
  }
  </script>
</section>

{% stylesheet %}
  .ptbg {
    position: relative;
    background: #ffffff;
    color: #0a0a0a;
    padding: 4.5rem 0 6rem;
    isolation: isolate;
    font-family: 'Outfit', system-ui, sans-serif;
  }
  .ptbg__container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* Breadcrumb */
  .ptbg__breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: rgba(10,10,10,0.55); margin-bottom: 2.5rem; }
  .ptbg__crumb { color: inherit; text-decoration: none; transition: color 0.18s; }
  .ptbg__crumb:hover { color: #0a0a0a; }
  .ptbg__crumb--current { color: #0a0a0a; font-weight: 600; }
  .ptbg__crumb-sep { color: rgba(10,10,10,0.3); }

  /* Hero — asymmetric grid */
  .ptbg__hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(10,10,10,0.1);
    margin-bottom: 3rem;
  }
  .ptbg__hero-left { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .ptbg__hero-right { display: flex; flex-direction: column; gap: 1.5rem; }

  .ptbg__eyebrow {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--brand-accent);
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 999px;
  }
  .ptbg__eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-accent);
    box-shadow: 0 0 12px var(--brand-accent);
  }

  .ptbg__title {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.96;
    margin: 0;
    color: #0a0a0a;
  }
  .ptbg__tldr {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: rgba(10,10,10,0.78);
    margin: 0;
    max-width: 60ch;
  }
  .ptbg__hero-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .ptbg__hero-cta {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.85rem 1.25rem;
    background: var(--brand-accent);
    color: #fff;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 26px -12px color-mix(in oklab, var(--brand-accent) 55%, transparent);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
  }
  .ptbg__hero-cta:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -12px color-mix(in oklab, var(--brand-accent) 75%, transparent); }
  .ptbg__hero-cta--secondary {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(10, 10, 10, 0.16);
    box-shadow: none;
  }
  .ptbg__hero-cta--secondary:hover {
    background: rgba(10, 10, 10, 0.04);
    border-color: rgba(10, 10, 10, 0.32);
    box-shadow: 0 4px 12px -4px rgba(10, 10, 10, 0.12);
  }
  .ptbg__hero-call { color: #0a0a0a; text-decoration: none; font-weight: 500; opacity: 0.65; transition: opacity 0.18s; }
  .ptbg__hero-call:hover { opacity: 1; }

  /* Stats strip */
  .ptbg__stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin-bottom: 4.5rem;
  }
  .ptbg__stat {
    position: relative;
    padding: 1.5rem 1.4rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 16px;
    display: flex; flex-direction: column; gap: 0.45rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, background 0.25s, box-shadow 0.25s;
  }
  .ptbg__stat:hover {
    transform: translateY(-3px);
    background: #ffffff;
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 10px 24px -16px rgba(10,10,10,0.15);
  }
  .ptbg__stat-value {
    font-size: clamp(1.7rem, 2.6vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1;
    color: var(--brand-accent);
  }
  .ptbg__stat-suffix { font-size: 0.7em; margin-left: 0.1em; opacity: 0.8; }
  .ptbg__stat-label { font-size: 0.95rem; color: rgba(10,10,10,0.7); line-height: 1.35; }

  /* Section heads */
  .ptbg__group-head { display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1.75rem; max-width: 64ch; }
  .ptbg__group-head--center { text-align: center; align-items: center; margin: 5rem auto 2.25rem; max-width: 64ch; }
  .ptbg__group-eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-accent); }
  .ptbg__group-title { font-size: clamp(1.85rem, 3vw, 2.6rem); font-weight: 700; letter-spacing: -0.02em; margin: 0; color: #0a0a0a; }
  .ptbg__group-body { font-size: 1.08rem; line-height: 1.65; color: rgba(10,10,10,0.75); margin: 0; }
  .ptbg__group-body--center { text-align: center; }

  /* Brand card grid */
  .ptbg__grid {
    list-style: none; padding: 0; margin: 0 0 5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .ptbg__grid--wheels { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-bottom: 0; }

  .ptbg__card { list-style: none; }
  .ptbg__card-link {
    position: relative;
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: 1.5rem;
    background: #ffffff;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 18px;
    color: inherit; text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.3s;
    height: 100%;
  }
  .ptbg__card-link:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 18px 40px -22px rgba(10,10,10,0.22);
  }

  .ptbg__card-logo {
    width: 100%; aspect-ratio: 2.2 / 1;
    background: #fafafa;
    border-radius: 12px;
    padding: 0.9rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 1px rgba(10,10,10,0.06);
  }
  .ptbg__logo-img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbg__logo-initial {
    font-size: 2rem; font-weight: 800; letter-spacing: -0.04em;
    color: #0a0a0a;
  }

  .ptbg__card-body { display: flex; flex-direction: column; gap: 0.7rem; flex: 1; }
  .ptbg__card-name { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; color: #0a0a0a; }
  .ptbg__card-tagline { font-size: 1rem; line-height: 1.5; color: rgba(10,10,10,0.72); margin: 0; }
  .ptbg__card-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; }
  .ptbg__tag {
    display: inline-flex; align-items: center;
    padding: 0.34rem 0.65rem;
    font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase;
    background: #f3f3f3;
    border: 1px solid rgba(10,10,10,0.08);
    color: rgba(10,10,10,0.78);
    border-radius: 6px;
  }
  .ptbg__card-arrow {
    position: absolute; top: 1.25rem; right: 1.25rem;
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    color: var(--brand-accent);
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
  }
  .ptbg__card-link:hover .ptbg__card-arrow { transform: translate(3px, -3px); background: var(--brand-accent); color: #fff; }

  /* Tier jumper anchor nav */
  .ptbg__jumper {
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.85rem 1.1rem;
    background: #fafafa;
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: 14px;
  }
  .ptbg__jumper-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.55);
  }
  .ptbg__jumper-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ptbg__jumper-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: #0a0a0a;
    text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, background 0.18s;
  }
  .ptbg__jumper-link:hover {
    border-color: rgba(10, 10, 10, 0.32);
    transform: translateY(-1px);
    background: #ffffff;
  }
  .ptbg__jumper-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ptbg__jumper-dot--premium { background: #0B5DA7; }
  .ptbg__jumper-dot--padj { background: #FF6A13; }
  .ptbg__jumper-dot--bestvalue { background: #009688; }
  .ptbg__jumper-dot--budget { background: #DA291C; }
  .ptbg__jumper-dot--wheels { background: #6B2BAA; }
  @media (max-width: 560px) {
    .ptbg__jumper { padding: 0.75rem; gap: 0.65rem; }
    .ptbg__jumper-label { width: 100%; }
  }

  /* Smooth scroll target offset for sticky header */
  .ptbg__tier { scroll-margin-top: 90px; }

  /* Per-tier section (bento mosaic) */
  .ptbg__tier { margin-bottom: 5rem; }

  /* ========================================
     BENTO BRAND WORLD — asymmetric mosaic
     6-col grid with dense packing. Featured cell
     spans 4x2, standard cells span 2x1, with
     varied span overrides via nth-child to break
     the rhythm and create editorial asymmetry.
     ======================================== */
  .ptbg-bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 178px;
    grid-auto-flow: dense;
    gap: 14px;
  }

  /* Default cell footprint — 1/3 width, single row */
  .ptbg-bento__cell {
    grid-column: span 2;
    grid-row: span 1;
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    isolation: isolate;
    border: 1px solid rgba(10, 10, 10, 0.07);
    box-shadow: 0 1px 0 rgba(10, 10, 10, 0.02);
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s;
    will-change: transform;
  }

  /* Featured hero cell — first in every tier */
  .ptbg-bento__cell--featured {
    grid-column: span 4;
    grid-row: span 2;
  }

  /* No asymmetric row/col overrides — featured stays 4x2, all other cells stay
     uniform 2x1 so the mosaic reads as "one hero + clean grid" instead of
     introducing tall/wide variants that disrupt the rhythm. */

  /* Color wash — soft branded gradient bg */
  .ptbg-bento__wash {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 100% at 100% 0%,
        color-mix(in oklab, var(--brand-color) 22%, transparent) 0%,
        transparent 55%),
      linear-gradient(180deg,
        color-mix(in oklab, var(--brand-color) 5%, #ffffff) 0%,
        #ffffff 70%);
    transition: opacity 0.5s ease, background 0.5s ease;
  }

  /* Hover glow — pulses brand color edge */
  .ptbg-bento__glow {
    position: absolute;
    inset: -1px;
    z-index: 0;
    border-radius: 22px;
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--brand-color) 65%, transparent),
      color-mix(in oklab, var(--brand-color) 15%, transparent));
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  /* Product photo — uniform size on all non-featured cells.
     Featured cell scales noticeably bigger to anchor the hierarchy. */
  .ptbg-bento__photo {
    position: absolute;
    right: -8%;
    bottom: -14%;
    width: 46%;
    aspect-ratio: 1 / 1;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transform: rotate(-6deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 16px 22px rgba(10, 10, 10, 0.14));
  }
  .ptbg-bento__photo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Featured cell — huge hero photo */
  .ptbg-bento__cell--featured .ptbg-bento__photo {
    right: -8%;
    bottom: -14%;
    width: 60%;
    transform: rotate(-8deg);
    filter: drop-shadow(0 22px 30px rgba(10, 10, 10, 0.2));
  }

  /* Content frame */
  .ptbg-bento__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.15rem 1.25rem 1.05rem;
    height: 100%;
  }
  .ptbg-bento__cell--featured .ptbg-bento__inner {
    padding: 1.6rem 1.75rem 1.5rem;
  }

  .ptbg-bento__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  /* Brand logo box */
  .ptbg-bento__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    max-width: 100px;
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: 7px;
    backdrop-filter: blur(6px);
  }
  .ptbg-bento__cell--featured .ptbg-bento__logo {
    height: 44px;
    max-width: 150px;
    padding: 6px 12px;
    border-radius: 9px;
  }
  .ptbg-bento__logo-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
  }
  .ptbg-bento__initial {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand-color);
  }

  /* Featured chip */
  .ptbg-bento__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.65rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-color);
    backdrop-filter: blur(6px);
  }
  .ptbg-bento__chip::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand-color);
    box-shadow: 0 0 8px var(--brand-color);
  }

  /* Body — wordmark + tagline */
  .ptbg-bento__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: auto;
  }

  /* The big brand wordmark — display type. Adjusts per cell size. */
  .ptbg-bento__wordmark {
    font-size: clamp(1.4rem, 2.3vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: #0a0a0a;
    max-width: 62%;
    transition: color 0.3s ease;
  }
  .ptbg-bento__cell--featured .ptbg-bento__wordmark {
    font-size: clamp(2.6rem, 5.8vw, 4.4rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    max-width: 65%;
  }

  .ptbg-bento__tagline {
    font-size: 1.02rem;
    line-height: 1.45;
    color: rgba(10, 10, 10, 0.7);
    max-width: 60%;
    margin-top: 0.35rem;
  }

  .ptbg-bento__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.45rem;
  }

  .ptbg-bento__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    overflow: hidden;
  }
  .ptbg-bento__cat {
    display: inline-flex;
    align-items: center;
    padding: 0.24rem 0.55rem;
    background: rgba(10, 10, 10, 0.045);
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(10, 10, 10, 0.7);
    white-space: nowrap;
  }

  /* Arrow — hidden by default, slides in on hover */
  .ptbg-bento__arrow {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-color);
    background: color-mix(in oklab, var(--brand-color) 12%, #ffffff);
    border: 1px solid color-mix(in oklab, var(--brand-color) 32%, transparent);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s, color 0.3s;
  }

  /* HOVER STATE — lift, glow, arrow nudge, photo zoom */
  .ptbg-bento__cell:hover {
    transform: translateY(-5px);
    box-shadow:
      0 28px 50px -28px color-mix(in oklab, var(--brand-color) 45%, rgba(10, 10, 10, 0.2)),
      0 0 0 1px color-mix(in oklab, var(--brand-color) 35%, transparent);
    border-color: transparent;
  }
  .ptbg-bento__cell:hover .ptbg-bento__glow {
    opacity: 0.12;
  }
  .ptbg-bento__cell:hover .ptbg-bento__arrow {
    background: var(--brand-color);
    color: #ffffff;
    transform: translate(3px, -3px);
  }
  .ptbg-bento__cell:hover .ptbg-bento__photo {
    transform: rotate(-4deg) scale(1.06);
  }
  .ptbg-bento__cell:hover .ptbg-bento__wordmark {
    color: var(--brand-color);
  }

  .ptbg-bento__cell:active {
    transform: translateY(-2px) scale(0.995);
  }

  /* Reveal — staggered by --idx */
  .ptbg-bento[data-reveal] .ptbg-bento__cell {
    opacity: 0;
    transform: translateY(20px) scale(0.985);
    transition:
      opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s,
      border-color 0.3s;
    transition-delay: calc(var(--idx, 0) * 55ms);
  }
  .ptbg-bento[data-reveal].is-revealed .ptbg-bento__cell {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .ptbg-bento[data-reveal].is-revealed .ptbg-bento__cell:hover {
    transform: translateY(-5px);
  }

  /* Responsive — collapse to a 2-col grid on tablet, 1-col on mobile */
  @media (max-width: 960px) {
    .ptbg-bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 168px;
      gap: 12px;
    }
    .ptbg-bento__cell { grid-column: span 2; }
    .ptbg-bento__cell--featured { grid-column: span 4; grid-row: span 2; }
    .ptbg-bento__cell--featured .ptbg-bento__wordmark { max-width: 75%; font-size: clamp(2.4rem, 9vw, 3.6rem); }
    .ptbg-bento__tagline { max-width: 80%; }
  }
  @media (max-width: 560px) {
    .ptbg-bento {
      grid-template-columns: 1fr;
      grid-auto-rows: 150px;
    }
    .ptbg-bento__cell,
    .ptbg-bento__cell--featured { grid-column: span 1; grid-row: span 1; }
    .ptbg-bento__cell--featured { grid-row: span 2; }
    .ptbg-bento__cell--featured .ptbg-bento__wordmark { font-size: clamp(2rem, 11vw, 2.8rem); max-width: 70%; }
    .ptbg-bento__photo { width: 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ptbg-bento[data-reveal] .ptbg-bento__cell {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ptbg-bento__cell,
    .ptbg-bento__photo,
    .ptbg-bento__arrow,
    .ptbg-bento__glow { transition: none; }
  }

  /* Brand logo bar */
  .ptbg__brand-bar {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.6rem 0.25rem 1rem;
    margin-bottom: 1.5rem;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(10,10,10,0.15) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .ptbg__brand-bar::-webkit-scrollbar { height: 4px; }
  .ptbg__brand-bar::-webkit-scrollbar-thumb { background: rgba(10,10,10,0.15); border-radius: 2px; }
  .ptbg__brand-tab {
    flex: 0 0 auto;
    appearance: none;
    border: 1px solid rgba(10,10,10,0.1);
    background: #ffffff;
    padding: 0.6rem 1rem;
    border-radius: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(10,10,10,0.78);
    transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.2s;
    white-space: nowrap;
    min-height: 56px;
  }
  .ptbg__brand-tab:hover {
    border-color: color-mix(in oklab, var(--brand-accent) 40%, rgba(10,10,10,0.1));
    transform: translateY(-1px);
  }
  .ptbg__brand-tab--active {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #ffffff;
  }
  .ptbg__brand-tab--active:hover {
    color: #ffffff;
    background: var(--brand-accent);
  }
  .ptbg__brand-tab-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 36px;
    flex-shrink: 0;
    background: #ffffff;
    border-radius: 6px;
    padding: 4px;
    box-shadow: 0 0 0 1px rgba(10,10,10,0.06);
  }
  .ptbg__brand-tab--active .ptbg__brand-tab-logo {
    background: #ffffff;
  }
  .ptbg__brand-tab-img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbg__brand-tab-text { font-size: 0.85rem; font-weight: 800; color: #0a0a0a; }
  .ptbg__brand-tab-name { letter-spacing: -0.01em; }
  /* The "All" tab has no logo box */
  .ptbg__brand-tab[data-brand="all"] .ptbg__brand-tab-logo { display: none; }
  .ptbg__brand-tab[data-brand="all"] { padding: 0.65rem 1.2rem; }

  /* Tire products carousel */
  .ptbg__products-wrap { position: relative; }
  .ptbg__products-arrow {
    appearance: none;
    border: 1px solid rgba(10,10,10,0.1);
    background: #ffffff;
    color: #0a0a0a;
    width: 42px; height: 42px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: absolute; top: 110px; transform: translateY(-50%);
    cursor: pointer; z-index: 2;
    box-shadow: 0 8px 18px -10px rgba(10,10,10,0.18);
    transition: transform 0.18s, border-color 0.18s, color 0.18s;
  }
  .ptbg__products-arrow:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    transform: translateY(-50%) scale(1.06);
  }
  .ptbg__products-arrow:disabled { opacity: 0.3; cursor: default; transform: translateY(-50%); }
  .ptbg__products-arrow--prev { left: -22px; }
  .ptbg__products-arrow--next { right: -22px; }
  @media (max-width: 1320px) {
    .ptbg__products-arrow--prev { left: 6px; }
    .ptbg__products-arrow--next { right: 6px; }
  }
  @media (max-width: 600px) { .ptbg__products-arrow { display: none; } }

  .ptbg__products {
    list-style: none; padding: 0.25rem 0.25rem 1rem; margin: 0;
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(10,10,10,0.15) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .ptbg__products::-webkit-scrollbar { height: 6px; }
  .ptbg__products::-webkit-scrollbar-thumb { background: rgba(10,10,10,0.18); border-radius: 3px; }
  .ptbg__product {
    flex: 0 0 auto;
    width: clamp(200px, 24%, 260px);
    scroll-snap-align: start;
    transition: opacity 0.25s, transform 0.25s;
  }
  @media (max-width: 720px) { .ptbg__product { width: 70vw; } }
  .ptbg__product[hidden] { display: none; }
  .ptbg__product.is-filtered-out { display: none; }
  .ptbg__product-link {
    display: flex; flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 18px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.25s;
  }
  .ptbg__product-link:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 16px 30px -18px rgba(10,10,10,0.2);
  }
  .ptbg__product-img {
    aspect-ratio: 1 / 1;
    background: #fafafa;
    display: flex; align-items: center; justify-content: center;
    padding: 1.1rem;
    border-bottom: 1px solid rgba(10,10,10,0.05);
  }
  .ptbg__product-image { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbg__product-meta { padding: 1rem 1.1rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .ptbg__product-brand {
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--brand-accent);
  }
  .ptbg__product-title {
    font-size: 0.95rem; font-weight: 600;
    color: #0a0a0a;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ptbg__product-foot {
    margin-top: auto;
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 0.6rem;
  }
  .ptbg__product-price { font-size: 1rem; font-weight: 700; color: #0a0a0a; }
  .ptbg__product-cta { font-size: 0.85rem; font-weight: 600; color: var(--brand-accent); }

  /* Calgary context cards */
  .ptbg__context {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 5rem;
  }
  .ptbg__context--four {
    grid-template-columns: repeat(4, 1fr);
    margin-bottom: 4.5rem;
  }
  @media (max-width: 1080px) {
    .ptbg__context--four { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .ptbg__context--four { grid-template-columns: 1fr; }
  }
  .ptbg__ctx-card {
    padding: 1.75rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 18px;
    display: flex; flex-direction: column; gap: 0.85rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, background 0.25s;
  }
  .ptbg__ctx-card--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .ptbg__ctx-card:hover { transform: translateY(-3px); background: #ffffff; border-color: color-mix(in oklab, var(--brand-accent) 40%, rgba(10,10,10,0.08)); }
  .ptbg__ctx-card--link:hover .ptbg__ctx-link {
    gap: 0.6rem;
    border-color: var(--brand-accent);
  }
  .ptbg__ctx-badge {
    align-self: flex-start;
    padding: 0.35rem 0.7rem;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    border-radius: 999px;
  }
  .ptbg__ctx-badge--winter { background: rgba(37, 99, 235, 0.10); color: #1d4ed8; border: 1px solid rgba(37,99,235,0.28); }
  .ptbg__ctx-badge--allweather { background: rgba(79, 70, 229, 0.10); color: #4338ca; border: 1px solid rgba(79,70,229,0.28); }
  .ptbg__ctx-badge--at { background: rgba(217, 119, 6, 0.10); color: #b45309; border: 1px solid rgba(217,119,6,0.28); }
  .ptbg__ctx-badge--highway { background: rgba(15, 118, 110, 0.10); color: #0f766e; border: 1px solid rgba(15,118,110,0.28); }
  .ptbg__ctx-title { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; color: #0a0a0a; }
  .ptbg__ctx-body { font-size: 0.96rem; line-height: 1.55; color: rgba(10,10,10,0.72); margin: 0; flex: 1; }
  .ptbg__ctx-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    align-self: flex-start;
    font-size: 0.85rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-accent) 50%, transparent);
    transition: gap 0.2s, border-color 0.2s;
  }
  .ptbg__ctx-link:hover { gap: 0.6rem; border-color: var(--brand-accent); }

  /* FAQ */
  .ptbg__faq { max-width: 880px; margin: 0 auto 5rem; }
  .ptbg__faq-head { text-align: center; margin-bottom: 2rem; }
  .ptbg__faq-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .ptbg__faq-item {
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .ptbg__faq-item[open] { background: #ffffff; border-color: color-mix(in oklab, var(--brand-accent) 45%, rgba(10,10,10,0.08)); }
  .ptbg__faq-q {
    list-style: none;
    cursor: pointer;
    padding: 1.3rem 1.5rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    font-size: 1.1rem; font-weight: 600;
    color: #0a0a0a;
  }
  .ptbg__faq-q::-webkit-details-marker { display: none; }
  .ptbg__faq-chev {
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    color: var(--brand-accent);
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  .ptbg__faq-item[open] .ptbg__faq-chev { transform: rotate(180deg); background: color-mix(in oklab, var(--brand-accent) 12%, transparent); }
  .ptbg__faq-a { padding: 0 1.5rem 1.5rem; color: rgba(10,10,10,0.78); line-height: 1.65; font-size: 1.05rem; }
  .ptbg__faq-a p { margin: 0; }

  /* CTA banner — light, neutral with accent CTA */
  .ptbg__cta {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    padding: 2.5rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 22px;
  }
  .ptbg__cta-text { position: relative; z-index: 1; }
  .ptbg__cta-heading { font-size: clamp(1.5rem, 2.4vw, 2.05rem); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 0.6rem 0; color: #0a0a0a; }
  .ptbg__cta-desc { font-size: 1.08rem; line-height: 1.6; color: rgba(10,10,10,0.75); margin: 0; max-width: 60ch; }
  .ptbg__cta-buttons { display: flex; flex-direction: column; gap: 0.65rem; align-self: center; position: relative; z-index: 1; }
  .ptbg__cta-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem; font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .ptbg__cta-btn--primary { background: var(--brand-accent); color: #fff; box-shadow: 0 10px 26px -10px color-mix(in oklab, var(--brand-accent) 60%, transparent); }
  .ptbg__cta-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -10px color-mix(in oklab, var(--brand-accent) 75%, transparent); }
  .ptbg__cta-btn--secondary { background: transparent; color: #0a0a0a; border: 1px solid rgba(10,10,10,0.18); }
  .ptbg__cta-btn--secondary:hover { background: rgba(10,10,10,0.04); border-color: rgba(10,10,10,0.32); }
  .ptbg__cta-nap {
    grid-column: 1 / -1;
    position: relative; z-index: 1;
    padding-top: 1.5rem; margin-top: 0.5rem;
    border-top: 1px solid rgba(10,10,10,0.08);
    font-size: 0.95rem; color: rgba(10,10,10,0.65); letter-spacing: 0.01em;
  }
  .ptbg__cta-nap strong { color: #0a0a0a; font-weight: 700; }

  /* Sticky mobile bottom CTA bar */
  .ptbg__sticky-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0.65rem 0.75rem calc(0.65rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(10, 10, 10, 0.08);
    box-shadow: 0 -8px 24px -12px rgba(10, 10, 10, 0.12);
    gap: 0.5rem;
  }
  .ptbg__sticky-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 0.6rem;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.12);
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 600;
    color: #0a0a0a;
    text-decoration: none;
    transition: transform 0.18s, background 0.18s;
  }
  .ptbg__sticky-btn:active { transform: scale(0.96); }
  .ptbg__sticky-btn--primary {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
    flex: 1.4;
  }
  @media (max-width: 768px) {
    .ptbg__sticky-cta { display: flex; }
    .ptbg { padding-bottom: calc(6rem + 4.5rem); }
  }

  /* Reveal-on-scroll */
  [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1); }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  .ptbg__card[data-reveal] { transition-delay: calc(var(--idx, 0) * 50ms); }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* Responsive */
  @media (max-width: 960px) {
    .ptbg__hero { grid-template-columns: 1fr; gap: 1.5rem; padding-bottom: 2rem; margin-bottom: 2rem; }
    .ptbg__stats { grid-template-columns: repeat(2, 1fr); margin-bottom: 3rem; }
    .ptbg__context { grid-template-columns: 1fr; }
    .ptbg__cta { grid-template-columns: 1fr; padding: 1.75rem; }
  }
  @media (max-width: 560px) {
    .ptbg__title { font-size: clamp(2rem, 9vw, 2.8rem); }
    .ptbg__stats { grid-template-columns: 1fr; }
    .ptbg__grid, .ptbg__grid--wheels { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // Scroll-reveal
    var els = document.querySelectorAll('.ptbg [data-reveal]');
    if (els.length && typeof IntersectionObserver !== 'undefined') {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add('is-revealed'); });
    }

    // Per-tier brand tabs filter the tier's product carousel.
    // Brand tabs are also clickable as nav links (data-href) if held by ctrl/cmd,
    // but a plain click just filters. We add a separate "View brand →" affordance.
    document.querySelectorAll('.ptbg__tier').forEach(function (tierEl) {
      var tabs = tierEl.querySelectorAll('.ptbg__brand-tab');
      var carousel = tierEl.querySelector('.ptbg__products');
      var prev = tierEl.querySelector('[data-tier-prev]');
      var next = tierEl.querySelector('[data-tier-next]');
      if (!carousel) return;
      var products = carousel.querySelectorAll('.ptbg__product');

      function setArrowState() {
        if (!prev || !next) return;
        var maxScroll = carousel.scrollWidth - carousel.clientWidth;
        prev.disabled = carousel.scrollLeft <= 2;
        next.disabled = carousel.scrollLeft >= maxScroll - 2;
      }
      carousel.addEventListener('scroll', setArrowState, { passive: true });
      if (prev) prev.addEventListener('click', function () {
        var step = (carousel.querySelector('.ptbg__product:not(.is-filtered-out)') || {}).offsetWidth || 240;
        carousel.scrollBy({ left: -(step + 16), behavior: 'smooth' });
      });
      if (next) next.addEventListener('click', function () {
        var step = (carousel.querySelector('.ptbg__product:not(.is-filtered-out)') || {}).offsetWidth || 240;
        carousel.scrollBy({ left: step + 16, behavior: 'smooth' });
      });

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function (e) {
          // Cmd/Ctrl-click on a brand tab: open the brand page directly.
          if ((e.metaKey || e.ctrlKey) && tab.dataset.href) {
            window.open(tab.dataset.href, '_blank');
            return;
          }
          // Double-click: go to the brand page.
          // (single click just filters)
          var brand = tab.dataset.brand;
          tabs.forEach(function (t) {
            var on = (t === tab);
            t.classList.toggle('ptbg__brand-tab--active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          products.forEach(function (p) {
            var match = (brand === 'all' || p.dataset.brand === brand);
            p.classList.toggle('is-filtered-out', !match);
          });
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
          setTimeout(setArrowState, 350);
        });
        // Double-click on a brand tab: navigate to the brand's dedicated page.
        tab.addEventListener('dblclick', function () {
          if (tab.dataset.href) window.location.href = tab.dataset.href;
        });
      });
      setArrowState();
    });
  })();
{% endjavascript %}

