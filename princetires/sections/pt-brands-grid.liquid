  }
  .ptbg__faq-item[open] .ptbg__faq-chev { transform: rotate(180deg); background: color-mix(in oklab, var(--brand-accent) 12%, transparent); }
  .ptbg__faq-a { padding: 0 1.5rem 1.5rem; color: rgba(10,10,10,0.78); line-height: 1.65; font-size: 1.05rem; }
