  .ptbg__cta-heading { font-size: clamp(1.5rem, 2.4vw, 2.05rem); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 0.6rem 0; color: #0a0a0a; }
  .ptbg__cta-desc { font-size: 1.08rem; line-height: 1.6; color: rgba(10,10,10,0.75); margin: 0; max-width: 60ch; }
  .ptbg__cta-buttons { display: flex; flex-direction: column; gap: 0.65rem; align-self: center; position: relative; z-index: 1; }
  .ptbg__cta-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem; font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s;
    white-space: nowrap;
