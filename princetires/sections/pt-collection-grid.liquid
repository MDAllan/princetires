{%- comment -%}
  Auto-defaults on first visit:
  - All collections: cheapest-first sort (price-ascending) so customers see the
    lowest price first when they land.
  - Tire collections (tires / imported-tires): also add a seasonal pre-filter
    (Oct-Feb: Winter; Mar-Sep: All-Season + All-Weather).
  - Wheel collections (wheels / alloy-wheels / steel-wheels): also add an
    in-stock-only filter (SimGym rec #3 — bias wheels browsing to availability).
  Auto-default runs once per tab session via sessionStorage marker, so the
  user's choice to clear filters is respected for the rest of the session.
{%- endcomment -%}
<script>
(function () {
  if (window.__ptCollSeed) return;
  window.__ptCollSeed = true;
  var TIRE_COLLS  = { 'tires': 1, 'imported-tires': 1 };
  var WHEEL_COLLS = { 'wheels': 1, 'alloy-wheels': 1, 'steel-wheels': 1 };
  var handle = {{ collection.handle | json }};
  var isTire  = !!TIRE_COLLS[handle];
  var isWheel = !!WHEEL_COLLS[handle];
  // Cheapest-first now applies to EVERY collection; the seasonal / availability
  // extras below stay scoped to tire / wheel collections only.

  // Auto-default runs AT MOST ONCE per browser tab. After the user has touched
  // anything (cleared the season, picked a brand, etc.), the marker keeps the
  // script from re-applying the default and overriding their choice.
  var SEEDED = 'ptg_auto_seeded_' + handle;
  try { if (sessionStorage.getItem(SEEDED)) return; } catch (e) {}

  var qs = new URLSearchParams(window.location.search);
  var hasSort = qs.has('sort_by');
  var hasSeason = false;
  var hasAvailability = false;
  var hasUserFilter = false;
  qs.forEach(function (_v, k) {
    if (k === 'filter.p.m.custom.seasonality') hasSeason = true;
    if (k === 'filter.v.availability') hasAvailability = true;
    if (k.indexOf('filter.') === 0) hasUserFilter = true;
  });

  // Always mark as seeded — even on early returns — so the user's subsequent
  // edits (e.g. clearing the season) are respected for the rest of this tab session.
  function markSeeded() { try { sessionStorage.setItem(SEEDED, '1'); } catch (e) {} }

  // If the user arrived with any explicit filter, respect their intent.
  if (hasUserFilter) { markSeeded(); return; }
  // If a sort is already in the URL and this collection has no extra default left
  // to apply (season for tires, availability for wheels), respect the user's state.
  if (hasSort) {
    if (isTire && !hasSeason) { /* fall through to add the seasonal default */ }
    else if (isWheel && !hasAvailability) { /* fall through to add availability */ }
    else { markSeeded(); return; }
  }

  var changed = false;
  if (!hasSort) { qs.set('sort_by', 'price-ascending'); changed = true; }

  if (isTire && !hasSeason) {
    var m = new Date().getMonth(); // 0 = Jan
    if (m >= 9 || m <= 1) {
      // Oct, Nov, Dec, Jan, Feb → Winter
      qs.set('filter.p.m.custom.seasonality', 'Winter');
      changed = true;
    } else if (m >= 2 && m <= 8) {
      // Mar → Sep → All-Season + All-Weather
      qs.append('filter.p.m.custom.seasonality', 'All-Season');
      qs.append('filter.p.m.custom.seasonality', 'All-Weather');
      changed = true;
    }
  }

  if (isWheel && !hasAvailability) {
    // Availability-first: only show in-stock wheels by default. The customer can
    // clear this filter from the sidebar to see out-of-stock SKUs.
    qs.set('filter.v.availability', '1');
    changed = true;
  }

  markSeeded();
  if (changed) {
    window.location.replace(window.location.pathname + '?' + qs.toString());
  }
})();
</script>

{%- comment -%} Smart search config — brand list pulled from the live vendor facet so it always matches inventory {%- endcomment -%}
{%- assign smart_brands = '' -%}
{%- for f in collection.filters -%}
  {%- if f.param_name == 'filter.p.vendor' -%}
    {%- for v in f.values -%}
      {%- assign smart_brands = smart_brands | append: v.label | append: '||' -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
<script data-smart-search-config type="application/json">
{
  "minYear": {{ settings.smart_search_min_year | default: 2001 }},
  "maxYear": {{ settings.smart_search_max_year | default: 2026 }},
  "assetUrlBase": {{ 'pt-vehicle-2025.json' | asset_url | split: 'pt-vehicle-2025.json' | first | json }},
  "brands": {{ smart_brands | split: '||' | json }}
}
</script>

{%- paginate collection.products by section.settings.products_per_page -%}
{%- liquid
  assign price_max_val = 0
  for product in collection.products
    assign p = product.price | divided_by: 100
    if p > price_max_val
      assign price_max_val = p
    endif
  endfor
  assign price_max_rounded = price_max_val | plus: 49 | divided_by: 50 | times: 50
  assign price_max_rounded = price_max_rounded | at_least: 200
-%}
{%- liquid
  # Clearance collection gets a banner + per-card CLEARANCE badge + % off.
  assign is_clearance = false
  if collection.handle == 'clearance'
    assign is_clearance = true
  endif
-%}
<div class="ptg" style="--ptg-img-pad: {{ section.settings.image_padding }}rem; --ptg-img-ratio: {{ section.settings.image_ratio }};">

  <div class="ptg__container">
    <div class="ptg__layout">

      {%- comment -%} ── Sidebar Filters ── {%- endcomment -%}
      {% render 'pt-collection-sidebar', price_max_rounded: price_max_rounded %}

      {%- comment -%} ── Product Grid ── {%- endcomment -%}
      <div class="ptg__main">

        <button class="ptg__mobile-filter-btn" data-open-filters>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
          Filters
        </button>

        {% render 'pt-collection-garage-banner' %}

        {%- if section.settings.show_trust_bar -%}
        {%- endif -%}

        {%- if is_clearance -%}
          <div class="ptg__clearance-banner" role="note">
            <svg class="ptg__clearance-banner-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span class="ptg__clearance-banner-text"><strong>Clearance</strong> — final markdowns, while quantities last</span>
          </div>
        {%- endif -%}

        <div class="ptg__toolbar">
          <div class="ptg__search" data-ptg-smart-search>
            <svg class="ptg__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/></svg>
            <input type="text" class="ptg__search-input" placeholder="" data-ptg-search data-ptg-typewriter autocomplete="off">
            <span class="ptg__search-badge">
              <span class="ptg__search-dot"></span>
              Powered by <strong>Smart Search</strong>
            </span>
            <div class="ptg__search-results" data-ptg-results hidden>
              <div class="ptg__search-loading" data-ptg-loading hidden>
                <span class="ptg__search-spinner"></span>
                AI is finding your vehicle...
              </div>
              <ul class="ptg__search-list" data-ptg-list></ul>
            </div>
          </div>
          <div class="ptg__sort">
            <label for="ptg-sort" class="ptg__sort-label">Sort by</label>
            <div class="ptg__sort-wrap">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <select id="ptg-sort" class="ptg__sort-select" data-ptg-sort>
                <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured</option>
                <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
                <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
                <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Lowest price</option>
                <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Highest price</option>
              </select>
              <svg class="ptg__sort-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
        </div>

        {%- comment -%} Tire-size + saved-car context line (text only) {%- endcomment -%}
        <p class="ptg__context" data-ptg-context hidden>
          Searching for <span data-results-size><strong data-results-size-val></strong></span><span data-ptg-context-car></span>
        </p>

        {% render 'pt-collection-research-strip' %}

        {%- if collection.products.size > 0 -%}
          <div class="ptg__grid">
            {%- comment -%}
              Render ALL products on the page — including sold-out ones.
              `pt-collection-card` applies a `--unavailable` greyscale class
              + "Out of stock" badge + ARIA label, so sold-out cards are
              visually distinct without being hidden. Customers can toggle
              them off with the Availability sidebar filter.

              Previously this loop was wrapped in `{% unless product.available
              == false %}` which silently dropped out-of-stock products from
              the grid; combined with Shopify's `collection.products_count`
              reporting the full total (41 wheels), the page showed
              "41 products" but rendered as few as 1 card on a page where
              the first-page sort happened to land on sold-out items.
            {%- endcomment -%}
            {%- for product in collection.products -%}
              {% render 'pt-collection-card', product: product, is_clearance: is_clearance %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="ptg__pages">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="ptg__page-btn">← Prev</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="ptg__page-num">{{ part.title }}</a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span class="ptg__page-num ptg__page-num--on">{{ part.title }}</span>
                  {%- else -%}
                    <span class="ptg__page-num">{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="ptg__page-btn">Next →</a>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- else -%}
          {% render 'pt-collection-empty' %}
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{%- if section.settings.enable_compare -%}
  {% render 'pt-collection-compare' %}
{%- endif -%}

{%- endpaginate -%}

{% stylesheet %}
  .ptg {
    background: #fff;
    padding: 0 0 5rem;
  }

  .ptg__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 12rem;
  }

  .ptg__layout {
    display: grid;
    grid-template-columns: 24rem 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ══ Sidebar ══ */
  .ptg__sidebar {
    position: sticky;
    top: 8rem;
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
    padding: 2rem 0.6rem 2rem 0;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f3f4f6;
    scroll-behavior: smooth;
  }

  .ptg__sidebar::-webkit-scrollbar { width: 8px; }
  .ptg__sidebar::-webkit-scrollbar-track { background: #f3f4f6; border-radius: 4px; }
  .ptg__sidebar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; border: 2px solid #f3f4f6; }
  .ptg__sidebar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  /* ── Grid transition ── */
  .ptg__grid {
    animation: ptg-fade-in 0.3s ease-out;
  }

  @keyframes ptg-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ptg__size-display {
    margin-bottom: 1.6rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid #f0f0f0;
  }

  .ptg__size-display-label {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 300;
    color: #9ca3af;
    display: block;
    margin-bottom: 0.3rem;
  }

  .ptg__size-display-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ptg__size-display-input {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #111;
    letter-spacing: 0.02em;
    border: none;
    background: transparent;
    outline: none;
    padding: 0;
    width: auto;
    max-width: 16rem;
    cursor: text;
    border-bottom: 1.5px dashed transparent;
    transition: border-color 0.2s;
  }

  .ptg__size-display-input:hover {
    border-bottom-color: #e5e7eb;
  }

  .ptg__size-display-input:focus {
    border-bottom-color: #F5820B;
  }

  .ptg__size-display-input::placeholder {
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    font-weight: 300;
    color: #d1d5db;
    letter-spacing: 0;
  }

  .ptg__size-display-clear {
    display: flex;
    align-items: center;
    color: #d1d5db;
    transition: color 0.15s;
  }

  .ptg__size-display-clear:hover {
    color: #dc2626;
  }

  .ptg__sidebar-head {
    margin-bottom: 1.2rem;
  }

  .ptg__sidebar-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #111;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .ptg__filter {
    margin-bottom: 0.4rem;
  }

  .ptg__filter-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 0;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    color: #111;
    list-style: none;
  }

  .ptg__filter-label::-webkit-details-marker { display: none; }

  .ptg__filter-label svg {
    color: #9ca3af;
    transition: transform 0.2s;
  }

  .ptg__filter[open] .ptg__filter-label svg {
    transform: rotate(180deg);
  }

  .ptg__filter-options {
    padding: 0 0 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ptg__filter--open {
    padding-bottom: 1rem;
    margin-bottom: 0.4rem;
  }

  .ptg__filter-label--static {
    display: block;
    padding: 1.2rem 0 0.8rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    color: #111;
  }

  /* ── Price Slider ── */
  .ptg__price-slider {
    padding: 0 0.2rem;
  }

  .ptg__price-values {
    display: flex;
    justify-content: space-between;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: #374151;
    margin-bottom: 0.6rem;
  }

  .ptg__price-track {
    position: relative;
    height: 28px;
    display: flex;
    align-items: center;
  }

  .ptg__price-range {
    position: absolute;
    width: 100%;
    height: 4px;
    appearance: none;
    background: transparent;
    pointer-events: none;
    outline: none;
  }

  .ptg__price-range::-webkit-slider-runnable-track {
    height: 4px;
    background: #e5e7eb;
    border-radius: 2px;
  }

  .ptg__price-range::-webkit-slider-runnable-track {
    background: linear-gradient(to right, #F5820B, #F5820B) !important;
  }

  .ptg__price-range::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    background: #F5820B;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 1px 6px rgba(245,130,11,0.3);
    cursor: pointer;
    pointer-events: all;
    margin-top: -7px;
  }

  .ptg__price-range::-moz-range-track {
    background: #F5820B !important;
  }

  .ptg__price-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    background: #F5820B;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 1px 6px rgba(245,130,11,0.3);
    cursor: pointer;
    pointer-events: all;
  }

  /* ── Scrollable inner lists (brand, model) ── */
  .ptg__filter-options--scroll {
    max-height: 18rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 #f3f4f6;
  }

  .ptg__filter-options--scroll::-webkit-scrollbar { width: 7px; }
  .ptg__filter-options--scroll::-webkit-scrollbar-track { background: #f3f4f6; border-radius: 4px; }
  .ptg__filter-options--scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; border: 1px solid #f3f4f6; }
  .ptg__filter-options--scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  /* ── Season Icons ── */
  .ptg__season-icons {
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem 0;
  }

  .ptg__season-icon {
    position: relative;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: color-mix(in srgb, var(--sc) 10%, transparent);
    color: var(--sc);
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .ptg__season-icon:hover {
    background: var(--sc);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--sc) 30%, transparent);
  }

  .ptg__season-tooltip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    background: #111;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    padding: 0.3rem 0.7rem;
    border-radius: 3px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }

  .ptg__season-icon:hover .ptg__season-tooltip {
    opacity: 1;
  }

  .ptg__filter-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    font-weight: 300;
    color: #9ca3af;
    text-decoration: none;
    border: none;
    background: none;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
    text-align: left;
    width: 100%;
  }

  .ptg__filter-link:hover {
    color: #111;
    background: #fafafa;
  }

  .ptg__filter-link--active {
    color: #111;
    font-weight: 500;
  }

  /* ── Checkmark ── */
  .ptg__filter-check {
    width: 16px;
    height: 16px;
    border: 1.5px solid #d1d5db;
    border-radius: 3px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .ptg__season-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
    margin-right: 0.1rem;
  }
  .ptg__filter-search {
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1.5px solid #e5e7eb;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.88rem;
    margin-bottom: 0.5rem;
    outline: none;
    transition: border-color 0.15s;
  }
  .ptg__filter-search:focus { border-color: #F5820B; }

  .ptg__filter-link--active .ptg__filter-check {
    background: #F5820B;
    border-color: #F5820B;
  }

  .ptg__filter-link--active .ptg__filter-check::after {
    content: '';
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-top: -2px;
  }

  .ptg__filter-symbol {
    font-size: 1.05rem;
    font-weight: 500;
    color: #d1d5db;
  }

  .ptg__filter-link--active .ptg__filter-symbol {
    color: #F5820B;
  }

  /* ── Season active frame ── */
  .ptg__season-icon--active {
    outline: 2px solid #F5820B;
    outline-offset: 2px;
    border-radius: 8px;
    background: var(--sc) !important;
    color: #fff !important;
  }

  .ptg__filter-cnt {
    color: #d1d5db;
    font-size: 1.1rem;
  }

  .ptg__filter-input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    outline: none;
    background: #f7f7f7;
    margin-bottom: 0.6rem;
  }

  .ptg__filter-input:focus {
    border-color: #dc2626;
    background: #fff;
  }

  .ptg__filter-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .ptg__filter-sizes .ptg__filter-link {
    padding: 0.4rem 0.8rem;
    background: #f7f7f7;
    border-radius: 4px;
    font-size: 1.15rem;
    font-weight: 400;
    color: #374151;
  }

  .ptg__filter-sizes .ptg__filter-link:hover {
    background: #fef2f2;
    color: #dc2626;
  }

  .ptg__filter-options--wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ptg__filter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    background: #f7f7f7;
    border-radius: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: #374151;
    text-decoration: none;
    transition: all 0.15s;
    min-width: 3.6rem;
    text-align: center;
  }

  .ptg__filter-pill:hover {
    background: #fef2f2;
    color: #dc2626;
  }

  /* ══ Main ══ */
  .ptg__main {
    min-width: 0;
  }

  /* ── Active Filters ── */
  .ptg__active-filters {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0 0 1rem;
  }

  .ptg__active-filters[hidden] { display: none; }

  .ptg__active-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    background: none;
    color: #dc2626;
    border: none;
    border-radius: 99px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 400;
    cursor: pointer;
    transition: opacity 0.15s;
    background: #fef2f2;
  }

  .ptg__active-tag:hover {
    opacity: 0.7;
  }

  .ptg__active-clear {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 300;
    color: #9ca3af;
    border: none;
    background: none;
    cursor: pointer;
    margin-left: 0.2rem;
  }

  .ptg__active-clear:hover { color: #dc2626; }

  /* ══ Trust Bar ══ */
  .ptg__trust-bar {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    padding: 0.6rem 1.2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .ptg__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: #15803d;
    white-space: nowrap;
  }
  .ptg__trust-sep {
    color: #bbf7d0;
    font-weight: 300;
  }

  .ptg__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1rem 0;
    margin-bottom: 1.6rem;
  }

  .ptg__context {
    margin: 0.6rem 0 0.4rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 300;
    color: #6b7280;
  }
  .ptg__context[hidden] { display: none; }
  .ptg__context strong { color: #dc2626; font-weight: 600; }
  [data-ptg-context-car] { color: #111; font-weight: 500; }
  [data-ptg-context-car]:not(:empty)::before { content: ' — '; color: #9ca3af; font-weight: 300; }

  .ptg__search {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    max-width: 36rem;
  }

  .ptg__search-icon {
    position: absolute;
    left: 1rem;
    color: #F5820B;
    pointer-events: none;
    z-index: 1;
  }

  .ptg__search-input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.8rem;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 300;
    color: #111;
    background: #fafafa;
    outline: none;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
    caret-color: #F5820B;
  }

  .ptg__search-input::placeholder {
    color: #9ca3af;
    transition: color 0.2s;
  }

  .ptg__search-input:focus {
    border-color: #F5820B;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(245, 130, 11, 0.1), 0 2px 8px rgba(245, 130, 11, 0.08);
  }

  .ptg__search-badge {
    position: absolute;
    right: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: #c0c0c0;
    pointer-events: none;
  }

  .ptg__search-dot {
    width: 5px;
    height: 5px;
    background: #F5820B;
    border-radius: 50%;
    box-shadow: 0 0 4px rgba(245,130,11,0.4);
  }

  .ptg__search-input:focus ~ .ptg__search-badge {
    opacity: 0;
  }

  .ptg__search-results {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    z-index: 50;
    max-height: 28rem;
    overflow-y: auto;
  }

  .ptg__search-results[hidden] { display: none; }

  .ptg__search-loading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.2rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 300;
    color: #9ca3af;
  }

  .ptg__search-loading[hidden] { display: none; }

  .ptg__search-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid #e5e7eb;
    border-top-color: #F5820B;
    border-radius: 50%;
    animation: ptg-spin 0.6s linear infinite;
  }

  @keyframes ptg-spin { to { transform: rotate(360deg); } }

  .ptg__search-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
  }

  .ptg__search-item {
    padding: 0.8rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: #374151;
    transition: background 0.15s;
  }

  .ptg__search-item:hover {
    background: #f7f7f7;
  }

  .ptg__search-item-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: #f7f7f7;
    color: #9ca3af;
    flex-shrink: 0;
  }

  .ptg__search-item-info {
    flex: 1;
    min-width: 0;
  }

  .ptg__search-item-title {
    font-weight: 500;
    color: #111;
  }

  .ptg__search-item-meta {
    font-size: 1.05rem;
    font-weight: 300;
    color: #9ca3af;
  }

  .ptg__search-item-tag {
    font-size: 0.95rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background: #f0f0f0;
    color: #6b7280;
    flex-shrink: 0;
  }

  .ptg__sort { display: flex; align-items: center; gap: 0.6rem; }

  .ptg__sort-label {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: #6b7280;
  }

  .ptg__sort-wrap { position: relative; }

  .ptg__sort-select {
    appearance: none;
    background: #f7f7f7;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 0.5rem 2.8rem 0.5rem 1rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    color: #374151;
    cursor: pointer;
    outline: none;
  }

  .ptg__sort-select:focus { border-color: #dc2626; }

  .ptg__sort-icon { position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }

  /* ══ Grid ══ */
  .ptg__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6rem;
  }

  .ptg__card {
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    max-width: 100%;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .ptg__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    border-color: #e0e0e0;
  }
  .ptg__card:focus-visible {
    outline: 2px solid #DA291C;
    outline-offset: 2px;
  }

  .ptg__card-img {
    aspect-ratio: var(--ptg-img-ratio, 1);
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--ptg-img-pad, 1.2rem) + 1.6rem) var(--ptg-img-pad, 1.2rem) 0.8rem;
    position: relative;
  }

  .ptg__img {
    width: 85%;
    height: 85%;
    object-fit: contain;
    max-height: 180px;
    margin: auto;
  }

  /* Branded placeholder — products with no photo */
  .ptg__card-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    background: linear-gradient(145deg, #f8f9fa 0%, #eceef0 100%);
  }
  .ptg__card-ph-tire {
    width: 44%;
    max-width: 88px;
    color: #c4cad2;
    flex-shrink: 0;
  }
  .ptg__card-ph-brand {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #8b94a0;
    text-align: center;
  }
  .ptg__card-ph-size {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #aab2bd;
    text-align: center;
  }

  .ptg__card--unavailable { opacity: 0.55; }
  .ptg__card--unavailable .ptg__img { filter: grayscale(80%); }
  .ptg__card-oos {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(17, 24, 39, 0.85);
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    pointer-events: none;
    z-index: 2;
  }
  .ptg__card-sale {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: #dc2626;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .ptg__card-lowstock {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: #dc2626;
    line-height: 1.2;
  }
  .ptg__card-lowstock svg { flex-shrink: 0; }

  .ptg__card-img-bottom {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .ptg__card-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #374151;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(4px);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }

  .ptg__card-stars--na {
    color: #9ca3af;
    font-weight: 400;
    font-size: 0.9rem;
  }

  .ptg__card-season {
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }

  .ptg__card-body {
    padding: 1.2rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .ptg__card-size-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .ptg__card-vendor {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #8b1a1a;
    flex-shrink: 0;
  }

  .ptg__card-vendor--michelin { color: #00205b; }
  .ptg__card-vendor--bridgestone { color: #cc0000; }
  .ptg__card-vendor--continental { color: #f0a000; }
  .ptg__card-vendor--goodyear { color: #003da5; }
  .ptg__card-vendor--toyo { color: #e60012; }
  .ptg__card-vendor--yokohama { color: #e60012; }
  .ptg__card-vendor--cooper { color: #003366; }
  .ptg__card-vendor--kumho { color: #d41920; }
  .ptg__card-vendor--bfgoodrich { color: #cc0000; }
  .ptg__card-vendor--firestone { color: #c41230; }
  .ptg__card-vendor--general { color: #333333; }
  .ptg__card-vendor--pirelli { color: #ffcc00; }
  .ptg__card-vendor--radar { color: #0066cc; }
  .ptg__card-vendor--falken { color: #005ca9; }

  .ptg__card-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #111;
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .ptg__card-size {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #111;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .ptg__card-type-tag {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: #9ca3af;
  }

  .ptg__card-review-count { font-weight: 300; font-size: 0.8rem; color: #9ca3af; }

  .ptg__card-badge-best {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    background: #F5820B;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .ptg__card-fitment {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: #16a34a;
  }
  .ptg__card-fitment[hidden] { display: none; }

  .ptg__card-warranty {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: #16a34a;
    background: #ecfdf5;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    width: fit-content;
  }

  .ptg__card-specs {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .ptg__card-spec {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    color: #6b7280;
    background: #f7f7f7;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .ptg__card-rebate {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: #F5820B;
    background: rgba(245, 130, 11, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    width: fit-content;
  }

  .ptg__card-price {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #111;
    margin-top: auto;
    padding-top: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .ptg__price-sale { color: #dc2626; }
  .ptg__price-was { font-size: 1.05rem; font-weight: 300; color: #9ca3af; text-decoration: line-through; }
  .ptg__price-per { font-size: 1rem; font-weight: 300; color: #9ca3af; }
  .ptg__price-set { font-size: 0.9rem; font-weight: 400; color: #6b7280; margin-left: auto; }

  /* ── Clearance collection treatment (collection.handle == 'clearance') ── */
  .ptg__card-clearance {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: #b91c1c;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 0 1px 4px rgba(185, 28, 28, 0.4);
    z-index: 2;
  }
  .ptg__price-off {
    display: inline-block;
    margin-top: 0.35rem;
    background: #fee2e2;
    color: #b91c1c;
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ptg__clearance-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(90deg, #dc2626, #b91c1c);
    color: #fff;
    font-family: 'Outfit', sans-serif;
    padding: 0.75rem 1.1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    box-shadow: 0 2px 10px rgba(220, 38, 38, 0.25);
  }
  .ptg__clearance-banner-icon { flex-shrink: 0; }
  .ptg__clearance-banner-text { font-size: 0.95rem; font-weight: 400; line-height: 1.3; }
  .ptg__clearance-banner-text strong { font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }

  /* Phase 5A · trade-price badge on collection cards. Hidden by default; shown
     when body.pt-trade-visible (header "Show cost" toggle is on). Compact so
     it doesn't disrupt the grid rhythm. */
  .ptg__card-trade {
    display: none;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.4rem;
    padding: 0.35rem 0.55rem;
    background: #fef3c7;
    border-left: 3px solid #DC2626;
    border-radius: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    line-height: 1.2;
    color: #374151;
  }
  body.pt-trade-visible .ptg__card-trade { display: flex; }
  .ptg__card-trade-label { font-weight: 500; }
  .ptg__card-trade-amount { color: #DC2626; font-weight: 700; font-size: 0.9rem; }
  .ptg__card-trade-pct { color: #6b7280; margin-left: auto; }

  .ptg__card-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .ptg__card-book {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.5rem;
    background: #f3f4f6;
    color: #dc2626;
    border: 1.5px solid #dc2626;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.2s;
    white-space: nowrap;
    cursor: pointer;
  }

  .ptg__card-book:hover {
    background: #fef2f2;
    color: #b91c1c;
    border-color: #b91c1c;
  }

  .ptg__card-cart {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f3f4f6;
    color: #374151;
    border: none;
    border-radius: 8px;
    flex-shrink: 0;
    transition: all 0.2s;
    cursor: pointer;
  }

  .ptg__card-cart:hover:not(:disabled) {
    background: #e5e7eb;
    color: #111;
  }

  .ptg__card-cart:disabled { opacity: .5; cursor: not-allowed; }
  .ptg__card-cart--success { background: #dcfce7 !important; color: #16a34a !important; }
  .ptg__card-cart--success .ptg__cart-icon,
  .ptg__card-cart--loading .ptg__cart-icon { display: none !important; }
  .ptg__card-cart--success .ptg__cart-check { display: inline-block !important; }
  .ptg__card-cart--loading .ptg__cart-spin { display: inline-block !important; animation: ptg-cart-spin .7s linear infinite; }
  @keyframes ptg-cart-spin { to { transform: rotate(360deg); } }

  /* ══ Compare ══ */
  .ptg__card-compare {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(220,38,38,0.2);
    border-radius: 999px;
    cursor: pointer;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .ptg__card:hover .ptg__card-compare,
  .ptg__card-compare:has(.ptg__compare-check:checked) { opacity: 1; }
  .ptg__compare-check { width: 14px; height: 14px; accent-color: #dc2626; cursor: pointer; margin: 0; }
  .ptg__compare-label { font-family: 'Outfit', sans-serif; font-size: 0.8rem; font-weight: 500; color: #374151; cursor: pointer; }

  /* ══ Pagination ══ */
  .ptg__pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .ptg__page-btn {
    padding: 0.6rem 1.2rem;
    background: #f7f7f7;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: #374151;
    text-decoration: none;
    transition: all 0.15s;
  }

  .ptg__page-btn:hover { border-color: #dc2626; color: #dc2626; }

  .ptg__page-num {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: #374151;
    text-decoration: none;
  }

  a.ptg__page-num:hover { background: #f7f7f7; color: #dc2626; }

  .ptg__page-num--on { background: #dc2626; color: #fff; font-weight: 600; }

  /* Empty-state styles moved to snippets/pt-collection-empty.liquid */

  .ptg__empty a { color: #dc2626; text-decoration: none; display: inline-block; margin-top: 0.8rem; }

  /* ══ Responsive ══ */
  /* ── Mobile filter button (hidden on desktop) ── */
  .ptg__mobile-filter-btn {
    display: none;
  }

  .ptg__sidebar-backdrop {
    display: none;
  }

  .ptg__sidebar-mobile-head {
    display: none;
  }

  @media (max-width: 989px) {
    .ptg__container { padding: 0 4rem; }
    .ptg__layout { grid-template-columns: 20rem 1fr; gap: 2rem; }
    .ptg__grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .ptg__container { padding: 0 1.6rem; }
    .ptg__layout { grid-template-columns: 1fr; }
    .ptg__grid { grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }

    /* ── Mobile filter button ── */
    .ptg__mobile-filter-btn {
      /* Sticky floating button — sits above the mobile tabbar */
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      position: fixed;
      bottom: calc(78px + env(safe-area-inset-bottom, 0px));
      right: 1rem;
      z-index: 1001;
      padding: 0.75rem 1.1rem;
      background: #111;
      color: #fff;
      border: none;
      border-radius: 999px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
      font-family: 'Outfit', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      width: auto;
      justify-content: center;
    }
    .ptg__mobile-filter-btn[data-count]:not([data-count="0"])::after {
      content: attr(data-count);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 18px;
      height: 18px;
      padding: 0 5px;
      background: #F5820B;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      margin-left: 0.1rem;
    }

    /* ── Sidebar as drawer ── */
    .ptg__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(320px, 85vw);
      background: #fff;
      z-index: 500;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0 1.6rem 2rem;
      overflow-y: auto;
      box-shadow: none;
      max-height: 100vh;
    }

    .ptg__sidebar.is-open {
      transform: translateX(0);
      box-shadow: 8px 0 40px rgba(0, 0, 0, 0.15);
    }

    /* ── Mobile header inside drawer ── */
    .ptg__sidebar-mobile-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.4rem 0;
      border-bottom: 1px solid #f0f0f0;
      margin-bottom: 1.2rem;
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 1;
    }

    .ptg__sidebar-mobile-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1.6rem;
      font-weight: 600;
      color: #111;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .ptg__sidebar-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f7f7f7;
      border: none;
      border-radius: 6px;
      color: #6b7280;
      cursor: pointer;
    }

    .ptg__sidebar-close:hover {
      color: #111;
    }

    /* ── Backdrop ── */
    .ptg__sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 490;
      backdrop-filter: blur(2px);
    }

    .ptg__sidebar-backdrop.is-open {
      display: block;
    }

    /* ── Hide desktop sidebar head on mobile ── */
    .ptg__sidebar-head {
      display: none;
    }

    /* ── Trust bar mobile ── */
    .ptg__trust-bar {
      flex-direction: column;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
    .ptg__trust-sep { display: none; }

    /* Mobile: hide the per-card compare checkbox — compare drawer is hidden on mobile so this would be unreachable */
    .ptg__card-compare { display: none; }
    .ptg__card-size { font-size: 1.2rem; }
  }

  @media (max-width: 480px) {
    .ptg__container {
      padding: 0 1.2rem;
    }
    .ptg__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }
    .ptg__mobile-filter-btn {
      padding: 1rem 1.4rem;
      font-size: 1.3rem;
      min-height: 4.4rem;
    }
    .ptg__sidebar {
      width: min(280px, 85vw);
    }
    .ptg__card-book {
      padding: 0.45rem 0.5rem;
      font-size: 0.9rem;
    }
    .ptg__card-cart {
      width: 4rem;
      height: 4rem;
      min-width: 4rem;
    }
    .ptg__card-title {
      font-size: 1.15rem;
    }
    .ptg__card-price {
      font-size: 1.5rem;
    }
    .ptg__card-size {
      font-size: 1.1rem;
    }
    .ptg__trust-bar {
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
    .ptg__search-badge {
      display: none;
    }
    .ptg__search-input {
      font-size: 1.4rem;
      padding: 0.5rem 0.8rem 0.5rem 2.6rem;
    }
    .ptg__search {
      max-width: 100%;
    }
    .ptg__sort-label {
      display: none;
    }
    .ptg__card-specs {
      display: none;
    }
    .ptg__top-bar {
      flex-direction: column;
      gap: 0.8rem;
      align-items: stretch;
    }
    .ptg__compare-tray-inner {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media (max-width: 360px) {
    .ptg__container {
      padding: 0 1rem;
    }
    .ptg__grid {
      gap: 0.5rem;
    }
    .ptg__sidebar {
      width: 100vw;
    }
    .ptg__card-body {
      padding: 0.8rem;
    }
    .ptg__card-title {
      font-size: 1.05rem;
    }
    .ptg__card-actions {
      gap: 0.3rem;
    }
    .ptg__card-book {
      padding: 0.45rem 0.5rem;
      font-size: 0.9rem;
    }
    .ptg__card-cart {
      width: 3.6rem;
      height: 3.6rem;
      min-width: 3.6rem;
    }
  }
{% endstylesheet %}


<script>
document.addEventListener('DOMContentLoaded', function() {

  /* ── Filter pills with [data-filter-set-key] preserve all active filters ──
     Set the named filter to the named value (or delete it if no value),
     keep every other URL param intact, then navigate. */
  document.addEventListener('click', function (e) {
    var pill = e.target.closest('[data-filter-set-key]');
    if (!pill) return;
    e.preventDefault();
    var key = pill.dataset.filterSetKey;
    var val = pill.dataset.filterSetValue;
    var qs = new URLSearchParams(window.location.search);
    if (val === undefined || val === '') {
      qs.delete(key);
    } else {
      qs.set(key, val);
    }
    window.location.href = window.location.pathname + (qs.toString() ? '?' + qs.toString() : '');
  });

  /* ── Typewriter placeholder ── */
  (function() {
    var input = document.querySelector('[data-ptg-typewriter]');
    if (!input) return;
    var phrases = [
      'Search by vehicle...',
      '2025 Toyota RAV4',
      'Search by tire size...',
      '225/65R17',
      'Smart search...',
      'Michelin Defender'
    ];
    var phraseIdx = 0, charIdx = 0, deleting = false, paused = false;

    function tick() {
      if (paused || input === document.activeElement || input.value !== '') return;
      var phrase = phrases[phraseIdx];

      if (!deleting) {
        charIdx++;
        input.setAttribute('placeholder', phrase.slice(0, charIdx));
        if (charIdx >= phrase.length) {
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        charIdx--;
        input.setAttribute('placeholder', phrase.slice(0, charIdx));
        if (charIdx <= 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, 300);
          return;
        }
        setTimeout(tick, 25);
      }
    }

    input.addEventListener('focus', function() { paused = true; input.setAttribute('placeholder', ''); });
    input.addEventListener('blur', function() {
      paused = false;
      if (input.value === '') { charIdx = 0; deleting = false; tick(); }
    });

    tick();
  })();

  var activeFiltersBar = document.querySelector('[data-active-filters-sidebar]');
  var params = new URLSearchParams(window.location.search);
  var baseUrl = window.location.pathname;

  // Helpers: identify size-related URL params and reconstruct display string
  function isSizeParam(k) {
    return k === 'filter.p.m.custom.tire_width' ||
           k === 'filter.p.m.custom.tire_profile' ||
           k === 'filter.p.m.custom.rim_diameter' ||
           k === 'filter.p.m.custom.tire_size';
  }
  function ptgNormSection(t) {
    return window.PTTireParse.normalizeSection(t);
  }
  function getSizeFromParams(p) {
    var w  = p.get('filter.p.m.custom.tire_width');
    var pr = p.get('filter.p.m.custom.tire_profile');
    var r  = p.get('filter.p.m.custom.rim_diameter');
    if (w && pr && r) {
      // Flotation (35X12.50R20) is written with "X"; metric (225/65R17) with "/".
      var sep = (pr.indexOf('.') !== -1 || w.length <= 2) ? 'X' : '/';
      return w + sep + pr + 'R' + r;
    }
    return p.get('filter.p.m.custom.tire_size'); // legacy fallback
  }

  // Result count — show tire size context (plus vehicle when localStorage has a matching saved car)
  (function() {
    var sizeParam = getSizeFromParams(params);
    if (!sizeParam) return;
    var contextRow = document.querySelector('[data-ptg-context]');
    var sizeVal = document.querySelector('[data-results-size-val]');
    var carEl = document.querySelector('[data-ptg-context-car]');
    if (!contextRow || !sizeVal) return;

    sizeVal.textContent = sizeParam;

    // Surface saved-car name when its size matches the URL filter
    if (carEl) {
      try {
        var raw = localStorage.getItem('pt-tire-search-vehicle');
        if (raw) {
          var v = JSON.parse(raw);
          if (v && v.tireSize && v.tireSize.indexOf(sizeParam.split('/')[0]) !== -1) {
            var car = [v.year, v.make, v.model, v.trim].filter(Boolean).join(' ');
            if (car) carEl.textContent = car;
          }
        }
      } catch (e) {}
    }

    contextRow.hidden = false;
  })();

  function isFilterActive(key, value) {
    var found = false;
    params.forEach(function(v, k) { if (k === key && v === value) found = true; });
    return found;
  }

  function toggleFilter(key, value) {
    var newParams = new URLSearchParams();
    var removed = false;
    params.forEach(function(v, k) {
      if (k === key && v === value) { removed = true; }
      else { newParams.append(k, v); }
    });
    if (!removed) newParams.append(key, value);
    var qs = newParams.toString();
    try { sessionStorage.setItem('ptg_filter_open', '1'); } catch(e) {}
    window.location.href = baseUrl + (qs ? '?' + qs : '');
  }

  // Universal filter links (brands, product types, etc.)
  document.querySelectorAll('[data-filter-key]').forEach(function(el) {
    var key = el.dataset.filterKey;
    var val = el.dataset.filterValue;
    if (isFilterActive(key, val)) el.classList.add('ptg__filter-link--active');
    el.addEventListener('click', function(e) {
      e.preventDefault();
      toggleFilter(key, val);
    });
  });

  // Brand list search — type to filter visible brand options
  (function () {
    var brandSearch = document.querySelector('[data-brand-search]');
    var brandList = document.querySelector('[data-brand-list]');
    if (!brandSearch || !brandList) return;
    brandSearch.addEventListener('input', function () {
      var q = this.value.trim().toLowerCase();
      brandList.querySelectorAll('[data-filter-key="filter.p.vendor"]').forEach(function (link) {
        var label = (link.textContent || '').toLowerCase();
        link.style.display = !q || label.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();

  // Model list search — type to filter visible model options
  (function () {
    var modelSearch = document.querySelector('[data-model-search]');
    var modelList = document.querySelector('[data-model-list]');
    if (!modelSearch || !modelList) return;
    modelSearch.addEventListener('input', function () {
      var q = this.value.trim().toLowerCase();
      modelList.querySelectorAll('[data-filter-key="filter.p.m.custom.tire_model"]').forEach(function (link) {
        var label = (link.textContent || '').toLowerCase();
        link.style.display = !q || label.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();

  // Empty-state handlers (clear-all + missing-vehicle form + auto-webhook)
  // moved to snippets/pt-collection-empty.liquid

  // Season icons
  document.querySelectorAll('[data-meta-filter]').forEach(function(el) {
    var key = 'filter.p.m.custom.' + el.dataset.metaFilter;
    var val = el.dataset.metaValue;
    if (isFilterActive(key, val)) {
      el.classList.add('ptg__season-icon--active');
    }
    el.addEventListener('click', function(e) {
      e.preventDefault();
      toggleFilter(key, val);
    });
  });

  // Active filter bubbles
  var activeFilters = [];
  params.forEach(function(v, k) {
    if (k.startsWith('filter.') && !k.includes('price')) {
      activeFilters.push({ key: k, value: v });
    }
  });

  // Reflect active filter count on the mobile filter button (count badge)
  var mobileBtn = document.querySelector('[data-open-filters]');
  if (mobileBtn) mobileBtn.setAttribute('data-count', String(activeFilters.length));

  function chipLabel(key, value) {
    var serviceMap = { 'P': 'Passenger', 'LT': 'Light Truck', 'ST': 'Trailer' };
    switch (key) {
      case 'filter.p.m.custom.tire_width':   return (value.length <= 2 ? 'Diameter: ' : 'Width: ') + value;
      case 'filter.p.m.custom.tire_profile': return (value.indexOf('.') !== -1 ? 'Width: ' : 'Aspect: ') + value;
      case 'filter.p.m.custom.rim_diameter': return 'Rim: ' + value + '"';
      case 'filter.p.m.custom.service_type': return serviceMap[value] || value;
      case 'filter.p.m.custom.tire_model':   return 'Model: ' + value;
      case 'filter.v.availability':          return value === '1' ? 'In stock' : 'Out of stock';
      default:                                return value;
    }
  }

  if (activeFilters.length > 0 && activeFiltersBar) {
    var html = '';
    activeFilters.forEach(function(f) {
      var lbl = chipLabel(f.key, f.value);
      html += '<button type="button" class="ptg__active-tag" data-rk="' + f.key + '" data-rv="' + f.value + '" aria-label="Remove filter ' + lbl + '">' +
        lbl +
        '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>' +
      '</button>';
    });
    html += '<button type="button" class="ptg__active-clear" data-clear-all>Clear all</button>';
    activeFiltersBar.innerHTML = html;
    activeFiltersBar.hidden = false;

    activeFiltersBar.querySelectorAll('[data-rk]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        toggleFilter(this.dataset.rk, this.dataset.rv);
      });
    });
    var clearAll = activeFiltersBar.querySelector('[data-clear-all]');
    if (clearAll) clearAll.addEventListener('click', function() {
      // Clear every filter, including tire size. The customer can re-apply
      // the size from the saved-car banner / Change-search strip / sidebar
      // pills if they want it back.
      window.location.href = baseUrl;
    });
  }

  // Editable tire size — populated from URL via JS
  var sizeDisplay = document.querySelector('[data-size-display]');
  var sizeEdit = document.querySelector('[data-size-edit]');
  var sizeClearLink = document.querySelector('[data-size-clear-link]');
  var activeTireSize = getSizeFromParams(params);

  if (activeTireSize && sizeEdit) {
    sizeEdit.value = activeTireSize;
    // Show X button when size is active
    if (sizeClearLink) {
      sizeClearLink.hidden = false;
      var clearParams = new URLSearchParams();
      params.forEach(function(v, k) {
        if (!isSizeParam(k)) clearParams.append(k, v);
      });
      var qs = clearParams.toString();
      sizeClearLink.href = baseUrl + (qs ? '?' + qs : '');
    }
  }

  if (sizeEdit) {
    sizeEdit.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        var val = this.value.trim();
        if (!val) {
          if (sizeClearLink) window.location.href = sizeClearLink.href;
          return;
        }
        var fl = val.match(/(\d{2})\s*[xX×]\s*(\d{1,4}(?:[.,]\d{1,2})?)\s*[rR]?\s*(\d{2})/);
        var m  = val.match(/[Pp]?[LlTtSs]?[Tt]?(\d{2,3})\/?(\d{2,3})[Rr](\d{2})/);
        var sw, sp, sr;
        if (fl) { sw = fl[1]; sp = ptgNormSection(fl[2]); sr = fl[3]; }
        else if (m) { sw = m[1]; sp = m[2]; sr = m[3]; }
        else { return; }
        var newParams = new URLSearchParams();
        params.forEach(function(v, k) {
          if (!isSizeParam(k)) newParams.append(k, v);
        });
        newParams.set('filter.p.m.custom.tire_width', sw);
        newParams.set('filter.p.m.custom.tire_profile', sp);
        newParams.set('filter.p.m.custom.rim_diameter', sr);
        window.location.href = baseUrl + '?' + newParams.toString();
      }
    });
  }

  // Price slider — Shopify expects filter.v.price.gte / filter.v.price.lte
  var minSlider = document.querySelector('[data-price-min]');
  var maxSlider = document.querySelector('[data-price-max]');
  var minDisplay = document.querySelector('[data-price-min-display]');
  var maxDisplay = document.querySelector('[data-price-max-display]');
  if (minSlider && maxSlider) {
    // Seed slider from URL so it reflects the active filter on page load
    var urlMin = params.get('filter.v.price.gte');
    var urlMax = params.get('filter.v.price.lte');
    if (urlMin !== null) {
      minSlider.value = urlMin;
      if (minDisplay) minDisplay.textContent = '$' + urlMin;
    }
    if (urlMax !== null) {
      maxSlider.value = urlMax;
      if (maxDisplay) maxDisplay.textContent = '$' + urlMax;
    }

    var priceTimer = null;
    function updatePrice() {
      var mn = parseInt(minSlider.value);
      var mx = parseInt(maxSlider.value);
      if (mn > mx) { minSlider.value = mx; mn = mx; }
      if (mx < mn) { maxSlider.value = mn; mx = mn; }
      minDisplay.textContent = '$' + mn;
      maxDisplay.textContent = '$' + mx;
    }
    function applyPrice() {
      clearTimeout(priceTimer);
      priceTimer = setTimeout(function() {
        var mn = parseInt(minSlider.value);
        var mx = parseInt(maxSlider.value);
        var sliderMin = parseInt(minSlider.min);
        var sliderMax = parseInt(maxSlider.max);
        var newParams = new URLSearchParams();
        params.forEach(function(v, k) {
          if (!k.includes('price')) newParams.append(k, v);
        });
        // Only emit the bound when it constrains the result.
        if (mn > sliderMin) newParams.set('filter.v.price.gte', mn);
        if (mx < sliderMax) newParams.set('filter.v.price.lte', mx);
        try { sessionStorage.setItem('ptg_filter_open', '1'); } catch(e) {}
        window.location.href = baseUrl + '?' + newParams.toString();
      }, 800);
    }
    minSlider.addEventListener('input', updatePrice);
    maxSlider.addEventListener('input', updatePrice);
    minSlider.addEventListener('change', applyPrice);
    maxSlider.addEventListener('change', applyPrice);
  }


  // Approximate filter counts from visible cards
  (function() {
    var cards = document.querySelectorAll('.ptg__card[data-vendor]');
    var vendorCounts = {};
    var typeCounts = {};
    cards.forEach(function(card) {
      var v = card.dataset.vendor;
      if (v) vendorCounts[v] = (vendorCounts[v] || 0) + 1;
      var t = card.dataset.type;
      if (t) typeCounts[t] = (typeCounts[t] || 0) + 1;
    });
    document.querySelectorAll('[data-filter-cnt]').forEach(function(el) {
      var parts = el.dataset.filterCnt.split(':');
      var kind = parts[0], key = parts[1];
      var count = 0;
      if (kind === 'vendor') count = vendorCounts[key] || 0;
      else if (kind === 'type') count = typeCounts[key] || 0;
      if (count > 0) el.textContent = '(' + count + ')';
    });
  })();

  // Vehicle fitment confirmation on cards
  (function() {
    var fitmentBadges = document.querySelectorAll('[data-card-fitment]');
    if (!fitmentBadges.length) return;
    try {
      var keys = Object.keys(localStorage).filter(function(k) { return k.startsWith('pt-garage-'); });
      var vehicleSizes = [];
      for (var i = 0; i < keys.length; i++) {
