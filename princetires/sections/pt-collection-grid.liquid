{%- comment -%} /collections/all is the Shop by size hub (pt-shop-by-size), not a 20,000-product grid without filters. {%- endcomment -%}
{%- unless collection.handle == 'all' -%}
{%- comment -%}
  Auto-defaults on first visit:
  - All collections: cheapest-first sort (price-ascending) so customers see the
    lowest price first when they land.
  - Tire collections (tires / imported-tires): also add a seasonal pre-filter
    (Oct-Feb: Winter; Mar-Sep: All-Season + All-Weather).
  - Wheel collections (wheels / alloy-wheels / steel-wheels): also add an
    in-stock-only filter (SimGym rec #3 — bias wheels browsing to availability).
  Auto-default runs once per tab session via sessionStorage marker, so the
  user's choice to clear filters is respected for the rest of the session.
{%- endcomment -%}
<script>
(function () {
  if (window.__ptCollSeed) return;
  window.__ptCollSeed = true;
  var TIRE_COLLS  = { 'tires': 1, 'imported-tires': 1 };
  var WHEEL_COLLS = { 'wheels': 1, 'alloy-wheels': 1, 'steel-wheels': 1 };
  var handle = {{ collection.handle | json }};
  var isTire  = !!TIRE_COLLS[handle] || /^tires-\d{2}-inch$/.test(handle);
  var isWheel = !!WHEEL_COLLS[handle] || /^wheels-\d{2}-inch$/.test(handle);
  // Cheapest-first now applies to EVERY collection; the seasonal / availability
  // extras below stay scoped to tire / wheel collections only.

  // Auto-default runs AT MOST ONCE per browser tab. After the user has touched
  // anything (cleared the season, picked a brand, etc.), the marker keeps the
  // script from re-applying the default and overriding their choice.
  var SEEDED = 'ptg_auto_seeded_' + handle;
  try { if (sessionStorage.getItem(SEEDED)) return; } catch (e) {}

  var qs = new URLSearchParams(window.location.search);
  var hasSort = qs.has('sort_by');
  var hasSeason = false;
  var hasAvailability = false;
  var hasUserFilter = false;
  qs.forEach(function (_v, k) {
    if (k === 'filter.p.m.custom.seasonality') hasSeason = true;
    if (k === 'filter.v.availability') hasAvailability = true;
    if (k.indexOf('filter.') === 0) hasUserFilter = true;
  });

  // Always mark as seeded — even on early returns — so the user's subsequent
  // edits (e.g. clearing the season) are respected for the rest of this tab session.
  function markSeeded() { try { sessionStorage.setItem(SEEDED, '1'); } catch (e) {} }

  // If the user arrived with any explicit filter, respect their intent.
  if (hasUserFilter) { markSeeded(); return; }
  // If a sort is already in the URL and this collection has no extra default left
  // to apply (season for tires, availability for wheels), respect the user's state.
  if (hasSort) {
    if (isTire && !hasSeason) { /* fall through to add the seasonal default */ }
    else if (isWheel && !hasAvailability) { /* fall through to add availability */ }
    else { markSeeded(); return; }
  }

  var changed = false;
  if (!hasSort) { qs.set('sort_by', 'price-ascending'); changed = true; }

  if (isTire && !hasSeason) {
    var m = new Date().getMonth(); // 0 = Jan
    if (m >= 9 || m <= 1) {
      // Oct, Nov, Dec, Jan, Feb → Winter
      qs.set('filter.p.m.custom.seasonality', 'Winter');
      changed = true;
    } else if (m >= 2 && m <= 8) {
      // Mar → Sep → All-Season + All-Weather
      qs.append('filter.p.m.custom.seasonality', 'All-Season');
      qs.append('filter.p.m.custom.seasonality', 'All-Weather');
      changed = true;
    }
  }

  if (isWheel && !hasAvailability) {
    // Availability-first: only show in-stock wheels by default. The customer can
    // clear this filter from the sidebar to see out-of-stock SKUs.
    qs.set('filter.v.availability', '1');
    changed = true;
  }

  markSeeded();
  if (changed) {
    window.location.replace(window.location.pathname + '?' + qs.toString());
  }
})();
</script>

{%- comment -%}
  Results grid (redesign 2026-11-13, mockups Main / Mobile / MobileFilters /
  States / WheelResults / WheelMobile .dc.html). The black header with the
  title, count, Change size and tabs is sections/pt-collection-header.

  Kept from the old grid: the first-visit default above (cheapest first +
  season / availability), Shopify filter URLs (filter.p.m.* / filter.v.*),
  pagination, the saved-car banner (tires only), the clearance banner,
  sold-out cards listed but greyed (pt-collection-stock moves them last),
  the compare drawer, the "Don't see the tire you need?" empty-state form,
  AJAX add to cart, scroll restoration and the wholesale price hooks.
  Dropped on purpose: the toolbar "Smart Search" box (the site search and
  the Change size panel cover it), the price slider (Min / Max boxes from
  the whole collection's price range instead of the page's), approximate
  option counts (owner decision 5: none).

  Behaviour lives in assets/pt-rd-results.js, styles in assets/pt-rd-results.css.
{%- endcomment -%}
{% render 'pt-vehicle-manifest-loader' %}
{% render 'pt-search-tracking' %}
{{ 'pt-rd-results.css' | asset_url | stylesheet_tag }}

{%- paginate collection.products by section.settings.products_per_page -%}
{%- liquid
  # Clearance collection gets a banner + per-card CLEARANCE badge + % off.
  assign is_clearance = false
  if collection.handle == 'clearance'
    assign is_clearance = true
  endif

  capture rd_kind
    render 'pt-rd-results-kind', collection: collection
  endcapture
  assign rd_kind = rd_kind | strip
  assign is_wheels = false
  assign rd_one = 'tire'
  assign rd_many = 'tires'
  if rd_kind == 'wheels'
    assign is_wheels = true
    assign rd_one = 'wheel'
    assign rd_many = 'wheels'
  elsif rd_kind == 'items'
    assign rd_one = 'item'
    assign rd_many = 'items'
  endif

  # Wheels: mount and balance per wheel (owner: $30/wheel, the theme fallback - never change).
  assign rd_wheel_install = 30

  # Active filters (badge on the phone Filters button + chips). The default
  # "available" filter is not counted: the site applies it for everyone.
  assign rd_active = 0
  for f in collection.filters
    if f.type == 'price_range'
      if f.min_value.value != blank or f.max_value.value != blank
        assign rd_active = rd_active | plus: 1
      endif
    elsif f.param_name == 'filter.v.availability'
      for v in f.active_values
        if v.value != '1'
          assign rd_active = rd_active | plus: 1
        endif
      endfor
    elsif f.param_name == 'filter.p.m.custom.tire_width' or f.param_name == 'filter.p.m.custom.tire_profile' or f.param_name == 'filter.p.m.custom.rim_diameter' or f.param_name == 'filter.p.m.custom.tire_size'
      # the size / diameter is the black header's, not a drawer filter
    elsif f.param_name == 'filter.p.m.custom.bolt_pattern'
      # One chosen pattern applies every value that contains it (5x139.7 ->
      # 5x139.7, 5x127/5x139.7, ...): count patterns, not values.
      if f.active_values.size > 0
        capture rd_bolts
          render 'pt-rd-results-bolt', filter: f
        endcapture
        assign rd_bolt_n = rd_bolts | strip | split: ', '
        assign rd_active = rd_active | plus: rd_bolt_n.size
      endif
    else
      assign rd_active = rd_active | plus: f.active_values.size
    endif
  endfor

  # Tags applied through the collection tag URL (wheel Finish / Wheel type
  # fallback, snippets/pt-rd-results-tagfacet) count as filters too.
  assign rd_active = rd_active | plus: current_tags.size

  assign rd_sort = collection.sort_by | default: collection.default_sort_by
  assign rd_total = paginate.items | default: 0
  assign rd_total_fmt = rd_total | times: 100 | money_without_currency | remove: '.00'
  assign rd_from = paginate.current_offset | plus: 1
  assign rd_to = paginate.current_offset | plus: collection.products.size
  assign rd_b2b = false
  if customer.b2b? or customer.tags contains 'wholesale'
    assign rd_b2b = true
  endif

  # Tire pages: the size shown as the H1 (pt-rd-results-title) and whether
  # the page has one (v16 cards put the size in the meta line only when not).
  assign rd_has_size = false
  assign rd_title = collection.title
  if rd_kind == 'tires'
    capture rd_title
      render 'pt-rd-results-title', kind: rd_kind
    endcapture
    assign rd_title = rd_title | strip
    if rd_title != collection.title
      assign rd_has_size = true
    endif
  endif
-%}
{%- capture rd_sort_opts -%}
  <option value="manual"{% if rd_sort == 'manual' %} selected{% endif %}>Recommended</option>
  <option value="price-ascending"{% if rd_sort == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
  <option value="price-descending"{% if rd_sort == 'price-descending' %} selected{% endif %}>Price: high to low</option>
  {%- if is_wheels or rd_sort == 'created-descending' -%}<option value="created-descending"{% if rd_sort == 'created-descending' %} selected{% endif %}>Newest</option>{%- endif -%}
  {%- if rd_sort == 'best-selling' -%}<option value="best-selling" selected>Best selling</option>{%- endif -%}
{%- endcapture -%}
{%- comment -%} Tire pages (v16): Price: low to high first (the first-visit seed), then high to low, then Recommended. {%- endcomment -%}
{%- capture rd_sort_opts_t -%}
  <option value="price-ascending"{% if rd_sort == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
  <option value="price-descending"{% if rd_sort == 'price-descending' %} selected{% endif %}>Price: high to low</option>
  <option value="manual"{% if rd_sort == 'manual' %} selected{% endif %}>Recommended</option>
  {%- if rd_sort == 'created-descending' -%}<option value="created-descending" selected>Newest</option>{%- endif -%}
  {%- if rd_sort == 'best-selling' -%}<option value="best-selling" selected>Best selling</option>{%- endif -%}
{%- endcapture -%}
{%- if rd_kind == 'tires' -%}
{%- comment -%}
  ── TIRE results, v16 (FINAL spec 2026-11-15, cdesign/FINAL/SPEC.md) ──
  Every job once: the size is the H1 with one "Change size" (desktop
  popover / phone sheet), one row of brands (phones: one swiping quick row
  with the season items first), one row of applied chips with the only
  desktop Clear all, red only on Request install. DOM order: skip link,
  head, results (hidden H2, skip to filters, quick row, chips, pair tabs,
  grid, foot), then the filters (placed in column 1 by CSS grid).
  Wheels and other kinds keep the markup in the else branch below as is.
{%- endcomment -%}
{%- liquid
  assign f_season = nil
  assign f_vendor = nil
  for f in collection.filters
    if f.param_name == 'filter.p.m.custom.seasonality'
      assign f_season = f
    elsif f.param_name == 'filter.p.vendor'
      assign f_vendor = f
    endif
  endfor
  assign q_keys = 'winter|all-weather|all-season|summer' | split: '|'
  assign q_names = 'Winter|All-weather|All-season|Summer' | split: '|'
  assign q_sea_n = 0
  assign q_sea_on = 0
  if f_season
    for v in f_season.values
      assign qk = v.label | downcase | replace: ' ', '-'
      if q_keys contains qk
        if v.count > 0 or v.active
          assign q_sea_n = q_sea_n | plus: 1
        endif
        if v.active
          assign q_sea_on = q_sea_on | plus: 1
        endif
      endif
    endfor
  endif
  assign q_brand_n = 0
  assign q_brand_on = 0
  if f_vendor
    for v in f_vendor.values
      if v.count > 0 or v.active
        assign q_brand_n = q_brand_n | plus: 1
      endif
      if v.active
        assign q_brand_on = q_brand_on | plus: 1
      endif
    endfor
  endif
  assign q_show_sea = false
  if q_sea_n >= 2 or q_sea_on > 0
    assign q_show_sea = true
  endif

  # Clear all: the size, rear and sort stay (assets/pt-rd-results.js KEEP_ON_CLEAR does the same).
  assign t_clear_q = ''
  for f in collection.filters
    if f.param_name == 'filter.p.m.custom.tire_width' or f.param_name == 'filter.p.m.custom.tire_profile' or f.param_name == 'filter.p.m.custom.rim_diameter' or f.param_name == 'filter.p.m.custom.tire_size'
      for v in f.active_values
        assign t_cv = v.value | url_encode
        assign t_clear_q = t_clear_q | append: v.param_name | append: '=' | append: t_cv | append: '&'
      endfor
    endif
  endfor
  if collection.sort_by != blank
    assign t_clear_q = t_clear_q | append: 'sort_by=' | append: collection.sort_by | append: '&'
  endif
  assign t_clear_q = t_clear_q | append: 'filter.v.availability=1'
  assign t_clear = collection.url | append: '?' | append: t_clear_q

  # The few-results / empty panel names the most recent kind of filter: brand, then price, then season.
  assign lr_brand = ''
  assign lr_brand_url = ''
  assign lr_price = ''
  assign lr_price_url = ''
  assign lr_sea = ''
  assign lr_sea_url = ''
  assign lr_sea_adj = ''
  assign lr_other = ''
  assign lr_other_url = ''
-%}
{%- capture t_chips_sea -%}
  {%- if f_season -%}
    {%- for qk in q_keys -%}
      {%- assign qi = forloop.index0 -%}
      {%- for v in f_season.values -%}
        {%- assign vk = v.label | downcase | replace: ' ', '-' -%}
        {%- if vk == qk and v.active -%}
          {%- if lr_sea == '' -%}{%- assign lr_sea = q_names[qi] -%}{%- assign lr_sea_url = v.url_to_remove -%}{%- endif -%}
          <a class="rd-chip rd-chip--link rd-chip--v16" href="{{ v.url_to_remove | escape }}" rel="nofollow" aria-label="Remove {{ q_names[qi] }}">{% render 'pt-icon', name: qk, size: 16, class: 'rd-chip__ic' %}<span>{{ q_names[qi] }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if q_sea_on == 1 -%}{%- assign lr_sea_adj = lr_sea | downcase -%}{%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture t_chips_brand -%}
  {%- if f_vendor -%}
    {%- for v in f_vendor.active_values -%}
      {%- if lr_brand == '' -%}{%- assign lr_brand = v.label -%}{%- assign lr_brand_url = v.url_to_remove -%}{%- endif -%}
      <a class="rd-chip rd-chip--link rd-chip--v16" href="{{ v.url_to_remove | escape }}" rel="nofollow" aria-label="Remove {{ v.label | escape }}"><span>{{ v.label | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- capture t_chips_other -%}
  {%- for f in collection.filters -%}
    {%- liquid
      assign ch_skip = false
      case f.param_name
        when 'filter.p.m.custom.tire_width', 'filter.p.m.custom.tire_profile', 'filter.p.m.custom.tire_size', 'filter.p.m.custom.rim_diameter', 'filter.p.m.custom.seasonality', 'filter.p.vendor'
          assign ch_skip = true
      endcase
      case f.param_name
        when 'filter.p.m.custom.service_type'
          assign ch_name = 'Tire class'
        when 'filter.p.m.custom.stud_option'
          assign ch_name = 'Studs'
        when 'filter.p.m.custom.tire_model'
          assign ch_name = 'Model'
        when 'filter.p.product_type'
          assign ch_name = 'Tire type'
        else
          assign ch_name = f.label
      endcase
    -%}
    {%- unless ch_skip -%}
      {%- if f.type == 'price_range' -%}
        {%- if f.min_value.value != blank or f.max_value.value != blank -%}
          {%- liquid
            assign ch_a = ''
            assign ch_b = ''
            if f.min_value.value != blank
              assign ch_a = f.min_value.value | divided_by: 100 | floor
            endif
            if f.max_value.value != blank
              assign ch_b = f.max_value.value | divided_by: 100 | floor
            endif
            if ch_a != '' and ch_b != ''
              assign ch_txt = '$' | append: ch_a | append: ' – $' | append: ch_b
            elsif ch_a != ''
              assign ch_txt = '$' | append: ch_a | append: ' and up'
            elsif ch_b == 150
              assign ch_txt = 'Under $150'
            else
              assign ch_txt = 'Up to $' | append: ch_b
            endif
            if lr_price == ''
              assign lr_price = ch_txt
              assign lr_price_url = f.url_to_remove
            endif
          -%}
          <a class="rd-chip rd-chip--link rd-chip--v16" href="{{ f.url_to_remove | escape }}" rel="nofollow" aria-label="Remove {{ ch_txt | escape }}"><span>{{ ch_txt }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
        {%- endif -%}
      {%- elsif f.param_name == 'filter.v.availability' or f.param_name == 'filter.p.tag' -%}
        {%- for v in f.active_values -%}
          {%- liquid
            assign ch_show = true
            assign ch_txt = v.label
            if f.param_name == 'filter.v.availability'
              if v.value == '1'
                assign ch_show = false
              else
                assign ch_txt = 'Sold out only'
              endif
            elsif v.value == 'Prince Stock'
              assign ch_txt = 'Stocked at our shops'
            endif
          -%}
          {%- if ch_show -%}
            {%- if lr_other == '' -%}{%- assign lr_other = ch_txt -%}{%- assign lr_other_url = v.url_to_remove -%}{%- endif -%}
            <a class="rd-chip rd-chip--link rd-chip--v16" href="{{ v.url_to_remove | escape }}" rel="nofollow" aria-label="Remove {{ ch_txt | escape }}"><span>{{ ch_txt | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif f.active_values.size > 0 -%}
        {%- for v in f.active_values -%}
          {%- liquid
            assign ch_l = v.label
            case v.value
              when 'Non-Studdable'
                assign ch_l = 'No studs'
              when 'P'
                assign ch_l = 'Passenger'
              when 'LT'
                assign ch_l = 'Light truck'
              when 'ST'
                assign ch_l = 'Trailer'
            endcase
            assign ch_txt = ch_name | append: ': ' | append: ch_l
            if lr_other == ''
              assign lr_other = ch_txt
              assign lr_other_url = v.url_to_remove
            endif
          -%}
          <a class="rd-chip rd-chip--link rd-chip--v16" href="{{ v.url_to_remove | escape }}" rel="nofollow" aria-label="Remove {{ ch_txt | escape }}"><span>{{ ch_txt | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
        {%- endfor -%}
      {%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- liquid
  assign lr_name = ''
  assign lr_url = ''
  if lr_brand != ''
    assign lr_name = lr_brand
    assign lr_url = lr_brand_url
  elsif lr_price != ''
    assign lr_name = lr_price
    assign lr_url = lr_price_url
  elsif lr_sea != ''
    assign lr_name = lr_sea
    assign lr_url = lr_sea_url
  elsif lr_other != ''
    assign lr_name = lr_other
    assign lr_url = lr_other_url
  endif
  assign t_in = ''
  if rd_has_size
    assign t_in = ' in ' | append: rd_title
  endif
-%}
<div class="rd rd-res rd-res--v16" data-rd-results data-kind="{{ rd_kind }}" data-unit="{{ rd_one }}" data-units="{{ rd_many }}">
  {%- comment -%}
    v16 fix1, before anything paints: rd-js (the phone no-JS Filters / Sort
    bar takes no space; assets/pt-rd-results.js shows the floating pill) and,
    with ?rear= in the address, rd-pairwait (the front grid, foot and Season
    items wait for the staggered sets, so nothing jumps; pair mode removes
    it, and it lifts by itself after 15 s if the script never runs).
  {%- endcomment -%}
  <script>(function(r){try{r.classList.add('rd-js');if(/[?&]rear=[^&]/.test(location.search)){r.classList.add('rd-pairwait');setTimeout(function(){r.classList.remove('rd-pairwait');},15000);}}catch(e){}})(document.currentScript.parentNode);</script>
  <a class="rd-skip" href="#rd-results">Skip to results</a>

  {%- comment -%} Phones / tablets without JS: sticky Filters + Sort bar (the floating pill replaces it). {%- endcomment -%}
  <div class="rd-sortbar rd-res__bar">
    <button type="button" class="rd-bar" data-rd-fopen aria-controls="rd-filters" aria-expanded="false">
      {%- render 'pt-icon', name: 'filter', size: 19 -%}
      Filters
      {%- if rd_active > 0 -%}<span class="rd-bar__badge" aria-label="{{ rd_active }} applied">{{ rd_active }}</span>{%- endif -%}
    </button>
    <label class="rd-bar">
      <span class="rd-sr">Sort by</span>
      <select data-rd-sort aria-label="Sort by">{{ rd_sort_opts_t }}</select>
      {%- render 'pt-icon', name: 'chevron-down', size: 16, class: 'rd-bar__chev' -%}
    </label>
  </div>

  {%- comment -%}
    Phones / tablets: floating "Filters (n) | Sort" pill. The badge counts
    APPLIED filters only (absent when none); the result count lives in the
    head and in the sheet's "Show N results". Shown by assets/pt-rd-results.js.
  {%- endcomment -%}
  <div class="rd-fab" data-rd-fab hidden>
    <button type="button" class="rd-fab__f" data-rd-fopen aria-controls="rd-filters" aria-expanded="false" aria-label="Filters{% if rd_active > 0 %}, {{ rd_active }} applied{% endif %}">
      {%- render 'pt-icon', name: 'filter', size: 18 -%}
      <span aria-hidden="true">Filters</span>
      {%- if rd_active > 0 -%}<span class="rd-fab__n" aria-hidden="true">{{ rd_active }}</span>{%- endif -%}
    </button>
    <span class="rd-fab__sep" aria-hidden="true"></span>
    <label class="rd-fab__s">
      <span aria-hidden="true">Sort</span>
      {%- render 'pt-icon', name: 'chevron-down', size: 16, class: 'rd-fab__chev' -%}
      <select data-rd-sort aria-label="Sort by">{{ rd_sort_opts_t }}</select>
    </label>
  </div>

  <div class="rd-wrap rd-res__layout">
    <span class="rd-rhd__sentinel" data-rd-head-sentinel aria-hidden="true"></span>
    <div class="rd-rhd{% unless rd_has_size %} rd-rhd--nosize{% endunless %}" data-rd-head>
      <div class="rd-rhd__l">
        <div class="rd-rhd__t">
          {%- comment -%} fix2: no size, sentence case like the rest ('16" Tires' -> '16" tires'). {%- endcomment -%}
          {%- assign rd_h1 = rd_title -%}
          {%- unless rd_has_size -%}
            {%- assign rd_h1_end = rd_title | slice: -6, 6 -%}
            {%- if rd_h1_end == ' Tires' -%}
              {%- assign rd_h1_n = rd_title.size | minus: 6 -%}
              {%- assign rd_h1 = rd_title | slice: 0, rd_h1_n | append: ' tires' -%}
            {%- endif -%}
          {%- endunless -%}
          <h1 class="rd-rhd__title" id="rd-rh-title" data-rd-title{% unless rd_has_size %} data-rd-size-fallback{% endunless %}>{{ rd_h1 | escape }}</h1>
          {%- comment -%} Staggered set (?rear=): the two-size H1 from the first paint (same markup as pairTitle() in pt-rd-results.js). {%- endcomment -%}
          <script>(function(h){try{var r=new URLSearchParams(location.search).get('rear');if(!r||!h)return;r=r.replace(/\s+/g,'').toUpperCase().replace('ZR','R');var f=h.textContent.trim().toUpperCase(),re=/^\d{3}\/\d{2}R\d{2}$/;if(!re.test(r)||!re.test(f)||r===f)return;h.setAttribute('data-rd-h1-orig',h.innerHTML);h.classList.add('is-pair');h.innerHTML='<span class="rd-rhd__ax"><span>'+f+'</span><small> front</small></span><span class="rd-rhd__dot" aria-hidden="true">·</span><span class="rd-rhd__ax"><span>'+r+'</span><small> rear</small></span>';}catch(e){}})(document.currentScript.previousElementSibling);</script>
          <p class="rd-rhd__sub"><span class="rd-rhd__count" data-rd-shown>
            {%- if collection.products.size > 0 -%}
              {%- comment -%} "results", not "tires": a count of matching listings must never read like stock on hand (owner 2026-11-15). {%- endcomment -%}{%- if paginate.current_page > 1 -%}Showing <strong data-rd-shown-n>{{ rd_from }}–{{ rd_to }}</strong> of {{ rd_total_fmt }} results{%- else -%}<strong data-rd-shown-n>{{ rd_total_fmt }}</strong> {% if rd_total == 1 %}result{% else %}results{% endif %}{%- endif -%}
            {%- else -%}
              <strong data-rd-shown-n>0</strong> results
            {%- endif -%}
          </span><span class="rd-rhd__gstm"> · before GST</span></p>
        </div>
        <button type="button" class="rd-btnsec rd-rhd__size" aria-expanded="false" aria-controls="rd-search-panel" aria-haspopup="dialog" data-rd-panel-toggle data-pt-size-sheet data-pss-pop data-label-closed="{% if rd_has_size %}Change size{% else %}Find your size{% endif %}" data-label-open="Hide size search">
          {%- render 'pt-icon', name: 'change-size', size: 18 -%}<span data-rd-size-label>{% if rd_has_size %}Change size{% else %}Find your size{% endif %}</span>
        </button>
      </div>
      <div class="rd-rhd__r">
        <span class="rd-rhd__gst">Prices per tire, before GST</span>
        <button type="button" class="rd-btnsec rd-rhd__filters" data-rd-fopen aria-controls="rd-filters" aria-expanded="false" aria-label="Filters{% if rd_active > 0 %}, {{ rd_active }} applied{% endif %}">
          {%- render 'pt-icon', name: 'filter', size: 18 -%}<span aria-hidden="true">Filters</span>{%- if rd_active > 0 -%}<span class="rd-rhd__n" aria-hidden="true">{{ rd_active }}</span>{%- endif -%}
        </button>
        <label class="rd-rhd__sort">
          <span class="rd-rhd__sortk">Sort</span>
          <select id="rd-sort" data-rd-sort>{{ rd_sort_opts_t }}</select>
          {%- render 'pt-icon', name: 'chevron-down', size: 16, class: 'rd-rhd__sortchev' -%}
        </label>
      </div>
    </div>
    {%- unless rd_has_size -%}
      {%- comment -%} No size yet (desktop): one quiet search row, filled by assets/pt-rd-results.js with the Find your size search (PTSizeSheet.inline, compact). {%- endcomment -%}
      <div class="rd-quiet" data-rd-quiet hidden><div class="rd-quiet__in" data-rd-quiet-host></div></div>
    {%- endunless -%}

    <div class="rd-res__main" id="rd-results" tabindex="-1">
      <h2 class="rd-sr">Results</h2>
      <a class="rd-skip rd-skip--in" href="#rd-filters">Skip to filters</a>

      {% render 'pt-collection-garage-banner', hide: false %}

      {%- if is_clearance -%}
        <p class="rd-note rd-res__clear" role="note"><strong>Clearance</strong> — final markdowns, while quantities last.</p>
      {%- endif -%}

      {%- comment -%}
        Quick row. Desktop: the brand slider (one tab stop, arrows). Phones /
        tablets: ONE swiping row (never stacked): Clear all (2+ filters), the
        sidebar-only filters as chips, the picked seasons and brand, a divider,
        the other seasons this size has, a divider, the other brands.
        Season items are plain links to the same filter URLs as the Season
        filter (multi-select), so they stay in sync with it.
      {%- endcomment -%}
      <nav class="rd-quick{% if q_sea_on > 0 or q_brand_on > 0 %} has-on{% endif %}" aria-label="Quick filters" data-rd-quick>
        {%- if rd_active >= 2 -%}<a class="rd-q rd-q--clear" href="{{ t_clear | escape }}" rel="nofollow" data-rd-clear>Clear all</a>{%- endif -%}
        {%- if t_chips_other != blank -%}<span class="rd-q-chips">{{ t_chips_other }}</span>{%- endif -%}
        {%- if q_show_sea -%}
          {%- for qk in q_keys -%}
            {%- assign qi = forloop.index0 -%}
            {%- for v in f_season.values -%}
              {%- assign vk = v.label | downcase | replace: ' ', '-' -%}
              {%- if vk == qk -%}
                {%- if v.count > 0 or v.active -%}
                  <a class="rd-q rd-q--season{% if v.active %} is-on{% endif %}" href="{% if v.active %}{{ v.url_to_remove | escape }}{% else %}{{ v.url_to_add | escape }}{% endif %}" rel="nofollow" role="button" aria-pressed="{{ v.active }}"{% if v.active %} aria-label="{{ q_names[qi] }}, selected. Remove"{% endif %} data-rd-qseason="{{ qk }}">
                    {%- render 'pt-icon', name: qk, size: 18, class: 'rd-q__ic' -%}<span>{{ q_names[qi] }}</span>
                    {%- if v.active -%}<span class="rd-q__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 16 %}</span>{%- endif -%}
                  </a>
                {%- endif -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
        <span class="rd-qsep rd-qsep--a" aria-hidden="true"></span>
        <span class="rd-qsep rd-qsep--b" aria-hidden="true"></span>
        {%- if f_vendor -%}{% render 'pt-rd-brand-row', filter: f_vendor, collection: collection %}{%- endif -%}
      </nav>

      {%- assign t_chips = t_chips_sea | append: t_chips_brand | append: t_chips_other | strip -%}
      {%- if t_chips != blank -%}
        <div class="rd-chips rd-res__chips rd-chips--v16" role="group" aria-label="Applied filters">
          {{- t_chips -}}
          <a class="rd-chips__clear" href="{{ t_clear | escape }}" rel="nofollow" data-rd-clear>Clear all</a>
        </div>
      {%- endif -%}

      {%- if rd_b2b == false -%}
        {%- comment -%}
          Staggered sets (front + rear sizes, ?rear=275%2F35R18): filled by
          assets/pt-rd-results.js ("pair mode"), which then hides the grid,
          the phone "Show more" and the pages below. Empty and hidden without
          JS, so the page is the normal front-size grid. Not a .ptg__grid on
          purpose (pt-collection-stock reorders those).
        {%- endcomment -%}
        <div class="rd-pair" data-rd-pair hidden></div>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <div class="rd-grid ptg__grid" data-rd-grid>
          {%- for product in collection.products -%}
            {% render 'pt-collection-card', product: product, is_clearance: is_clearance, index: forloop.index, show_set: section.settings.show_set_price, show_compare: section.settings.enable_compare, show_best: section.settings.show_bestseller, show_rebate: section.settings.show_rebate, show_fit: section.settings.show_fitment, v16: true, has_size: rd_has_size %}
          {%- endfor -%}
          {%- if rd_total <= 2 and rd_active > 0 and lr_name != '' -%}
            {%- comment -%} Few results with filters on: one way to widen, naming the filter. No numbers, no "only". {%- endcomment -%}
            <div class="rd-widen" data-rd-widen>
              <p class="rd-widen__h">Want more choice?</p>
              <p class="rd-widen__p">Remove {{ lr_name | escape }} to see every {% if lr_name != lr_sea and lr_sea_adj != '' %}{{ lr_sea_adj }} {% endif %}tire{{ t_in | escape }}.</p>
              <a class="rd-btnout" href="{{ lr_url | escape }}" rel="nofollow">Remove {{ lr_name | escape }}</a>
            </div>
          {%- endif -%}
        </div>

        {%- if paginate.next and rd_b2b == false -%}
          <div class="rd-res__more rd-hide-lg" data-rd-more-wrap hidden>
            <button type="button" class="rd-btnout rd-btnout--block" data-rd-more-page data-next="{{ paginate.next.url | escape }}">Show more results</button>
            <div class="rd-res__more-count" data-rd-more-count aria-live="polite">Showing {{ rd_to }} of {{ rd_total_fmt }} results</div>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="rd-pages" aria-label="Pages" data-rd-pages>
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="rd-pages__step" rel="prev">← Prev</a>
            {%- else -%}
              <span class="rd-pages__step is-off" aria-hidden="true">← Prev</span>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="rd-pages__num">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="rd-pages__num is-on" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="rd-pages__gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="rd-pages__step rd-pages__step--next" rel="next">Next →</a>
            {%- else -%}
              <span class="rd-pages__step is-off" aria-hidden="true">Next →</span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- elsif rd_active > 0 and lr_name != '' -%}
        {%- comment -%} Zero results with filters on: name the actual filters, one tap to remove each. {%- endcomment -%}
        <div class="rd-widen rd-widen--empty" data-ptg-empty>
          <p class="rd-widen__h">No tires match these filters</p>
          <p class="rd-widen__p">
            {%- if lr_sea_adj != '' -%}No {{ lr_sea_adj }} tires{%- else -%}Nothing{%- endif -%}
            {%- if lr_brand != '' %} from {{ lr_brand | escape }}{% endif -%}
            {%- if lr_price != '' %} {{ lr_price | replace: 'Up to', 'up to' | replace: 'Under', 'under' | escape }} per tire{% endif -%}
            {{- t_in | escape }}. Remove a filter to see more.</p>
          <div class="rd-widen__b">
            {%- if lr_price != '' -%}<a class="rd-btnout rd-btnout--sm" href="{{ lr_price_url | escape }}" rel="nofollow">Remove {{ lr_price | escape }}</a>{%- endif -%}
            {%- if lr_brand != '' -%}<a class="rd-btnout rd-btnout--sm" href="{{ lr_brand_url | escape }}" rel="nofollow">Remove {{ lr_brand | escape }}</a>{%- endif -%}
            {%- if lr_sea != '' -%}<a class="rd-btnout rd-btnout--sm" href="{{ lr_sea_url | escape }}" rel="nofollow">Remove {{ lr_sea | escape }}</a>{%- endif -%}
            {%- if lr_other != '' and lr_price == '' and lr_brand == '' and lr_sea == '' -%}<a class="rd-btnout rd-btnout--sm" href="{{ lr_other_url | escape }}" rel="nofollow">Remove {{ lr_other | escape }}</a>{%- endif -%}
          </div>
        </div>
      {%- else -%}
        {% render 'pt-collection-empty', is_wheels: false %}
      {%- endif -%}

      <div class="rd-res__end">
        {%- if collection.products.size > 0 -%}
          <p class="rd-res__foot">Prices are per tire, before GST. Installation is added when you request install.</p>
        {%- endif -%}
        <div class="rd-help">
          <p class="rd-help__p">{% if collection.products.size > 0 %}Not sure which one? Call and we'll help you pick.{% else %}Can't find what you need? Call and we'll check what we can order in.{% endif %}</p>
          <div class="rd-help__b">
            <a class="rd-help__a" href="tel:+14034524283">{% render 'pt-icon', name: 'phone', size: 18 %}<span><b>42 Ave SW</b><small>(403) 452-4283</small></span></a>
            <a class="rd-help__a" href="tel:+18253954024">{% render 'pt-icon', name: 'phone', size: 18 %}<span><b>Edmonton Trail NE</b><small>(825) 395-4024</small></span></a>
          </div>
        </div>
      </div>
    </div>

    {% render 'pt-collection-sidebar', kind: rd_kind %}
  </div>
</div>
{%- else -%}
<div class="rd rd-res" data-rd-results data-kind="{{ rd_kind }}" data-unit="{{ rd_one }}" data-units="{{ rd_many }}">

  {%- comment -%} Phones / tablets: sticky Filters + Sort bar (MobileFilters.dc.html) {%- endcomment -%}
  <div class="rd-sortbar rd-res__bar">
    <button type="button" class="rd-bar" data-rd-fopen aria-controls="rd-filters" aria-expanded="false">
      {%- render 'pt-icon', name: 'filter', size: 19 -%}
      Filters
      {%- if rd_active > 0 -%}<span class="rd-bar__badge" aria-label="{{ rd_active }} active">{{ rd_active }}</span>{%- endif -%}
    </button>
    <label class="rd-bar">
      <span class="rd-sr">Sort by</span>
      <select data-rd-sort aria-label="Sort by">
        <option value="manual"{% if rd_sort == 'manual' %} selected{% endif %}>Sort: Recommended</option>
        <option value="price-ascending"{% if rd_sort == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
        <option value="price-descending"{% if rd_sort == 'price-descending' %} selected{% endif %}>Price: high to low</option>
        {%- if is_wheels or rd_sort == 'created-descending' -%}<option value="created-descending"{% if rd_sort == 'created-descending' %} selected{% endif %}>Newest</option>{%- endif -%}
        {%- if rd_sort == 'best-selling' -%}<option value="best-selling" selected>Best selling</option>{%- endif -%}
      </select>
      {%- render 'pt-icon', name: 'chevron-down', size: 16, class: 'rd-bar__chev' -%}
    </label>
  </div>

  {%- comment -%}
    Phones / tablets: floating "Filters · N | Sort" pill near the bottom
    (SizeSheet.dc.html board 2). N = this page's result count. Hidden until
    assets/pt-rd-results.js shows it; it then hides the sticky bar above,
    so without JS the bar above still works.
  {%- endcomment -%}
  <div class="rd-fab" data-rd-fab hidden>
    <button type="button" class="rd-fab__f" data-rd-fopen aria-controls="rd-filters" aria-expanded="false" aria-label="Filters{% if rd_active > 0 %}, {{ rd_active }} active{% endif %}. {{ rd_total_fmt }} {% if rd_total == 1 %}{{ rd_one }}{% else %}{{ rd_many }}{% endif %}">
      {%- render 'pt-icon', name: 'filter', size: 18 -%}
      <span aria-hidden="true">Filters · {{ rd_total_fmt }}</span>
      {%- if rd_active > 0 -%}<span class="rd-fab__dot" aria-hidden="true"></span>{%- endif -%}
    </button>
    <span class="rd-fab__sep" aria-hidden="true"></span>
    <label class="rd-fab__s">
      <span aria-hidden="true">Sort</span>
      <select data-rd-sort aria-label="Sort by">{{ rd_sort_opts }}</select>
    </label>
  </div>

  <div class="rd-wrap rd-res__layout">
    {% render 'pt-collection-sidebar', kind: rd_kind %}

    <div class="rd-res__main" id="rd-results">
      {%- if rd_kind == 'tires' -%}
        {%- comment -%} Saved-car banner filters by TIRE size, so never on a wheel page. {%- endcomment -%}
        {% render 'pt-collection-garage-banner', hide: false %}
      {%- endif -%}

      {%- if is_clearance -%}
        <p class="rd-note rd-res__clear" role="note"><strong>Clearance</strong> — final markdowns, while quantities last.</p>
      {%- endif -%}

      <div class="rd-toolbar rd-res__toolbar">
        {%- if rd_kind == 'tires' -%}
          {%- comment -%}
            Tire pages (owner 2026-11-15): the page title (H1) and count live
            here, on the Sort line, instead of a black band above the size
            search. Phones get "Change size" on this line (it opens the Find
            your size sheet; desktop has the size bar open above, so the
            button hides there via html:has(.rd-rh--bar)).
          {%- endcomment -%}
          <div class="rd-toolbar__head">
            <h1 class="rd-toolbar__title" id="rd-rh-title" data-rd-title{% unless rd_has_size %} data-rd-size-fallback{% endunless %}>{{ rd_title | escape }}</h1>
            <span class="rd-toolbar__count" data-rd-shown>
              {%- if collection.products.size > 0 -%}
                {%- comment -%} "results", not "tires": a count of matching listings must never read like stock on hand (owner 2026-11-15). {%- endcomment -%}{%- if paginate.current_page > 1 -%}Showing <strong data-rd-shown-n>{{ rd_from }}–{{ rd_to }}</strong> of {{ rd_total_fmt }} results{%- else -%}<strong data-rd-shown-n>{{ rd_total_fmt }}</strong> {% if rd_total == 1 %}result{% else %}results{% endif %}{%- endif -%}
              {%- else -%}
                No {{ rd_many }} match
              {%- endif -%}
            </span>
            <button type="button" class="rd-toolbar__size" aria-expanded="false" aria-controls="rd-search-panel" data-rd-panel-toggle data-pt-size-sheet data-label-closed="{% if rd_has_size %}Change size{% else %}Find your size{% endif %}" data-label-open="Hide size search">{% if rd_has_size %}Change size{% else %}Find your size{% endif %}</button>
          </div>
          {%- comment -%}
            Shop by brand (design board Option B, owner 2026-11-15): logo
            tiles on this line (desktop) / a swipe row under it (phones), from
            the Brand facet. Tire pages only; the sidebar Brand group stays.
          {%- endcomment -%}
          {%- for f in collection.filters -%}
            {%- if f.param_name == 'filter.p.vendor' -%}
              {% render 'pt-rd-brand-row', filter: f, collection: collection %}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
        <div class="rd-toolbar__count" data-rd-shown>
          {%- if collection.products.size > 0 -%}
            Showing <strong data-rd-shown-n>{% if paginate.current_page > 1 %}{{ rd_from }}–{{ rd_to }}{% else %}{{ collection.products.size }}{% endif %}</strong> of {{ rd_total_fmt }}
          {%- else -%}
            No {{ rd_many }} match
          {%- endif -%}
        </div>
        {%- endif -%}

        {%- comment -%} Active-filter chips: one per filter, each a link that removes it. {%- endcomment -%}
        {%- capture rd_chips -%}
          {%- comment -%} Tags in the collection URL (wheel Finish / Wheel type fallback): one chip each. {%- endcomment -%}
          {%- if current_tags.size > 0 -%}
            {%- liquid
              assign tc_q = ''
              for f in collection.filters
                if f.type == 'price_range'
                  if f.min_value.value != blank
                    assign tc_pv = f.min_value.value | divided_by: 100
                    assign tc_q = tc_q | append: 'filter.v.price.gte=' | append: tc_pv | append: '&'
                  endif
                  if f.max_value.value != blank
                    assign tc_pv = f.max_value.value | divided_by: 100
                    assign tc_q = tc_q | append: 'filter.v.price.lte=' | append: tc_pv | append: '&'
                  endif
                else
                  for v in f.active_values
                    assign tc_v = v.value | url_encode
                    assign tc_q = tc_q | append: v.param_name | append: '=' | append: tc_v | append: '&'
                  endfor
                endif
              endfor
              if collection.sort_by != blank
                assign tc_q = tc_q | append: 'sort_by=' | append: collection.sort_by
              endif
              assign tc_q = tc_q | remove_last: '&'
            -%}
            {%- for ct in current_tags -%}
              {%- liquid
                assign ct_h = ct | handleize
                assign ct_label = ct
                for t in collection.all_tags
                  assign t_h = t | handleize
                  if t_h == ct_h
                    assign ct_label = t
                    break
                  endif
                endfor
                if ct_h == 'winter-approved'
                  assign ct_label = 'Winter approved'
                endif
                assign ct_rest = ''
                for o in current_tags
                  assign o_h = o | handleize
                  if o_h != ct_h
                    if ct_rest != ''
                      assign ct_rest = ct_rest | append: '+'
                    endif
                    assign ct_rest = ct_rest | append: o_h
                  endif
                endfor
                assign ct_href = collection.url
                if ct_rest != ''
                  assign ct_href = ct_href | append: '/' | append: ct_rest
                endif
                if tc_q != ''
                  assign ct_href = ct_href | append: '?' | append: tc_q
                endif
              -%}
              <a class="rd-chip rd-chip--link" href="{{ ct_href | escape }}" rel="nofollow" aria-label="Remove filter {{ ct_label | escape }}" data-rd-tagchip="{{ ct_h }}"><span>{{ ct_label | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
            {%- endfor -%}
          {%- endif -%}
          {%- for f in collection.filters -%}
            {%- liquid
              assign ch_skip = false
              if f.param_name == 'filter.p.m.custom.tire_width' or f.param_name == 'filter.p.m.custom.tire_profile' or f.param_name == 'filter.p.m.custom.tire_size'
                assign ch_skip = true
              endif
              if f.param_name == 'filter.p.m.custom.rim_diameter'
                assign ch_skip = true
              endif
              case f.param_name
                when 'filter.p.vendor'
                  assign ch_name = 'Brand'
                when 'filter.p.m.custom.seasonality'
                  assign ch_name = 'Season'
                when 'filter.p.m.custom.service_type'
                  assign ch_name = 'Tire type'
                when 'filter.p.m.custom.stud_option'
                  assign ch_name = 'Studs'
                when 'filter.p.m.custom.tire_model'
                  assign ch_name = 'Model'
                when 'filter.p.m.custom.bolt_pattern'
                  assign ch_name = 'Bolt pattern'
                when 'filter.p.m.custom.rim_width'
                  assign ch_name = 'Width'
                when 'filter.p.m.custom.rim_offset'
                  assign ch_name = 'Offset'
                when 'filter.p.m.custom.center_bore'
                  assign ch_name = 'Centre bore'
                when 'filter.p.product_type'
                  if is_wheels
                    assign ch_name = 'Wheel type'
                  else
                    assign ch_name = 'Type'
                  endif
                else
                  assign ch_name = f.label
              endcase
            -%}
            {%- unless ch_skip -%}
              {%- if f.type == 'price_range' -%}
                {%- if f.min_value.value != blank or f.max_value.value != blank -%}
                  {%- liquid
                    assign ch_txt = 'Price: '
                    if f.min_value.value != blank and f.max_value.value != blank
                      assign ch_a = f.min_value.value | divided_by: 100 | floor
                      assign ch_b = f.max_value.value | divided_by: 100 | floor
                      assign ch_txt = ch_txt | append: '$' | append: ch_a | append: ' – $' | append: ch_b
                    elsif f.min_value.value != blank
                      assign ch_a = f.min_value.value | divided_by: 100 | floor
                      assign ch_txt = ch_txt | append: '$' | append: ch_a | append: ' and up'
                    else
                      assign ch_b = f.max_value.value | divided_by: 100 | floor
                      assign ch_txt = ch_txt | append: 'under $' | append: ch_b
                    endif
                  -%}
                  <a class="rd-chip rd-chip--link" href="{{ f.url_to_remove | escape }}" rel="nofollow" aria-label="Remove filter {{ ch_txt | escape }}"><span>{{ ch_txt }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
                {%- endif -%}
              {%- elsif f.param_name == 'filter.p.m.custom.bolt_pattern' -%}
                {%- if f.active_values.size > 0 -%}
                  {%- capture ch_bolts -%}{% render 'pt-rd-results-bolt', filter: f %}{%- endcapture -%}
                  {%- assign ch_txt = 'Bolt pattern: ' | append: ch_bolts -%}
                  <a class="rd-chip rd-chip--link" href="{{ f.url_to_remove | escape }}" rel="nofollow" aria-label="Remove filter {{ ch_txt | escape }}"><span>{{ ch_txt | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
                {%- endif -%}
              {%- elsif f.param_name == 'filter.p.tag' or f.param_name == 'filter.v.availability' -%}
                {%- for v in f.active_values -%}
                  {%- liquid
                    assign ch_show = true
                    assign ch_txt = v.label
                    if f.param_name == 'filter.v.availability'
                      if v.value == '1'
                        assign ch_show = false
                      else
                        assign ch_txt = 'Sold out only'
                      endif
                    elsif v.value == 'Prince Stock'
                      assign ch_txt = 'Stocked at our shops'
                    elsif v.value == 'Winter Approved'
                      assign ch_txt = 'Winter approved'
                    endif
                  -%}
                  {%- if ch_show -%}
                    <a class="rd-chip rd-chip--link" href="{{ v.url_to_remove | escape }}" rel="nofollow" aria-label="Remove filter {{ ch_txt | escape }}"><span>{{ ch_txt | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif f.active_values.size > 0 -%}
                {%- liquid
                  assign ch_vals = ''
                  assign ch_seen = ','
                  assign ch_n = 0
                  assign ch_more = 0
                  for v in f.active_values
                    assign ch_l = v.label
                    case v.value
                      when 'All-Weather'
                        assign ch_l = 'All-weather'
                      when 'All-Season'
                        assign ch_l = 'All-season'
                      when 'Non-Studdable'
                        assign ch_l = 'No studs'
                      when 'Alloy Rims'
                        assign ch_l = 'Alloy'
                      when 'Steel Rims'
                        assign ch_l = 'Steel'
                      when 'P'
                        assign ch_l = 'Passenger'
                      when 'LT'
                        assign ch_l = 'Light truck'
                      when 'ST'
                        assign ch_l = 'Trailer'
                    endcase
                    if f.param_name == 'filter.p.m.custom.rim_width'
                      assign ch_wp = ch_l | split: '.'
                      if ch_wp[1] == '0'
                        assign ch_l = ch_wp[0]
                      endif
                      assign ch_l = ch_l | append: '″'
                    endif
                    if f.param_name == 'filter.p.m.custom.center_bore'
                      assign ch_l = ch_l | append: ' mm'
                    endif
                    assign ch_tok = ',' | append: ch_l | append: ','
                    if ch_seen contains ch_tok
                      continue
                    endif
                    assign ch_seen = ch_seen | append: ch_l | append: ','
                    if ch_n < 3
                      if ch_vals != ''
                        assign ch_vals = ch_vals | append: ', '
                      endif
                      assign ch_vals = ch_vals | append: ch_l
                    else
                      assign ch_more = ch_more | plus: 1
                    endif
                    assign ch_n = ch_n | plus: 1
                  endfor
                  assign ch_txt = ch_name | append: ': ' | append: ch_vals
                  if ch_more > 0
                    assign ch_txt = ch_txt | append: ' +' | append: ch_more
                  endif
                -%}
                <a class="rd-chip rd-chip--link" href="{{ f.url_to_remove | escape }}" rel="nofollow" aria-label="Remove filter {{ ch_txt | escape }}"><span>{{ ch_txt | escape }}</span><span class="rd-chip__x" aria-hidden="true">{% render 'pt-icon', name: 'close', size: 14 %}</span></a>
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if rd_chips != blank -%}
          <div class="rd-chips rd-res__chips" aria-label="Active filters">{{ rd_chips }}</div>
        {%- endif -%}

        <div class="rd-toolbar__sort rd-res__sort">
          <label for="rd-sort">Sort by</label>
          <select id="rd-sort" class="rd-select" data-rd-sort>
            <option value="manual"{% if rd_sort == 'manual' %} selected{% endif %}>Recommended</option>
            <option value="price-ascending"{% if rd_sort == 'price-ascending' %} selected{% endif %}>Price: low to high</option>
            <option value="price-descending"{% if rd_sort == 'price-descending' %} selected{% endif %}>Price: high to low</option>
            {%- if is_wheels or rd_sort == 'created-descending' -%}<option value="created-descending"{% if rd_sort == 'created-descending' %} selected{% endif %}>Newest</option>{%- endif -%}
            {%- comment -%} Best selling is not in the mockups: listed only when a link already uses it, so the box shows the real order. {%- endcomment -%}
            {%- if rd_sort == 'best-selling' -%}<option value="best-selling" selected>Best selling</option>{%- endif -%}
          </select>
        </div>
      </div>

      {%- if rd_kind == 'tires' and rd_b2b == false -%}
        {%- comment -%}
          Staggered sets (front + rear sizes, ?rear=275%2F35R18): filled by
          assets/pt-rd-results.js ("pair mode"), which then hides the grid,
          the phone "Show more" and the pages below. Empty and hidden without
          JS, so the page is the normal front-size grid. Not a .ptg__grid on
          purpose (pt-collection-stock reorders those).
        {%- endcomment -%}
        <div class="rd-pair" data-rd-pair hidden></div>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        {%- comment -%}
          Every product on the page is rendered, sold-out ones included (greyed,
          "Sold out"); pt-collection-stock moves them to the end of .ptg__grid.
          Hiding them made "41 products" show as 1 card (see git history).
        {%- endcomment -%}
        <div class="rd-grid ptg__grid" data-rd-grid>
          {%- for product in collection.products -%}
            {%- if rd_kind == 'tires' -%}
              {% render 'pt-collection-card', product: product, is_clearance: is_clearance, index: forloop.index, show_set: section.settings.show_set_price, show_compare: section.settings.enable_compare, show_best: section.settings.show_bestseller, show_rebate: section.settings.show_rebate, show_fit: section.settings.show_fitment, v16: true, has_size: rd_has_size %}
            {%- else -%}
              {% render 'pt-collection-card', product: product, is_clearance: is_clearance, index: forloop.index, show_set: section.settings.show_set_price, show_compare: section.settings.enable_compare, show_best: section.settings.show_bestseller, show_rebate: section.settings.show_rebate, show_fit: section.settings.show_fitment %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.next and rd_b2b == false -%}
          <div class="rd-res__more rd-hide-lg" data-rd-more-wrap hidden>
            <div class="rd-res__more-count" data-rd-more-count aria-live="polite">Showing {{ rd_to }} of {{ rd_total_fmt }}</div>
            <button type="button" class="rd-btn rd-btn--line rd-btn--block" data-rd-more-page data-next="{{ paginate.next.url | escape }}">Show more {{ rd_many }}</button>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="rd-pages" aria-label="Pages" data-rd-pages>
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="rd-pages__step" rel="prev">← Prev</a>
            {%- else -%}
              <span class="rd-pages__step is-off" aria-hidden="true">← Prev</span>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="rd-pages__num">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="rd-pages__num is-on" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="rd-pages__gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="rd-pages__step rd-pages__step--next" rel="next">Next →</a>
            {%- else -%}
              <span class="rd-pages__step is-off" aria-hidden="true">Next →</span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        {% render 'pt-collection-empty', is_wheels: is_wheels %}
      {%- endif -%}

      <p class="rd-res__foot">
        {%- if is_wheels -%}
          Prices are per wheel, before GST. Mount and balance is ${{ rd_wheel_install }} a wheel, added when you request installation.
        {%- elsif rd_kind == 'tires' -%}
          Prices are per tire, before GST. Installation is added when you book.
        {%- else -%}
          Prices are before GST.
        {%- endif -%}
      </p>

      {%- if is_wheels -%}
        <div class="rd-res__box">
          <div class="rd-res__box-text">
            <div class="rd-res__box-h">Wheels and tires together?</div>
            <div class="rd-res__box-sub">Build a package: wheels, tires, sensors and installation, priced as one set.</div>
          </div>
          <a class="rd-btn rd-btn--line" href="/pages/wheel-package">Build a package</a>
        </div>
      {%- endif -%}

      <div class="rd-res__box rd-res__box--help">
        <div class="rd-res__box-text">
          {%- if is_wheels -%}
            <div class="rd-res__box-h"><span class="rd-hide-sm">Don't see the wheel you need?</span><span class="rd-hide-lg">Not sure it fits?</span></div>
            <div class="rd-res__box-sub rd-hide-sm">Call either shop. We can order most sizes and bolt patterns.</div>
          {%- else -%}
            <div class="rd-res__box-h">Not sure which one?</div>
            <div class="rd-res__box-sub rd-hide-sm">Call either shop and we'll talk it through with you.</div>
          {%- endif -%}
        </div>
        <div class="rd-res__calls">
          {%- comment -%} Shop names + one phone format: "Call 42 Ave SW · (403) 452-4283" (the dot is read out, the label sits above the number). {%- endcomment -%}
          <a class="rd-res__call" style="text-align:center" href="tel:+14034524283"><span class="rd-res__call-k">Call 42 Ave SW</span><span class="rd-sr"> · </span><span class="rd-res__call-n">(403) 452-4283</span></a>
          <a class="rd-res__call" style="text-align:center" href="tel:+18253954024"><span class="rd-res__call-k">Call Edmonton Trail NE</span><span class="rd-sr"> · </span><span class="rd-res__call-n">(825) 395-4024</span></a>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{%- if section.settings.enable_compare -%}
  {% render 'pt-collection-compare' %}
{%- endif -%}

<script type="application/json" data-rd-results-config>
{
  "kind": {{ rd_kind | json }},
  "one": {{ rd_one | json }},
  "many": {{ rd_many | json }},
  "b2b": {{ rd_b2b | json }},
  "sectionId": {{ section.id | json }},
  "collectionUrl": {{ collection.url | json }},
  "tags": [{%- for t in current_tags -%}{%- unless forloop.first -%},{%- endunless -%}{{ t | handleize | json }}{%- endfor -%}],
  "total": {{ rd_total | json }},
  "perPage": {{ section.settings.products_per_page | json }},
  "page": {{ paginate.current_page | json }}
}
</script>
{%- comment -%} window.PTVehiclePairs.url (the one staggered-set URL builder); loaded here for now, sitewide later. {%- endcomment -%}
<script src="{{ 'pt-vehicle-pairs.js' | asset_url }}" defer></script>
<script src="{{ 'pt-rd-results.js' | asset_url }}" defer></script>
{%- endpaginate -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "image_padding",
      "label": "Image padding",
      "min": 0,
      "max": 4,
      "step": 0.2,
      "default": 1.2,
      "unit": "rem",
      "info": "Padding around tire images (top, left, right)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "0.8", "label": "Short (4:5)" },
        { "value": "1", "label": "Square (1:1)" },
        { "value": "1.2", "label": "Tall (5:6)" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Trust bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Price match vs local independent shops"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "Road Hazard Protection"
    },
    {
      "type": "header",
      "content": "Card features"
    },
    {
      "type": "checkbox",
      "id": "show_set_price",
      "label": "Show set-of-4 price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_warranty",
      "label": "Show mileage warranty",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Show speed/load badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fitment",
      "label": "Show vehicle fitment confirmation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bestseller",
      "label": "Show best seller badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rebate",
      "label": "Show rebate callouts",
      "default": true
    },
    {
      "type": "header",
      "content": "Compare"
    },
    {
      "type": "checkbox",
      "id": "enable_compare",
      "label": "Enable compare feature",
      "default": true
    }
  ]
}
{% endschema %}
