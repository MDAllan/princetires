  // Reopen filter drawer after a filter is selected — mobile only.
  // On desktop the sidebar is always visible (no drawer); openFilters() would
  // lock body scroll with no backdrop/close button on screen to release it.
  try {
    if (sessionStorage.getItem('ptg_filter_open') === '1') {
      sessionStorage.removeItem('ptg_filter_open');
      if (openBtn && getComputedStyle(openBtn).display !== 'none') openFilters();
    }
  } catch(e) {}

  // Sort
  var sortSelect = document.querySelector('[data-ptg-sort]');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', this.value);
      window.location.href = url.toString();
    });
  }

  /* ── AJAX add-to-cart for collection card cart buttons ─────────────────── */
  (function() {
    function updateBadge(count) {
      // Live header is pt-header (sections/header-group.json); its cart count
      // lives in .pt-header__cart-count (desktop + mobile). The old
      // #cart-icon-bubble target only existed in the orphaned pt-navbar.
      document.querySelectorAll('.pt-header__cart-count').forEach(function(el) {
        el.textContent = count;
      });
    }

    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.ptg__card-cart');
      if (!btn || btn.disabled) return;
      e.preventDefault();
      e.stopPropagation();

      var variantId = btn.dataset.variant;
      if (!variantId) return;

      btn.disabled = true;
      btn.classList.add('ptg__card-cart--loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        btn.classList.remove('ptg__card-cart--loading');
        if (data.status) { btn.disabled = false; return; }
        btn.classList.add('ptg__card-cart--success');
        fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function(r) { return r.json(); })
          .then(function(cart) { updateBadge(cart.item_count); })
          .catch(function() {});
        setTimeout(function() { btn.classList.remove('ptg__card-cart--success'); btn.disabled = false; }, 2000);
      })
      .catch(function() { btn.classList.remove('ptg__card-cart--loading'); btn.disabled = false; });
    });
  })();
});
</script>

