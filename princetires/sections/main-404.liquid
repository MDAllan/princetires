<section class="pt404" data-pt404>

  {%- comment -%} Page schema — Schema.org WebPage + BreadcrumbList — helps recovery in search results {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ request.path }}#404",
        "name": "Page not found",
        "description": "The page you were looking for does not exist at Prince Tires Calgary. Use the navigation to find tires, brands, booking, or to contact the shop at 111 42 Ave SW.",
        "isPartOf": { "@type": "WebSite", "@id": "{{ shop.url }}/#website", "url": "{{ shop.url }}", "name": "Prince Tires" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
          { "@type": "ListItem", "position": 2, "name": "Page not found" }
        ]
      }
    ]
  }
  </script>

  <div class="pt404__container">

    {%- comment -%} Hero: eyebrow + cracked-pothole 404 + headline + subhead + CTAs {%- endcomment -%}
    <header class="pt404__hero">
      <span class="pt404__eyebrow">
        <span class="pt404__eyebrow-dot" aria-hidden="true"></span>
        404 · Page not found
      </span>

      {%- comment -%} The big 404 — the 0 is rendered as an SVG with a "pothole" crack {%- endcomment -%}
      <div class="pt404__number" aria-hidden="true">
        <span class="pt404__digit pt404__digit--four">4</span>
        <span class="pt404__digit pt404__digit--zero">

          {%- comment -%} Tire that rolls in from the right and falls into the pothole on loop {%- endcomment -%}
          <span class="pt404__tire" aria-hidden="true">
            <svg viewBox="0 0 80 80" class="pt404__tire-svg" focusable="false">
              <defs>
                <radialGradient id="pt404-tire" cx="50%" cy="50%" r="50%">
                  <stop offset="55%" stop-color="#1a1a1a"/>
                  <stop offset="100%" stop-color="#0a0a0a"/>
                </radialGradient>
              </defs>
              <circle cx="40" cy="40" r="36" fill="url(#pt404-tire)"/>
              <circle cx="40" cy="40" r="36" fill="none" stroke="#2a2a2a" stroke-width="1.5"/>
              {%- comment -%} Tread blocks rotated around the circumference {%- endcomment -%}
              <g fill="#2a2a2a">
                {%- for i in (0..11) -%}
                  <rect x="38" y="4" width="4" height="8" rx="1" transform="rotate({{ i | times: 30 }} 40 40)"/>
                {%- endfor -%}
              </g>
              {%- comment -%} Rim — gives the tire visual depth {%- endcomment -%}
              <circle cx="40" cy="40" r="16" fill="#4a4a4a"/>
              <circle cx="40" cy="40" r="13" fill="#2a2a2a"/>
              <circle cx="40" cy="40" r="3.5" fill="#5a5a5a"/>
              {%- comment -%} 5-spoke star {%- endcomment -%}
              <g stroke="#4a4a4a" stroke-width="2.4" stroke-linecap="round">
                <line x1="40" y1="40" x2="40" y2="29"/>
                <line x1="40" y1="40" x2="50.5" y2="33.7"/>
                <line x1="40" y1="40" x2="46.5" y2="48.7"/>
                <line x1="40" y1="40" x2="33.5" y2="48.7"/>
                <line x1="40" y1="40" x2="29.5" y2="33.7"/>
              </g>
            </svg>
          </span>

          <svg viewBox="0 0 200 200" class="pt404__pothole-svg" preserveAspectRatio="xMidYMid meet" focusable="false">
            <defs>
              <radialGradient id="pt404-bowl" cx="55%" cy="45%" r="65%">
                <stop offset="0%" stop-color="#1a1a1a"/>
                <stop offset="100%" stop-color="#0a0a0a"/>
              </radialGradient>
              <linearGradient id="pt404-glow" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#F5820B" stop-opacity="0.85"/>
                <stop offset="100%" stop-color="#DA291C" stop-opacity="0.65"/>
              </linearGradient>
            </defs>

            {%- comment -%} The outer "ring" — the 0 shape with irregular jagged edge {%- endcomment -%}
            <path
              d="M100 14
                 C 132 14 165 26 178 60
                 C 192 92 188 130 168 158
                 C 152 182 130 192 100 192
                 C 76 192 50 184 32 162
                 C 10 138 6 102 18 70
                 C 30 38 60 22 88 16
                 Z
                 M100 48
                 L 118 42
                 L 134 56
                 L 152 64
                 L 158 86
                 L 168 100
                 L 158 122
                 L 152 142
                 L 132 148
                 L 116 158
                 L 96 154
                 L 80 158
                 L 64 146
                 L 50 136
                 L 42 116
                 L 34 96
                 L 44 78
                 L 52 60
                 L 70 54
                 L 84 50
                 Z"
              fill="url(#pt404-glow)"
              fill-rule="evenodd"
              class="pt404__pothole-outer"
            />

            {%- comment -%} The pothole "bowl" — dark inner shape {%- endcomment -%}
            <path
              d="M100 48
                 L 118 42 L 134 56 L 152 64 L 158 86 L 168 100
                 L 158 122 L 152 142 L 132 148 L 116 158 L 96 154
                 L 80 158 L 64 146 L 50 136 L 42 116 L 34 96
                 L 44 78 L 52 60 L 70 54 L 84 50 Z"
              fill="url(#pt404-bowl)"
              class="pt404__pothole-bowl"
            />

            {%- comment -%} Cracks fanning out from the pothole {%- endcomment -%}
            <g class="pt404__cracks" stroke="#F5820B" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.78">
              <path d="M100 14 L 96 6 L 92 -2"/>
              <path d="M178 60 L 188 56 L 194 48 M186 52 L 192 60"/>
              <path d="M168 158 L 184 168 L 190 178"/>
              <path d="M32 162 L 18 174 L 6 180"/>
              <path d="M18 70 L 4 60 L -2 52 M 8 56 L -4 60"/>
            </g>

            {%- comment -%} Small chunks of broken pavement {%- endcomment -%}
            <g class="pt404__chunks" fill="#1a1a1a" opacity="0.85">
              <polygon points="172,176 184,170 188,180 178,184"/>
              <polygon points="20,184 32,178 34,188 24,192"/>
              <polygon points="190,30 198,26 196,40 188,38"/>
            </g>
          </svg>
        </span>
        <span class="pt404__digit pt404__digit--four">4</span>
      </div>

      <h1 class="pt404__headline">
        Looks like you hit a <span class="pt404__highlight">Calgary&nbsp;pothole.</span>
      </h1>

      <p class="pt404__subhead">
        The page you were looking for didn't survive the freeze-thaw.
        Let's get you back on the road &mdash; pick a route below or use the search.
      </p>

      <form action="{{ routes.search_url }}" method="get" class="pt404__search" role="search">
        <input type="hidden" name="type" value="product">
        <label for="pt404-q" class="visually-hidden">Search</label>
        <span class="pt404__search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        </span>
        <input
          id="pt404-q"
          type="search"
          name="q"
          placeholder="Search tires, brands, services&hellip;"
          autocomplete="off"
        >
        <button type="submit" class="pt404__search-go">Search</button>
      </form>

      <div class="pt404__primary-ctas">
        <a href="/collections/tires" class="pt404__btn pt404__btn--primary">
          Find my tires
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/pages/booking" class="pt404__btn pt404__btn--secondary">
          Book an install
        </a>
        <a href="tel:+14034524283" class="pt404__btn pt404__btn--ghost">
          Or call (403) 452-4283
        </a>
      </div>
    </header>

    {%- comment -%} Popular paths — bento mosaic of recovery destinations {%- endcomment -%}
    <section class="pt404__paths" aria-labelledby="pt404-paths-heading">
      <div class="pt404__paths-head">
        <span class="pt404__paths-eyebrow">Popular routes back</span>
        <h2 class="pt404__paths-heading" id="pt404-paths-heading">Where most Calgary drivers go next</h2>
      </div>

      <ul class="pt404__paths-grid" role="list">
        <li>
          <a href="/collections/winter-tires" class="pt404__path pt404__path--winter">
            <span class="pt404__path-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"/></svg>
            </span>
            <span class="pt404__path-body">
              <span class="pt404__path-title">Winter tires</span>
              <span class="pt404__path-sub">3PMSF-rated · Alberta winter-tire law compliant</span>
            </span>
            <span class="pt404__path-arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        </li>
        <li>
          <a href="/pages/brands" class="pt404__path pt404__path--brands">
            <span class="pt404__path-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </span>
            <span class="pt404__path-body">
              <span class="pt404__path-title">All 26 brands</span>
              <span class="pt404__path-sub">Michelin, Bridgestone, BFGoodrich, Toyo &amp; more</span>
            </span>
            <span class="pt404__path-arrow" aria-hidden="true">
