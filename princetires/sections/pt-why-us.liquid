{%- comment -%} Prince Tires - Why-us 4-up {%- endcomment -%}
<div class="ptwh">
  <div class="ptwh__container">
    {%- if section.settings.eyebrow != blank -%}
      <span class="ptwh__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="ptwh__heading">{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 0 -%}
      <div class="ptwh__grid">
        {%- for block in section.blocks -%}
          <div class="ptwh__card" {{ block.shopify_attributes }}>
            <span class="ptwh__bar" aria-hidden="true"></span>
            <h3 class="ptwh__card-title">{{ block.settings.title }}</h3>
            <p class="ptwh__card-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ptwh { background: #fafafa; padding: 5rem 0; }
  .ptwh__container { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
  .ptwh__eyebrow { display: block; font-family: 'Outfit', sans-serif; font-size: 0.85rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: #dc2626; margin-bottom: 0.4rem; }
  .ptwh__heading { font-family: 'Barlow Condensed', sans-serif; font-size: 2.6rem; font-weight: 700;
    color: #111; margin: 0 0 2.5rem; line-height: 1.1; }
  .ptwh__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .ptwh__card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.6rem; }
  .ptwh__bar { display: block; width: 32px; height: 3px; background: #dc2626; margin-bottom: 1rem; }
  .ptwh__card-title { font-family: 'Outfit', sans-serif; font-size: 1.15rem; font-weight: 600;
    color: #111; margin: 0 0 0.4rem; }
  .ptwh__card-text { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 300;
    color: #6b7280; margin: 0; line-height: 1.55; }
  @media (max-width: 989px) {
    .ptwh__container { padding: 0 2rem; }
    .ptwh__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .ptwh { padding: 4rem 0; }
    .ptwh__grid { grid-template-columns: 1fr; gap: 1rem; }
    .ptwh__heading { font-size: 2.1rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Prince Tires",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Calgary drivers pick us" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Reason" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Description." }
      ]
    }
  ],
  "presets": [{ "name": "Why Prince Tires" }]
}
{% endschema %}
