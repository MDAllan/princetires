{%- comment -%}
  Old wholesale order page — /pages/wholesale-order (template page.wholesale-order).

  2026-11-12: wholesale ordering moved to the dealer portal at
  https://wholesale.princetires.ca (operations app). The B2B tire search and
  add-to-order that lived here was removed on purpose. This section now shows
  a short notice and sends the visitor to the dealer portal login.

  Nothing here depends on a theme setting, a customer tag or a login.
  JS redirect first, meta refresh for browsers without JS, visible link as the
  last fallback. No redirect inside the theme editor.
  Rollback: docs/wholesale-to-portal.md.
{%- endcomment -%}

{%- liquid
  assign pwo_login = 'https://wholesale.princetires.ca/dealer/login'
-%}

{%- unless request.design_mode -%}
  <script>window.location.replace({{ pwo_login | json }});</script>
  <noscript><meta http-equiv="refresh" content="0;url={{ pwo_login }}"></noscript>
{%- endunless -%}

<style>
  .pwo { font-family:'Outfit',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; color:#111111; max-width:1040px; margin:0 auto; padding:56px 16px 72px; text-align:center; font-size:1.6rem; line-height:1.55; }
  .pwo *, .pwo *::before, .pwo *::after { box-sizing:border-box; }
  .pwo h1 { font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:3.8rem; line-height:1.08; margin:0; text-transform:uppercase; letter-spacing:.01em; }
  .pwo p { font-size:1.7rem; color:#4b5563; max-width:520px; margin:14px auto 0; }
  .pwo__btns { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:28px; }
  .pwo__btn { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding:12px 26px; border-radius:10px; border:2px solid #DC2626;
              background:#DC2626; color:#fff; font-size:1.7rem; font-weight:700; line-height:1.2; text-decoration:none; text-align:center; }
  .pwo__btn:hover { background:#b91c1c; border-color:#b91c1c; color:#fff; }
  .pwo__btn--dark { background:#111111; border-color:#111111; }
  .pwo__btn--dark:hover { background:#fff; border-color:#111111; color:#111111; }
  .pwo__btn:focus-visible { outline:3px solid #F97316; outline-offset:3px; }
  @media (max-width: 749px) {
    .pwo { padding:40px 16px 56px; }
    .pwo h1 { font-size:3rem; }
    .pwo__btns { flex-direction:column; }
    .pwo__btn { width:100%; }
  }
</style>

<div class="pwo" data-wholesale-moved>
  <h1>Wholesale ordering has moved to the dealer portal</h1>
  <p>We are taking you to the Prince Tires dealer portal now. If nothing happens, use the button below.</p>
  <div class="pwo__btns">
    <a class="pwo__btn" href="{{ pwo_login }}" rel="noopener">Go to dealer login</a>
    <a class="pwo__btn pwo__btn--dark" href="/pages/wholesale-register">Apply for a wholesale account</a>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale order (moved)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Wholesale ordering moved to the dealer portal at wholesale.princetires.ca. This page only sends visitors there. The settings below are not used any more; they are kept so the old page template still loads."
    },
    { "type": "text", "id": "heading", "label": "Not used", "default": "Wholesale order" },
    { "type": "text", "id": "subheading", "label": "Not used" },
    { "type": "number", "id": "default_qty", "label": "Not used", "default": 4 }
  ],
  "presets": [{ "name": "Wholesale order (moved)" }]
}
{% endschema %}
