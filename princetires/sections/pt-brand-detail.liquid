  /* Reveal on scroll */
  [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  .ptbd__model[data-reveal] { transition-delay: calc(var(--idx, 0) * 80ms); }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ptbd { padding: 3rem 0 4rem; }
    .ptbd__hero { grid-template-columns: 1fr; gap: 1.75rem; padding-bottom: 2.5rem; margin-bottom: 2.5rem; }
    .ptbd__stats { grid-template-columns: 1fr; gap: 0.75rem; margin-bottom: 3rem; }
    .ptbd__cta { padding: 1.75rem; }
  }
  @media (max-width: 600px) {
    .ptbd__hero-logo { max-width: 140px; }
    .ptbd__title { font-size: clamp(2.2rem, 9vw, 3rem); }
    .ptbd__models { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // Scroll-reveal
    var els = document.querySelectorAll('.ptbd [data-reveal]');
    if (els.length && typeof IntersectionObserver !== 'undefined') {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add('is-revealed'); });
    }

    // Carousel: tab filtering + arrow scrolling
    var carousel = document.querySelector('.ptbd__carousel');
    if (!carousel) return;
    var cards = carousel.querySelectorAll('.ptbd__card');
    var tabs = document.querySelectorAll('.ptbd__tab');
    var arrows = document.querySelectorAll('.ptbd__carousel-arrow');

    function setArrowState() {
      var prev = document.querySelector('.ptbd__carousel-arrow--prev');
      var next = document.querySelector('.ptbd__carousel-arrow--next');
      if (!prev || !next) return;
      var maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prev.disabled = carousel.scrollLeft <= 2;
      next.disabled = carousel.scrollLeft >= maxScroll - 2;
    }
    carousel.addEventListener('scroll', setArrowState, { passive: true });
    window.addEventListener('resize', setArrowState);

    arrows.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dir = parseInt(btn.dataset.dir, 10) || 1;
        var card = carousel.querySelector('.ptbd__card:not(.is-filtered-out)');
        var step = card ? card.getBoundingClientRect().width + 16 : 320;
        carousel.scrollBy({ left: dir * step, behavior: 'smooth' });
      });
    });

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var filter = tab.dataset.filter;
        tabs.forEach(function (t) {
          var on = (t === tab);
          t.classList.toggle('ptbd__tab--active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        cards.forEach(function (c) {
          var match = (filter === 'all' || c.dataset.season === filter);
          c.classList.toggle('is-filtered-out', !match);
        });
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
        setTimeout(setArrowState, 300);
      });
    });

    setArrowState();

    // Hash-driven smooth-scroll to a specific model card (e.g. /pages/brand-michelin#crossclimate2)
    function scrollToHashCard() {
      var hash = (location.hash || '').replace(/^#/, '');
      if (!hash) return;
      var target = document.getElementById(hash);
      if (!target || !target.classList.contains('ptbd__card')) return;
      // If filtered out by an active season tab, reset to "All" so the card is visible
      if (target.classList.contains('is-filtered-out')) {
        var allTab = document.querySelector('.ptbd__tab[data-filter="all"]');
        if (allTab) allTab.click();
      }
      setTimeout(function () {
        // Carousel is a horizontally-scrolling container — scroll inside it
        var rect = target.getBoundingClientRect();
        var crect = carousel.getBoundingClientRect();
        carousel.scrollBy({ left: rect.left - crect.left - 24, behavior: 'smooth' });
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target.classList.add('ptbd__card--highlight');
        setTimeout(function () { target.classList.remove('ptbd__card--highlight'); }, 1800);
      }, 120);
    }
    scrollToHashCard();
    window.addEventListener('hashchange', scrollToHashCard);
  })();
{% endjavascript %}

