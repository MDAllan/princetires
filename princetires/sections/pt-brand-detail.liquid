{%- comment -%} PrinceTires – Premium Brand Detail (used by every /pages/brand-*.json) {%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#DA291C'
  assign hero_img = section.settings.hero_image
-%}

<section class="ptbd" style="--brand-accent: {{ accent }};">

  {%- if hero_img != blank -%}
    <div class="ptbd__bg" aria-hidden="true">
      {{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ptbd__bg-img', alt: '' }}
      <div class="ptbd__bg-veil"></div>
    </div>
  {%- endif -%}

  <div class="ptbd__container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="ptbd__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ptbd__crumb">Home</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <a href="/pages/brands" class="ptbd__crumb">Brands</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <span class="ptbd__crumb ptbd__crumb--current">{{ page.title }}</span>
    </nav>

    {%- comment -%} Hero — asymmetric, logo + heading + subtitle {%- endcomment -%}
    {%- liquid
      assign brand_handle = page.handle | remove_first: 'brand-'
      assign brand_asset = 'brand-' | append: brand_handle | append: '.webp'
    -%}
    <header class="ptbd__hero" data-reveal>
      <div class="ptbd__hero-left">
        {%- if section.settings.logo != blank -%}
          <div class="ptbd__hero-logo">
            {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', class: 'ptbd__logo-img', alt: page.title }}
          </div>
        {%- else -%}
          <div class="ptbd__hero-logo" data-brand-logo>
            <img src="{{ brand_asset | asset_url }}" alt="{{ page.title | escape }}" class="ptbd__logo-img" loading="eager" onerror="this.parentElement.classList.add('ptbd__hero-logo--initial');this.replaceWith(Object.assign(document.createElement('span'),{textContent:'{{ page.title | slice: 0, 2 | upcase | escape }}'}));">
          </div>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <span class="ptbd__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
      </div>
      <div class="ptbd__hero-right">
        <h1 class="ptbd__title">{{ page.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="ptbd__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        <div class="ptbd__hero-meta">
          {%- assign brand_query = page.title | url_encode -%}
          <a href="/?vehicle-search=1&amp;brand={{ brand_query }}" class="ptbd__hero-cta">
            Find my size in {{ page.title | escape }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/pages/booking" class="ptbd__hero-cta ptbd__hero-cta--secondary">
            Book installation
          </a>
          <a href="tel:+14034524283" class="ptbd__hero-call">Call (403) 452-4283</a>
        </div>
      </div>
    </header>

    {%- comment -%} Sticky in-page TOC (desktop only — mobile hidden) {%- endcomment -%}
    <nav class="ptbd__toc" aria-label="On this page">
      <ul class="ptbd__toc-list" role="list">
        <li><a href="#section-models" class="ptbd__toc-link">Models</a></li>
        {%- if section.settings.intro_richtext != blank -%}
          <li><a href="#section-why" class="ptbd__toc-link">Why {{ page.title | escape }}</a></li>
        {%- endif -%}
        {%- if section.settings.calgary_richtext != blank -%}
          <li><a href="#section-calgary" class="ptbd__toc-link">Calgary fit</a></li>
        {%- endif -%}
        <li><a href="#section-faq" class="ptbd__toc-link">FAQ</a></li>
        <li><a href="#section-shop" class="ptbd__toc-link ptbd__toc-link--accent">Shop</a></li>
      </ul>
    </nav>

    {%- comment -%} Stats strip {%- endcomment -%}
    {%- if section.settings.stat_1_value != blank -%}
      <div class="ptbd__stats" data-reveal>
        <div class="ptbd__stat">
          <span class="ptbd__stat-value">{{ section.settings.stat_1_value | escape }}</span>
          <span class="ptbd__stat-label">{{ section.settings.stat_1_label | escape }}</span>
        </div>
        {%- if section.settings.stat_2_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_2_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_2_label | escape }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_3_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_3_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_3_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Tire model showcase {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Build a string of unique seasons present, then split into an array.
        Order matters: this is the order tabs render in.
      {%- endcomment -%}
      {%- liquid
        assign known_seasons = 'All-Season,Winter,All-Weather,All-Terrain,Performance' | split: ','
        assign seasons_csv = ''
        for s in known_seasons
          assign hit = false
          for b in section.blocks
            if b.type == 'model' and b.settings.season == s
              assign hit = true
              break
            endif
          endfor
          if hit
            if seasons_csv == ''
              assign seasons_csv = s
            else
              assign seasons_csv = seasons_csv | append: ',' | append: s
            endif
          endif
        endfor
        assign seasons_present = seasons_csv | split: ','
      -%}
      <div class="ptbd__models-head" id="section-models" data-reveal>
        <span class="ptbd__models-eyebrow">Lineup</span>
        <h2 class="ptbd__models-title">{{ section.settings.models_heading | default: 'Popular models in Calgary' | escape }}</h2>
      </div>

      {%- if seasons_present.size > 1 -%}
        <div class="ptbd__tabs" role="tablist" aria-label="Filter tire models by category" data-reveal>
          <button class="ptbd__tab ptbd__tab--active" type="button" role="tab" aria-selected="true" data-filter="all">All</button>
          {%- for s in seasons_present -%}
            <button class="ptbd__tab" type="button" role="tab" aria-selected="false" data-filter="{{ s | handleize }}">{{ s | escape }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ptbd__carousel-wrap" data-reveal>
        <button class="ptbd__carousel-arrow ptbd__carousel-arrow--prev" type="button" aria-label="Previous" data-dir="-1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <ul class="ptbd__carousel" role="list" data-carousel>
          {%- for block in section.blocks -%}
            {%- if block.type == 'model' -%}
              {%- liquid
                assign season = block.settings.season
                assign season_class = season | default: 'All-Season' | handleize
                assign rep = block.settings.image_product
                assign price_str = ''
                if rep != blank and rep.price > 0
                  assign price_str = rep.price | money_without_trailing_zeros
                elsif block.settings.price_override != blank
                  assign price_str = block.settings.price_override
                endif
                comment
                  Shop CTA priority:
                    1. Merchant-defined shop_link (theme editor override)
                    2. Otherwise tires collection filtered by this model's name
                    3. Last-resort fallback to the rep product's page
                endcomment
                assign card_link = block.settings.shop_link
                if card_link == blank and block.settings.model_name != blank
                  assign m_enc = block.settings.model_name | url_encode
                  assign card_link = '/collections/tires?filter.p.m.custom.tire_model=' | append: m_enc
                endif
                if card_link == blank and rep != blank
                  assign card_link = rep.url
                endif
              -%}
              <li class="ptbd__card" data-season="{{ season_class }}" id="{{ block.settings.model_name | handleize }}" {{ block.shopify_attributes }}>
                <div class="ptbd__card-img">
                  {%- if rep != blank and rep.featured_image != blank -%}
                    {{ rep.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ptbd__tire-img', alt: block.settings.model_name }}
                  {%- else -%}
                    <svg class="ptbd__tire-placeholder" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
                    </svg>
                  {%- endif -%}
                  <span class="ptbd__card-badge ptbd__model-badge--{{ season_class }}">{{ season | escape }}</span>
                </div>
                <div class="ptbd__card-meta">
                  <h3 class="ptbd__card-name">{{ block.settings.model_name | escape }}</h3>
                  {%- if block.settings.description != blank -%}
                    <p class="ptbd__card-desc">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                  <div class="ptbd__card-foot">
                    {%- if price_str != blank -%}
                      <span class="ptbd__card-price">from {{ price_str }}</span>
                    {%- endif -%}
                    {%- if card_link != blank -%}
                      <a href="{{ card_link }}" class="ptbd__card-cta" aria-label="Shop {{ block.settings.model_name | escape }}">
                        Shop
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <button class="ptbd__carousel-arrow ptbd__carousel-arrow--next" type="button" aria-label="Next" data-dir="1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Why this brand in Calgary — GEO content block {%- endcomment -%}
    {%- if section.settings.intro_richtext != blank -%}
      <div class="ptbd__intro" id="section-why" data-reveal>
        <div class="ptbd__intro-head">
          <span class="ptbd__intro-eyebrow">Why we recommend it</span>
          <h2 class="ptbd__intro-title">{{ section.settings.intro_heading | default: 'Why Calgary drivers choose this brand' | escape }}</h2>
        </div>
        <div class="ptbd__intro-body">{{ section.settings.intro_richtext }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} Manufacturer awards citation (links out to brand's authoritative source) {%- endcomment -%}
    {%- if section.settings.awards_text != blank and section.settings.awards_url != blank -%}
      <div class="ptbd__awards" data-reveal>
        <span class="ptbd__awards-badge" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M9 13.5L7 22l5-3 5 3-2-8.5"/></svg>
        </span>
        <div class="ptbd__awards-body">
          <p class="ptbd__awards-text">{{ section.settings.awards_text | escape }}</p>
          <a href="{{ section.settings.awards_url }}" class="ptbd__awards-link" target="_blank" rel="noopener nofollow">View source<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10"/></svg></a>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Calgary-local angle — brand × Calgary terrain/weather context {%- endcomment -%}
    {%- if section.settings.calgary_richtext != blank -%}
      <div class="ptbd__calgary" id="section-calgary" data-reveal>
        <div class="ptbd__calgary-head">
          <span class="ptbd__calgary-eyebrow">Built for Calgary</span>
          <h2 class="ptbd__calgary-title">{{ section.settings.calgary_heading | default: 'How this brand performs in Calgary' | escape }}</h2>
        </div>
        <div class="ptbd__calgary-body">{{ section.settings.calgary_richtext }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} Per-brand testimonial (one quote) {%- endcomment -%}
    {%- if section.settings.testimonial_quote != blank -%}
      <blockquote class="ptbd__quote" data-reveal>
        <svg class="ptbd__quote-mark" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 17h4l2-4V7H5v6h4l-2 4zm10 0h4l2-4V7h-8v6h4l-2 4z"/></svg>
        <p class="ptbd__quote-text">{{ section.settings.testimonial_quote | escape }}</p>
        {%- if section.settings.testimonial_author != blank -%}
          <footer class="ptbd__quote-author">— {{ section.settings.testimonial_author | escape }}</footer>
        {%- endif -%}
      </blockquote>
    {%- endif -%}

    {%- comment -%} FAQ — up to 6 Q&A pairs, emitted as FAQPage schema below {%- endcomment -%}
    {%- liquid
      assign faq_count = 0
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          assign faq_count = faq_count | plus: 1
        endif
      endfor
    -%}
    {%- if faq_count > 0 -%}
      <div class="ptbd__faq" id="section-faq" data-reveal>
        <div class="ptbd__faq-head">
          <span class="ptbd__intro-eyebrow">Frequently asked</span>
          <h2 class="ptbd__intro-title">{{ section.settings.faq_heading | default: 'Calgary driver questions' | escape }}</h2>
        </div>
        <div class="ptbd__faq-list">
          {%- for i in (1..6) -%}
            {%- liquid
              assign q_key = 'faq_' | append: i | append: '_q'
              assign a_key = 'faq_' | append: i | append: '_a'
              assign q = section.settings[q_key]
              assign a = section.settings[a_key]
            -%}
            {%- if q != blank and a != blank -%}
              <details class="ptbd__faq-item">
                <summary class="ptbd__faq-q">
                  <span>{{ q | escape }}</span>
                  <span class="ptbd__faq-chev" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></span>
                </summary>
                <div class="ptbd__faq-a"><p>{{ a | escape | newline_to_br }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} CTA banner {%- endcomment -%}
    <div class="ptbd__cta" id="section-shop" data-reveal>
      <div class="ptbd__cta-text">
        <h2 class="ptbd__cta-heading">{{ section.settings.cta_heading | default: 'Ready to shop?' | escape }}</h2>
        <p class="ptbd__cta-desc">{{ section.settings.cta_description | default: 'Come in or book online — same-day installation available.' | escape }}</p>
      </div>
      <div class="ptbd__cta-buttons">
        {%- if section.settings.cta_shop_link != blank -%}
          <a href="{{ section.settings.cta_shop_link }}" class="ptbd__cta-btn ptbd__cta-btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            {{ section.settings.cta_shop_label | default: 'Shop all tires' | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_phone != blank -%}
          {%- assign cta_phone_clean = section.settings.cta_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:+1{{ cta_phone_clean }}" class="ptbd__cta-btn ptbd__cta-btn--secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {{ section.settings.cta_phone | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Sibling brands — peers in the same tier {%- endcomment -%}
    {%- liquid
      assign cur_handle = page.handle | remove_first: 'brand-'

      assign sibling_tier_label = ''
      assign sibling_brands = '' | split: ','
      case cur_handle
        when 'michelin', 'bridgestone', 'continental'
          assign sibling_tier_label = 'Premium'
          assign sibling_brands = 'michelin,bridgestone,continental' | split: ','
        when 'bfgoodrich', 'firestone', 'general', 'toyo', 'yokohama', 'dunlop', 'falken', 'nexen', 'kumho', 'mickey-thompson', 'cooper'
          assign sibling_tier_label = 'Premium-Adjacent'
          assign sibling_brands = 'bfgoodrich,firestone,general,toyo,yokohama,dunlop,falken,nexen,kumho,mickey-thompson,cooper' | split: ','
        when 'tesche', 'suretrac', 'cargomax', 'sierra', 'composal', 'radar'
          assign sibling_tier_label = 'Best Value'
          assign sibling_brands = 'tesche,suretrac,cargomax,sierra,composal,radar' | split: ','
        when 'haida', 'rotalla', 'mileking'
          assign sibling_tier_label = 'Budget'
          assign sibling_brands = 'haida,rotalla,mileking' | split: ','
        when 'xf-off-road', 'rtx', 'envy'
          assign sibling_tier_label = 'Wheel'
          assign sibling_brands = 'xf-off-road,rtx,envy' | split: ','
      endcase

      assign no_page_brands = 'tesche,suretrac,cargomax,sierra,composal,mileking' | split: ','
    -%}
    {%- if sibling_brands.size > 1 -%}
      <section class="ptbd__siblings" data-reveal>
        <header class="ptbd__siblings-head">
          <span class="ptbd__siblings-eyebrow">Same tier</span>
          <h2 class="ptbd__siblings-title">Other {{ sibling_tier_label }} brands at Prince Tires</h2>
        </header>
        <ul class="ptbd__siblings-list" role="list">
          {%- for sb in sibling_brands -%}
            {%- if sb == cur_handle -%}{%- continue -%}{%- endif -%}
            {%- assign sb_name = sb | replace: '-', ' ' | capitalize -%}
            {%- if sb == 'bfgoodrich' -%}{%- assign sb_name = 'BFGoodrich' -%}{%- endif -%}
            {%- if sb == 'mickey-thompson' -%}{%- assign sb_name = 'Mickey Thompson' -%}{%- endif -%}
            {%- if sb == 'xf-off-road' -%}{%- assign sb_name = 'XF Off-Road' -%}{%- endif -%}
            {%- if sb == 'rtx' -%}{%- assign sb_name = 'RTX' -%}{%- endif -%}
            {%- if sb == 'envy' -%}{%- assign sb_name = 'ENVY' -%}{%- endif -%}
            {%- if no_page_brands contains sb -%}
              {%- assign sb_link = '/collections/' | append: sb -%}
            {%- else -%}
              {%- assign sb_link = '/pages/brand-' | append: sb -%}
            {%- endif -%}
            {%- assign sb_asset = 'brand-' | append: sb | append: '.webp' -%}
            <li>
              <a href="{{ sb_link }}" class="ptbd__sibling-card" aria-label="View {{ sb_name | escape }} tires">
                <span class="ptbd__sibling-logo">
                  <img src="{{ sb_asset | asset_url }}" alt="{{ sb_name | escape }}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                  <span class="ptbd__sibling-initial" style="display:none">{{ sb_name | slice: 0, 1 | upcase }}</span>
                </span>
                <span class="ptbd__sibling-name">{{ sb_name | escape }}</span>
                <svg class="ptbd__sibling-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    {%- comment -%} Related — internal-link cluster to Prince Tires hub pages {%- endcomment -%}
    <div class="ptbd__related" data-reveal>
      <h2 class="ptbd__related-title">Explore more at Prince Tires</h2>
      <ul class="ptbd__related-list" role="list">
        <li><a href="/collections/winter-tires">Winter tires for Calgary →</a></li>
        <li><a href="/collections/all-weather-tires">All-weather tires (3PMSF rated) →</a></li>
        <li><a href="/collections/all-season-tires">All-season tires →</a></li>
        <li><a href="/pages/services">All services (install, balance, repair) →</a></li>
        <li><a href="/pages/booking">Book an appointment →</a></li>
        <li><a href="/pages/brands">All 26 brands we stock →</a></li>
      </ul>
    </div>

    {%- comment -%} Byline + NAP — E-E-A-T signal {%- endcomment -%}
    <footer class="ptbd__byline">
      <p class="ptbd__byline-author">Posted by the Prince Tires team — Calgary's family-owned tire shop since 2021. 4.9★ from {{ section.settings.review_count | default: '562' }}+ Google reviews.</p>
      <p class="ptbd__byline-nap"><strong>Prince Tires</strong> · 111 42 Ave SW, Calgary, AB T2G 0A4 · Mon–Sat 9:30–5:30 · Sun 10:00–3:30 · <a href="tel:+14034524283">(403) 452-4283</a></p>
      {%- if section.settings.last_updated != blank -%}
        <p class="ptbd__byline-updated">Last updated: {{ section.settings.last_updated | escape }}</p>
      {%- endif -%}
    </footer>

  </div>

  {%- comment -%} JSON-LD: LocalBusiness + FAQPage + BreadcrumbList for GEO citation {%- endcomment -%}
  {%- liquid
    capture faq_json_items
      assign emitted = 0
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          if emitted > 0
            echo ','
          endif
          echo '{"@type":"Question","name":'
          echo q | json
          echo ',"acceptedAnswer":{"@type":"Answer","text":'
          echo a | json
          echo '}}'
          assign emitted = emitted | plus: 1
        endif
      endfor
    endcapture

    capture product_json_items
      assign p_count = 0
      for block in section.blocks
        if block.type != 'model'
          continue
        endif
        assign m_name = block.settings.model_name
        if m_name == blank
          continue
        endif
        assign m_prod = block.settings.image_product
        assign m_desc = block.settings.description
        assign m_season = block.settings.season
        if p_count > 0
          echo ','
        endif
        assign p_count = p_count | plus: 1
        echo '{"@type":"Product","name":'
        assign full_name = page.title | append: ' ' | append: m_name
        echo full_name | json
        echo ',"brand":{"@type":"Brand","name":'
        echo page.title | json
        echo '}'
        if m_desc != blank
          echo ',"description":'
          echo m_desc | json
        endif
        if m_season != blank
          echo ',"category":'
          echo m_season | json
        endif
        if m_prod != blank and m_prod.featured_image != blank
          echo ',"image":"'
          echo m_prod.featured_image | image_url: width: 1200
          echo '"'
        endif
        if m_prod != blank
          echo ',"offers":{"@type":"Offer","priceCurrency":"CAD","price":"'
          echo m_prod.price | divided_by: 100.0
          echo '","availability":"https://schema.org/'
          if m_prod.available
            echo 'InStock'
          else
            echo 'OutOfStock'
          endif
          echo '","url":"'
          echo shop.url
          echo m_prod.url
          echo '"}'
        endif
        echo '}'
      endfor
    endcapture
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoPartsStore",
        "@id": "{{ shop.url }}/#business",
        "name": "Prince Tires",
        "url": "{{ shop.url }}",
        "telephone": "+1-403-452-4283",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "111 42 Ave SW",
          "addressLocality": "Calgary",
          "addressRegion": "AB",
          "postalCode": "T2G 0A4",
          "addressCountry": "CA"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "09:30", "closes": "17:30" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "10:00", "closes": "15:30" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ section.settings.aggregate_rating | default: '4.9' }}",
          "reviewCount": "{{ section.settings.review_count | default: '562' }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
          { "@type": "ListItem", "position": 2, "name": "Brands", "item": "{{ shop.url }}/pages/brands" },
          { "@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}" }
        ]
      }
      {%- if faq_json_items != blank -%}
      ,{ "@type": "FAQPage", "mainEntity": [ {{ faq_json_items }} ] }
      {%- endif -%}
      {%- if product_json_items != blank -%}
      ,{
        "@type": "ItemList",
        "@id": "{{ shop.url }}{{ page.url }}#models",
        "name": "{{ page.title | escape }} tire models stocked at Prince Tires Calgary",
        "itemListElement": [ {{ product_json_items }} ]
      }
      {%- endif -%}
    ]
  }
  </script>
</section>

{% stylesheet %}
  .ptbd {
    position: relative;
    background: #ffffff;
    color: #0a0a0a;
    padding: 5rem 0 6rem;
    overflow: hidden;
    isolation: isolate;
    font-family: 'Outfit', system-ui, sans-serif;
  }

  /* Optional hero background image — soft, behind everything */
  .ptbd__bg { position: absolute; inset: 0; z-index: -1; }
  .ptbd__bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.06; filter: saturate(0.6); }
  .ptbd__bg-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, #ffffff 70%);
  }

  .ptbd__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumb */
  .ptbd__breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(10,10,10,0.55);
    margin-bottom: 3rem;
  }
  .ptbd__crumb { color: inherit; text-decoration: none; transition: color 0.18s; }
  .ptbd__crumb:hover { color: #0a0a0a; }
  .ptbd__crumb--current { color: #0a0a0a; font-weight: 600; }
  .ptbd__crumb-sep { color: rgba(10,10,10,0.3); }

  /* Hero — asymmetric split */
  .ptbd__hero {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(10,10,10,0.1);
    margin-bottom: 4rem;
  }
  .ptbd__hero-left { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .ptbd__hero-logo {
    width: 100%; max-width: 220px;
    aspect-ratio: 1.6 / 1;
    background: #fff;
    border-radius: 18px;
    padding: 1.5rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 12px 30px -16px rgba(0,0,0,0.18), 0 0 0 1px rgba(10,10,10,0.08);
  }
  .ptbd__hero-logo--initial {
    background: linear-gradient(135deg, var(--brand-accent) 0%, #000 130%);
    color: #fff;
  }
  .ptbd__hero-logo--initial span {
    font-size: 3.5rem; font-weight: 800; letter-spacing: -0.04em;
  }
  .ptbd__logo-img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .ptbd__eyebrow {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--brand-accent);
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 999px;
  }
  .ptbd__eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-accent);
    box-shadow: 0 0 12px var(--brand-accent);
  }

  .ptbd__hero-right { display: flex; flex-direction: column; gap: 1.25rem; }
  .ptbd__title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
    color: #0a0a0a;
  }
  .ptbd__subtitle {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: rgba(10,10,10,0.78);
    max-width: 60ch;
    margin: 0;
  }

  /* Hero CTAs */
  .ptbd__hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .ptbd__hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.3rem;
    background: var(--brand-accent);
    color: #fff;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 26px -12px color-mix(in oklab, var(--brand-accent) 55%, transparent);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
  }
  .ptbd__hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -12px color-mix(in oklab, var(--brand-accent) 75%, transparent);
  }
  .ptbd__hero-cta--secondary {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(10, 10, 10, 0.18);
    box-shadow: none;
  }
  .ptbd__hero-cta--secondary:hover {
    background: rgba(10, 10, 10, 0.04);
    border-color: rgba(10, 10, 10, 0.36);
  }
  .ptbd__hero-call {
    color: #0a0a0a;
    text-decoration: none;
    font-weight: 500;
    opacity: 0.6;
    transition: opacity 0.18s;
  }
  .ptbd__hero-call:hover { opacity: 1; }

  /* Stats — three premium tiles */
  .ptbd__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 5rem;
  }
  .ptbd__stat {
    position: relative;
    padding: 1.75rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 18px;
    display: flex; flex-direction: column; gap: 0.45rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, background 0.25s;
  }
  .ptbd__stat:hover {
    transform: translateY(-3px);
    background: #ffffff;
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 10px 28px -16px rgba(10,10,10,0.18);
  }
  .ptbd__stat-value {
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--brand-accent);
  }
  .ptbd__stat-label {
    font-size: 0.98rem;
    color: rgba(10,10,10,0.7);
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  /* Models — heading */
  .ptbd__models-head {
    display: flex; flex-direction: column; gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .ptbd__models-eyebrow {
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--brand-accent);
  }
  .ptbd__models-title {
    font-size: clamp(1.95rem, 3.2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: #0a0a0a;
  }

  /* Category tabs above the carousel */
  .ptbd__tabs {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .ptbd__tab {
    appearance: none; border: 1px solid rgba(10,10,10,0.12);
    background: #ffffff; color: rgba(10,10,10,0.7);
    padding: 0.65rem 1.15rem; border-radius: 999px;
    font-family: inherit; font-size: 0.95rem; font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
    letter-spacing: 0.02em;
  }
  .ptbd__tab:hover { border-color: rgba(10,10,10,0.25); color: #0a0a0a; }
  .ptbd__tab--active {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #ffffff;
  }
  .ptbd__tab--active:hover { color: #ffffff; }

  /* Carousel wrap + arrows */
  .ptbd__carousel-wrap {
    position: relative;
    margin: 0 0 5rem 0;
  }
  .ptbd__carousel-arrow {
    appearance: none; border: 1px solid rgba(10,10,10,0.12);
    background: #ffffff; color: #0a0a0a;
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: absolute; top: 50%; transform: translateY(-50%);
    cursor: pointer; z-index: 2;
    box-shadow: 0 8px 20px -10px rgba(10,10,10,0.15);
    transition: transform 0.18s, border-color 0.18s, color 0.18s;
  }
  .ptbd__carousel-arrow:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    transform: translateY(-50%) scale(1.06);
  }
  .ptbd__carousel-arrow:disabled { opacity: 0.35; cursor: default; transform: translateY(-50%); }
  .ptbd__carousel-arrow--prev { left: -22px; }
  .ptbd__carousel-arrow--next { right: -22px; }
  @media (max-width: 1320px) { .ptbd__carousel-arrow--prev { left: 6px; } .ptbd__carousel-arrow--next { right: 6px; } }
  @media (max-width: 600px) { .ptbd__carousel-arrow { display: none; } }

  /* Carousel itself */
  .ptbd__carousel {
    list-style: none; padding: 0.25rem 0.25rem 1rem; margin: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(10,10,10,0.18) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .ptbd__carousel::-webkit-scrollbar { height: 6px; }
  .ptbd__carousel::-webkit-scrollbar-thumb { background: rgba(10,10,10,0.18); border-radius: 3px; }

  /* Carousel card */
  .ptbd__card {
    flex: 0 0 auto;
    width: clamp(240px, 32%, 320px);
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 22px;
    overflow: hidden;
    scroll-snap-align: start;
    display: flex; flex-direction: column;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.3s;
  }
  @media (max-width: 720px) { .ptbd__card { width: 78vw; } }
  .ptbd__card--highlight {
    box-shadow: 0 0 0 3px var(--brand-accent), 0 12px 30px rgba(0,0,0,0.12);
    transform: translateY(-3px);
    transition: box-shadow 0.4s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ptbd__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 18px 36px -18px rgba(10,10,10,0.18);
  }
  .ptbd__card[hidden],
  .ptbd__card.is-filtered-out { display: none; }

  .ptbd__card-img {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(10,10,10,0.06);
  }
  .ptbd__tire-img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbd__tire-placeholder { color: rgba(10,10,10,0.18); }
  .ptbd__card-badge {
    position: absolute; top: 0.85rem; left: 0.85rem;
    padding: 0.32rem 0.7rem;
    font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 999px;
  }

  .ptbd__card-meta {
    padding: 1.25rem 1.25rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.55rem;
    flex: 1;
  }
  .ptbd__card-name {
    font-size: 1.25rem; font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0; color: #0a0a0a;
  }
  .ptbd__card-desc {
    font-size: 0.98rem; line-height: 1.55;
    color: rgba(10,10,10,0.7);
    margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ptbd__card-foot {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .ptbd__card-price {
    font-size: 1.08rem; font-weight: 700;
    color: #0a0a0a;
    letter-spacing: -0.01em;
  }
  .ptbd__card-cta {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.95rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    background: color-mix(in oklab, var(--brand-accent) 10%, transparent);
    transition: gap 0.2s, background 0.2s;
  }
  .ptbd__card-cta:hover {
    gap: 0.55rem;
    background: color-mix(in oklab, var(--brand-accent) 16%, transparent);
  }

  /* Legacy: kept for backward-compat in case any old block markup is around */
  .ptbd__model-badge {
    display: inline-flex; align-items: center;
    padding: 0.4rem 0.75rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 999px;
  }
  /* Season-coloured badges (light theme) */
  .ptbd__model-badge--all-season  { background: rgba(22, 163, 74, 0.10);  color: #15803d; border: 1px solid rgba(22,163,74,0.28); }
  .ptbd__model-badge--winter      { background: rgba(37, 99, 235, 0.10);  color: #1d4ed8; border: 1px solid rgba(37,99,235,0.28); }
  .ptbd__model-badge--all-terrain { background: rgba(217, 119, 6, 0.10);  color: #b45309; border: 1px solid rgba(217,119,6,0.28); }
  .ptbd__model-badge--all-weather { background: rgba(79, 70, 229, 0.10);  color: #4338ca; border: 1px solid rgba(79,70,229,0.28); }
  .ptbd__model-badge--performance { background: rgba(219, 39, 119, 0.10); color: #be185d; border: 1px solid rgba(219,39,119,0.28); }
  .ptbd__model-number {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: rgba(10,10,10,0.35);
    letter-spacing: 0.05em;
  }
  .ptbd__model-name {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.7rem 0;
    color: #0a0a0a;
  }
  .ptbd__model-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(10,10,10,0.7);
    margin: 0 0 1.25rem 0;
    flex: 1;
  }
  .ptbd__model-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    align-self: flex-start;
    font-size: 0.85rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-accent) 50%, transparent);
    transition: gap 0.2s, border-color 0.2s;
  }
  .ptbd__model-link:hover { gap: 0.7rem; border-color: var(--brand-accent); }

  /* CTA banner — light, neutral with accent CTA */
  .ptbd__cta {
    position: relative;
    display: flex; flex-direction: column; gap: 1.5rem;
    padding: 2.5rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 22px;
  }
  .ptbd__cta-text { position: relative; z-index: 1; }
  .ptbd__cta-heading {
    font-size: clamp(1.65rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem 0;
    color: #0a0a0a;
  }
  .ptbd__cta-desc {
    font-size: 1.1rem; line-height: 1.6;
    color: rgba(10,10,10,0.75);
    margin: 0;
    max-width: 60ch;
  }
  .ptbd__cta-buttons {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    position: relative; z-index: 1;
  }
  .ptbd__cta-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem; font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s;
  }
  .ptbd__cta-btn--primary {
    background: var(--brand-accent);
    color: #fff;
    box-shadow: 0 10px 26px -10px color-mix(in oklab, var(--brand-accent) 60%, transparent);
  }
  .ptbd__cta-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -10px color-mix(in oklab, var(--brand-accent) 75%, transparent); }
  .ptbd__cta-btn--secondary {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(10,10,10,0.18);
  }
  .ptbd__cta-btn--secondary:hover { background: rgba(10,10,10,0.04); border-color: rgba(10,10,10,0.32); }

  /* Intro / Why-this-brand block */
  .ptbd__intro { max-width: 880px; margin: 0 auto 5rem; }
  .ptbd__intro-head { margin-bottom: 1.5rem; }
  .ptbd__intro-eyebrow {
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--brand-accent);
    display: block; margin-bottom: 0.5rem;
  }
  .ptbd__intro-title {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    font-weight: 700; letter-spacing: -0.02em;
    margin: 0; color: #0a0a0a;
  }
  .ptbd__intro-body { font-size: 1.12rem; line-height: 1.7; color: rgba(10,10,10,0.82); }
  .ptbd__intro-body p { margin: 0 0 1rem 0; }
  .ptbd__intro-body p:last-child { margin: 0; }
  .ptbd__intro-body a { color: var(--brand-accent); text-decoration: underline; text-underline-offset: 2px; }

  /* FAQ */
  .ptbd__faq { max-width: 880px; margin: 0 auto 5rem; }
  .ptbd__faq-head { margin-bottom: 1.5rem; }
  .ptbd__faq-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .ptbd__faq-item {
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .ptbd__faq-item[open] {
    background: #ffffff;
    border-color: color-mix(in oklab, var(--brand-accent) 45%, rgba(10,10,10,0.08));
  }
  .ptbd__faq-q {
    list-style: none; cursor: pointer;
    padding: 1.25rem 1.4rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    font-size: 1.12rem; font-weight: 600;
    color: #0a0a0a;
  }
  .ptbd__faq-q::-webkit-details-marker { display: none; }
  .ptbd__faq-chev {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    color: var(--brand-accent);
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  .ptbd__faq-item[open] .ptbd__faq-chev {
    transform: rotate(180deg);
    background: color-mix(in oklab, var(--brand-accent) 12%, transparent);
  }
  .ptbd__faq-a { padding: 0 1.4rem 1.4rem; color: rgba(10,10,10,0.78); line-height: 1.65; font-size: 1.05rem; }
  .ptbd__faq-a p { margin: 0; }

  /* Sticky in-page TOC */
  .ptbd__toc {
    position: sticky;
    top: 76px;
    z-index: 20;
    margin: -1.5rem -1.5rem 3rem;
    padding: 0.7rem 1.5rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(10, 10, 10, 0.06);
    border-bottom: 1px solid rgba(10, 10, 10, 0.06);
    box-shadow: 0 4px 16px -8px rgba(10, 10, 10, 0.08);
  }
  .ptbd__toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .ptbd__toc-list::-webkit-scrollbar { display: none; }
  .ptbd__toc-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: rgba(10, 10, 10, 0.72);
    text-decoration: none;
    transition: background 0.18s, color 0.18s;
    white-space: nowrap;
  }
  .ptbd__toc-link:hover {
    background: rgba(10, 10, 10, 0.05);
    color: #0a0a0a;
  }
  .ptbd__toc-link--accent {
    color: var(--brand-accent);
    background: color-mix(in oklab, var(--brand-accent) 12%, transparent);
  }
  .ptbd__toc-link--accent:hover {
    background: color-mix(in oklab, var(--brand-accent) 22%, transparent);
    color: var(--brand-accent);
  }
  @media (max-width: 600px) {
    .ptbd__toc { display: none; }
  }
  /* Scroll-margin so anchored sections don't hide behind sticky TOC */
  #section-models, #section-why, #section-calgary, #section-faq, #section-shop {
    scroll-margin-top: 130px;
  }

  /* Manufacturer awards citation */
  .ptbd__awards {
    max-width: 880px;
    margin: 0 auto 4rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.75rem;
    background: #ffffff;
    border: 1px solid color-mix(in oklab, var(--brand-accent) 28%, rgba(10,10,10,0.08));
    border-radius: 16px;
    box-shadow: 0 12px 28px -18px rgba(10,10,10,0.1);
  }
  .ptbd__awards-badge {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    color: var(--brand-accent);
    border-radius: 50%;
  }
  .ptbd__awards-body { flex: 1; }
  .ptbd__awards-text {
    margin: 0 0 0.3rem 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #0a0a0a;
    font-weight: 600;
  }
  .ptbd__awards-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    transition: gap 0.2s;
  }
  .ptbd__awards-link:hover { gap: 0.55rem; }

  /* Testimonial quote */
  .ptbd__quote {
    max-width: 760px;
    margin: 0 auto 4rem;
    padding: 2rem 2.5rem;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    color: #fff;
    border-radius: 22px;
    position: relative;
    overflow: hidden;
  }
  .ptbd__quote::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: var(--brand-accent);
  }
  .ptbd__quote-mark {
    color: color-mix(in oklab, var(--brand-accent) 80%, transparent);
    margin-bottom: 0.5rem;
  }
  .ptbd__quote-text {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.55;
    font-weight: 500;
    margin: 0 0 1rem 0;
    color: #fff;
  }
  .ptbd__quote-author {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.02em;
  }
  @media (max-width: 720px) {
    .ptbd__quote { padding: 1.5rem 1.75rem; }
    .ptbd__awards { padding: 1.1rem 1.25rem; gap: 1rem; }
  }

  /* Calgary-local angle */
  .ptbd__calgary {
    max-width: 880px;
    margin: 0 auto 5rem;
    padding: 2.25rem 2.5rem;
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--brand-accent) 4%, #fafafa) 0%,
      #fafafa 70%);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 22%, rgba(10,10,10,0.06));
    border-radius: 22px;
    position: relative;
  }
  .ptbd__calgary::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    background: linear-gradient(135deg, color-mix(in oklab, var(--brand-accent) 12%, transparent), transparent 60%);
    pointer-events: none;
  }
  .ptbd__calgary-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
    position: relative;
  }
  .ptbd__calgary-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-accent);
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 32%, transparent);
    border-radius: 999px;
  }
  .ptbd__calgary-eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-accent);
  }
  .ptbd__calgary-title {
