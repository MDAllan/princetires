    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
  }
  .ptbd__sibling-card:hover {
    border-color: rgba(10, 10, 10, 0.28);
    background: #ffffff;
    transform: translateY(-2px);
  }
  .ptbd__sibling-logo {
    flex-shrink: 0;
    width: 40px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: 5px;
    padding: 3px 5px;
  }
  .ptbd__sibling-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbd__sibling-initial {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0a0a0a;
  }
  .ptbd__sibling-name {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: -0.01em;
  }
  .ptbd__sibling-arrow {
    flex-shrink: 0;
    color: rgba(10, 10, 10, 0.45);
    transition: transform 0.2s, color 0.2s;
  }
  .ptbd__sibling-card:hover .ptbd__sibling-arrow {
    transform: translateX(3px);
    color: #0a0a0a;
  }

  /* Related */
  .ptbd__related { max-width: 880px; margin: 4rem auto 0; padding-top: 2rem; border-top: 1px solid rgba(10,10,10,0.08); }
  .ptbd__related-title {
    font-size: 0.95rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(10,10,10,0.65);
