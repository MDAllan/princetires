{%- comment -%} PrinceTires – Premium Brand Detail (used by every /pages/brand-*.json) {%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#DA291C'
  assign hero_img = section.settings.hero_image
-%}

<section class="ptbd" style="--brand-accent: {{ accent }};">

  {%- if hero_img != blank -%}
    <div class="ptbd__bg" aria-hidden="true">
      {{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ptbd__bg-img', alt: '' }}
      <div class="ptbd__bg-veil"></div>
    </div>
  {%- endif -%}

  <div class="ptbd__container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="ptbd__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ptbd__crumb">Home</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <a href="/pages/brands" class="ptbd__crumb">Brands</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <span class="ptbd__crumb ptbd__crumb--current">{{ page.title }}</span>
    </nav>

    {%- comment -%} Hero — asymmetric, logo + heading + subtitle {%- endcomment -%}
    <header class="ptbd__hero" data-reveal>
      <div class="ptbd__hero-left">
        {%- if section.settings.logo != blank -%}
          <div class="ptbd__hero-logo">
            {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', class: 'ptbd__logo-img', alt: page.title }}
          </div>
        {%- else -%}
          <div class="ptbd__hero-logo ptbd__hero-logo--initial">
            <span>{{ page.title | slice: 0, 2 | upcase }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <span class="ptbd__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
      </div>
      <div class="ptbd__hero-right">
        <h1 class="ptbd__title">{{ page.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="ptbd__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} Stats strip {%- endcomment -%}
    {%- if section.settings.stat_1_value != blank -%}
      <div class="ptbd__stats" data-reveal>
        <div class="ptbd__stat">
          <span class="ptbd__stat-value">{{ section.settings.stat_1_value | escape }}</span>
          <span class="ptbd__stat-label">{{ section.settings.stat_1_label | escape }}</span>
        </div>
        {%- if section.settings.stat_2_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_2_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_2_label | escape }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_3_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_3_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_3_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Tire model showcase {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="ptbd__models-head" data-reveal>
        <span class="ptbd__models-eyebrow">Lineup</span>
        <h2 class="ptbd__models-title">{{ section.settings.models_heading | default: 'Popular models in Calgary' | escape }}</h2>
      </div>
      <ul class="ptbd__models" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'model' -%}
            {%- liquid
              assign season = block.settings.season
              assign season_class = season | default: 'All-Season' | handleize
            -%}
            <li class="ptbd__model" data-reveal data-season="{{ season_class }}" {{ block.shopify_attributes }}>
              <div class="ptbd__model-head">
                <span class="ptbd__model-badge ptbd__model-badge--{{ season_class }}">{{ season | escape }}</span>
                <span class="ptbd__model-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </div>
              <h3 class="ptbd__model-name">{{ block.settings.model_name | escape }}</h3>
              <p class="ptbd__model-desc">{{ block.settings.description | escape }}</p>
              {%- if block.settings.shop_link != blank -%}
                <a href="{{ block.settings.shop_link }}" class="ptbd__model-link">
                  Shop {{ block.settings.model_name | escape }}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} CTA banner {%- endcomment -%}
    <div class="ptbd__cta" data-reveal>
      <div class="ptbd__cta-text">
        <h2 class="ptbd__cta-heading">{{ section.settings.cta_heading | default: 'Ready to shop?' | escape }}</h2>
        <p class="ptbd__cta-desc">{{ section.settings.cta_description | default: 'Come in or book online — same-day installation available.' | escape }}</p>
      </div>
      <div class="ptbd__cta-buttons">
        {%- if section.settings.cta_shop_link != blank -%}
          <a href="{{ section.settings.cta_shop_link }}" class="ptbd__cta-btn ptbd__cta-btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            {{ section.settings.cta_shop_label | default: 'Shop all tires' | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_phone != blank -%}
          {%- assign cta_phone_clean = section.settings.cta_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:+1{{ cta_phone_clean }}" class="ptbd__cta-btn ptbd__cta-btn--secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {{ section.settings.cta_phone | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .ptbd {
    position: relative;
    background: #0a0a0a;
    color: #f5f5f5;
    padding: 5rem 0 6rem;
    overflow: hidden;
    isolation: isolate;
    font-family: 'Outfit', system-ui, sans-serif;
  }

  /* Optional hero background image */
  .ptbd__bg { position: absolute; inset: 0; z-index: -1; }
  .ptbd__bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.18; filter: saturate(0.7); }
  .ptbd__bg-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 80% 0%, color-mix(in oklab, var(--brand-accent) 18%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(10,10,10,0.4) 0%, rgba(10,10,10,0.85) 60%, #0a0a0a 100%);
  }

  .ptbd__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumb */
  .ptbd__breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(245,245,245,0.5);
    margin-bottom: 3rem;
  }
  .ptbd__crumb { color: inherit; text-decoration: none; transition: color 0.18s; }
  .ptbd__crumb:hover { color: #fff; }
  .ptbd__crumb--current { color: #fff; font-weight: 600; }
  .ptbd__crumb-sep { color: rgba(245,245,245,0.25); }

  /* Hero — asymmetric split */
  .ptbd__hero {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 4rem;
  }
  .ptbd__hero-left { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .ptbd__hero-logo {
    width: 100%; max-width: 220px;
    aspect-ratio: 1.6 / 1;
    background: #fff;
    border-radius: 18px;
    padding: 1.5rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 22px 60px -20px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.06);
  }
  .ptbd__hero-logo--initial {
    background: linear-gradient(135deg, var(--brand-accent) 0%, #000 130%);
    color: #fff;
  }
  .ptbd__hero-logo--initial span {
    font-size: 3.5rem; font-weight: 800; letter-spacing: -0.04em;
  }
  .ptbd__logo-img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .ptbd__eyebrow {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--brand-accent);
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 999px;
  }
  .ptbd__eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-accent);
    box-shadow: 0 0 12px var(--brand-accent);
  }

  .ptbd__hero-right { display: flex; flex-direction: column; gap: 1.25rem; }
  .ptbd__title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
    background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.7) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ptbd__subtitle {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.55;
    color: rgba(245,245,245,0.72);
    max-width: 56ch;
    margin: 0;
  }

  /* Stats — three premium tiles */
  .ptbd__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 5rem;
  }
  .ptbd__stat {
    position: relative;
    padding: 1.75rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    display: flex; flex-direction: column; gap: 0.45rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, background 0.25s;
  }
  .ptbd__stat:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,0.05);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(255,255,255,0.08));
  }
  .ptbd__stat-value {
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--brand-accent);
  }
  .ptbd__stat-label {
    font-size: 0.85rem;
    color: rgba(245,245,245,0.6);
    letter-spacing: 0.02em;
  }

  /* Models — heading */
  .ptbd__models-head {
    display: flex; flex-direction: column; gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .ptbd__models-eyebrow {
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--brand-accent);
  }
  .ptbd__models-title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Models — grid */
  .ptbd__models {
    list-style: none; padding: 0; margin: 0 0 5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .ptbd__model {
    position: relative;
    padding: 1.75rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px;
    display: flex; flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.3s;
    overflow: hidden;
  }
  .ptbd__model::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(circle at 0% 0%, color-mix(in oklab, var(--brand-accent) 18%, transparent), transparent 60%);
    opacity: 0; transition: opacity 0.3s;
    pointer-events: none;
  }
  .ptbd__model:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(255,255,255,0.08));
    box-shadow: 0 24px 50px -20px rgba(0,0,0,0.6);
  }
  .ptbd__model:hover::before { opacity: 1; }
  .ptbd__model-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .ptbd__model-badge {
    display: inline-flex; align-items: center;
    padding: 0.4rem 0.75rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 999px;
  }
  /* Season-coloured badges */
  .ptbd__model-badge--all-season  { background: rgba(34, 197, 94, 0.12);  color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
  .ptbd__model-badge--winter      { background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59,130,246,0.3); }
  .ptbd__model-badge--all-terrain { background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
  .ptbd__model-badge--all-weather { background: rgba(99, 102, 241, 0.12); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.3); }
  .ptbd__model-badge--performance { background: rgba(236, 72, 153, 0.12); color: #f9a8d4; border: 1px solid rgba(236,72,153,0.3); }
  .ptbd__model-number {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: rgba(245,245,245,0.35);
    letter-spacing: 0.05em;
  }
  .ptbd__model-name {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.7rem 0;
    color: #fff;
  }
  .ptbd__model-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(245,245,245,0.65);
    margin: 0 0 1.25rem 0;
    flex: 1;
  }
  .ptbd__model-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    align-self: flex-start;
    font-size: 0.85rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-accent) 50%, transparent);
    transition: gap 0.2s, border-color 0.2s;
  }
  .ptbd__model-link:hover { gap: 0.7rem; border-color: var(--brand-accent); }

  /* CTA banner */
  .ptbd__cta {
    position: relative;
    display: flex; flex-direction: column; gap: 1.5rem;
    padding: 2.5rem;
    background: linear-gradient(135deg, color-mix(in oklab, var(--brand-accent) 18%, #161616) 0%, #0e0e0e 100%);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 25%, rgba(255,255,255,0.05));
    border-radius: 22px;
    overflow: hidden;
  }
  .ptbd__cta::after {
    content: "";
    position: absolute;
    top: -50%; right: -10%;
    width: 60%; height: 200%;
    background: radial-gradient(circle, color-mix(in oklab, var(--brand-accent) 22%, transparent), transparent 60%);
    pointer-events: none;
  }
  .ptbd__cta-text { position: relative; z-index: 1; }
  .ptbd__cta-heading {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem 0;
    color: #fff;
  }
  .ptbd__cta-desc {
    font-size: 1rem; line-height: 1.55;
    color: rgba(245,245,245,0.72);
    margin: 0;
    max-width: 56ch;
  }
  .ptbd__cta-buttons {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    position: relative; z-index: 1;
  }
  .ptbd__cta-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem; font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s;
  }
  .ptbd__cta-btn--primary {
    background: var(--brand-accent);
    color: #fff;
    box-shadow: 0 12px 32px -10px color-mix(in oklab, var(--brand-accent) 70%, transparent);
  }
  .ptbd__cta-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -10px color-mix(in oklab, var(--brand-accent) 80%, transparent); }
  .ptbd__cta-btn--secondary {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.18);
  }
  .ptbd__cta-btn--secondary:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.3); }

  /* Reveal on scroll */
  [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  .ptbd__model[data-reveal] { transition-delay: calc(var(--idx, 0) * 80ms); }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ptbd { padding: 3rem 0 4rem; }
    .ptbd__hero { grid-template-columns: 1fr; gap: 1.75rem; padding-bottom: 2.5rem; margin-bottom: 2.5rem; }
    .ptbd__stats { grid-template-columns: 1fr; gap: 0.75rem; margin-bottom: 3rem; }
    .ptbd__cta { padding: 1.75rem; }
  }
  @media (max-width: 600px) {
    .ptbd__hero-logo { max-width: 140px; }
    .ptbd__title { font-size: clamp(2.2rem, 9vw, 3rem); }
    .ptbd__models { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var els = document.querySelectorAll('.ptbd [data-reveal]');
    if (!els.length || typeof IntersectionObserver === 'undefined') {
      els.forEach(function (el) { el.classList.add('is-revealed'); });
      return;
    }
    document.querySelectorAll('.ptbd__model').forEach(function (el, i) {
      el.style.setProperty('--idx', i);
    });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    els.forEach(function (el) { io.observe(el); });
  })();
{% endjavascript %}

