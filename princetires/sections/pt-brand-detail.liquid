{%- comment -%} PrinceTires – Premium Brand Detail (used by every /pages/brand-*.json) {%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#DA291C'
  assign hero_img = section.settings.hero_image
-%}

<section class="ptbd" style="--brand-accent: {{ accent }};">

  {%- if hero_img != blank -%}
    <div class="ptbd__bg" aria-hidden="true">
      {{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ptbd__bg-img', alt: '' }}
      <div class="ptbd__bg-veil"></div>
    </div>
  {%- endif -%}

  <div class="ptbd__container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="ptbd__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ptbd__crumb">Home</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <a href="/pages/brands" class="ptbd__crumb">Brands</a>
      <span class="ptbd__crumb-sep" aria-hidden="true">/</span>
      <span class="ptbd__crumb ptbd__crumb--current">{{ page.title }}</span>
    </nav>

    {%- comment -%} Hero — asymmetric, logo + heading + subtitle {%- endcomment -%}
    {%- liquid
      assign brand_handle = page.handle | remove_first: 'brand-'
      assign brand_asset = 'brand-' | append: brand_handle | append: '.webp'
    -%}
    <header class="ptbd__hero" data-reveal>
      <div class="ptbd__hero-left">
        {%- if section.settings.logo != blank -%}
          <div class="ptbd__hero-logo">
            {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', class: 'ptbd__logo-img', alt: page.title }}
          </div>
        {%- else -%}
          <div class="ptbd__hero-logo" data-brand-logo>
            <img src="{{ brand_asset | asset_url }}" alt="{{ page.title | escape }}" class="ptbd__logo-img" loading="eager" onerror="this.parentElement.classList.add('ptbd__hero-logo--initial');this.replaceWith(Object.assign(document.createElement('span'),{textContent:'{{ page.title | slice: 0, 2 | upcase | escape }}'}));">
          </div>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <span class="ptbd__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
      </div>
      <div class="ptbd__hero-right">
        <h1 class="ptbd__title">{{ page.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="ptbd__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} Stats strip {%- endcomment -%}
    {%- if section.settings.stat_1_value != blank -%}
      <div class="ptbd__stats" data-reveal>
        <div class="ptbd__stat">
          <span class="ptbd__stat-value">{{ section.settings.stat_1_value | escape }}</span>
          <span class="ptbd__stat-label">{{ section.settings.stat_1_label | escape }}</span>
        </div>
        {%- if section.settings.stat_2_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_2_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_2_label | escape }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.stat_3_value != blank -%}
          <div class="ptbd__stat">
            <span class="ptbd__stat-value">{{ section.settings.stat_3_value | escape }}</span>
            <span class="ptbd__stat-label">{{ section.settings.stat_3_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Tire model showcase {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Build a string of unique seasons present, then split into an array.
        Order matters: this is the order tabs render in.
      {%- endcomment -%}
      {%- liquid
        assign known_seasons = 'All-Season,Winter,All-Weather,All-Terrain,Performance' | split: ','
        assign seasons_csv = ''
        for s in known_seasons
          assign hit = false
          for b in section.blocks
            if b.type == 'model' and b.settings.season == s
              assign hit = true
              break
            endif
          endfor
          if hit
            if seasons_csv == ''
              assign seasons_csv = s
            else
              assign seasons_csv = seasons_csv | append: ',' | append: s
            endif
          endif
        endfor
        assign seasons_present = seasons_csv | split: ','
      -%}
      <div class="ptbd__models-head" data-reveal>
        <span class="ptbd__models-eyebrow">Lineup</span>
        <h2 class="ptbd__models-title">{{ section.settings.models_heading | default: 'Popular models in Calgary' | escape }}</h2>
      </div>

      {%- if seasons_present.size > 1 -%}
        <div class="ptbd__tabs" role="tablist" aria-label="Filter tire models by category" data-reveal>
          <button class="ptbd__tab ptbd__tab--active" type="button" role="tab" aria-selected="true" data-filter="all">All</button>
          {%- for s in seasons_present -%}
            <button class="ptbd__tab" type="button" role="tab" aria-selected="false" data-filter="{{ s | handleize }}">{{ s | escape }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ptbd__carousel-wrap" data-reveal>
        <button class="ptbd__carousel-arrow ptbd__carousel-arrow--prev" type="button" aria-label="Previous" data-dir="-1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <ul class="ptbd__carousel" role="list" data-carousel>
          {%- for block in section.blocks -%}
            {%- if block.type == 'model' -%}
              {%- liquid
                assign season = block.settings.season
                assign season_class = season | default: 'All-Season' | handleize
                assign rep = block.settings.image_product
                assign price_str = ''
                if rep != blank and rep.price > 0
                  assign price_str = rep.price | money_without_trailing_zeros
                elsif block.settings.price_override != blank
                  assign price_str = block.settings.price_override
                endif
                assign card_link = block.settings.shop_link
                if card_link == blank and rep != blank
                  assign card_link = rep.url
                endif
              -%}
              <li class="ptbd__card" data-season="{{ season_class }}" {{ block.shopify_attributes }}>
                <div class="ptbd__card-img">
                  {%- if rep != blank and rep.featured_image != blank -%}
                    {{ rep.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ptbd__tire-img', alt: block.settings.model_name }}
                  {%- else -%}
                    <svg class="ptbd__tire-placeholder" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
                    </svg>
                  {%- endif -%}
                  <span class="ptbd__card-badge ptbd__model-badge--{{ season_class }}">{{ season | escape }}</span>
                </div>
                <div class="ptbd__card-meta">
                  <h3 class="ptbd__card-name">{{ block.settings.model_name | escape }}</h3>
                  {%- if block.settings.description != blank -%}
                    <p class="ptbd__card-desc">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                  <div class="ptbd__card-foot">
                    {%- if price_str != blank -%}
                      <span class="ptbd__card-price">from {{ price_str }}</span>
                    {%- endif -%}
                    {%- if card_link != blank -%}
                      <a href="{{ card_link }}" class="ptbd__card-cta" aria-label="Shop {{ block.settings.model_name | escape }}">
                        Shop
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <button class="ptbd__carousel-arrow ptbd__carousel-arrow--next" type="button" aria-label="Next" data-dir="1">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Why this brand in Calgary — GEO content block {%- endcomment -%}
    {%- if section.settings.intro_richtext != blank -%}
      <div class="ptbd__intro" data-reveal>
        <div class="ptbd__intro-head">
          <span class="ptbd__intro-eyebrow">Why we recommend it</span>
          <h2 class="ptbd__intro-title">{{ section.settings.intro_heading | default: 'Why Calgary drivers choose this brand' | escape }}</h2>
        </div>
        <div class="ptbd__intro-body">{{ section.settings.intro_richtext }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} FAQ — up to 6 Q&A pairs, emitted as FAQPage schema below {%- endcomment -%}
    {%- liquid
      assign faq_count = 0
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          assign faq_count = faq_count | plus: 1
        endif
      endfor
    -%}
    {%- if faq_count > 0 -%}
      <div class="ptbd__faq" data-reveal>
        <div class="ptbd__faq-head">
          <span class="ptbd__intro-eyebrow">Frequently asked</span>
          <h2 class="ptbd__intro-title">{{ section.settings.faq_heading | default: 'Calgary driver questions' | escape }}</h2>
        </div>
        <div class="ptbd__faq-list">
          {%- for i in (1..6) -%}
            {%- liquid
              assign q_key = 'faq_' | append: i | append: '_q'
              assign a_key = 'faq_' | append: i | append: '_a'
              assign q = section.settings[q_key]
              assign a = section.settings[a_key]
            -%}
            {%- if q != blank and a != blank -%}
              <details class="ptbd__faq-item">
                <summary class="ptbd__faq-q">
                  <span>{{ q | escape }}</span>
                  <span class="ptbd__faq-chev" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></span>
                </summary>
                <div class="ptbd__faq-a"><p>{{ a | escape | newline_to_br }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} CTA banner {%- endcomment -%}
    <div class="ptbd__cta" data-reveal>
      <div class="ptbd__cta-text">
        <h2 class="ptbd__cta-heading">{{ section.settings.cta_heading | default: 'Ready to shop?' | escape }}</h2>
        <p class="ptbd__cta-desc">{{ section.settings.cta_description | default: 'Come in or book online — same-day installation available.' | escape }}</p>
      </div>
      <div class="ptbd__cta-buttons">
        {%- if section.settings.cta_shop_link != blank -%}
          <a href="{{ section.settings.cta_shop_link }}" class="ptbd__cta-btn ptbd__cta-btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
            {{ section.settings.cta_shop_label | default: 'Shop all tires' | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_phone != blank -%}
          {%- assign cta_phone_clean = section.settings.cta_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:+1{{ cta_phone_clean }}" class="ptbd__cta-btn ptbd__cta-btn--secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call {{ section.settings.cta_phone | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Related — internal-link cluster to Prince Tires hub pages {%- endcomment -%}
    <div class="ptbd__related" data-reveal>
      <h2 class="ptbd__related-title">Explore more at Prince Tires</h2>
      <ul class="ptbd__related-list" role="list">
        <li><a href="/collections/winter-tires">Winter tires for Calgary →</a></li>
        <li><a href="/collections/all-weather-tires">All-weather tires (3PMSF rated) →</a></li>
        <li><a href="/collections/all-season-tires">All-season tires →</a></li>
        <li><a href="/pages/services">All services (install, balance, repair) →</a></li>
        <li><a href="/pages/booking">Book an appointment →</a></li>
        <li><a href="/pages/brands">All 26 brands we stock →</a></li>
      </ul>
    </div>

    {%- comment -%} Byline + NAP — E-E-A-T signal {%- endcomment -%}
    <footer class="ptbd__byline">
      <p class="ptbd__byline-author">Posted by the Prince Tires team — Calgary's family-owned tire shop since 2021. 4.9★ from {{ section.settings.review_count | default: '562' }}+ Google reviews.</p>
      <p class="ptbd__byline-nap"><strong>Prince Tires</strong> · 111 42 Ave SW, Calgary, AB T2G 0A4 · Mon–Sat 9:30–5:30 · Sun 10:00–3:30 · <a href="tel:+14034524283">(403) 452-4283</a></p>
      {%- if section.settings.last_updated != blank -%}
        <p class="ptbd__byline-updated">Last updated: {{ section.settings.last_updated | escape }}</p>
      {%- endif -%}
    </footer>

  </div>

  {%- comment -%} JSON-LD: LocalBusiness + FAQPage + BreadcrumbList for GEO citation {%- endcomment -%}
  {%- liquid
    capture faq_json_items
      assign emitted = 0
      for i in (1..6)
        assign q_key = 'faq_' | append: i | append: '_q'
        assign a_key = 'faq_' | append: i | append: '_a'
        assign q = section.settings[q_key]
        assign a = section.settings[a_key]
        if q != blank and a != blank
          if emitted > 0
            echo ','
          endif
          echo '{"@type":"Question","name":'
          echo q | json
          echo ',"acceptedAnswer":{"@type":"Answer","text":'
          echo a | json
          echo '}}'
          assign emitted = emitted | plus: 1
        endif
      endfor
    endcapture
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoPartsStore",
        "@id": "{{ shop.url }}/#business",
        "name": "Prince Tires",
        "url": "{{ shop.url }}",
        "telephone": "+1-403-452-4283",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "111 42 Ave SW",
          "addressLocality": "Calgary",
          "addressRegion": "AB",
          "postalCode": "T2G 0A4",
          "addressCountry": "CA"
        },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "09:30", "closes": "17:30" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "10:00", "closes": "15:30" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ section.settings.aggregate_rating | default: '4.9' }}",
          "reviewCount": "{{ section.settings.review_count | default: '562' }}",
          "bestRating": "5",
          "worstRating": "1"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" },
          { "@type": "ListItem", "position": 2, "name": "Brands", "item": "{{ shop.url }}/pages/brands" },
          { "@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}" }
        ]
      }
      {%- if faq_json_items != blank -%}
      ,{ "@type": "FAQPage", "mainEntity": [ {{ faq_json_items }} ] }
      {%- endif -%}
    ]
  }
  </script>
</section>

{% stylesheet %}
  .ptbd {
    position: relative;
    background: #ffffff;
    color: #0a0a0a;
    padding: 5rem 0 6rem;
    overflow: hidden;
    isolation: isolate;
    font-family: 'Outfit', system-ui, sans-serif;
  }

  /* Optional hero background image — soft, behind everything */
  .ptbd__bg { position: absolute; inset: 0; z-index: -1; }
  .ptbd__bg-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.06; filter: saturate(0.6); }
  .ptbd__bg-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, #ffffff 70%);
  }

  .ptbd__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumb */
  .ptbd__breadcrumb {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(10,10,10,0.55);
    margin-bottom: 3rem;
  }
  .ptbd__crumb { color: inherit; text-decoration: none; transition: color 0.18s; }
  .ptbd__crumb:hover { color: #0a0a0a; }
  .ptbd__crumb--current { color: #0a0a0a; font-weight: 600; }
  .ptbd__crumb-sep { color: rgba(10,10,10,0.3); }

  /* Hero — asymmetric split */
  .ptbd__hero {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: end;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(10,10,10,0.1);
    margin-bottom: 4rem;
  }
  .ptbd__hero-left { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; }
  .ptbd__hero-logo {
    width: 100%; max-width: 220px;
    aspect-ratio: 1.6 / 1;
    background: #fff;
    border-radius: 18px;
    padding: 1.5rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 12px 30px -16px rgba(0,0,0,0.18), 0 0 0 1px rgba(10,10,10,0.08);
  }
  .ptbd__hero-logo--initial {
    background: linear-gradient(135deg, var(--brand-accent) 0%, #000 130%);
    color: #fff;
  }
  .ptbd__hero-logo--initial span {
    font-size: 3.5rem; font-weight: 800; letter-spacing: -0.04em;
  }
  .ptbd__logo-img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .ptbd__eyebrow {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--brand-accent);
    padding: 0.45rem 0.8rem;
    background: color-mix(in oklab, var(--brand-accent) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-accent) 35%, transparent);
    border-radius: 999px;
  }
  .ptbd__eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-accent);
    box-shadow: 0 0 12px var(--brand-accent);
  }

  .ptbd__hero-right { display: flex; flex-direction: column; gap: 1.25rem; }
  .ptbd__title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0;
    color: #0a0a0a;
  }
  .ptbd__subtitle {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: rgba(10,10,10,0.78);
    max-width: 60ch;
    margin: 0;
  }

  /* Stats — three premium tiles */
  .ptbd__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 5rem;
  }
  .ptbd__stat {
    position: relative;
    padding: 1.75rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 18px;
    display: flex; flex-direction: column; gap: 0.45rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, background 0.25s;
  }
  .ptbd__stat:hover {
    transform: translateY(-3px);
    background: #ffffff;
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 10px 28px -16px rgba(10,10,10,0.18);
  }
  .ptbd__stat-value {
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--brand-accent);
  }
  .ptbd__stat-label {
    font-size: 0.98rem;
    color: rgba(10,10,10,0.7);
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  /* Models — heading */
  .ptbd__models-head {
    display: flex; flex-direction: column; gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .ptbd__models-eyebrow {
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--brand-accent);
  }
  .ptbd__models-title {
    font-size: clamp(1.95rem, 3.2vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: #0a0a0a;
  }

  /* Category tabs above the carousel */
  .ptbd__tabs {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .ptbd__tab {
    appearance: none; border: 1px solid rgba(10,10,10,0.12);
    background: #ffffff; color: rgba(10,10,10,0.7);
    padding: 0.65rem 1.15rem; border-radius: 999px;
    font-family: inherit; font-size: 0.95rem; font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
    letter-spacing: 0.02em;
  }
  .ptbd__tab:hover { border-color: rgba(10,10,10,0.25); color: #0a0a0a; }
  .ptbd__tab--active {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #ffffff;
  }
  .ptbd__tab--active:hover { color: #ffffff; }

  /* Carousel wrap + arrows */
  .ptbd__carousel-wrap {
    position: relative;
    margin: 0 0 5rem 0;
  }
  .ptbd__carousel-arrow {
    appearance: none; border: 1px solid rgba(10,10,10,0.12);
    background: #ffffff; color: #0a0a0a;
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    position: absolute; top: 50%; transform: translateY(-50%);
    cursor: pointer; z-index: 2;
    box-shadow: 0 8px 20px -10px rgba(10,10,10,0.15);
    transition: transform 0.18s, border-color 0.18s, color 0.18s;
  }
  .ptbd__carousel-arrow:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    transform: translateY(-50%) scale(1.06);
  }
  .ptbd__carousel-arrow:disabled { opacity: 0.35; cursor: default; transform: translateY(-50%); }
  .ptbd__carousel-arrow--prev { left: -22px; }
  .ptbd__carousel-arrow--next { right: -22px; }
  @media (max-width: 1320px) { .ptbd__carousel-arrow--prev { left: 6px; } .ptbd__carousel-arrow--next { right: 6px; } }
  @media (max-width: 600px) { .ptbd__carousel-arrow { display: none; } }

  /* Carousel itself */
  .ptbd__carousel {
    list-style: none; padding: 0.25rem 0.25rem 1rem; margin: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(10,10,10,0.18) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .ptbd__carousel::-webkit-scrollbar { height: 6px; }
  .ptbd__carousel::-webkit-scrollbar-thumb { background: rgba(10,10,10,0.18); border-radius: 3px; }

  /* Carousel card */
  .ptbd__card {
    flex: 0 0 auto;
    width: clamp(240px, 32%, 320px);
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 22px;
    overflow: hidden;
    scroll-snap-align: start;
    display: flex; flex-direction: column;
    transition: opacity 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s, box-shadow 0.3s;
  }
  @media (max-width: 720px) { .ptbd__card { width: 78vw; } }
  .ptbd__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--brand-accent) 50%, rgba(10,10,10,0.08));
    box-shadow: 0 18px 36px -18px rgba(10,10,10,0.18);
  }
  .ptbd__card[hidden],
  .ptbd__card.is-filtered-out { display: none; }

  .ptbd__card-img {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(10,10,10,0.06);
  }
  .ptbd__tire-img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ptbd__tire-placeholder { color: rgba(10,10,10,0.18); }
  .ptbd__card-badge {
    position: absolute; top: 0.85rem; left: 0.85rem;
    padding: 0.32rem 0.7rem;
    font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 999px;
  }

  .ptbd__card-meta {
    padding: 1.25rem 1.25rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.55rem;
    flex: 1;
  }
  .ptbd__card-name {
    font-size: 1.25rem; font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0; color: #0a0a0a;
  }
  .ptbd__card-desc {
    font-size: 0.98rem; line-height: 1.55;
    color: rgba(10,10,10,0.7);
    margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ptbd__card-foot {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .ptbd__card-price {
    font-size: 1.08rem; font-weight: 700;
    color: #0a0a0a;
    letter-spacing: -0.01em;
  }
  .ptbd__card-cta {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.95rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    background: color-mix(in oklab, var(--brand-accent) 10%, transparent);
    transition: gap 0.2s, background 0.2s;
  }
  .ptbd__card-cta:hover {
    gap: 0.55rem;
    background: color-mix(in oklab, var(--brand-accent) 16%, transparent);
  }

  /* Legacy: kept for backward-compat in case any old block markup is around */
  .ptbd__model-badge {
    display: inline-flex; align-items: center;
    padding: 0.4rem 0.75rem;
    font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 999px;
  }
  /* Season-coloured badges (light theme) */
  .ptbd__model-badge--all-season  { background: rgba(22, 163, 74, 0.10);  color: #15803d; border: 1px solid rgba(22,163,74,0.28); }
  .ptbd__model-badge--winter      { background: rgba(37, 99, 235, 0.10);  color: #1d4ed8; border: 1px solid rgba(37,99,235,0.28); }
  .ptbd__model-badge--all-terrain { background: rgba(217, 119, 6, 0.10);  color: #b45309; border: 1px solid rgba(217,119,6,0.28); }
  .ptbd__model-badge--all-weather { background: rgba(79, 70, 229, 0.10);  color: #4338ca; border: 1px solid rgba(79,70,229,0.28); }
  .ptbd__model-badge--performance { background: rgba(219, 39, 119, 0.10); color: #be185d; border: 1px solid rgba(219,39,119,0.28); }
  .ptbd__model-number {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: rgba(10,10,10,0.35);
    letter-spacing: 0.05em;
  }
  .ptbd__model-name {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.7rem 0;
    color: #0a0a0a;
  }
  .ptbd__model-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(10,10,10,0.7);
    margin: 0 0 1.25rem 0;
    flex: 1;
  }
  .ptbd__model-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    align-self: flex-start;
    font-size: 0.85rem; font-weight: 600;
    color: var(--brand-accent);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid color-mix(in oklab, var(--brand-accent) 50%, transparent);
    transition: gap 0.2s, border-color 0.2s;
  }
  .ptbd__model-link:hover { gap: 0.7rem; border-color: var(--brand-accent); }

  /* CTA banner — light, neutral with accent CTA */
  .ptbd__cta {
    position: relative;
    display: flex; flex-direction: column; gap: 1.5rem;
    padding: 2.5rem;
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 22px;
  }
  .ptbd__cta-text { position: relative; z-index: 1; }
  .ptbd__cta-heading {
    font-size: clamp(1.65rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem 0;
    color: #0a0a0a;
  }
  .ptbd__cta-desc {
    font-size: 1.1rem; line-height: 1.6;
    color: rgba(10,10,10,0.75);
    margin: 0;
    max-width: 60ch;
  }
  .ptbd__cta-buttons {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    position: relative; z-index: 1;
  }
  .ptbd__cta-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem; font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background 0.2s;
  }
  .ptbd__cta-btn--primary {
    background: var(--brand-accent);
    color: #fff;
    box-shadow: 0 10px 26px -10px color-mix(in oklab, var(--brand-accent) 60%, transparent);
  }
  .ptbd__cta-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -10px color-mix(in oklab, var(--brand-accent) 75%, transparent); }
  .ptbd__cta-btn--secondary {
    background: transparent;
    color: #0a0a0a;
    border: 1px solid rgba(10,10,10,0.18);
  }
  .ptbd__cta-btn--secondary:hover { background: rgba(10,10,10,0.04); border-color: rgba(10,10,10,0.32); }

  /* Intro / Why-this-brand block */
  .ptbd__intro { max-width: 880px; margin: 0 auto 5rem; }
  .ptbd__intro-head { margin-bottom: 1.5rem; }
  .ptbd__intro-eyebrow {
    font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--brand-accent);
    display: block; margin-bottom: 0.5rem;
  }
  .ptbd__intro-title {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    font-weight: 700; letter-spacing: -0.02em;
    margin: 0; color: #0a0a0a;
  }
  .ptbd__intro-body { font-size: 1.12rem; line-height: 1.7; color: rgba(10,10,10,0.82); }
  .ptbd__intro-body p { margin: 0 0 1rem 0; }
  .ptbd__intro-body p:last-child { margin: 0; }
  .ptbd__intro-body a { color: var(--brand-accent); text-decoration: underline; text-underline-offset: 2px; }

  /* FAQ */
  .ptbd__faq { max-width: 880px; margin: 0 auto 5rem; }
  .ptbd__faq-head { margin-bottom: 1.5rem; }
  .ptbd__faq-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .ptbd__faq-item {
    background: #fafafa;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .ptbd__faq-item[open] {
    background: #ffffff;
    border-color: color-mix(in oklab, var(--brand-accent) 45%, rgba(10,10,10,0.08));
  }
  .ptbd__faq-q {
    list-style: none; cursor: pointer;
    padding: 1.25rem 1.4rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    font-size: 1.12rem; font-weight: 600;
    color: #0a0a0a;
  }
  .ptbd__faq-q::-webkit-details-marker { display: none; }
  .ptbd__faq-chev {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    color: var(--brand-accent);
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  .ptbd__faq-item[open] .ptbd__faq-chev {
    transform: rotate(180deg);
    background: color-mix(in oklab, var(--brand-accent) 12%, transparent);
  }
  .ptbd__faq-a { padding: 0 1.4rem 1.4rem; color: rgba(10,10,10,0.78); line-height: 1.65; font-size: 1.05rem; }
  .ptbd__faq-a p { margin: 0; }

  /* Related */
  .ptbd__related { max-width: 880px; margin: 4rem auto 0; padding-top: 2rem; border-top: 1px solid rgba(10,10,10,0.08); }
  .ptbd__related-title {
    font-size: 0.95rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(10,10,10,0.65);
    margin: 0 0 1.1rem 0;
  }
  .ptbd__related-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.7rem 1.5rem;
  }
  .ptbd__related-list a {
    color: #0a0a0a; text-decoration: none;
    font-size: 1.05rem;
    transition: color 0.2s;
  }
  .ptbd__related-list a:hover { color: var(--brand-accent); }

  /* Byline */
  .ptbd__byline {
    max-width: 880px; margin: 2.5rem auto 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgba(10,10,10,0.06);
    font-size: 0.98rem; line-height: 1.6;
    color: rgba(10,10,10,0.65);
  }
  .ptbd__byline p { margin: 0 0 0.4rem 0; }
  .ptbd__byline-author { color: rgba(10,10,10,0.72); }
  .ptbd__byline-nap strong { color: rgba(10,10,10,0.9); font-weight: 700; }
  .ptbd__byline-nap a { color: var(--brand-accent); text-decoration: none; }
  .ptbd__byline-updated { color: rgba(10,10,10,0.45); font-size: 0.78rem; }

  /* Reveal on scroll */
  [data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  .ptbd__model[data-reveal] { transition-delay: calc(var(--idx, 0) * 80ms); }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ptbd { padding: 3rem 0 4rem; }
    .ptbd__hero { grid-template-columns: 1fr; gap: 1.75rem; padding-bottom: 2.5rem; margin-bottom: 2.5rem; }
    .ptbd__stats { grid-template-columns: 1fr; gap: 0.75rem; margin-bottom: 3rem; }
    .ptbd__cta { padding: 1.75rem; }
  }
  @media (max-width: 600px) {
    .ptbd__hero-logo { max-width: 140px; }
    .ptbd__title { font-size: clamp(2.2rem, 9vw, 3rem); }
    .ptbd__models { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // Scroll-reveal
    var els = document.querySelectorAll('.ptbd [data-reveal]');
    if (els.length && typeof IntersectionObserver !== 'undefined') {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add('is-revealed'); });
    }

    // Carousel: tab filtering + arrow scrolling
    var carousel = document.querySelector('.ptbd__carousel');
    if (!carousel) return;
    var cards = carousel.querySelectorAll('.ptbd__card');
    var tabs = document.querySelectorAll('.ptbd__tab');
    var arrows = document.querySelectorAll('.ptbd__carousel-arrow');

    function setArrowState() {
      var prev = document.querySelector('.ptbd__carousel-arrow--prev');
      var next = document.querySelector('.ptbd__carousel-arrow--next');
      if (!prev || !next) return;
      var maxScroll = carousel.scrollWidth - carousel.clientWidth;
      prev.disabled = carousel.scrollLeft <= 2;
      next.disabled = carousel.scrollLeft >= maxScroll - 2;
    }
    carousel.addEventListener('scroll', setArrowState, { passive: true });
    window.addEventListener('resize', setArrowState);

    arrows.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var dir = parseInt(btn.dataset.dir, 10) || 1;
        var card = carousel.querySelector('.ptbd__card:not(.is-filtered-out)');
        var step = card ? card.getBoundingClientRect().width + 16 : 320;
        carousel.scrollBy({ left: dir * step, behavior: 'smooth' });
      });
    });

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var filter = tab.dataset.filter;
        tabs.forEach(function (t) {
          var on = (t === tab);
          t.classList.toggle('ptbd__tab--active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        cards.forEach(function (c) {
          var match = (filter === 'all' || c.dataset.season === filter);
          c.classList.toggle('is-filtered-out', !match);
        });
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
        setTimeout(setArrowState, 300);
      });
    });

    setArrowState();
  })();
{% endjavascript %}

