    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0;
    color: #0a0a0a;
  }
  .ptbd__siblings-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
