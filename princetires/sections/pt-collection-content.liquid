{%- comment -%} /collections/all is the Shop by size hub (pt-shop-by-size), not a 20,000-product grid without filters. {%- endcomment -%}
{%- unless collection.handle == 'all' -%}
{%- comment -%}
  Renders a collection's long-form SEO / editorial content (brand overview, buying guide,
  Calgary-specific notes) BELOW the product grid.

  Source: the collection's native description (rich text / HTML), shown only when the
  collection is flagged with the boolean metafield custom.show_guide = true. Ordinary
  collections (no flag) render nothing, so this section is inert until a collection opts in.

  Every other collection with a description (redesign 2026-11-13): the same
  description in a collapsed "About ..." block, so the text is still in the
  page HTML (the old header printed it; the slim results header does not).
  Setting "Show the description on other collections" turns it off.

  Used by templates/collection.json. Content for brand & category collections is migrated
  here from the legacy /pages/brand-* and /pages/<type> pages during the SEO de-duplication
  (see docs/redirect-log-*.md).
{%- endcomment -%}

{%- if collection.metafields.custom.show_guide.value and collection.description != blank -%}
  <section class="ptcc">
    <div class="ptcc__container">
      <div class="ptcc__body rte aeo-speakable-summary">
        {{ collection.description }}
      </div>
    </div>
  </section>
{%- elsif collection.description != blank and section.settings.show_about -%}
  {{ 'pt-rd-results.css' | asset_url | stylesheet_tag }}
  <section class="rd rd-about" aria-label="About {{ collection.title | escape }}">
    <div class="rd-about__in">
      <details class="rd-about__box">
        <summary class="rd-about__sum">
          <span>About {{ collection.title | escape }}</span>
          {%- render 'pt-icon', name: 'chevron-down', size: 18, class: 'rd-acc__chev' -%}
        </summary>
        <div class="rd-about__body rte">
          {{ collection.description }}
        </div>
      </details>
    </div>
  </section>
{%- endif -%}
{%- endunless -%}

{% stylesheet %}
  .ptcc {
    background: #fff;
    padding: 4rem 0 1rem;
    border-top: 1px solid #f0f0f0;
  }
  .ptcc__container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .ptcc__body {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.75;
    color: #374151;
  }
  .ptcc__body h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin: 2.4rem 0 0.8rem;
    line-height: 1.15;
  }
  .ptcc__body h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #111;
    margin: 1.8rem 0 0.6rem;
  }
  .ptcc__body p { margin: 0 0 1.1rem; }
  .ptcc__body ul,
  .ptcc__body ol { margin: 0 0 1.1rem; padding-left: 1.4rem; }
  .ptcc__body li { margin: 0 0 0.4rem; }
  .ptcc__body a {
    color: #0033A0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ptcc__body strong { font-weight: 600; color: #1f2937; }
  .ptcc__body :first-child { margin-top: 0; }
  @media (max-width: 768px) {
    .ptcc { padding: 3rem 0 0.5rem; }
    .ptcc__container { padding: 0 1.6rem; }
    .ptcc__body { font-size: 1rem; }
    .ptcc__body h2 { font-size: 1.7rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_about",
      "label": "Show the description on other collections",
      "default": true,
      "info": "Collections without the show_guide metafield get their description in a collapsed \"About\" block under the products (keeps the text on the page for search engines)."
    }
  ]
}
{% endschema %}
