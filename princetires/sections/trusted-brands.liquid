<div class="trusted-brands" data-trusted-brands>
  <div class="trusted-brands__container">
    <div class="trusted-brands__header">
      <h2 class="trusted-brands__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="trusted-brands__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="trusted-brands__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- assign brand_blocks = section.blocks | where: "type", "brand" -%}

    {%- if brand_blocks.size > 0 -%}
      <div class="trusted-brands__strip" data-brand-strip>
        <div class="trusted-brands__track" data-brand-track>
          {%- comment -%}
            Render every brand TWICE so the CSS keyframe (translateX 0 → -50%)
            loops seamlessly without a visible gap. The duplicate set is
            aria-hidden so screen readers don't double-announce.
          {%- endcomment -%}
          {%- for pass in (1..2) -%}
            {%- for block in brand_blocks -%}
              {%- comment -%}
                Link priority:
                  1. /collections/<brand-handle> if a matching collection exists
                  2. fallback /collections/tires?filter.p.vendor=<brand>
              {%- endcomment -%}
              {%- assign brand_handle = block.settings.name | handleize -%}
              {%- assign brand_collection = collections[brand_handle] -%}
              {%- if brand_collection != empty and brand_collection.handle != blank -%}
                {%- assign brand_url = '/collections/' | append: brand_handle -%}
              {%- else -%}
                {%- assign brand_url = '/collections/tires?filter.p.vendor=' | append: block.settings.name | url_encode -%}
              {%- endif -%}
              <a
                href="{{ brand_url }}"
                class="trusted-brands__tab"
                data-brand-name="{{ block.settings.name | escape }}"
                aria-label="Shop {{ block.settings.name | escape }} tires"
                {% if pass == 2 %}aria-hidden="true" tabindex="-1"{% else %}{{ block.shopify_attributes }}{% endif %}
              >
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 280 | image_tag: class: "trusted-brands__tab-logo", loading: "lazy", widths: "160,240,320", sizes: "140px", alt: block.settings.name }}
                {%- else -%}
                  <span class="trusted-brands__tab-text">{{ block.settings.name | escape }}</span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var section = document.currentScript.closest('[data-trusted-brands]');
      if (!section) return;
      var strip = section.querySelector('[data-brand-strip]');
      if (!strip) return;

      /* ── Drag-to-scroll on desktop (mousedown + move). Touch uses native scroll. ── */
      var drag = { active: false, startX: 0, startLeft: 0, moved: 0 };
      var DRAG_THRESHOLD = 6; // pixels of movement before we count it as a drag, not a click

      strip.addEventListener('mousedown', function (e) {
        if (e.button !== 0) return;
        drag.active = true;
        drag.moved = 0;
        drag.startX = e.pageX;
        drag.startLeft = strip.scrollLeft;
        strip.classList.add('is-dragging');
      });
      document.addEventListener('mousemove', function (e) {
        if (!drag.active) return;
        e.preventDefault();
        var dx = e.pageX - drag.startX;
        drag.moved = Math.max(drag.moved, Math.abs(dx));
        strip.scrollLeft = drag.startLeft - dx;
      }, { passive: false });
      document.addEventListener('mouseup', function () {
        if (!drag.active) return;
        drag.active = false;
        strip.classList.remove('is-dragging');
      });

      /* If the user actually dragged (not just clicked), suppress the click on the
         logo so they don't get teleported to /collections/<brand> mid-drag. */
      strip.addEventListener('click', function (e) {
        if (drag.moved > DRAG_THRESHOLD) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    }());
  </script>
</div>

{% stylesheet %}
  .trusted-brands {
    background: #fff;
    padding: 4rem 0 3.5rem;
  }
  .trusted-brands__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 4rem;
  }
  .trusted-brands__header {
    text-align: center;
    margin-bottom: 2.4rem;
  }
  .trusted-brands__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 2.6rem;
    font-weight: 700;
    color: #111;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
  }
  .trusted-brands__accent { color: #dc2626; }
  .trusted-brands__subtitle {
    font-family: 'Outfit', sans-serif;
    color: #6b7280;
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0;
  }

  /* ── Brand strip — horizontal scroll with grab-to-drag on desktop, native swipe on mobile ── */
  .trusted-brands__strip {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    /* Fade the edges so it's visually clear there's more to scroll to */
    mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
  }
  .trusted-brands__strip::-webkit-scrollbar { display: none; }
  .trusted-brands__strip.is-dragging { cursor: grabbing; }
  .trusted-brands__strip.is-dragging .trusted-brands__tab { pointer-events: none; }

  .trusted-brands__track {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.6rem 0.4rem;
    width: max-content;
    user-select: none;
    /* Auto-scrolling marquee. Tabs are rendered twice in HTML so the keyframe
       (translateX 0 → -50%) loops seamlessly. Slower than product carousels
       because logos are easier to scan than dense product cards. */
    animation: tb-strip-scroll 35s linear infinite;
    will-change: transform;
  }
  /* Pause animation when the user hovers, focuses, OR drags. The drag handler
     adds .is-dragging, so this also covers click-and-hold interactions. */
  .trusted-brands__strip:hover .trusted-brands__track,
  .trusted-brands__strip:focus-within .trusted-brands__track,
  .trusted-brands__strip.is-dragging .trusted-brands__track {
    animation-play-state: paused;
  }
  @keyframes tb-strip-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trusted-brands__track { animation: none; }
  }

  /* ── Brand tile — fixed-size pill so every logo aligns the same ── */
  .trusted-brands__tab {
    flex-shrink: 0;
    width: 160px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 1.4rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    -webkit-user-drag: none;
  }
  .trusted-brands__tab:hover {
    border-color: #dc2626;
    box-shadow: 0 6px 18px -8px rgba(220, 38, 38, 0.35);
    transform: translateY(-2px);
  }
  .trusted-brands__tab:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  .trusted-brands__tab-logo {
    max-height: 44px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    pointer-events: none; /* let the drag handler own all mouse events */
    -webkit-user-drag: none;
  }
  .trusted-brands__tab-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .trusted-brands { padding: 3rem 0 2.5rem; }
    .trusted-brands__container { padding: 0 1.6rem; }
    .trusted-brands__heading { font-size: 2.1rem; }
    .trusted-brands__subtitle { font-size: 1.15rem; }
    .trusted-brands__tab {
      width: 130px;
      height: 70px;
      padding: 1rem 1.1rem;
    }
    .trusted-brands__tab-logo { max-height: 36px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trusted_brands.name",
  "blocks": [
    {
      "type": "brand",
      "name": "Brand tab",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Lowercased + hyphenated to form the link target (e.g. \"BFGoodrich\" → /collections/bfgoodrich). If no matching collection exists, the tile links to the tires page filtered by vendor.",
          "default": "Brand"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our trusted"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Brands"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We carry every major brand Calgary drivers ask for by name"
    }
  ],
  "presets": [
    {
      "name": "t:sections.trusted_brands.name",
      "blocks": [
        { "type": "brand", "settings": { "name": "Michelin" } },
        { "type": "brand", "settings": { "name": "Bridgestone" } },
        { "type": "brand", "settings": { "name": "Continental" } },
        { "type": "brand", "settings": { "name": "Toyo" } },
        { "type": "brand", "settings": { "name": "Yokohama" } },
        { "type": "brand", "settings": { "name": "Kumho" } },
        { "type": "brand", "settings": { "name": "BFGoodrich" } },
        { "type": "brand", "settings": { "name": "Cooper" } },
        { "type": "brand", "settings": { "name": "Firestone" } },
        { "type": "brand", "settings": { "name": "General" } }
      ]
    }
  ]
}
{% endschema %}
