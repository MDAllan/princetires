<div class="pte pte--{{ section.settings.background }} pte--image-{{ section.settings.image_position | default: 'bottom' }}">
  <div class="pte__container">

    {%- assign img_pos = section.settings.image_position | default: 'bottom' -%}

    {%- if section.settings.image and img_pos == 'top' -%}
      <div class="pte__image pte__image--top">
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading | default: 'Prince Tires Calgary' }}
      </div>
    {%- endif -%}

    <div class="pte__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="pte__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="pte__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
      {%- if bullet_blocks.size > 0 -%}
        <ul class="pte__bullets">
          {%- for block in bullet_blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.lead != blank -%}
                <strong>{{ block.settings.lead }}</strong>
                {% if block.settings.text != blank %} {{ block.settings.text }}{% endif %}
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.outro != blank -%}
        <div class="pte__outro rte">{{ section.settings.outro }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.image and img_pos == 'right' -%}
      <div class="pte__image pte__image--right">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading | default: 'Prince Tires Calgary' }}
      </div>
    {%- endif -%}

    {%- if section.settings.image and img_pos == 'bottom' -%}
      <div class="pte__image pte__image--bottom">
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading | default: 'Prince Tires Calgary' }}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.pte { padding: 64px 0; font-family: 'Outfit', sans-serif; }
.pte--white { background: #fff; }
.pte--light { background: #f8f8f8; }
.pte__container { max-width: 900px; margin: 0 auto; padding: 0 24px; }
.pte__heading { font-family: 'Barlow Condensed', sans-serif; font-size: 2.8rem; font-weight: 700; text-transform: uppercase; margin: 0 0 24px; color: #111; }
.pte__intro { font-size: 1.6rem; color: #333; line-height: 1.7; margin: 0 0 24px; }
.pte__intro p { margin: 0 0 16px; }
.pte__intro p:last-child { margin-bottom: 0; }
.pte__intro a { color: #E8251D; text-decoration: underline; }
.pte__bullets { font-size: 1.6rem; color: #333; line-height: 1.7; padding-left: 24px; margin: 0 0 24px; }
.pte__bullets li { margin-bottom: 8px; }
.pte__bullets li::marker { color: #E8251D; }
.pte__bullets strong { color: #111; }
.pte__outro { font-size: 1.6rem; color: #333; line-height: 1.7; margin-top: 24px; }
.pte__outro p { margin: 0 0 16px; }
.pte__outro p:last-child { margin-bottom: 0; }
.pte__outro a { color: #E8251D; text-decoration: underline; }

/* Image rendering */
.pte__image { width: 100%; }
.pte__image img { width: 100%; height: auto; display: block; border-radius: 8px; }
.pte__image--top { margin-bottom: 32px; }
.pte__image--bottom { margin-top: 32px; }

/* Right-aligned image: stack on mobile, side-by-side on desktop */
.pte--image-right .pte__container {
  display: flex;
  flex-direction: column;
  gap: 32px;
  max-width: 1100px;
}
.pte--image-right .pte__content { order: 1; min-width: 0; }
.pte--image-right .pte__image--right { order: 2; }

@media (min-width: 820px) {
  .pte--image-right .pte__container {
    flex-direction: row;
    align-items: center;
    gap: 48px;
  }
  .pte--image-right .pte__content { flex: 1 1 60%; }
  .pte--image-right .pte__image--right { flex: 0 0 35%; order: 2; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Tire explainer",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        { "type": "text",     "id": "lead", "label": "Lead (bold, optional)" },
        { "type": "textarea", "id": "text", "label": "Bullet text" }
      ]
    }
  ],
  "settings": [
    { "type": "text",     "id": "heading",    "label": "H2 heading" },
    { "type": "richtext", "id": "intro",      "label": "Intro paragraph(s)" },
    { "type": "richtext", "id": "outro",      "label": "Closing paragraph(s)" },
    { "type": "image_picker", "id": "image",  "label": "Image (optional)" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "top",    "label": "Above heading" },
        { "value": "right",  "label": "Right of content (desktop)" },
        { "value": "bottom", "label": "Below content" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "light", "label": "Light gray" }
      ],
      "default": "white"
    }
  ],
  "presets": [
    { "name": "Tire explainer" }
  ]
}
{% endschema %}
