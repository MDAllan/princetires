    showNeedsTrimGuidance(vehicleLabel, originalQuery) {
      this.loading.hidden = true;
      this.awaitingTrim = false;
      this.awaitingSelection = false;

      const li =
        '<li class="hero-smart-search__guidance hero-smart-search__guidance--needs-trim" role="option" data-needs-trim="true" aria-live="polite">' +
          '<span class="hero-smart-search__guidance-icon">' + this.hintIcon() + '</span>' +
          '<span class="hero-smart-search__guidance-text">' +
            '<span class="hero-smart-search__guidance-title">Got ' + this.escapeHtml(vehicleLabel) + ' — what trim?</span>' +
            '<span class="hero-smart-search__guidance-sub">Tire sizes vary by trim. Add yours (e.g. <em>LX</em>, <em>EX</em>, <em>Touring</em>) so we can pull the right size — or call us and we\'ll look it up.</span>' +
          '</span>' +
          '<span class="hero-smart-search__result-tag">Need trim</span>' +
        '</li>';

      this.list.innerHTML = li;
      this.items = [];
      this.selectedIndex = -1;
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');

      // Clicking the card just focuses the input so the customer can keep typing
      const card = this.list.querySelector('[data-needs-trim]');
      if (card) card.addEventListener('click', () => this.input.focus());

      // Trigger the same missing-vehicle capture used by the no-match fallback
      // so we don't lose the lead while waiting for them to add a trim.
      const webhook = this.config.missingVehicleWebhookUrl;
      const q = (originalQuery || vehicleLabel || '').trim();
      if (webhook && q.length >= 3 && this._lastReportedNoMatch !== q) {
        this._lastReportedNoMatch = q;
        try {
          fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              vehicle:    vehicleLabel,
              year:       '',
              make:       '',
              model:      '',
              trim:       '',
              page_url:   window.location.href,
              user_agent: navigator.userAgent,
              timestamp:  new Date().toISOString(),
              source:     'homepage_smart_search_needs_trim'
            })
          }).catch(() => { /* best-effort */ });
        } catch (e) { /* never break the widget */ }
      }

      window.PTTireParse && window.PTTireParse.track({ surface: 'homepage', search_query: originalQuery || vehicleLabel, search_type: 'vehicle', search_outcome: 'needs_trim' });
    }

    showLoading() {
      this.results.hidden = false;
      this.loading.hidden = false;
      this.list.innerHTML = '';
      this.input.setAttribute('aria-expanded', 'true');
    }

    renderResults(results) {
      this.loading.hidden = true;
      this.awaitingTrim = false;
      this.awaitingSelection = false;

      if (results.length === 0) {
        this.hideResults();
        return;
      }

      this.list.innerHTML = results.map((r, i) => {
        var icon;
        if (r.type === 'size') icon = this.tireIcon();
        else if (r.type === 'vehicle') icon = this.vehicleIcon();
        else if (r.type === 'service') icon = this.serviceIcon();
        else icon = this.searchIcon();

        var tag;
        if (r.type === 'size') tag = 'Size';
        else if (r.type === 'vehicle') tag = 'Vehicle';
        else if (r.type === 'service') tag = 'Service';
        else tag = 'Search';

        return '<li class="hero-smart-search__result-item" role="option" data-index="' + i + '" data-url="' + this.escapeAttr(r.url) + '">' +
          '<span class="hero-smart-search__result-icon">' + icon + '</span>' +
          '<span class="hero-smart-search__result-info">' +
            '<span class="hero-smart-search__result-title">' + this.escapeHtml(r.title) + '</span>' +
            '<span class="hero-smart-search__result-meta">' + this.escapeHtml(r.meta) + '</span>' +
          '</span>' +
          '<span class="hero-smart-search__result-tag">' + tag + '</span>' +
        '</li>';
      }).join('');

      this.items = this.list.querySelectorAll('.hero-smart-search__result-item');
      this.items.forEach(item => {
        item.addEventListener('click', () => this.selectResult(item));
      });

      this.awaitingSelection = true;
      this.selectedIndex = -1;
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');
    }

    hideResults() {
      this.results.hidden = true;
      this.loading.hidden = true;
      this.input.setAttribute('aria-expanded', 'false');
      this.selectedIndex = -1;
      this.awaitingTrim = false;
      this.awaitingSelection = false;
    }

    /* ──────────────────────────────────────────────────────────────────
       Recent + popular searches (empty-state of the dropdown).
       Same localStorage key is shared with the header overlay so the
       customer has ONE search history across both surfaces.
       ────────────────────────────────────────────────────────────────── */
    static get RECENT_KEY() { return 'pt-recent-searches'; }
    static get RECENT_MAX() { return 5; }

    getRecentSearches() {
      try {
        var raw = localStorage.getItem('pt-recent-searches');
        if (!raw) return [];
        var arr = JSON.parse(raw);
        return Array.isArray(arr) ? arr.filter(function(x){ return x && typeof x === 'string' && x.trim().length; }) : [];
      } catch (e) { return []; }
    }

    addRecentSearch(query) {
      var q = (query || '').trim();
      if (!q || q.length < 2) return;
      try {
        var current = this.getRecentSearches();
        // De-duplicate, case-insensitive — keep most-recent-first
        var lower = q.toLowerCase();
        current = current.filter(function(x){ return x.toLowerCase() !== lower; });
        current.unshift(q);
        if (current.length > 5) current = current.slice(0, 5);
        localStorage.setItem('pt-recent-searches', JSON.stringify(current));
      } catch (e) { /* localStorage full / private mode — silent */ }
    }

    clearRecentSearches() {
      try { localStorage.removeItem('pt-recent-searches'); } catch (e) {}
    }

    /* Render the empty-state — recent chips (if any) + curated popular chips.
       Triggered on focus when input is empty, and when the input is
       cleared mid-session. */
    renderEmptyState() {
      this.loading.hidden = true;
      this.awaitingTrim = false;
      this.awaitingSelection = false;

      var recent = this.getRecentSearches();
      // Mode-aware popular chips. Tire chips (sizes, services, brand) make
      // no sense on the Wheels tab; wheel chips (diameters, bolt patterns,
      // vehicle fitment) are tire-irrelevant. Each chip can carry a direct
      // `url` — if set, the click navigates straight there instead of
      // running search() (used for chips whose canonical destination is
      // a known filtered-collection URL).
      var popular = this.mode === 'wheels'
        ? [
            { label: '17" wheels',      query: '17" wheels',    url: '/collections/wheels?filter.p.m.custom.rim_diameter=17' },
            { label: '18" wheels',      query: '18" wheels',    url: '/collections/wheels?filter.p.m.custom.rim_diameter=18' },
            { label: '2020 Honda Civic', query: '2020 Honda Civic' },
            { label: 'Browse all wheels', query: 'all wheels',  url: '/collections/wheels' }
          ]
        : [
            { label: '225/65R17',        query: '225/65R17' },
            { label: '2020 Honda Civic', query: '2020 Honda Civic' },
            { label: 'Tire rotation',    query: 'tire rotation' },
            { label: 'Michelin',         query: 'Michelin' }
          ];

      var html = '<li class="hero-smart-search__empty-state" role="presentation">';

      if (recent.length) {
        html += '<div class="hero-smart-search__empty-section">' +
          '<div class="hero-smart-search__empty-header">' +
            '<span class="hero-smart-search__empty-label">Recent searches</span>' +
            '<button type="button" class="hero-smart-search__empty-clear" data-clear-recent="true" aria-label="Clear recent searches">Clear</button>' +
          '</div>' +
          '<div class="hero-smart-search__empty-chips">' +
            recent.map(function(q){
              return '<button type="button" class="hero-smart-search__empty-chip hero-smart-search__empty-chip--recent" data-empty-query="' + this.escapeAttr(q) + '">' +
                '<span class="hero-smart-search__empty-chip-icon" aria-hidden="true">↻</span>' +
                '<span class="hero-smart-search__empty-chip-text">' + this.escapeHtml(q) + '</span>' +
              '</button>';
            }.bind(this)).join('') +
          '</div>' +
        '</div>';
      }

      html += '<div class="hero-smart-search__empty-section">' +
        '<div class="hero-smart-search__empty-header">' +
          '<span class="hero-smart-search__empty-label">Popular</span>' +
        '</div>' +
        '<div class="hero-smart-search__empty-chips">' +
          popular.map(function(p){
            var urlAttr = p.url ? ' data-empty-url="' + this.escapeAttr(p.url) + '"' : '';
            return '<button type="button" class="hero-smart-search__empty-chip" data-empty-query="' + this.escapeAttr(p.query) + '"' + urlAttr + '>' +
              '<span class="hero-smart-search__empty-chip-text">' + this.escapeHtml(p.label) + '</span>' +
            '</button>';
          }.bind(this)).join('') +
        '</div>' +
      '</div>';

      html += '</li>';

      this.list.innerHTML = html;
      this.items = [];
      this.selectedIndex = -1;
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');

      // Wire chip clicks — if the chip has a direct `data-empty-url` (used
      // for known-canonical destinations like /collections/wheels?diameter=17),
      // navigate straight there. Otherwise fill the input and run search.
      var self = this;
      this.list.querySelectorAll('[data-empty-query]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var q   = btn.getAttribute('data-empty-query');
          var url = btn.getAttribute('data-empty-url');
          var kind = btn.classList.contains('hero-smart-search__empty-chip--recent') ? 'recent_chip' : 'popular_chip';
          window.PTTireParse && window.PTTireParse.track({ surface: 'homepage', search_query: q, search_type: kind, search_outcome: 'click' });
          self.addRecentSearch(q);
          if (url) {
            window.location.href = url;
          } else {
            self.input.value = q;
            self.input.focus();
            self.search(q);
          }
        });
      });

      // Wire the "Clear" link
      var clearBtn = this.list.querySelector('[data-clear-recent]');
      if (clearBtn) {
        clearBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          self.clearRecentSearches();
          self.renderEmptyState();
        });
      }
    }

    highlightItem() {
      this.items.forEach((item, i) => {
        item.setAttribute('aria-selected', i === this.selectedIndex ? 'true' : 'false');
      });
      if (this.selectedIndex >= 0) {
        this.items[this.selectedIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    selectResult(item) {
      this.awaitingTrim = false;
      this.awaitingSelection = false;
      const url = item.dataset.url;
      if (url) {
        // Persist this search in the recent-searches history so the customer
        // sees it on their next visit (or on the next empty focus).
        this.addRecentSearch(this.input.value);
        window.location.href = url;
      }
    }

    showPrompt(message) {
      // Surface the "pick your trim" cue WHERE THE CUSTOMER IS LOOKING — i.e.
      // attached to the trim-header that sits at the top of the dropdown,
      // not appended at the bottom of an internally-scrollable list (which
      // is below the fold the moment the trim list is longer than ~4 rows).
      // Pulse the header so the change is visible, scroll the trim picker
      // to the top of both the dropdown and the page viewport, and auto-
      // highlight the first row so Enter immediately works.
      const header = this.list.querySelector('.hero-smart-search__trim-header');
      const inlineMessage = message || 'Pick one to continue';

      if (header) {
        // Inject (or refresh) the inline cue right under the "Choose your trim" label
        let cue = header.querySelector('.hero-smart-search__trim-cue');
        if (!cue) {
          cue = document.createElement('span');
          cue.className = 'hero-smart-search__trim-cue';
          cue.setAttribute('aria-live', 'polite');
          header.appendChild(cue);
        }
        cue.innerHTML = '<span class="hero-smart-search__trim-cue-icon" aria-hidden="true">↓</span>' +
          '<span class="hero-smart-search__trim-cue-text">' + this.escapeHtml(inlineMessage) + '</span>';

        // Retrigger the pulse animation on the whole header (the "blink")
        header.classList.remove('hero-smart-search__trim-header--attention');
        void header.offsetWidth; /* reflow restarts the keyframes */
        header.classList.add('hero-smart-search__trim-header--attention');

        // Scroll the dropdown's INTERNAL scroll back to the top so the
        // header is visible even when the trim list is long.
        if (this.results && this.results.scrollTop) this.results.scrollTop = 0;

        // Smooth-scroll the dropdown into the page viewport in case the
        // page itself is scrolled past it (small-viewport / mobile edge case).
        try {
          const rect = this.results.getBoundingClientRect();
          const out = rect.top < 0 || rect.top > (window.innerHeight - 120);
          if (out) this.results.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (e) { /* never break the widget */ }

        // Auto-highlight the first trim row so Enter immediately picks it.
        if (this.items && this.items.length > 0 && this.selectedIndex < 0) {
          this.selectedIndex = 0;
          this.highlightItem();
        }
        return;
      }

      // Fallback for callers that fire showPrompt outside a trim-results render
      // (defensive — the live code always renders the header first, but keep
      // the legacy behavior in case some path skips it).
      const existing = this.list.querySelector('.hero-smart-search__trim-prompt');
      if (existing) {
        existing.textContent = inlineMessage;
        existing.classList.remove('hero-smart-search__trim-prompt--shake');
        void existing.offsetWidth;
        existing.classList.add('hero-smart-search__trim-prompt--shake');
        return;
      }
      const li = document.createElement('li');
      li.className = 'hero-smart-search__trim-prompt';
      li.setAttribute('aria-live', 'polite');
      li.textContent = inlineMessage;
      this.list.appendChild(li);
    }

    onKeydown(e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!this.items.length) return;
        this.selectedIndex = Math.min(this.selectedIndex + 1, this.items.length - 1);
        this.highlightItem();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!this.items.length) return;
        this.selectedIndex = Math.max(this.selectedIndex - 1, 0);
        this.highlightItem();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (this.selectedIndex >= 0 && this.items[this.selectedIndex]) {
          this.selectResult(this.items[this.selectedIndex]);
        } else if (this.awaitingTrim) {
          this.showPrompt('Pick one to continue');
        } else {
          this.onSubmit();
        }
      } else if (e.key === 'Escape') {
        this.hideResults();
      }
    }

    onSubmit() {
      if (this.awaitingTrim) {
        this.showPrompt('Pick one to continue');
        return;
      }

      // If a single resolved result is already queued in the dropdown
      // (e.g. customer typed "2012 Honda Civic DX" and we matched the
      // exact trim), honor the arrow CTA by navigating to that result's
      // URL — don't re-parse the free-text query as a tire size, which
      // would fail and surface the "couldn't find a match" fallback.
      if (this.awaitingSelection && this.items && this.items.length > 0) {
        var firstUrl = this.items[0].dataset && this.items[0].dataset.url;
        if (firstUrl) {
          this.selectResult(this.items[0]);
          return;
        }
      }

      const query = this.input.value.trim();
      if (!query) return;

      // Service routing — must be checked before tire-size parsing.
      // SUPPRESSED on the Wheels tab — services are tire-only and shouldn't
      // intercept queries that the customer typed while shopping for wheels.
      if (this.mode !== 'wheels') {
        const service = this.detectService(query);
        if (service) {
          window.PTTireParse && window.PTTireParse.track({ surface: 'homepage', search_query: query, search_type: 'service', search_outcome: 'match' });
          this.addRecentSearch(query);
          window.location.href = service.url;
          return;
        }
      }

      const parsed = this.normalizeTireSize(query);
      const intent = this.parseSearchIntent(query);
      // On the Wheels tab, season + serviceType signals are tire-only
      // noise — strip them so the resulting URL never carries
      // `filter.p.m.custom.seasonality` etc. to /collections/wheels.
      if (this.mode === 'wheels') {
        intent.season = null;
        intent.serviceType = null;
      }

      // If the customer pressed Enter on a partial tire size (e.g. "28540"),
      // surface the autocomplete suggestions instead of running it through
      // vehicle parse (which would hallucinate "2026 RAM 2500" or worse).
      if (!parsed) {
        const partialSize = this.detectPartialTireSize(query);
        if (partialSize) {
          this.renderTireSizeSuggestions(partialSize, query);
          return;
        }
      }

      if (parsed) {
        this.addRecentSearch(query);
        window.location.href = this.buildCollectionUrl({
          width: parsed.width,
          aspect: parsed.aspect,
          rim: parsed.rim,
          brand: intent.brand,
          season: intent.season,
          serviceType: intent.serviceType,
        });
      } else if (intent.brand || intent.season || intent.serviceType || intent.rim) {
        this.addRecentSearch(query);
        window.location.href = this.buildCollectionUrl({
          brand: intent.brand,
          season: intent.season,
          serviceType: intent.serviceType,
          rim: intent.rim,
        });
      } else {
        var partialOnSubmit = this.detectPartialQuery(query);
        if (partialOnSubmit) {
          this.renderGuidance(partialOnSubmit);
        } else {
          this.showFallback(query);
        }
      }
    }

    renderGuidance(partial) {
      this.loading.hidden = true;
      this.awaitingTrim = false;
      this.awaitingSelection = false;

      var title, sub, url, chipsHtml = '';

      if (partial.type === 'year-only') {
        title = 'Got ' + partial.year + ' — what car?';
        sub = 'Pick a make below, or type a make + model (e.g. <em>' + partial.year + ' Honda Civic</em>).';
        url = null;
        // "Use the year you DO have" — render top-volume make chips so the
        // customer drills in one click instead of typing.
        chipsHtml = '<span class="hero-smart-search__guidance-chips">' +
          this.popularMakes.map(function(mk) {
            return '<button type="button" class="hero-smart-search__guidance-chip" data-make="' + this.escapeAttr(mk) + '" data-year="' + partial.year + '">' + this.escapeHtml(mk) + '</button>';
          }.bind(this)).join('') +
          '</span>';
      } else if (partial.type === 'year-make') {
        title = 'Almost — what model?';
        sub = 'Try <em>' + partial.year + ' ' + this.escapeHtml(partial.make) + ' [model]</em> — e.g. <em>' + partial.year + ' ' + this.escapeHtml(partial.make) + ' Civic</em>.';
        url = null;
      } else {
        // make-only
        title = 'Looking for <em>' + this.escapeHtml(partial.make) + '</em> tires?';
        sub = 'Add a year + model — <em>or</em> <strong><a href="/collections/brand-' + partial.make.toLowerCase().replace(/\s+/g,'-') + '" class="hero-smart-search__guidance-link">browse all ' + this.escapeHtml(partial.make) + ' tires →</a></strong>';
        url = '/collections/brand-' + partial.make.toLowerCase().replace(/\s+/g, '-');
      }

      var liClass = 'hero-smart-search__guidance' + (url ? ' hero-smart-search__guidance--link' : '');
      var inner =
        '<span class="hero-smart-search__guidance-icon">' + this.hintIcon() + '</span>' +
        '<span class="hero-smart-search__guidance-text">' +
          '<span class="hero-smart-search__guidance-title">' + title + '</span>' +
          '<span class="hero-smart-search__guidance-sub">' + sub + '</span>' +
          chipsHtml +
        '</span>' +
        '<span class="hero-smart-search__result-tag">Hint</span>';

      var li;
      if (url) {
        li = '<li class="' + liClass + '" role="option" data-url="' + this.escapeAttr(url) + '">' + inner + '</li>';
      } else {
        li = '<li class="' + liClass + '" role="option" data-guidance-hint="true">' + inner + '</li>';
      }

      this.list.innerHTML = li;
      this.items = this.list.querySelectorAll('.hero-smart-search__guidance[data-url]');
      this.items.forEach(item => {
        item.addEventListener('click', () => this.selectResult(item));
      });

      // Non-link guidance: clicking focuses back on input
      var hintItems = this.list.querySelectorAll('.hero-smart-search__guidance[data-guidance-hint]');
      hintItems.forEach(item => {
        item.addEventListener('click', () => { this.input.focus(); });
      });

      // Year-only make-chip clicks: stop the li focus handler, fill the input
      // with "<year> <make>", and re-run search (which will route to the
      // year-make guidance asking for a model).
      var self = this;
      this.list.querySelectorAll('.hero-smart-search__guidance-chip').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var mk = btn.getAttribute('data-make');
          var yr = btn.getAttribute('data-year');
          var q = yr + ' ' + mk;
          self.input.value = q;
          self.input.focus();
          window.PTTireParse && window.PTTireParse.track({ surface: 'homepage', search_query: q, search_type: 'guidance_chip', search_outcome: 'click' });
          self.search(q);
        });
      });

      this.selectedIndex = -1;
      this.awaitingSelection = false;
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');
    }

    showFallback(query) {
      window.PTTireParse && window.PTTireParse.track({ surface: 'homepage', search_query: query, search_type: 'none', search_outcome: 'no_match' });
      const phone = this.config.fallbackPhone || '403 452 4283';
      const phoneClean = phone.replace(/\s/g, '');
      this.loading.hidden = true;
      this.awaitingTrim = false;
      this.awaitingSelection = false;

      var exampleChips = ['225/65R17', '2020 Honda Civic', 'tire rotation', 'Michelin'];
      var chipsHtml = exampleChips.map(function(ex) {
        return '<button type="button" class="hero-smart-search__fallback-chip" data-example="' + ex.replace(/"/g, '&quot;') + '">' + ex + '</button>';
      }.bind(this)).join('');

      this.list.innerHTML =
        '<li class="hero-smart-search__fallback">' +
          '<span class="hero-smart-search__fallback-icon">' + this.searchIcon() + '</span>' +
          '<span class="hero-smart-search__fallback-text">' +
            '<span class="hero-smart-search__fallback-title">Tell us what you\'re looking for</span>' +
            '<span class="hero-smart-search__fallback-sub">Try a tire size, a vehicle, a service, or a brand &mdash; we\'ll find your tires.</span>' +
            '<span class="hero-smart-search__fallback-examples">' + chipsHtml + '</span>' +
          '</span>' +
          '<a href="tel:' + phoneClean + '" class="hero-smart-search__fallback-phone">Or call us &middot; ' + phone + '</a>' +
        '</li>';

      // Wire up example chip clicks
      var self = this;
      this.list.querySelectorAll('.hero-smart-search__fallback-chip').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var ex = btn.getAttribute('data-example');
          self.input.value = ex;
          self.input.focus();
          self.search(ex);
        });
      });

      this.items = [];
      this.selectedIndex = -1;
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');

      // Auto-capture every "no match" to the missing-vehicle Sheet / email pipeline.
      // Light dedup: min 3 chars + don't re-post the exact same query within this session.
      const webhook = this.config.missingVehicleWebhookUrl;
      const q = (query || '').trim();
      if (webhook && q.length >= 3 && this._lastReportedNoMatch !== q) {
        this._lastReportedNoMatch = q;
        try {
          fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              vehicle:    q,
              year:       '',
              make:       '',
              model:      '',
              trim:       '',
              page_url:   window.location.href,
              user_agent: navigator.userAgent,
              timestamp:  new Date().toISOString(),
              source:     'homepage_smart_search_no_match'
            })
          }).catch(() => { /* best-effort; never break the widget */ });
        } catch (e) { /* never break the widget */ }
      }
    }

    tireIcon() {
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>';
    }

    vehicleIcon() {
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 17h14M7.5 17V13L6 9H18L16.5 13V17M9 21H7V19H9V21ZM17 21H15V19H17V21ZM3 13H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    searchIcon() {
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M16 16L21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
    }

    phoneIcon() {
      return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22 16.92V19.92C22 20.48 21.56 20.93 21 20.97C20.66 21 20.33 21.01 20 21.01C10.61 21.01 3 13.4 3 3.97C3 3.64 3.01 3.31 3.03 2.97C3.07 2.41 3.52 1.97 4.08 1.97H7.08C7.56 1.97 7.97 2.33 8.03 2.81C8.09 3.33 8.2 3.84 8.37 4.33C8.52 4.76 8.41 5.24 8.08 5.57L6.62 7.03C8.06 9.78 10.22 11.94 12.97 13.38L14.43 11.92C14.76 11.59 15.24 11.48 15.67 11.63C16.16 11.8 16.67 11.91 17.19 11.97C17.67 12.03 18.03 12.44 18.03 12.92V16.92H22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    }

    hintIcon() {
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v1M12 11v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
    }

    escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    escapeAttr(text) {
      return text.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
  }

  const smartSearchInstances = [];
  document.querySelectorAll('[data-smart-search]').forEach(el => {
    smartSearchInstances.push(new SmartTireSearch(el.closest('.hero-smart-search')));
  });

  /* ── ?ss= hydration — header fallthrough lands here ── */
  (function() {
    var ss = new URLSearchParams(location.search).get('ss');
    if (!ss || !ss.trim()) return;
    var instance = smartSearchInstances[0];
    if (!instance || !instance.input) return;
    /* Set the input value */
    instance.input.value = ss.trim();
    /* Hide the typewriter placeholder (it checks input.value on blur/input) */
    var tw = document.querySelector('[data-typewriter]');
    if (tw) tw.classList.add('is-hidden');
    /* Track the header fallthrough hydration */
    try {
      if (window.PTTireParse && typeof window.PTTireParse.track === 'function') {
        window.PTTireParse.track({ surface: 'header_fallthrough', search_query: ss.trim(), search_type: 'hydrate', search_outcome: 'match' });
      }
    } catch(e) { /* never throw */ }
    /* Auto-submit after a short delay so the page has fully painted */
    setTimeout(function() {
      if (typeof instance.onSubmit === 'function') {
        instance.onSubmit();
      }
    }, 120);
  })();

  /* Garage pre-fill removed — typewriter handles placeholder */

  (function() {
    var heading = document.querySelector('[data-hero-heading]');
    if (!heading) return;

    var left = heading.querySelector('[data-hero-left]');
    var right = heading.querySelector('[data-hero-right]');
    var searchWrap = document.querySelector('.hero-smart-search__input-wrapper');

    function trigger() {
      if (left) left.classList.add('is-animated');
      if (right) right.classList.add('is-animated');
      if (searchWrap) searchWrap.classList.add('is-animated');
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            setTimeout(trigger, 200);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3 });
      observer.observe(heading);
    } else {
      setTimeout(trigger, 300);
    }
  })();

  /* Typewriter placeholder effect */
  (function() {
    var el = document.querySelector('[data-typewriter]');
    var input = document.querySelector('[data-smart-search-input]');
    if (!el || !input) return;

    var intro = 'What are you looking for?';
    var PHRASES_BY_MODE = {
      tires: [
        'tires for Honda Civic SI 2025',
        'Michelin 225/65R17',
        'winter tires for my RAV4',
        'Ford F-150 2024',
        'all season tires 2055516',
        'Bridgestone Subaru Outback',
        'crv 2025 winter',
        'Toyota Camry LE 2024',
      ],
      wheels: [
        '17 inch wheels for Honda Civic',
        '5x114.3 bolt pattern',
        '20 inch black rims',
        'wheels for Ford F-150 2024',
        '6x139.7 bolt pattern',
        '18" matte black wheels',
        'rims for RAV4 2023',
        '22 inch chrome wheels',
        'wheels for Toyota Tacoma',
        '19 inch alloy wheels',
      ],
    };
    function currentMode() {
      try { return (localStorage.getItem('pt-search-mode') === 'wheels') ? 'wheels' : 'tires'; }
      catch (e) { return 'tires'; }
    }
    var phrases = PHRASES_BY_MODE[currentMode()];
    var phase = 'intro';       /* intro → examples */
    var phraseIndex = 0;
    var charIndex = 0;
    var isDeleting = false;
    var isPaused = false;
    var isActive = true;

    function tick() {
      if (!isActive) return;

      /* Phase 1: Show intro instantly, pause, then clear */
      if (phase === 'intro') {
        el.textContent = intro;
        phase = 'intro-clear';
        setTimeout(tick, 2000);
        return;
      }

      if (phase === 'intro-clear') {
        el.textContent = '';
        phase = 'examples';
        setTimeout(tick, 300);
        return;
      }

      /* Phase 2: Cycle through examples */
      var current = phrases[phraseIndex];

      if (isPaused) {
        isPaused = false;
        isDeleting = true;
        setTimeout(tick, 25);
        return;
      }

      if (!isDeleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);
        if (charIndex >= current.length) {
          isPaused = true;
          setTimeout(tick, 1600);
          return;
        }
        setTimeout(tick, 35 + Math.random() * 25);
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);
        if (charIndex <= 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          setTimeout(tick, 250);
          return;
        }
        setTimeout(tick, 20);
      }
    }

    /* Hide typewriter when user focuses or types */
    input.addEventListener('focus', function() {
      el.classList.add('is-hidden');
    });
    input.addEventListener('blur', function() {
      if (!input.value) {
        el.classList.remove('is-hidden');
        if (!isActive) {
          isActive = true;
          tick();
        }
      }
    });
    input.addEventListener('input', function() {
      if (input.value) {
        el.classList.add('is-hidden');
        isActive = false;
      } else {
        el.classList.remove('is-hidden');
        if (!isActive) {
          isActive = true;
          charIndex = 0;
          tick();
        }
      }
    });

    /* React to mode changes — swap the phrase pool + restart the typewriter */
    document.addEventListener('pt-search-mode-change', function(e) {
      var newMode = (e && e.detail && e.detail.mode) || currentMode();
      phrases = PHRASES_BY_MODE[newMode] || PHRASES_BY_MODE.tires;
      phraseIndex = 0;
      charIndex = 0;
      isDeleting = false;
      el.textContent = '';
    });

    /* Start after heading animation completes */
    setTimeout(tick, 1200);
  })();

  /* ── Hero slideshow cycler ─────────────────────────────────── */
  (function () {
    var root = document.querySelector('[data-hero-slideshow]');
    if (!root) return;
    var slides = root.querySelectorAll('.hero-smart-search__slide');
    if (slides.length < 2) return;

    var interval = parseInt(root.dataset.interval, 10) || 5000;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    var current = 0;
    var timer = null;

    function show(next) {
      var prev = current;
      if (next === prev) return;

      var prevEl = slides[prev];
      var nextEl = slides[next];

      prevEl.classList.remove('is-active');
      prevEl.classList.add('is-leaving');
      nextEl.classList.remove('is-leaving');
      nextEl.classList.add('is-entering', 'is-active');

      // Cleanup the leaving class after the exit animation finishes
      window.setTimeout(function () { prevEl.classList.remove('is-leaving'); }, 1100);
      window.setTimeout(function () { nextEl.classList.remove('is-entering'); }, 700);

      current = next;
    }

    function next() {
      show((current + 1) % slides.length);
    }

    function start() {
      if (timer) return;
      timer = window.setInterval(next, interval);
    }
    function stop() {
      if (!timer) return;
      window.clearInterval(timer);
      timer = null;
    }

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') stop();
      else start();
    });

    start();
  })();
});
</script>

