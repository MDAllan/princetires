<div
  class="hero-smart-search"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-subtitle-opacity: {{ section.settings.subtitle_opacity | divided_by: 100.0 }};
  "
>
  {%- assign slide_blocks = section.blocks | where: 'type', 'slide_image' -%}

  {%- if slide_blocks.size > 0 -%}
    <div
      class="hero-smart-search__slideshow"
      data-hero-slideshow
      data-direction="{{ section.settings.slideshow_direction | default: 'up' }}"
      data-interval="{{ section.settings.slideshow_interval_s | default: 5 | times: 1000 }}"
      aria-hidden="true"
    >
      {%- for block in slide_blocks -%}
        {%- if block.settings.image != blank -%}
          <picture class="hero-smart-search__slide-pic">
            {%- if block.settings.mobile_image != blank -%}
              <source
                media="(max-width: 768px)"
                srcset="{{ block.settings.mobile_image | image_url: width: 600 }} 600w, {{ block.settings.mobile_image | image_url: width: 900 }} 900w, {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w"
                sizes="100vw"
              >
            {%- endif -%}
            <img
              class="hero-smart-search__slide{% if forloop.first %} is-active{% endif %}"
              src="{{ block.settings.image | image_url: width: 2400 }}"
              srcset="{{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1400 }} 1400w, {{ block.settings.image | image_url: width: 2000 }} 2000w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              alt=""
              {{ block.shopify_attributes }}
            >
          </picture>
        {%- endif -%}
      {%- endfor -%}
      <div
        class="hero-smart-search__slideshow-overlay"
        style="--hero-overlay-opacity: {{ section.settings.slideshow_overlay_opacity | default: 60 | divided_by: 100.0 }};"
      ></div>
    </div>
  {%- elsif section.settings.hero_3d_scene_url != blank -%}
    <div class="hero-smart-search__spline" aria-hidden="true">
      <spline-viewer
        url="{{ section.settings.hero_3d_scene_url }}"
        loading-anim-type="spinner-small-light"
        events-target="global"
      ></spline-viewer>
    </div>
  {%- endif -%}

  <div class="hero-smart-search__container">
    <div class="hero-smart-search__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-smart-search__heading aeo-speakable-title" data-hero-heading>
          <span class="hero-smart-search__heading-left" data-hero-left>{{ section.settings.heading }}</span>
          {%- if section.settings.heading_accent != blank -%}
            <span class="hero-smart-search__heading-right" data-hero-right>{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="hero-smart-search__subtitle aeo-speakable-summary">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}

      <div class="hero-smart-search__search-wrapper">
        <div class="hero-smart-search__tabs" role="tablist" aria-label="Search category">
          <button
            type="button"
            class="hero-smart-search__tab hero-smart-search__tab--active"
            role="tab"
            aria-selected="true"
            data-search-mode="tires"
          >Tires</button>
          <button
            type="button"
            class="hero-smart-search__tab"
            role="tab"
            aria-selected="false"
            data-search-mode="wheels"
          >Wheels</button>
        </div>

        <div class="hero-smart-search__search" data-smart-search>
          <div class="hero-smart-search__input-wrapper">
            <input
              type="text"
              class="hero-smart-search__input"
              data-smart-search-input
              placeholder=""
              autocomplete="off"
              aria-label="{{ 'sections.hero_smart_search.search_label' | t }}"
              aria-expanded="false"
              aria-controls="smart-search-results"
              role="combobox"
            >
            <span class="hero-smart-search__typewriter" data-typewriter aria-hidden="true"></span>
            <button
              class="hero-smart-search__submit"
              data-smart-search-submit
              aria-label="{{ 'sections.hero_smart_search.search_submit' | t }}"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <div class="hero-smart-search__results" id="smart-search-results" data-smart-search-results hidden>
            <div class="hero-smart-search__loading" data-smart-search-loading hidden>
              <span class="hero-smart-search__spinner"></span>
              <span>{{ 'sections.hero_smart_search.ai_thinking' | t }}</span>
            </div>
            <ul class="hero-smart-search__results-list" role="listbox" data-smart-search-list></ul>
          </div>
        </div>
      </div>

      {%- comment -%}
        Action buttons: Book service + the hardcoded phone link both removed —
        the new mobile sticky bar carries those CTAs (and on desktop the
        header phone icon does). Other action blocks (tire search, wheel
        search, etc) are still rendered as before.
      {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        {%- assign visible_block_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.action != 'book_service'
             and block.settings.label != blank
             and block.settings.icon != 'phone' -%}
            {%- assign visible_block_count = visible_block_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if visible_block_count > 0 -%}
          <div class="hero-smart-search__actions">
            {%- for block in section.blocks -%}
              {%- if block.settings.action == 'book_service' -%}{%- continue -%}{%- endif -%}
              {%- if block.settings.label == blank -%}{%- continue -%}{%- endif -%}
              {%- if block.settings.icon == 'phone' -%}{%- continue -%}{%- endif -%}

              <a
                href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}"
                class="hero-smart-search__btn"
                {{ block.shopify_attributes }}
              >
                {%- case block.settings.icon -%}
                  {%- when 'tire' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="2" fill="currentColor"/>
                    </svg>
                  {%- when 'wheel' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M12 2V9M12 15V22M2 12H9M15 12H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- when 'calendar' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M16 2V6M8 2V6M3 10H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {%- endcase -%}
                {{ block.settings.label | escape }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  Config block — passes Liquid values to JavaScript since
  Liquid can't render inside {% javascript %} tags.
{%- endcomment -%}
{%- comment -%}
  Brand list pulled from the tires collection's vendor facet so the
  hero smart search always knows about every brand currently stocked
  (rather than a hardcoded list that drifts when inventory changes).
{%- endcomment -%}
{%- assign hero_brands = '' -%}
{%- for f in collections.tires.filters -%}
  {%- if f.param_name == 'filter.p.vendor' -%}
    {%- for v in f.values -%}
      {%- assign hero_brands = hero_brands | append: v.label | append: '||' -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
<script data-smart-search-config type="application/json">
  {
    "minYear": {{ settings.smart_search_min_year | default: 2001 }},
    "maxYear": {{ settings.smart_search_max_year | default: 2026 }},
    "assetUrlBase": {{ 'pt-vehicle-2025.json' | asset_url | split: 'pt-vehicle-2025.json' | first | json }},
    "fallbackPhone": {{ settings.smart_search_fallback_phone | default: '403 452 4283' | json }},
    "missingVehicleWebhookUrl": {{ settings.missing_vehicle_webhook_url | json }},
    "brands": {{ hero_brands | split: '||' | json }}
  }
</script>

{%- if section.settings.hero_3d_scene_url != blank -%}
  <script
    type="module"
    src="https://unpkg.com/@splinetool/viewer@1.9.71/build/spline-viewer.js"
    defer
  ></script>
{%- endif -%}

{% stylesheet %}
  .hero-smart-search {
    background-color: var(--hero-bg, #000000);
    color: var(--hero-text, #ffffff);
    padding: 4rem 2rem;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Direct upward shift of the content wrapper — works regardless of
     whether align-items has slack to center within. */
  .hero-smart-search__container {
    transform: translateY(-20px);
  }
  @media (max-width: 768px) {
    .hero-smart-search__container { transform: translateY(-12px); }
  }

  /* ── 3D Spline scene (optional background) ── */
  .hero-smart-search__spline {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.65;
    mix-blend-mode: screen;
  }
  .hero-smart-search__spline spline-viewer,
  .hero-smart-search__spline canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  /* Dim further on small screens so the search bar stays legible */
  @media (max-width: 749px) {
    .hero-smart-search__spline { opacity: 0.45; }
  }
  /* Honor user motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .hero-smart-search__spline { display: none; }
  }

  /* ── Slideshow background (optional, replaces Spline if both set) ── */
  .hero-smart-search__slideshow {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* <picture> wrapper sits in normal flow but is invisible — only the img renders */
  .hero-smart-search__slide-pic { display: contents; }
  .hero-smart-search__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1) rotateX(0deg);
    transform-origin: center;
    will-change: transform, opacity;
  }
  /* Mobile: switch to `contain` so wide product photos (wheels, tires) show
     fully without their sides being cropped. Letterbox top/bottom is fine —
     the slideshow overlay + hero background fill the gap. */
  @media (max-width: 768px) {
    .hero-smart-search__slide {
      object-fit: contain;
      object-position: center;
    }
  }
  .hero-smart-search__slide.is-entering {
    animation: hero-slide-in 0.55s cubic-bezier(0.645, 0.045, 0.355, 1.0) forwards;
  }
  .hero-smart-search__slide.is-active {
    opacity: 1;
    z-index: 1;
  }
  /* Ken Burns — slow zoom while a slide is active. Only kicks in after the
     entry animation finishes (the :not(.is-entering) gate). 7s zoom matches
     the default 5s slide interval + 2s tail for a soft motion bed. */
  .hero-smart-search__slide.is-active:not(.is-entering):not(.is-leaving) {
    animation: hero-ken-burns 7s cubic-bezier(0.16, 0.6, 0.3, 1.0) forwards;
  }
  .hero-smart-search__slide.is-leaving {
    z-index: 1;
    opacity: 1;
    animation: hero-slide-out-up 1.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .hero-smart-search__slideshow[data-direction="down"] .hero-smart-search__slide.is-leaving {
    animation-name: hero-slide-out-down;
  }
  @keyframes hero-slide-in {
    from { opacity: 0; transform: scale(0.4) rotateX(45deg); }
    to   { opacity: 1; transform: scale(1) rotateX(0deg); }
  }
  @keyframes hero-ken-burns {
    from { transform: scale(1)    rotateX(0deg); }
    to   { transform: scale(1.07) rotateX(0deg); }
  }
  /* Softer exits: shorter travel + opacity fade so the image dissolves
     instead of hard-dropping. Reads gracefully on mobile. */
  @keyframes hero-slide-out-up {
    0%   { opacity: 1; transform: translateY(0)    scale(1.07); }
    60%  { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-40%) scale(1.10); }
  }
  @keyframes hero-slide-out-down {
    0%   { opacity: 1; transform: translateY(0)   scale(1.07); }
    60%  { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(40%) scale(1.10); }
  }
  .hero-smart-search__slideshow-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--hero-overlay-opacity, 0.6));
    z-index: 2;
    pointer-events: none;
  }
  /* Reduced-motion: skip animations, just show the active slide */
  @media (prefers-reduced-motion: reduce) {
    .hero-smart-search__slide.is-entering,
    .hero-smart-search__slide.is-leaving {
      animation: none;
    }
    .hero-smart-search__slide:not(.is-active) { display: none; }
  }
  .hero-smart-search__container {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-smart-search__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-smart-search__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(3rem, 4.5vw, 4.2rem);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 1rem;
    letter-spacing: 0.06em;
    color: var(--hero-text, #ffffff);
    text-transform: uppercase;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
    overflow: hidden;
  }

  .hero-smart-search__heading-left,
  .hero-smart-search__heading-right {
    display: inline-block;
    opacity: 0;
    animation: hero-fallback 0s 2.5s forwards;
  }

  .hero-smart-search__heading-left {
    transform: translateX(-120%);
  }

  .hero-smart-search__heading-right {
    color: var(--hero-accent, #DC2626);
    transform: translateX(120%);
  }

  @keyframes hero-fallback {
    to { opacity: 1; transform: translateX(0); }
  }

  .hero-smart-search__heading-left.is-animated {
    animation: hero-slide-left 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-smart-search__heading-right.is-animated {
    animation: hero-slide-right 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
  }

  @keyframes hero-slide-left {
    0% { transform: translateX(-120%); opacity: 0; filter: blur(8px); }
    60% { filter: blur(2px); }
    100% { transform: translateX(0); opacity: 1; filter: blur(0); }
  }

  @keyframes hero-slide-right {
    0% { transform: translateX(120%); opacity: 0; filter: blur(8px); }
    60% { filter: blur(2px); }
    100% { transform: translateX(0); opacity: 1; filter: blur(0); }
  }


  .hero-smart-search__subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 4rem;
    color: #6B7280;
    font-weight: 300;
    letter-spacing: 0.04em;
  }

  .hero-smart-search__search-wrapper {
    margin-bottom: 2.4rem;
    width: 100%;
    max-width: 48rem;
  }

  /* ── Tires / Wheels mode tabs (replaces the old "Search by …" badge) ── */
  .hero-smart-search__tabs {
    display: inline-flex;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }

  .hero-smart-search__tab {
    appearance: none;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.5rem 1.4rem;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: background 0.18s, color 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .hero-smart-search__tab:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .hero-smart-search__tab--active {
    color: #fff;
    background: #dc2626;
    border-color: #dc2626;
    box-shadow: 0 6px 18px rgba(220, 38, 38, 0.35);
  }
  .hero-smart-search__tab--active:hover {
    background: #b91c1c;
    border-color: #b91c1c;
    color: #fff;
  }
  .hero-smart-search__tab:focus-visible {
    outline: 2px solid #F5820B;
    outline-offset: 2px;
  }

  .hero-smart-search__search {
    position: relative;
  }

  .hero-smart-search__input-wrapper {
    display: flex;
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    overflow: visible;
    transition: border-color 0.2s ease;
    position: relative;
    isolation: isolate;
  }

  @keyframes hero-search-fade-in {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .hero-smart-search__input-wrapper::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 4px;
    background: linear-gradient(90deg, #525252, #525252, #dc2626, #F5820B, #525252, #525252);
    background-size: 300% 100%;
    z-index: -1;
    animation: hero-border-shimmer 4s ease-in-out infinite;
  }

  .hero-smart-search__input-wrapper::after {
    content: '';
    position: absolute;
    inset: 0px;
    border-radius: 2px;
    background: #000;
    z-index: -1;
  }

  @keyframes hero-border-shimmer {
    0% { background-position: 100% 0; }
    50% { background-position: 0% 0; }
    100% { background-position: 100% 0; }
  }

  .hero-smart-search__input-wrapper:focus-within::before {
    background: linear-gradient(90deg, #dc2626, #F5820B, #dc2626, #F5820B, #dc2626);
    background-size: 300% 100%;
  }

  .hero-smart-search__input {
    flex: 1;
    background: none;
    border: none;
    padding: 1.4rem 2rem;
    font-size: 1.4rem;
    color: var(--hero-text, #ffffff);
    outline: none;
    font-family: 'Outfit', sans-serif;
    font-weight: 300;
  }

  .hero-smart-search__input::placeholder {
    color: #6B7280;
  }

  .hero-smart-search__typewriter {
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    font-weight: 300;
    color: #6B7280;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .hero-smart-search__typewriter::after {
    content: '|';
    animation: hero-cursor-blink 0.7s step-end infinite;
    color: #F5820B;
    font-weight: 300;
    margin-left: 1px;
  }

  .hero-smart-search__typewriter.is-hidden {
    display: none;
  }

  @keyframes hero-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-smart-search__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    margin: 0.3rem;
    background: var(--hero-accent, #DC2626);
    color: #ffffff;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .hero-smart-search__submit:hover {
    opacity: 0.85;
  }

  .hero-smart-search__results {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    right: 0;
    background: #2a2a2a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    max-height: 32rem;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.4);
  }

  .hero-smart-search__results[hidden] {
    display: none;
  }

  .hero-smart-search__results-list {
    list-style: none;
    margin: 0;
    padding: 0.6rem;
  }

  .hero-smart-search__loading {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 1.6rem;
    font-size: 1.3rem;
    opacity: 0.7;
    color: var(--hero-text, #ffffff);
  }

  .hero-smart-search__loading[hidden] {
    display: none;
  }

  .hero-smart-search__spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: var(--hero-accent, #c0392b);
    border-radius: 50%;
    animation: smart-search-spin 0.6s linear infinite;
  }

  @keyframes smart-search-spin {
    to { transform: rotate(360deg); }
  }

  .hero-smart-search__result-item {
    padding: 1.2rem 1.4rem;
    border-radius: 3px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.4rem;
    transition: background 0.15s ease;
    color: var(--hero-text, #ffffff);
  }

  .hero-smart-search__result-item:hover,
  .hero-smart-search__result-item[aria-selected="true"] {
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-smart-search__result-icon {
    width: 3.2rem;
    height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  .hero-smart-search__result-info {
    flex: 1;
    min-width: 0;
  }

  .hero-smart-search__result-title {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-smart-search__result-meta {
    font-size: 1.2rem;
    opacity: 0.5;
    margin-top: 0.2rem;
  }

  .hero-smart-search__result-tag {
    font-size: 1.1rem;
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .hero-smart-search__error {
    padding: 1.2rem 1.6rem;
    font-size: 1.3rem;
    opacity: 0.6;
    color: var(--hero-text, #ffffff);
  }

  .hero-smart-search__fallback {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.4rem 1.6rem;
    list-style: none;
  }

  .hero-smart-search__fallback-icon {
    flex-shrink: 0;
    width: 3.6rem;
    height: 3.6rem;
    background: rgba(245, 130, 11, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F5820B;
  }

  .hero-smart-search__fallback-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .hero-smart-search__fallback-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
  }

  .hero-smart-search__fallback-sub {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    color: #6B7280;
  }

  .hero-smart-search__fallback-phone {
    flex-shrink: 0;
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: #F5820B;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgba(245, 130, 11, 0.2);
    border-radius: 4px;
    transition: background 0.15s;
  }

  .hero-smart-search__fallback-phone:hover {
    background: rgba(245, 130, 11, 0.1);
  }

  /* ── Reframed fallback: example chips ── */
  .hero-smart-search__fallback-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .hero-smart-search__fallback-chip {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #F5820B;
    background: rgba(245, 130, 11, 0.08);
    border: 1px solid rgba(245, 130, 11, 0.3);
    border-radius: 4px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    line-height: 1.6;
  }

  .hero-smart-search__fallback-chip:hover {
    background: rgba(245, 130, 11, 0.18);
    border-color: rgba(245, 130, 11, 0.6);
  }

  /* ── Guidance card (partial query hints) ── */
  .hero-smart-search__guidance {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.2rem 1.6rem;
    list-style: none;
    border-left: 2px solid rgba(99, 179, 237, 0.4);
    background: rgba(99, 179, 237, 0.04);
  }

  .hero-smart-search__guidance--link {
    cursor: pointer;
  }

  .hero-smart-search__guidance--link:hover {
    background: rgba(99, 179, 237, 0.09);
  }

  /* Vehicle resolved, no trim data — orange tint (urgent: we need more) */
  .hero-smart-search__guidance--needs-trim {
    border-left-color: rgba(245, 130, 11, 0.55);
    background: rgba(245, 130, 11, 0.06);
    cursor: text;
  }

  .hero-smart-search__guidance--needs-trim .hero-smart-search__guidance-icon {
    background: rgba(245, 130, 11, 0.18);
    color: #F5820B;
  }

  .hero-smart-search__guidance--needs-trim .hero-smart-search__result-tag {
    background: rgba(245, 130, 11, 0.18);
    color: #F5820B;
  }

  .hero-smart-search__guidance-icon {
    flex-shrink: 0;
    width: 3.2rem;
    height: 3.2rem;
    background: rgba(99, 179, 237, 0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #63B3ED;
  }

  .hero-smart-search__guidance-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }

  .hero-smart-search__guidance-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
  }

  .hero-smart-search__guidance-sub {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    color: #9CA3AF;
    line-height: 1.4;
  }

  .hero-smart-search__guidance-sub em {
    color: #CBD5E0;
    font-style: italic;
  }

  .hero-smart-search__guidance-sub strong {
    color: #E2E8F0;
  }

  .hero-smart-search__guidance-link {
    color: #63B3ED;
    text-decoration: none;
  }

  .hero-smart-search__guidance-link:hover {
    text-decoration: underline;
  }

  /* ── Wheel fitment card (Wheels tab + resolved vehicle) ── */
  .hsf-wf {
    list-style: none;
    padding: 1.2rem 1.4rem;
    border-left: 3px solid #dc2626;
    background: rgba(220, 38, 38, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .hsf-wf__header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .hsf-wf__icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .hsf-wf__heading {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .hsf-wf__title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
  }
  .hsf-wf__subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
  }
  .hsf-wf__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hsf-wf__spec {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .hsf-wf__spec-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
  }
  .hsf-wf__spec-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: #e5e7eb;
  }
  .hsf-wf__row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .hsf-wf__row-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
  }
  .hsf-wf__row-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hsf-wf__chip {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
  }
  .hsf-wf__chip--tire {
    color: #cbd5e0;
  }
  .hsf-wf__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hsf-wf__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.45rem 0.95rem;
    border-radius: 4px;
    background: #dc2626;
    color: #fff;
    transition: background 0.15s;
  }
  .hsf-wf__cta:hover {
    background: #b91c1c;
    color: #fff;
  }
  .hsf-wf__cta--secondary {
    background: transparent;
    color: #cbd5e0;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .hsf-wf__cta--secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  /* Primary "Wheels that fit your car" CTA — full-width, eye-catching */
  .hsf-wf__cta--primary {
    flex-basis: 100%;
    justify-content: center;
    font-size: 1.1rem;
    padding: 0.7rem 1.1rem;
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
  }
  .hsf-wf__cta--primary:hover {
    background: linear-gradient(135deg, #b91c1c, #991b1b);
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
  }

  /* ── Empty state: Recent + Popular searches ── */
  .hero-smart-search__empty-state {
    list-style: none;
    padding: 0.6rem 0.6rem 0.4rem;
  }

  .hero-smart-search__empty-section + .hero-smart-search__empty-section {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .hero-smart-search__empty-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.6rem 0.5rem;
  }

  .hero-smart-search__empty-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
  }

  .hero-smart-search__empty-clear {
    background: none;
    border: none;
    color: #9ca3af;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    transition: color 0.15s, background 0.15s;
  }
  .hero-smart-search__empty-clear:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-smart-search__empty-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 0.6rem;
  }

  .hero-smart-search__empty-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.02rem;
    font-weight: 500;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 4px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    line-height: 1.5;
  }
  .hero-smart-search__empty-chip:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .hero-smart-search__empty-chip--recent {
    color: #F5820B;
    background: rgba(245, 130, 11, 0.08);
    border-color: rgba(245, 130, 11, 0.25);
  }
  .hero-smart-search__empty-chip--recent:hover {
    background: rgba(245, 130, 11, 0.16);
    border-color: rgba(245, 130, 11, 0.5);
  }
  .hero-smart-search__empty-chip-icon {
    color: #F5820B;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  /* ── Year-only quick-pick make chips ── */
  .hero-smart-search__guidance-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .hero-smart-search__guidance-chip {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #63B3ED;
    background: rgba(99, 179, 237, 0.08);
    border: 1px solid rgba(99, 179, 237, 0.3);
    border-radius: 4px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    line-height: 1.6;
  }

  .hero-smart-search__guidance-chip:hover {
    background: rgba(99, 179, 237, 0.18);
    border-color: rgba(99, 179, 237, 0.6);
  }

  /* ── Partial tire-size autocomplete suggestions ── */
  .hero-smart-search__suggest-header {
    list-style: none;
    padding: 0.9rem 1.4rem 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .hero-smart-search__suggest-header-label {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #F5820B;
  }
  .hero-smart-search__suggest-header-label strong { color: #fff; }
  .hero-smart-search__suggest-header-sub {
    display: block;
    margin-top: 0.15rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    color: #9ca3af;
  }
  .hero-smart-search__suggest-row {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.4rem;
    cursor: pointer;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 0.12s;
  }
  .hero-smart-search__suggest-row:last-child { border-bottom: none; }
  .hero-smart-search__suggest-row:hover,
  .hero-smart-search__suggest-row[aria-selected="true"] {
    background: rgba(245, 130, 11, 0.06);
  }
  .hero-smart-search__suggest-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .hero-smart-search__suggest-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    flex: 1;
    min-width: 0;
  }
  .hero-smart-search__suggest-size {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
  }
  .hero-smart-search__suggest-hint {
    font-family: 'Outfit', sans-serif;
    font-size: 0.88rem;
    color: #71717a;
  }

  .hero-smart-search__trim-prompt {
    padding: 0.8rem 1.4rem;
    font-size: 1.2rem;
    font-family: 'Outfit', sans-serif;
    color: #F5820B;
    border-top: 1px solid rgba(245, 130, 11, 0.2);
    background: rgba(245, 130, 11, 0.06);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-smart-search__trim-prompt::before {
    content: '↑';
    font-size: 1rem;
    opacity: 0.8;
  }

  .hero-smart-search__trim-prompt--shake {
    animation: hero-trim-shake 0.4s ease;
  }

  @keyframes hero-trim-shake {
    0%, 100% { transform: translateX(0); }
    20%       { transform: translateX(-6px); }
    40%       { transform: translateX(6px); }
    60%       { transform: translateX(-4px); }
    80%       { transform: translateX(4px); }
  }

  /* ── Trim results ── */
  .hero-smart-search__trim-header {
    padding: 1.2rem 1.4rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    transition: box-shadow 0.3s, background 0.3s;
  }

  /* "Look here" attention pulse — fires when the customer clicks the red
     arrow CTA without picking a trim. Two pulses of an orange glow + warm
     background tint so the change is unmistakable. Lives ~1.4s then fades. */
  .hero-smart-search__trim-header--attention {
    animation: hero-trim-header-pulse 1.4s cubic-bezier(0.4, 0, 0.6, 1);
  }

  @keyframes hero-trim-header-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(245, 130, 11, 0.0);  background: transparent; }
    15%  { box-shadow: 0 0 0 6px rgba(245, 130, 11, 0.45); background: rgba(245, 130, 11, 0.10); }
    30%  { box-shadow: 0 0 0 0 rgba(245, 130, 11, 0.0);  background: rgba(245, 130, 11, 0.06); }
    50%  { box-shadow: 0 0 0 6px rgba(245, 130, 11, 0.45); background: rgba(245, 130, 11, 0.10); }
    70%  { box-shadow: 0 0 0 0 rgba(245, 130, 11, 0.0);  background: rgba(245, 130, 11, 0.04); }
    100% { box-shadow: 0 0 0 0 rgba(245, 130, 11, 0.0);  background: transparent; }
  }

  .hero-smart-search__trim-vehicle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
  }

  .hero-smart-search__trim-label {
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
  }

  /* Inline cue rendered inside the trim-header on missed-CTA — sits right
     under the "Choose your trim" label so the customer's eyes land on it
     immediately after the click, instead of hunting through a scrolled list. */
  .hero-smart-search__trim-cue {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: #F5820B;
  }

  .hero-smart-search__trim-cue-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: rgba(245, 130, 11, 0.15);
    color: #F5820B;
    font-size: 0.95rem;
    line-height: 1;
    animation: hero-trim-cue-bounce 1s ease-in-out infinite;
  }

  @keyframes hero-trim-cue-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(2px); }
  }

  .hero-smart-search__trim-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.4rem;
    cursor: pointer;
    transition: background 0.15s;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .hero-smart-search__trim-row:last-child {
    border-bottom: none;
  }

  .hero-smart-search__trim-row:hover,
  .hero-smart-search__trim-row[aria-selected="true"] {
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-smart-search__trim-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 500;
    color: #e5e7eb;
  }

  .hero-smart-search__trim-size {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #F5820B;
    letter-spacing: 0.02em;
  }

  .hero-smart-search__intent-badge {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 500;
    color: #F5820B;
    background: rgba(245, 130, 11, 0.1);
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  .hero-smart-search__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
  }

  .hero-smart-search__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    background: transparent;
    font-family: 'Outfit', sans-serif;
  }

  .hero-smart-search__btn svg {
    width: 14px;
    height: 14px;
  }

  .hero-smart-search__btn:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .hero-smart-search__btn--phone-icon {
    padding: 0.45rem 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.2);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .hero-smart-search__btn--phone-icon:hover {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.5);
    color: #22c55e;
    transform: scale(1.08);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.2);
  }

  @media screen and (max-width: 749px) {
    .hero-smart-search {
      padding: 0 1.6rem 4rem;
      min-height: 80vh;
    }

    .hero-smart-search__heading {
      font-size: 2.8rem;
    }

    .hero-smart-search__subtitle {
      font-size: 1.3rem;
      margin-bottom: 2rem;
    }

    .hero-smart-search__actions {
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0.6rem;
    }

    .hero-smart-search__btn {
      padding: 0.6rem 1.2rem;
      font-size: 1rem;
    }
  }

  @media screen and (max-width: 480px) {
    .hero-smart-search {
      padding: 0 1.2rem 3rem;
      min-height: 80vh;
    }
    .hero-smart-search__heading {
      font-size: clamp(2.2rem, 7vw, 2.8rem);
      flex-direction: column;
      gap: 0;
    }
    .hero-smart-search__subtitle {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
    }
    .hero-smart-search__search-wrapper {
      max-width: 100%;
    }
    .hero-smart-search__input {
      padding: 1.2rem 1.4rem;
      font-size: 1.6rem;
    }
    .hero-smart-search__typewriter {
      left: 1.4rem;
      font-size: 1.4rem;
    }
