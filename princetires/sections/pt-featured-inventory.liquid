{%- liquid
  assign setting = section.settings.collection
  assign source = collections[setting]
  assign limit = section.settings.product_limit | default: 12
  assign has_products = false
  if source != blank and source.products.size > 0
    assign has_products = true
  endif
-%}

<div class="pti" data-pti>
  <div class="pti__container">

    <div class="pti__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pti__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pti__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="pti__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="pti__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      <div class="pti__marquee" data-pti-marquee>
        <div class="pti__track" data-pti-track>
          {%- comment -%} Render the products twice for a seamless infinite loop {%- endcomment -%}
          {%- for loop_pass in (1..2) -%}
            {%- for product in source.products limit: limit -%}
              {%- liquid
                assign tire_size = product.metafields.custom.tire_size | default: ''
                assign clean_title = product.title
                if tire_size != blank
                  assign clean_title = product.title | remove: tire_size | strip | remove_first: ' '
                endif
                assign season_tag = ''
                assign season_color = '#6b7280'
                comment
                  Canonical source: custom.seasonality metafield (set by import +
                  admin). Tags are noisy — many imported products carry BOTH
                  "all-weather-rated" AND a stray "Summer" tag from the supplier
                  feed, and the old tag loop let the last match overwrite the
                  first (e.g. BFG KO3 ended up labelled "Summer"). Use the
                  metafield first; only fall back to tags when blank.
                endcomment
                assign m_season = product.metafields.custom.seasonality | default: ''
                if m_season != blank
                  assign season_tag = m_season
                endif
                if season_tag == blank
                  for tag in product.tags
                    assign tag_down = tag | downcase
                    if tag_down contains 'winter'
                      assign season_tag = 'Winter'
                    elsif tag_down contains 'all-weather' or tag_down contains 'all weather'
                      assign season_tag = 'All-Weather'
                    elsif tag_down contains 'all-season' or tag_down contains 'all season'
                      assign season_tag = 'All-Season'
                    elsif tag_down contains 'summer'
                      assign season_tag = 'Summer'
                    endif
                  endfor
                endif
                case season_tag
                  when 'Winter'
                    assign season_color = '#2563eb'
                  when 'All-Weather'
                    assign season_color = '#F5820B'
                  when 'All-Season'
                    assign season_color = '#16a34a'
                  when 'Summer'
                    assign season_color = '#eab308'
                  when 'All-Terrain'
                    assign season_color = '#92400e'
                  when 'Performance'
                    assign season_color = '#7c3aed'
                endcase
              -%}
              <a
                class="pti__card{% unless product.available %} pti__card--unavailable{% endunless %}"
                href="{{ product.url }}"
                aria-label="{{ product.title | escape }}"
                {% if loop_pass == 2 %}aria-hidden="true" tabindex="-1"{% endif %}
              >
                <div class="pti__card-img">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: class: 'pti__img', loading: 'lazy', widths: '200,300,400', sizes: '(max-width: 768px) 65vw, 240px', alt: product.title }}
                  {%- else -%}
                    <div class="pti__card-ph" aria-hidden="true">
                      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="50" cy="50" r="45"/>
                        <circle cx="50" cy="50" r="22"/>
                      </svg>
                    </div>
                  {%- endif -%}
                  {%- if season_tag != blank -%}
                    <span class="pti__card-season" style="--season:{{ season_color }}">{{ season_tag }}</span>
                  {%- endif -%}
                </div>
                <div class="pti__card-body">
                  <span class="pti__card-brand">{{ product.vendor | escape }}</span>
                  <h3 class="pti__card-title">{{ clean_title | escape }}</h3>
                  {%- if tire_size != blank -%}
                    <span class="pti__card-size">{{ tire_size }}</span>
                  {%- endif -%}
                  <div class="pti__card-foot">
                    {%- if product.available -%}
                      <span class="pti__card-price">
                        {%- if product.compare_at_price > product.price -%}
                          <s class="pti__card-was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                        {%- endif -%}
                        {{ product.price | money_without_trailing_zeros }}
                      </span>
                    {%- else -%}
                      <span class="pti__card-oos">Out of stock</span>
                    {%- endif -%}
                    <span class="pti__card-view">View
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="pti__cta-wrap">
          <a href="{{ section.settings.cta_link | default: '/collections/tires' }}" class="pti__cta">
            {{ section.settings.cta_label }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="pti__empty">
        <p>No featured products yet. Add products to the <strong>{{ source.title | default: section.settings.collection }}</strong> collection in Shopify admin to populate this carousel.</p>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .pti {
    background: #fff;
    padding: 6rem 0 5rem;
    overflow: hidden;
  }
  .pti__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 6rem;
  }
  .pti__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }
  .pti__eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: #dc2626;
    letter-spacing: 0.02em;
  }
  .pti__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 3rem;
    font-weight: 600;
    color: #111;
    margin: 0;
    line-height: 1.1;
  }
  .pti__accent {
    color: #dc2626;
    margin-left: 0.4rem;
  }
  .pti__subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #6b7280;
    margin: 0.4rem 0 0;
    max-width: 56ch;
  }

  /* ── Marquee — desktop: auto-scroll, mobile: native horizontal scroll ── */
  .pti__marquee {
    position: relative;
    overflow: hidden;
    /* Fade the left+right edges so cards seem to come from / leave to nowhere */
    mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
  }
  .pti__track {
    display: flex;
    gap: 1.6rem;
    width: max-content;
    animation: pti-scroll var(--pti-duration, 60s) linear infinite;
    will-change: transform;
  }
  .pti:hover .pti__track,
  .pti:focus-within .pti__track {
    animation-play-state: paused;
  }
  @keyframes pti-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Card ── */
  .pti__card {
    flex: 0 0 240px;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .pti__card:hover {
    transform: translateY(-3px);
    border-color: #dc2626;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,0.18);
  }
  .pti__card--unavailable { opacity: 0.65; }

  .pti__card-img {
    position: relative;
    background: #f9fafb;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .pti__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
  }
  .pti__card-ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d1d5db;
  }
  .pti__card-ph svg { width: 60%; height: 60%; }

  .pti__card-season {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--season, #6b7280);
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    line-height: 1;
  }

  .pti__card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .pti__card-brand {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pti__card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #111;
    margin: 0;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pti__card-size {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    color: #4b5563;
    font-weight: 500;
  }
  .pti__card-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .pti__card-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #111;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pti__card-was {
    font-size: 0.9rem;
    color: #9ca3af;
    font-weight: 500;
  }
  .pti__card-oos {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    color: #9ca3af;
    font-weight: 600;
  }
  .pti__card-view {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #dc2626;
  }

  .pti__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.4rem;
  }
  .pti__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #111;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.9rem 1.6rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.18s;
  }
  .pti__cta:hover { background: #dc2626; }

  .pti__empty {
    padding: 2rem;
    background: #f9fafb;
    border: 1px dashed #d1d5db;
    border-radius: 10px;
    color: #6b7280;
    font-size: 1.05rem;
  }

  /* ── Mobile: replace marquee with native horizontal scroll (no animation,
        users control via swipe). Cards keep size, scroll-snap to each one. ── */
  @media (max-width: 768px) {
    .pti { padding: 4rem 0 3.5rem; }
    .pti__container { padding: 0 1.6rem; }
    .pti__heading { font-size: 2rem; }
    .pti__marquee {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .pti__marquee::-webkit-scrollbar { display: none; }
    .pti__track {
      animation: none;
      gap: 1rem;
      padding: 0 0.4rem 0.4rem;
    }
    .pti__card {
      flex: 0 0 75vw;
      max-width: 280px;
      scroll-snap-align: start;
    }
  }

  /* ── Reduced motion: no auto-scroll; let users swipe ── */
  @media (prefers-reduced-motion: reduce) {
    .pti__track { animation: none; }
    .pti__marquee {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured inventory",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In stock now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (red)",
      "default": "Tires"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A curated selection of what we have in stock right now — real prices, real inventory."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection",
      "info": "Pick the collection of products to feature. Recommend a curated collection of 10–15 items mixed across seasons (winter, all-weather, all-season, performance)."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12,
      "info": "Will render this many cards in the carousel (max 24)."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop all tires"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Leave empty to fall back to /collections/tires."
    }
  ],
  "presets": [
    {
      "name": "Featured inventory"
    }
  ]
}
{% endschema %}
