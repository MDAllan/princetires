{%- liquid
  # Tabbed mode if section has 'tab' blocks; legacy single-collection mode otherwise.
  # Legacy mode is kept so the "Trending This Week" instance (and any other
  # un-migrated instances) keep working unchanged.
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign use_tabs = false
  if tab_blocks.size > 0
    assign use_tabs = true
  endif

  # Count visible (non-empty) panels so we know whether to render the tabs row
  # (don't render tabs UI for a single visible panel — it'd be a single button).
  assign visible_count = 0
  if use_tabs
    for tab in tab_blocks
      if tab.settings.collection != blank and tab.settings.collection.products.size > 0
        assign visible_count = visible_count | plus: 1
      endif
    endfor
  else
    if section.settings.collection != blank and section.settings.collection.products.size > 0
      assign visible_count = 1
    endif
  endif
-%}

<div class="pti" data-pti>
  <div class="pti__container">

    <div class="pti__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pti__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pti__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="pti__accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="pti__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if visible_count > 0 -%}

      {%- comment -%} ─── Tabs row (only when 2+ visible panels) ─── {%- endcomment -%}
      {%- if use_tabs and visible_count > 1 -%}
        <div class="pti__tabs" role="tablist">
          {%- assign idx = 0 -%}
          {%- for tab in tab_blocks -%}
            {%- if tab.settings.collection != blank and tab.settings.collection.products.size > 0 -%}
              <button
                class="pti__tab{% if idx == 0 %} is-active{% endif %}"
                role="tab"
                data-pti-tab="{{ idx }}"
                aria-selected="{% if idx == 0 %}true{% else %}false{% endif %}"
                {{ tab.shopify_attributes }}
              >{{ tab.settings.label | default: tab.settings.collection.title }}</button>
              {%- assign idx = idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        ─── Panels ───
        Performance optimization: only the FIRST (active) panel renders into
        the live DOM. Non-active panels' content goes inside a <template> tag,
        which the browser parses (so it's in the HTML and Google can index the
        ItemList JSON-LD), but does NOT add to the rendered DOM until JS
        clones it on first tab activation. Cuts the rendered DOM by ~60%
        (2 of 3 tabs deferred). Lighthouse Performance benefits accordingly.
      {%- endcomment -%}
      {%- if use_tabs -%}
        {%- assign idx = 0 -%}
        {%- for tab in tab_blocks -%}
          {%- if tab.settings.collection != blank and tab.settings.collection.products.size > 0 -%}
            {%- assign panel_limit = tab.settings.product_limit | default: 12 -%}
            {%- if idx == 0 -%}
              {%- comment -%} Active tab — render normally (visible) {%- endcomment -%}
              {%- render 'pti-panel',
                  source: tab.settings.collection,
                  limit: panel_limit,
                  panel_index: idx,
                  hidden: false -%}
            {%- else -%}
              {%- comment -%}
                Non-active tab — empty placeholder div + <template> with the
                full panel markup inside. JS will clone the template content
                into the placeholder on first tab click.
              {%- endcomment -%}
              <div class="pti__panel pti__panel--deferred" data-pti-panel="{{ idx }}" data-pti-defer="1" hidden></div>
              <template data-pti-tab-template="{{ idx }}">
                {%- render 'pti-panel',
                    source: tab.settings.collection,
                    limit: panel_limit,
                    panel_index: idx,
                    hidden: false -%}
              </template>
            {%- endif -%}
            {%- assign idx = idx | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign legacy_limit = section.settings.product_limit | default: 12 -%}
        {%- render 'pti-panel',
            source: section.settings.collection,
            limit: legacy_limit,
            panel_index: 0,
            hidden: false -%}
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="pti__cta-wrap">
          <a href="{{ section.settings.cta_link | default: '/collections/tires' }}" class="pti__cta">
            {{ section.settings.cta_label }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="pti__empty">
        <p>No products to show yet. Add tabs (and pick a collection for each) in the theme editor, or use the section's single-collection setting for a non-tabbed view.</p>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  // Tab switching — show/hide panels via [hidden]; aria + active class on tabs.
  // Each section is scoped independently so multiple pti sections on a page
  // (Featured + Trending) don't interfere.
  //
  // Deferred-panel inflate: non-active tabs are rendered as empty placeholder
  // <div data-pti-defer="1"> divs with the actual panel markup sitting in a
  // sibling <template data-pti-tab-template="N">. On first activation, the
  // template content is cloned into the placeholder. This cuts initial
  // rendered DOM by ~60% (2 of 3 tabs deferred) without losing SEO crawl —
  // the markup is still in the HTML for Google to see.
  (function () {
    function inflateDeferredPanel(section, panelIndex) {
      var placeholder = section.querySelector('[data-pti-panel="' + panelIndex + '"]');
      if (!placeholder || !placeholder.hasAttribute('data-pti-defer')) return;
      var template = section.querySelector('[data-pti-tab-template="' + panelIndex + '"]');
      if (!template || !template.content) return;
      // Clone the rendered panel out of the template and replace the empty placeholder
      var inflated = template.content.firstElementChild ? template.content.firstElementChild.cloneNode(true) : null;
      if (!inflated) return;
      // Preserve the placeholder's hidden + index state on the inflated node
      inflated.dataset.ptiPanel = panelIndex;
      placeholder.replaceWith(inflated);
      // Drop the template — we won't need it again, and it shouldn't sit in the DOM forever
      template.remove();
    }

    document.querySelectorAll('[data-pti]').forEach(function (section) {
      var tabs = section.querySelectorAll('[data-pti-tab]');
      if (tabs.length < 2) return;
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.dataset.ptiTab;
          // Inflate first (so the panel actually exists before we try to show it)
          inflateDeferredPanel(section, id);
          // Re-query panels — the inflate just replaced one of them with a fresh node
          var panels = section.querySelectorAll('[data-pti-panel]');
          tabs.forEach(function (t) {
            var active = t.dataset.ptiTab === id;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.hidden = p.dataset.ptiPanel !== id;
          });
        });
      });
    });
  }());
</script>

{% stylesheet %}
  .pti {
    background: #fcfcfa;
    padding: 6rem 0 5rem;
    overflow: hidden;
  }
  .pti__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 6rem;
  }
  .pti__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .pti__eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: #dc2626;
    letter-spacing: 0.02em;
  }
  .pti__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 3rem;
    font-weight: 600;
    color: #111;
    margin: 0;
    line-height: 1.1;
  }
  .pti__accent {
    color: #dc2626;
    margin-left: 0.4rem;
  }
  .pti__subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #6b7280;
    margin: 0.4rem 0 0;
    max-width: 56ch;
  }

  /* ── Tabs row ── */
  .pti__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.4rem;
    margin: 0 0 2.4rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 0;
  }
  .pti__tab {
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #6b7280;
    padding: 0.7rem 1.1rem;
    border-radius: 6px 6px 0 0;
    position: relative;
    transition: color 0.18s ease, background 0.18s ease;
    letter-spacing: 0.02em;
  }
  .pti__tab:hover {
    color: #111;
    background: rgba(220, 38, 38, 0.04);
  }
  .pti__tab.is-active {
    color: #111;
  }
  .pti__tab.is-active::after {
    content: '';
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: -1px;
    height: 2.5px;
    background: #dc2626;
    border-radius: 2px 2px 0 0;
  }
  .pti__tab:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }
  .pti__panel[hidden] { display: none; }

  /* ── Marquee — desktop: auto-scroll, mobile: native horizontal scroll ── */
  .pti__marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 4%, #000 96%, transparent 100%);
  }
  .pti__track {
    display: flex;
    gap: 1.6rem;
    width: max-content;
    animation: pti-scroll var(--pti-duration, 60s) linear infinite;
    will-change: transform;
  }
  .pti:hover .pti__track,
  .pti:focus-within .pti__track {
    animation-play-state: paused;
  }
  @keyframes pti-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Card ── */
  .pti__card {
    flex: 0 0 240px;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .pti__card:hover {
    transform: translateY(-3px);
    border-color: #dc2626;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,0.18);
  }
  .pti__card--unavailable { opacity: 0.65; }

  .pti__card-img {
    position: relative;
    background: #f9fafb;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .pti__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
  }
  .pti__card-ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d1d5db;
  }
  .pti__card-ph svg { width: 60%; height: 60%; }

  .pti__card-season {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--season, #6b7280);
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    line-height: 1;
  }

  .pti__card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .pti__card-brand {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .pti__card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #111;
    margin: 0;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pti__card-size {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    color: #4b5563;
    font-weight: 500;
  }
  .pti__card-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .pti__card-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #111;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pti__card-was {
    font-size: 0.9rem;
    color: #9ca3af;
    font-weight: 500;
  }
  .pti__card-oos {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    color: #9ca3af;
    font-weight: 600;
  }
  .pti__card-view {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #dc2626;
  }

  .pti__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.4rem;
  }
  .pti__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #111;
    color: #fff;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.9rem 1.6rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.18s;
  }
  .pti__cta:hover { background: #dc2626; }

  .pti__empty {
    padding: 2rem;
    background: #f9fafb;
    border: 1px dashed #d1d5db;
    border-radius: 10px;
    color: #6b7280;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .pti { padding: 4rem 0 3.5rem; }
    .pti__container { padding: 0 1.6rem; }
    .pti__heading { font-size: 2rem; }
    .pti__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.2rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-bottom: 1.6rem;
    }
    .pti__tabs::-webkit-scrollbar { display: none; }
    .pti__tab { font-size: 0.95rem; padding: 0.6rem 0.9rem; white-space: nowrap; flex-shrink: 0; }
    .pti__marquee {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .pti__marquee::-webkit-scrollbar { display: none; }
    .pti__track {
      animation: none;
      gap: 1rem;
      padding: 0 0.4rem 0.4rem;
    }
    .pti__card {
      flex: 0 0 75vw;
      max-width: 280px;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pti__track { animation: none; }
    .pti__marquee {
      overflow-x: auto;
      scrollbar-width: thin;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured inventory",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In stock now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (red)",
      "default": "Tires"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A curated selection of what we have in stock right now — real prices, real inventory."
    },
    {
      "type": "header",
      "content": "Single-collection mode (legacy / no tabs)"
    },
    {
      "type": "paragraph",
      "content": "If you don't add any Tab blocks below, the section falls back to a single carousel using this collection. If you add tabs, this setting is ignored."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products (legacy mode)",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop all tires"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Leave empty to fall back to /collections/tires."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "info": "Short label shown on the tab pill (e.g. \"Featured\", \"Winter\", \"Trailer\").",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Source collection",
          "info": "Pick the collection of products this tab should show. Tabs whose collection is empty are auto-hidden."
        },
        {
          "type": "range",
          "id": "product_limit",
          "label": "Max products",
          "min": 4,
          "max": 24,
          "step": 1,
          "default": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured inventory"
    }
  ]
}
{% endschema %}
