<header class="pt-header" data-pt-header data-cb="2026-05-19-4">
  <div class="pt-header__container">

    {%- comment -%}
      Logo — left/center. Two parallel variants: desktop + mobile.
      Each variant has its own SVG / image / wordmark in priority order.
      Mobile variant only renders if at least one mobile-specific field
      is set; otherwise the desktop variant shows on both.
    {%- endcomment -%}
    {%- assign wordmark_text = section.settings.wordmark_text | default: shop.name -%}
    {%- assign has_mobile_logo = false -%}
    {%- if section.settings.mobile_logo_svg != blank
       or section.settings.mobile_logo != blank
       or section.settings.mobile_wordmark_text != blank -%}
      {%- assign has_mobile_logo = true -%}
    {%- endif -%}
    {%- if has_mobile_logo -%}
      {%- assign mobile_wordmark = section.settings.mobile_wordmark_text | default: wordmark_text -%}
    {%- endif -%}

    <a href="{{ routes.root_url }}" class="pt-header__logo" aria-label="{{ shop.name }}">
      <!-- Desktop variant -->
      <span class="pt-header__logo-variant pt-header__logo-variant--desktop">
        {%- if section.settings.logo_svg != blank -%}
          <span class="pt-header__logo-svg">{{ section.settings.logo_svg }}</span>
        {%- elsif section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: height: 88 | image_tag: class: "pt-header__logo-img" }}
        {%- else -%}
          <span class="pt-header__logo-wordmark">{{ wordmark_text }}</span>
        {%- endif -%}
      </span>

      {%- if has_mobile_logo -%}
        <!-- Mobile variant (only rendered when at least one mobile field is set) -->
        <span class="pt-header__logo-variant pt-header__logo-variant--mobile">
          {%- if section.settings.mobile_logo_svg != blank -%}
            <span class="pt-header__logo-svg">{{ section.settings.mobile_logo_svg }}</span>
          {%- elsif section.settings.mobile_logo != blank -%}
            {{ section.settings.mobile_logo | image_url: height: 72 | image_tag: class: "pt-header__logo-img" }}
          {%- else -%}
            <span class="pt-header__logo-wordmark">{{ mobile_wordmark }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>

    {%- comment -%} Nav links — center {%- endcomment -%}
    <nav class="pt-header__nav" aria-label="{{ 'sections.pt_header.navigation' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="pt-header__link"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
    </nav>

    {%- comment -%} Icons — right {%- endcomment -%}
    <div class="pt-header__icons">
        <!-- Search trigger — desktop only (hidden on mobile via CSS) -->
        <button
          type="button"
          class="pt-header__icon pt-header__search-btn"
          aria-label="{{ 'sections.pt_header.search' | t }}"
          aria-expanded="false"
          aria-controls="pt-header-search-overlay"
          data-pt-search-trigger
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>

        {%- if customer -%}
          {%- if customer.tags contains 'wholesale' -%}
            <a href="/pages/wholesale-portal" class="pt-header__icon pt-header__garage-link" aria-label="My portal">
              <span class="pt-header__garage-label">My portal</span>
            </a>
          {%- else -%}
            <a href="/pages/garage" class="pt-header__icon pt-header__garage-link" aria-label="{{ 'sections.pt_header.garage' | t }}" data-garage-customer-id="{{ customer.id }}">
              <span class="pt-header__garage-label">{{ 'sections.pt_header.my_garage' | t }}</span>
              <span class="pt-header__garage-count" data-garage-count hidden>0</span>
            </a>
          {%- endif -%}
        {%- else -%}
          <a href="{{ routes.account_login_url }}&return_to=/pages/garage" class="pt-header__icon pt-header__icon--stack" aria-label="{{ 'sections.pt_header.account' | t }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="pt-header__icon-label">Sign in</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="pt-header__icon pt-header__icon--stack pt-header__cart" aria-label="{{ 'sections.pt_header.cart' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="pt-header__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="pt-header__icon-label">Cart</span>
        </a>
    </div>

    {%- comment -%} Mobile hamburger {%- endcomment -%}
    <button class="pt-header__menu-btn" aria-label="{{ 'sections.pt_header.menu' | t }}" data-pt-menu-toggle aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    {%- comment -%}
      Mobile right cluster — search + cart wrapped together so they appear as one
      right-aligned unit. This prevents justify-content: space-between from
      centering the search icon under the absolute logo.
    {%- endcomment -%}
    <div class="pt-header__mobile-right">
      <button
        type="button"
        class="pt-header__icon pt-header__search-btn pt-header__search-btn-mobile"
        aria-label="{{ 'sections.pt_header.search' | t }}"
        aria-expanded="false"
        aria-controls="pt-header-search-overlay"
        data-pt-search-trigger
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <a href="{{ routes.cart_url }}" class="pt-header__icon pt-header__cart pt-header__cart-mobile" aria-label="{{ 'sections.pt_header.cart' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="pt-header__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- comment -%}
    Search overlay modal — lives inside <header> so pt-header-search-enhance.liquid
    finds it via headerEl.querySelector('form[action*="/search"]').
    Toggled via hidden attribute by the inline JS below.
  {%- endcomment -%}
  <div
    id="pt-header-search-overlay"
    class="pt-header__search-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.pt_header.search' | t }}"
    hidden
  >
    <div class="pt-header__search-panel" role="search">
      <form action="/search" method="get" class="pt-header__search-form" id="header-search-form">
        <input type="hidden" name="type" value="product,article,page">
        <label for="pt-header-search-input" class="visually-hidden">
          {{ 'sections.pt_header.search' | t }}
        </label>
        <svg class="pt-header__search-panel-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="pt-header-search-input"
          type="search"
          name="q"
          class="pt-header__search-panel-input"
          placeholder="{{ 'sections.pt_header.search_placeholder' | t }}"
          aria-label="{{ 'sections.pt_header.search_placeholder' | t }}"
          autocomplete="off"
          enterkeyhint="search"
        >
        <button type="submit" class="pt-header__search-panel-submit" aria-label="{{ 'sections.pt_header.search_submit' | t | default: 'Search' }}">
          {{ 'sections.pt_header.search_submit' | t | default: 'Search' }}
        </button>
      </form>
      <button type="button" class="pt-header__search-close" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}" data-pt-search-close>&times;</button>
    </div>
  </div>

  {%- comment -%} Mobile drawer {%- endcomment -%}
  <div class="pt-header__mobile-menu" data-pt-mobile-menu>
    <nav class="pt-header__mobile-nav">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_link' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="pt-header__mobile-link">{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if customer -%}
        {%- if customer.tags contains 'wholesale' -%}
          <a href="/pages/wholesale-portal" class="pt-header__mobile-link pt-header__mobile-garage">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><path d="M12 12v4"/><path d="M8 12h8"/></svg>
            My portal
          </a>
        {%- else -%}
          <a href="/pages/garage" class="pt-header__mobile-link pt-header__mobile-garage">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
            {{ 'sections.pt_header.my_garage' | t }}
          </a>
        {%- endif -%}
      {%- else -%}
        <a href="{{ routes.account_login_url }}&return_to=/pages/garage" class="pt-header__mobile-link">{{ 'customer.login_page.sign_in' | t }}</a>
      {%- endif -%}
    </nav>
  </div>
</header>

<script>
  /* ── Mobile menu toggle ── */
  (function() {
    var toggle = document.querySelector('[data-pt-menu-toggle]');
    var menu   = document.querySelector('[data-pt-mobile-menu]');
    if (toggle && menu) {
      toggle.addEventListener('click', function() {
        var isOpen = menu.classList.toggle('pt-header__mobile-menu--open');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
    }
  })();

  /* ── Search overlay open / close ── */
  (function () {
    var triggers = document.querySelectorAll('[data-pt-search-trigger]');
    var overlay  = document.getElementById('pt-header-search-overlay');
    if (!triggers.length || !overlay) return;
    var input    = overlay.querySelector('#pt-header-search-input');
    var closeBtn = overlay.querySelector('[data-pt-search-close]');

    /* Keep the suggest dropdown inside the *visible* viewport on mobile —
       i.e. the rectangle above the on-screen keyboard. We expose the visual
       viewport's height as a CSS var so the dropdown's max-height shrinks
       when the keyboard opens, instead of being clipped under it. */
    function updateVisualViewportVar() {
      if (!window.visualViewport) return;
      var vh = window.visualViewport.height;
      document.documentElement.style.setProperty('--pt-visual-vh', vh + 'px');
    }
    var vvAttached = false;
    function attachVisualViewport() {
      if (vvAttached || !window.visualViewport) return;
      window.visualViewport.addEventListener('resize', updateVisualViewportVar);
      window.visualViewport.addEventListener('scroll', updateVisualViewportVar);
      vvAttached = true;
    }

    function open() {
      overlay.hidden = false;
      triggers.forEach(function (t) { t.setAttribute('aria-expanded', 'true'); });
      attachVisualViewport();
      updateVisualViewportVar();
      setTimeout(function () {
        if (input) input.focus();
        // After the keyboard animates in (~300ms), re-read the visual
        // viewport so the dropdown's max-height is correct.
        setTimeout(updateVisualViewportVar, 380);
      }, 30);
    }
    function close() {
      overlay.hidden = true;
      triggers.forEach(function (t) { t.setAttribute('aria-expanded', 'false'); });
      var first = triggers[0];
      if (first) first.focus();
    }

    triggers.forEach(function (t) { t.addEventListener('click', open); });
    if (closeBtn) closeBtn.addEventListener('click', close);

    /* Close on click outside the panel */
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });

    /* Close on Escape */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
  })();
</script>

{% stylesheet %}
  /* ═══════════════════════════════════════════
     PT-HEADER — Single-row, logo left
     Palette: OLED black · red #dc2626 · white
  ═══════════════════════════════════════════ */
  .pt-header {
    background: #000;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid #1a1a1a;
    transition: background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /*
    Body padding-top:
    Desktop (>768px): 72px main row
    Mobile (≤768px): 60px — single row, no inline search bar
  */
  body { padding-top: 72px; }
  @media (max-width: 768px) { body { padding-top: 60px; } }

  /* ── Scrolled state — morph to centered pill on desktop ── */
  .pt-header.is-scrolled {
    background: transparent;
    border-bottom-color: transparent;
    padding: 12px 16px 0;
  }

  /* ── Main flex row ── */
  .pt-header__container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 2rem;
    height: 72px;
    display: flex;
    align-items: center;
    gap: 2rem;
    transition: max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-radius 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pt-header.is-scrolled .pt-header__container {
    max-width: 920px;
    height: 60px;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    box-shadow: 0 10px 36px -8px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    padding: 0 24px;
  }

  /* ── Logo — left ── */
  .pt-header__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .pt-header__logo-img {
    height: 44px;
    width: auto;
    display: block;
  }
  .pt-header__logo-svg {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .pt-header__logo-svg > svg {
    height: 44px;
    width: auto;
    display: block;
  }
  /* Variant visibility — defaults: show desktop on all viewports */
  .pt-header__logo-variant--desktop { display: inline-flex; align-items: center; }
  .pt-header__logo-variant--mobile  { display: none; }
  /* When a mobile variant exists, hide desktop ≤768px and show mobile */
  @media (max-width: 768px) {
    .pt-header__logo:has(.pt-header__logo-variant--mobile) .pt-header__logo-variant--desktop { display: none; }
    .pt-header__logo-variant--mobile { display: inline-flex; align-items: center; }
  }

  /* Wordmark fallback — shop name styled */
  .pt-header__logo-wordmark {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.65rem;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
    display: inline-block;
  }
  .pt-header__logo:hover .pt-header__logo-wordmark { color: #fff; }

  /* Legacy "P" mark — kept for backward compat in case anyone re-enables it */
  .pt-header__logo-mark {
    width: 40px;
    height: 40px;
    background: #dc2626;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pt-header__logo-mark span {
    color: #fff;
    font-weight: 800;
    font-size: 18px;
    line-height: 1;
  }

  /* ── Nav links — grow to fill, center content ── */
  .pt-header__nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .pt-header__link {
    position: relative;
    color: #e4e4e7;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    transition: color 0.18s, background 0.18s;
    white-space: nowrap;
  }
  .pt-header__link::after {
    content: "";
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 0.35rem;
    height: 2px;
    background: #dc2626;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }
  .pt-header__link:hover {
    color: #fff;
    background: rgba(255,255,255,0.08);
  }
  .pt-header__link:hover::after,
  .pt-header__link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .pt-header__link[aria-current="page"] {
    color: #fff;
  }
  .pt-header__link:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  /* ── Icons — right ── */
  .pt-header__icons {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pt-header__icon {
    color: #a1a1aa;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    transition: color 0.18s, background 0.18s;
    position: relative;
  }
  .pt-header__icon:hover {
    color: #fff;
    background: rgba(255,255,255,0.08);
  }

  /* Stacked icons (icon + small label) on desktop */
  .pt-header__icon--stack {
    flex-direction: column;
    gap: 2px;
    width: auto;
    min-width: 52px;
    height: auto;
    padding: 6px 10px 4px;
  }
  .pt-header__icon-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* Phone-number tooltip on hover */
  .pt-header__phone { position: relative; }
  .pt-header__phone-tip {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    background: #0a0a0a;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 50;
  }
  .pt-header__phone-tip::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: #0a0a0a;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .pt-header__phone:hover .pt-header__phone-tip,
  .pt-header__phone:focus-visible .pt-header__phone-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (hover: none) {
    .pt-header__phone-tip { display: none; }
  }

  /* Cart badge */
  .pt-header__cart-count {
    position: absolute;
    top: 4px;
    right: 4px;
    background: #dc2626;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 99px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
  }

  /* Garage / Portal pill */
  .pt-header__garage-link {
    width: auto;
    padding: 0 14px;
    gap: 7px;
    color: #dc2626;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.25);
  }
  .pt-header__garage-link:hover {
    color: #fff;
    background: #dc2626;
    border-color: #dc2626;
  }
  .pt-header__garage-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .pt-header__garage-count {
    background: #dc2626;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 99px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
  }

  /* ── Search trigger button — desktop ── */
  .pt-header__search-btn {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    padding: 0;
    flex-shrink: 0;
    transition: opacity 0.18s;
  }
  .pt-header__search-btn:hover {
    opacity: 0.7;
    background: none;
  }
  .pt-header__search-btn:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  /* Desktop: show in .pt-header__icons; hide mobile variant */
  .pt-header__search-btn-mobile { display: none; }

  /* ── Hamburger — hidden on desktop ── */
  .pt-header__menu-btn {
    display: none;
    background: none;
    border: none;
    color: #a1a1aa;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex-shrink: 0;
    transition: background 0.18s, color 0.18s;
  }
  .pt-header__menu-btn:hover {
    background: rgba(255,255,255,0.08);
    color: #fff;
  }

  /* ── Mobile drawer ── */
  .pt-header__mobile-menu {
    display: none;
    border-top: 1px solid #1a1a1a;
    padding: 1.25rem 1.5rem 1.5rem;
    background: #000;
  }
  .pt-header__mobile-menu--open {
    display: block;
  }
  .pt-header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pt-header__mobile-link {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 1.15rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    transition: color 0.18s, background 0.18s;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
  }
  .pt-header__mobile-link:hover {
    color: #fff;
    background: rgba(255,255,255,0.06);
  }
  .pt-header__mobile-garage {
    color: #dc2626;
    font-weight: 700;
    background: rgba(220, 38, 38, 0.08);
  }
  .pt-header__mobile-garage:hover {
    color: #fff;
    background: #dc2626;
  }

  /* ══════════════════════════
     MOBILE  (≤ 768px)
  ══════════════════════════ */
  @media (max-width: 768px) {
    /* Mobile top row: menu (left) | logo (center, absolute) | search+cart (right) */
    .pt-header__container {
      position: relative;
      padding: 0 0.75rem;
      height: 60px;
      gap: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .pt-header__nav { display: none; }
    .pt-header__icons { display: none; }

    .pt-header__menu-btn {
      display: flex;
      order: 0;
      width: 44px;
      height: 44px;
    }

    /* Logo absolutely centered — hamburger on left, search + cart on right, logo in the middle */
    .pt-header__logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      flex: none;
      width: auto;
      pointer-events: auto;
    }
    .pt-header__logo-img {
      height: 36px;
      max-width: 50vw;
      object-fit: contain;
    }
    .pt-header__logo-svg > svg { height: 32px; max-width: 50vw; }
    .pt-header__logo-wordmark { font-size: 1.35rem; max-width: 60vw; overflow: hidden; text-overflow: ellipsis; }

    /*
      Mobile right cluster — single flex wrapper for search + cart.
      Sits on the right as one unit (order: 2) so justify-content: space-between
      keeps it flush right, never centered under the absolute logo.
    */
    .pt-header__mobile-right {
      display: flex;
      align-items: center;
      gap: 0;
      order: 2;
      flex-shrink: 0;
    }

    .pt-header__search-btn-mobile {
      display: inline-flex;
      width: 36px;
      height: 36px;
      color: #fff;
      background: none;
      border: none;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      padding: 0;
      flex-shrink: 0;
      transition: opacity 0.18s;
    }
    .pt-header__search-btn-mobile:hover { opacity: 0.7; }
    .pt-header__search-btn-mobile:focus-visible {
      outline: 2px solid #dc2626;
      outline-offset: 2px;
    }

    .pt-header__cart-mobile {
      display: flex;
      width: 44px;
      height: 44px;
    }

    /* Mobile keeps full-width on scroll — pill is desktop-only */
    .pt-header.is-scrolled { padding: 0; }
    .pt-header.is-scrolled .pt-header__container {
      max-width: none;
      border-radius: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.92);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
      height: 60px;
    }
  }

  /* Hide mobile right cluster (search + cart) on desktop */
  .pt-header__mobile-right {
    display: none;
  }
  /* .pt-header__cart-mobile inside the wrapper — hide on desktop too */
  .pt-header__cart-mobile {
    display: none;
  }
  @media (max-width: 768px) {
    /* wrapper shown on mobile — children inherit */
    .pt-header__mobile-right {
      display: flex;
    }
    .pt-header__cart-mobile {
      display: flex;
      width: 40px;
      height: 40px;
    }
  }

  /* ══════════════════════════════════════════
     SEARCH OVERLAY MODAL
  ══════════════════════════════════════════ */
  .pt-header__search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* Cap the overlay's effective height to the *visible* viewport — the
       portion above the on-screen keyboard on mobile. Falls back to 100vh
       on browsers without the visualViewport API. The JS in this section
       updates --pt-visual-vh on visualViewport resize/scroll. */
    height: var(--pt-visual-vh, 100vh);
    background: rgba(0, 0, 0, 0.92);
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    opacity: 1;
    transition: opacity 0.18s, transform 0.18s;
  }
  .pt-header__search-overlay[hidden] {
    display: none;
  }

  .pt-header__search-panel {
    max-width: 720px;
    width: 100%;
    margin: 80px auto 0;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
  }

  .pt-header__search-form {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 2px solid rgba(255,255,255,0.2);
    padding-bottom: 0.5rem;
    transition: border-color 0.18s;
  }
  .pt-header__search-form:focus-within {
    border-bottom-color: #dc2626;
  }

  .pt-header__search-panel-icon {
    color: #71717a;
    flex-shrink: 0;
  }

  .pt-header__search-panel-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: 'Barlow', 'Barlow Condensed', sans-serif;
    font-size: 1.125rem;
    font-weight: 400;
    padding: 0.4rem 0;
    min-width: 0;
    -webkit-appearance: none;
  }
  .pt-header__search-panel-input::placeholder {
    color: #52525b;
  }
  .pt-header__search-panel-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .pt-header__search-panel-submit {
    background: #dc2626;
    color: #fff;
    border: none;
    cursor: pointer;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    flex-shrink: 0;
    transition: background 0.18s;
  }
  .pt-header__search-panel-submit:hover {
    background: #b91c1c;
  }
  .pt-header__search-panel-submit:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  .pt-header__search-close {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex-shrink: 0;
    transition: opacity 0.18s;
    padding: 0;
  }
  .pt-header__search-close:hover {
    opacity: 0.7;
  }
  .pt-header__search-close:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  /* Mobile overlay — full screen, smaller padding. The panel sits a
     comfortable distance from the top (not flush) so the page still
     feels rooted; the overlay's height is capped to the visible viewport
     by --pt-visual-vh, which leaves room below for suggestions when
     the keyboard is open. */
  @media (max-width: 768px) {
    .pt-header__search-panel {
      margin-top: 24px;
      padding: 1rem;
      flex-wrap: wrap;
    }
    .pt-header__search-panel-input {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-header__link,
    .pt-header__icon,
    .pt-header__garage-link { transition: none; }
    .pt-header__search-overlay { transition: none; }
  }

  /* Visually hidden utility (for the sr-only label) */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─────────────────────────────────────────────────────────────────
     Predictive-search dropdown (rendered by pt-header-search-enhance)
     Lives inside .pt-header__search-overlay as a sibling of the panel.
     ───────────────────────────────────────────────────────────────── */
  .pt-search-suggest {
    max-width: 720px;
    width: calc(100% - 3rem);
    margin: 0.4rem auto 0;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    overflow: hidden;
    max-height: 70vh;
    overflow-y: auto;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.55);
  }
  .pt-search-suggest[hidden] { display: none; }

  .pt-search-suggest__section {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .pt-search-suggest__section:first-child { border-top: none; }

  .pt-search-suggest__section-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #71717a;
    padding: 0.75rem 1.1rem 0.4rem;
  }

  .pt-search-suggest__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1.1rem;
    color: #e5e7eb;
    text-decoration: none;
    font-family: 'Barlow', sans-serif;
    font-size: 0.95rem;
    transition: background 0.12s;
  }
  .pt-search-suggest__item:hover,
  .pt-search-suggest__item--selected {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .pt-search-suggest__item-thumb {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    object-fit: cover;
    background: #0f0f0f;
    flex-shrink: 0;
  }
  .pt-search-suggest__item-thumb--placeholder {
    display: block;
    background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
  }

  .pt-search-suggest__item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    color: #a1a1aa;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .pt-search-suggest__item-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .pt-search-suggest__item-title {
    color: #e5e7eb;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }
  .pt-search-suggest__item--selected .pt-search-suggest__item-title { color: #fff; }

  .pt-search-suggest__item-meta {
    color: #71717a;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pt-search-suggest__item-price {
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .pt-search-suggest__item-arrow {
    color: #dc2626;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Quick-action row (the "⚡ Show 225/65R17 tires" pinned suggestion) */
  .pt-search-suggest__quick {
    background: rgba(220, 38, 38, 0.08);
    border-bottom: 1px solid rgba(220, 38, 38, 0.25);
  }
  .pt-search-suggest__item--quick {
    color: #fff;
    font-weight: 600;
  }
  .pt-search-suggest__item--quick:hover,
  .pt-search-suggest__item--quick.pt-search-suggest__item--selected {
    background: rgba(220, 38, 38, 0.15);
  }
  .pt-search-suggest__quick-bolt {
    color: #f59e0b;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .pt-search-suggest__empty {
    padding: 1.2rem 1.1rem;
    color: #a1a1aa;
    font-family: 'Barlow', sans-serif;
    font-size: 0.95rem;
  }
  .pt-search-suggest__empty em { color: #e5e7eb; font-style: italic; }

  .pt-search-suggest__view-all {
    display: block;
    padding: 0.85rem 1.1rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #dc2626;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.12s;
  }
  .pt-search-suggest__view-all:hover {
    background: rgba(220, 38, 38, 0.08);
  }

  /* ── Empty-state: recent + popular chips (focus, input cleared) ── */
  .pt-search-suggest__empty-state {
    padding: 0.5rem 0.5rem 0.7rem;
  }
  .pt-search-suggest__empty-section + .pt-search-suggest__empty-section {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .pt-search-suggest__empty-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.6rem 0.4rem;
  }
  .pt-search-suggest__empty-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #71717a;
  }
  .pt-search-suggest__empty-clear {
    background: none;
    border: none;
    color: #a1a1aa;
    font-family: 'Barlow', sans-serif;
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    transition: color 0.12s, background 0.12s;
  }
  .pt-search-suggest__empty-clear:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .pt-search-suggest__empty-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 0.6rem;
  }
  .pt-search-suggest__empty-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Barlow', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 4px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition: background 0.12s, border-color 0.12s;
    line-height: 1.5;
  }
  .pt-search-suggest__empty-chip:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .pt-search-suggest__empty-chip--recent {
    color: #dc2626;
    background: rgba(220, 38, 38, 0.08);
    border-color: rgba(220, 38, 38, 0.25);
  }
  .pt-search-suggest__empty-chip--recent:hover {
    background: rgba(220, 38, 38, 0.16);
    border-color: rgba(220, 38, 38, 0.5);
  }
  .pt-search-suggest__empty-chip-icon {
    color: #dc2626;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .pt-search-suggest {
      width: calc(100% - 2rem);
      max-height: calc(100vh - 130px);
    }
    .pt-search-suggest__item { padding: 0.65rem 0.9rem; }
    .pt-search-suggest__item-title { font-size: 0.95rem; }
  }
{% endstylesheet %}

{% javascript %}
  /* Scroll-pill effect — toggles .is-scrolled on the header past 4px */
  (function() {
    var hdr = document.querySelector('[data-pt-header]');
    if (!hdr) return;
    function syncScroll() {
      hdr.classList.toggle('is-scrolled', window.scrollY > 4);
    }
    syncScroll();
    window.addEventListener('scroll', syncScroll, { passive: true });
  })();

  /* Garage badge */
  (function() {
    var badge = document.querySelector('[data-garage-count]');
    if (!badge) return;

    function updateBadge(count) {
      if (count > 0) {
        badge.textContent = count;
        badge.hidden = false;
      } else {
        badge.hidden = true;
      }
    }

    /* Read initial count from localStorage */
    var garageLink = document.querySelector('[data-garage-customer-id]');
    var customerId = garageLink ? garageLink.dataset.garageCustomerId : null;
    if (customerId) {
      try {
        var raw = localStorage.getItem('pt-garage-' + customerId);
        var vehicles = raw ? JSON.parse(raw) : [];
        updateBadge(vehicles.length);
      } catch(e) {}
    }

    /* Subscribe to live updates */
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
      subscribe(PUB_SUB_EVENTS.garageUpdate, function(data) {
        updateBadge(data.vehicles ? data.vehicles.length : 0);
      });
    }
  })();
{% endjavascript %}

