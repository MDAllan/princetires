<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    {%- liquid
      # Legacy /collections/vendors?q=Brand URLs self-canonicalize WITH the query
      # param, so Google indexes each vendor view as its own page competing with
      # the real brand collection. Point them at /collections/<brand> when one
      # exists; otherwise self-canonical without the param + noindex. Page 2+ is
      # left alone — seo-meta.liquid already noindexes paginated views.
      assign pt_canonical = canonical_url
      assign pt_vendors_noindex = false
      if request.page_type == 'collection' and collection.handle == 'vendors'
        if collection.current_vendor != blank and current_page == 1
          assign pt_vendor_handle = collection.current_vendor | handleize
          assign pt_vendor_collection = collections[pt_vendor_handle]
          if pt_vendor_collection != blank and pt_vendor_collection.products_count > 0
            assign pt_canonical = shop.url | append: pt_vendor_collection.url
          else
            assign pt_canonical = shop.url | append: request.path
            assign pt_vendors_noindex = true
          endif
        endif
      endif
    -%}
    <link rel="canonical" href="{{ pt_canonical }}">
    {%- if pt_vendors_noindex -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {%- render 'sxo-performance' -%}

    {%- comment -%}
      Favicon — prefer the merchant-uploaded Theme Settings → Favicon; otherwise
      fall back to the brand mark on the CDN so a favicon ALWAYS renders (browser
      tab + Google SERP). 48px size is included because Google's SERP favicon
      crawler wants a square icon that's a multiple of 48px. Same source image as
      the PWA manifest fallback (manifest.json.liquid).
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      {%- assign favicon_16 = settings.favicon | image_url: width: 16, height: 16 -%}
      {%- assign favicon_32 = settings.favicon | image_url: width: 32, height: 32 -%}
      {%- assign favicon_48 = settings.favicon | image_url: width: 48, height: 48 -%}
      {%- assign favicon_180 = settings.favicon | image_url: width: 180, height: 180 -%}
      {%- assign favicon_192 = settings.favicon | image_url: width: 192, height: 192 -%}
    {%- else -%}
      {%- assign favicon_16 = 'https://cdn.shopify.com/s/files/1/0698/9542/2227/files/Untitled_design_6_0abd9b57-e83e-48ec-aca6-2a9e4a39b7fe.png?width=16&height=16&v=1780092164' -%}
      {%- assign favicon_32 = 'https://cdn.shopify.com/s/files/1/0698/9542/2227/files/Untitled_design_6_0abd9b57-e83e-48ec-aca6-2a9e4a39b7fe.png?width=32&height=32&v=1780092164' -%}
      {%- assign favicon_48 = 'https://cdn.shopify.com/s/files/1/0698/9542/2227/files/Untitled_design_6_0abd9b57-e83e-48ec-aca6-2a9e4a39b7fe.png?width=48&height=48&v=1780092164' -%}
      {%- assign favicon_180 = 'https://cdn.shopify.com/s/files/1/0698/9542/2227/files/Untitled_design_6_0abd9b57-e83e-48ec-aca6-2a9e4a39b7fe.png?width=180&height=180&v=1780092164' -%}
      {%- assign favicon_192 = 'https://cdn.shopify.com/s/files/1/0698/9542/2227/files/Untitled_design_6_0abd9b57-e83e-48ec-aca6-2a9e4a39b7fe.png?width=192&height=192&v=1780092164' -%}
    {%- endif -%}
    <link rel="shortcut icon" type="image/png" href="{{ favicon_32 }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ favicon_16 }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ favicon_32 }}">
    <link rel="icon" type="image/png" sizes="48x48" href="{{ favicon_48 }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ favicon_192 }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ favicon_180 }}">
    <meta name="apple-mobile-web-app-title" content="Prince Tires">
    <meta name="application-name" content="Prince Tires">

    <link rel="manifest" href="{{ 'manifest.json' | asset_url }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- comment -%}
      Title ladder:
      1) /pages/brand-{handle} → "{Brand} Tires in Calgary | Prince Tires"
      2) /pages/brands → "Tire & Wheel Brands in Calgary | Prince Tires"
      3) Default Shopify behaviour (page_title + shop name)
    {%- endcomment -%}
    <title>
      {%- if page.handle contains 'brand-' -%}
        {%- assign t_slug = page.handle | remove_first: 'brand-' -%}
        {%- assign t_name = t_slug | replace: '-', ' ' | capitalize -%}
        {%- if t_slug == 'bfgoodrich' -%}{%- assign t_name = 'BFGoodrich' -%}{%- endif -%}
        {%- if t_slug == 'mickey-thompson' -%}{%- assign t_name = 'Mickey Thompson' -%}{%- endif -%}
        {%- if t_slug == 'xf-off-road' -%}{%- assign t_name = 'XF Off-Road' -%}{%- endif -%}
        {%- if t_slug == 'envy' -%}{%- assign t_name = 'ENVY' -%}{%- endif -%}
        {%- if t_slug == 'rtx' -%}{%- assign t_name = 'RTX' -%}{%- endif -%}
        {{ t_name }} Tires in Calgary | {{ shop.name }}
      {%- elsif page.handle == 'brands' -%}
        Tire &amp; Wheel Brands in Calgary | {{ shop.name }}
      {%- elsif page.handle == 'about' -%}
        About Prince Tires — Calgary's Trusted Tire Shop
      {%- else -%}
        {{- page_title -}}
        {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- comment -%}
      Meta description with fallback ladder:
      1) Page-level SEO description (admin-set) — authoritative
      2) /pages/brands hub — hardcoded GEO/AEO snippet
      3) /pages/brand-{handle} — auto-generated per brand
      4) Otherwise omit (Shopify will fall back to shop description)
    {%- endcomment -%}
    {%- if page_description != blank -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- elsif page.handle == 'brands' -%}
      <meta name="description" content="Shop 26 tire and wheel brands at Prince Tires Calgary — Michelin, Bridgestone, BFGoodrich, Toyo, plus value picks like Radar and Tesche. Same-day installation, price-match guarantee, 4.9 stars from 562+ Google reviews. 111 42 Ave SW Calgary.">
    {%- elsif page.handle contains 'brand-' -%}
      {%- assign brand_slug = page.handle | remove_first: 'brand-' -%}
      {%- assign brand_name = brand_slug | replace: '-', ' ' | capitalize -%}
      {%- if brand_slug == 'bfgoodrich' -%}{%- assign brand_name = 'BFGoodrich' -%}{%- endif -%}
      {%- if brand_slug == 'mickey-thompson' -%}{%- assign brand_name = 'Mickey Thompson' -%}{%- endif -%}
      {%- if brand_slug == 'xf-off-road' -%}{%- assign brand_name = 'XF Off-Road' -%}{%- endif -%}
      {%- if brand_slug == 'envy' -%}{%- assign brand_name = 'ENVY' -%}{%- endif -%}
      {%- if brand_slug == 'rtx' -%}{%- assign brand_name = 'RTX' -%}{%- endif -%}
      <meta name="description" content="Shop {{ brand_name }} tires in Calgary at Prince Tires. In-stock all-season, winter, and all-terrain options. Same-day installation in most cases, price-match guarantee, 4.9 stars from 562+ Google reviews. 111 42 Ave SW Calgary.">
    {%- elsif page.handle == 'about' -%}
      <meta name="description" content="Family-owned Calgary tire shop at 111 42 Ave SW. Same-day installation, price-match guarantee, 4.9 stars from 562+ Google reviews. Serving NE/NW/SE/SW Calgary plus Airdrie, Cochrane, Okotoks, and Chestermere with 26 tire and wheel brands in stock.">
    {%- endif -%}

    {%- comment -%}
      Utility / internal pages — noindex so they don't compete in SERP with
      the real landing pages. These handles have no SEO purpose (account flows,
      garage, data-deletion compliance, intermediate quote/search results).
    {%- endcomment -%}
    {%- if request.page_type == 'page' -%}
      {%- assign _no_index_handles = 'garage,sign-in,wheel-quote,find-tires,data-deletion,rapid-search-results' | split: ',' -%}
      {%- if _no_index_handles contains page.handle -%}
        <meta name="robots" content="noindex, follow">
      {%- endif -%}
    {%- endif -%}

    {% render 'meta-tags' %}
    {%- render 'seo-meta' -%}
    {%- render 'aeo-meta' -%}
    {%- render 'geo-meta' -%}
    {%- render 'schema-local-business' -%}
    {%- render 'pt-locations' -%}
    {%- comment -%}
      pt-booking-core is a parse-time dependency ONLY on /pages/book
      (pt-booking-page.liquid calls PTBookingCore.loadLocations() in a top-level
      inline script). The booking modals resolve it lazily on open, so it can
      defer everywhere else — defer scripts finish before DOMContentLoaded.
    {%- endcomment -%}
    {%- if template.name == 'page' and template.suffix == 'booking' -%}
      <script src="{{ 'pt-booking-core.js' | asset_url }}"></script>
    {%- else -%}
      <script src="{{ 'pt-booking-core.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- render 'pt-analytics' -%}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pt-tire-parse.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 62.5%; height: 100%; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
      body {
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-weight: 300;
        font-size: 1.6rem;
        line-height: 1.6;
        color: #1a1a1a;
        background: #ffffff;
        min-height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
      }
      img, svg { display: block; max-width: 100%; }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; cursor: pointer; }
      input, textarea, select { font-family: inherit; }
      ul, ol { list-style: none; }
      h1, h2, h3, h4, h5, h6 { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; line-height: 1.1; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
      .skip-to-content-link { z-index: 9999; }
      .content-for-layout { flex: 1; }
    </style>

    {{ 'component-pt-button.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Shopify font preloads removed — using Google Fonts (Inter + Rubik) {%- endcomment -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}">
    {%- if settings.gtm_container_id != blank -%}
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif -%}
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- render 'breadcrumbs' -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'pt-booking-modal' -%}
    {%- render 'pt-service-booking-modal' -%}
    {%- section 'pt-sticky-book-bar' -%}
    {%- render 'pt-header-search-enhance' -%}
    {%- render 'pt-pwa-install' -%}
    {%- comment -%} AI chat widget: desktop floating bubble (hidden on product via CSS) + mobile opens from the bottom tab bar's Chat tab. {%- endcomment -%}
    {%- render 'pt-chat-widget', page_product: product -%}
  </body>
</html>
