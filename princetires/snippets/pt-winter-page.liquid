  };
  function init(){
    var hero=document.querySelector('.cgs__hero'); if(!hero||document.querySelector('.ptw-facts')) return;
    var sub=hero.querySelector('.cgs__subtitle');
    if(sub){var a=sub.querySelector('a');sub.textContent='3PMSF-rated winter tires in every common Calgary size — Michelin, Bridgestone, Toyo and more. Same-day install where stock allows, plus price match with local independent shops. ';if(a)sub.appendChild(a);}
    var f=document.createElement('div');f.className='ptw-facts';
    f.innerHTML=[[I.tag,'From $82 / tire','In-stock winter tires'],[I.therm,'Below 7°C','Time to switch (mid-Oct)'],[I.flake,'3PMSF symbol','The only real winter rating'],[I.four,'All 4 wheels','Never just 2']].map(function(x){return '<div class="ptw-fact">'+x[0]+'<div><b>'+x[1]+'</b><span>'+x[2]+'</span></div></div>';}).join('');
    hero.parentNode.insertBefore(f,hero.nextSibling);
    var pr=document.querySelector('.cgs__pricing'), t=pr&&pr.querySelector('table');
    if(t){
      var cards=document.createElement('div');cards.className='ptw-cards';
      [].forEach.call(t.tBodies[0].rows,function(r){
        var size=r.cells[0].textContent.trim(), lo=r.cells[1].textContent.trim(), hi=r.cells[2].textContent.trim();
        var lp=(lo.match(/\$[\d.,]+/)||[''])[0], lb=(lo.match(/\((.*)\)/)||['',''])[1];
        var hp=(hi.match(/\$[\d.,]+/)||[''])[0], hb=(hi.match(/\((.*)\)/)||['',''])[1];
