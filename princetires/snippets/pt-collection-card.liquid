{% doc %}
  One product card for the tires collection grid. Renders the image,
  season/sale/bestseller badges, compare checkbox, brand + title,
  size, stars, spec strip, price, rebate, and the Book Install / Add
  to Cart buttons.

  All product-derived helpers (season_tag, card_title, set_price, …)
  are computed inside the snippet so the section's for-loop only has
  to pass the product object.

  @param {product} product - The Shopify product to render.
  @param {boolean} [is_clearance] - When true (clearance collection), shows a CLEARANCE badge + % off instead of the generic Sale badge.

  @example
  {% render 'pt-collection-card', product: product %}
{% enddoc %}

              {%- liquid
                # Canonical (and ONLY) source for the season pill: custom.seasonality metafield.
                # No tag/type fallback — set the metafield on the product if you want a pill.
                # Backfilled + case-normalized 2026-05-24 (97% coverage).
                assign season_tag = product.metafields.custom.seasonality | default: '' | strip
                assign season_color = '#6b7280'
                case season_tag
                  when 'Winter'
                    assign season_color = '#2563eb'
                  when 'All-Weather'
                    assign season_color = '#F5820B'
                  when 'All-Season'
                    assign season_color = '#16a34a'
                  when 'Summer'
                    assign season_color = '#eab308'
                  when 'All-Terrain'
                    assign season_color = '#92400e'
                  when 'Performance'
                    assign season_color = '#7c3aed'
                endcase
              -%}
              {%- liquid
                assign tire_size_display = product.metafields.custom.tire_size | default: ''
                assign card_title = product.title
                if tire_size_display != blank
                  assign card_title = product.title | remove: tire_size_display | strip | remove_first: ' '
                endif
                assign set_price = product.price | times: 4
                comment
                  Low-stock cap for the displayed set price (mirrors the PDP). The
                  full 4x set_price above still feeds the compare drawer so tires
                  compare apples-to-apples; the card UI shows what's buyable now.
                endcomment
                assign card_max_qty = 0
                if product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_policy == 'deny' and product.selected_or_first_available_variant.inventory_quantity > 0
                  assign card_max_qty = product.selected_or_first_available_variant.inventory_quantity
                endif
                assign card_set_count = 4
                if card_max_qty > 0 and card_max_qty < 4
                  assign card_set_count = card_max_qty
                endif
                assign card_set_price = product.price | times: card_set_count
                assign card_rating = product.metafields.reviews.rating.value
                assign card_rating_count = product.metafields.reviews.rating_count | default: 0
                assign mileage_warranty = product.metafields.custom.mileage_warranty | default: ''
                assign card_speed = product.metafields.custom.speed_rating | default: ''
                assign card_load = product.metafields.custom.load_index | default: ''
                assign rebate_text = product.metafields.custom.rebate_text | default: ''
                # Clearance treatment (clearance collection only — flag passed by the grid section).
                assign is_clearance = is_clearance | default: false
                assign is_clearance_sale = false
                assign pct_off = 0
                if product.compare_at_price > product.price
                  if is_clearance
                    assign is_clearance_sale = true
                  endif
                  if product.compare_at_price > 0
                    assign pct_off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                  endif
                endif
                assign is_bestseller = false
                for tag in product.tags
                  assign tag_down = tag | downcase
                  if tag_down == 'best-seller' or tag_down == 'best seller' or tag_down == 'bestseller'
                    assign is_bestseller = true
                  endif
                endfor
              -%}
              <a href="{{ product.url }}" class="ptg__card{% unless product.available %} ptg__card--unavailable{% endunless %}" data-vendor="{{ product.vendor | handleize }}" data-season="{{ season_tag | handleize }}" data-type="{{ product.type | downcase }}" data-price="{{ product.price | money_without_currency | strip_html | strip }}" data-tire-size="{{ tire_size_display }}" data-product-title="{{ card_title | escape }}"{% unless product.available %} aria-label="Out of stock — {{ card_title | escape }}"{% endunless %}>
                <div class="ptg__card-img">
                  {%- if product.featured_image -%}
                    {%- if forloop.index <= 4 -%}
                      {{ product.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: class: 'ptg__img', loading: 'eager', fetchpriority: 'high', widths: '200,300,400,600', sizes: '(max-width: 768px) 50vw, (max-width: 989px) 30vw, 25vw', alt: product.title }}
                    {%- else -%}
                      {{ product.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: class: 'ptg__img', loading: 'lazy', widths: '200,300,400,600', sizes: '(max-width: 768px) 50vw, (max-width: 989px) 30vw, 25vw', alt: product.title }}
                    {%- endif -%}
                  {%- else -%}
                    {%- comment -%} Branded placeholder when product has no photo {%- endcomment -%}
                    <div class="ptg__card-ph" aria-hidden="true">
                      <svg class="ptg__card-ph-tire" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="50" cy="50" r="45"/>
                        <circle cx="50" cy="50" r="39" stroke-width="5" stroke-dasharray="3.5 5"/>
                        <circle cx="50" cy="50" r="22"/>
                        <circle cx="50" cy="50" r="4.5" fill="currentColor" stroke="none"/>
                        <g stroke-width="2.4" stroke-linecap="round">
                          <line x1="50" y1="50" x2="50" y2="31"/>
                          <line x1="50" y1="50" x2="68" y2="43.5"/>
                          <line x1="50" y1="50" x2="61" y2="65"/>
                          <line x1="50" y1="50" x2="39" y2="65"/>
                          <line x1="50" y1="50" x2="32" y2="43.5"/>
                        </g>
                      </svg>
                      {%- if product.vendor != blank -%}
                        <span class="ptg__card-ph-brand">{{ product.vendor | escape }}</span>
                      {%- endif -%}
                      {%- if tire_size_display != blank -%}
                        <span class="ptg__card-ph-size">{{ tire_size_display }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- unless product.available -%}
                    <span class="ptg__card-oos">Out of stock</span>
                  {%- endunless -%}
                  {%- if is_clearance_sale -%}
                    <span class="ptg__card-clearance">Clearance</span>
                  {%- elsif product.compare_at_price > product.price -%}
                    <span class="ptg__card-sale">Sale</span>
                  {%- endif -%}
                  {%- if section.settings.show_bestseller and is_bestseller -%}
                    <span class="ptg__card-badge-best">Best Seller</span>
                  {%- endif -%}
                  {%- if section.settings.enable_compare -%}
                    <label class="ptg__card-compare" onclick="event.stopPropagation();">
                      <input type="checkbox" class="ptg__compare-check" data-compare-id="{{ product.id }}" data-compare-title="{{ card_title | escape }}" data-compare-vendor="{{ product.vendor | escape }}" data-compare-price="{{ product.price | money_without_currency | strip_html | strip }}" data-compare-set="{{ set_price | money_without_currency | strip_html | strip }}" data-compare-img="{{ product.featured_image | image_url: width: 200 }}" data-compare-size="{{ tire_size_display }}" data-compare-url="{{ product.url }}" data-compare-season="{{ season_tag }}" data-compare-type="{{ product.type | escape }}" data-compare-speed="{{ card_speed }}" data-compare-load="{{ card_load }}" data-compare-warranty="{{ mileage_warranty }}">
                      <span class="ptg__compare-label">Compare</span>
                    </label>
                  {%- endif -%}
                  <div class="ptg__card-img-bottom">
                    {%- liquid
                      assign display_rating = 0
                      if card_rating != blank
                        assign display_rating = card_rating | round: 1
                      elsif product.metafields.custom.tyre_rating.value and product.metafields.custom.tyre_rating.value > 0
                        assign tr = product.metafields.custom.tyre_rating.value | times: 1.0
                        assign display_rating = tr | divided_by: 20.0 | round: 1
                      else
                        assign v = product.vendor | downcase
                        if v == 'michelin' or v == 'continental' or v == 'pirelli' or v == 'goodyear'
                          assign display_rating = 4.7
                        elsif v == 'bridgestone' or v == 'hankook' or v == 'yokohama' or v == 'falken' or v == 'nokian'
                          assign display_rating = 4.5
                        elsif v == 'kumho' or v == 'toyo' or v == 'cooper' or v == 'firestone' or v == 'general' or v == 'dunlop' or v == 'bfgoodrich' or v == 'nexen'
                          assign display_rating = 4.3
                        elsif v == 'gt radial' or v == 'maxxis' or v == 'rotalla'
                          assign display_rating = 4.0
                        elsif v == 'radar' or v == 'haida' or v == 'starfire' or v == 'austone'
                          assign display_rating = 3.7
                        else
                          assign display_rating = 3.9
                        endif
                      endif
                    -%}
                    {%- if display_rating >= 4.0 -%}
                    <span class="ptg__card-stars">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="#F5820B"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {{ display_rating }}
                      {%- if card_rating != blank and card_rating_count > 0 -%}
                        <span class="ptg__card-review-count">({{ card_rating_count }})</span>
                      {%- endif -%}
                    </span>
                    {%- else -%}
                    <span class="ptg__card-stars ptg__card-stars--na">N/A</span>
                    {%- endif -%}
                    {%- if season_tag != blank -%}
                      <span class="ptg__card-season" style="background: {{ season_color }}">{{ season_tag }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <div class="ptg__card-body">
                  <div class="ptg__card-size-row">
                    {%- if tire_size_display != blank -%}
                      <span class="ptg__card-size">{{ tire_size_display }}</span>
                    {%- endif -%}
                    <span class="ptg__card-vendor ptg__card-vendor--{{ product.vendor | handleize }}">{{ product.vendor | escape }}</span>
                  </div>
                  {%- if section.settings.show_fitment -%}
                    <span class="ptg__card-fitment" data-card-fitment hidden>
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                      Fits your vehicle
                    </span>
                  {%- endif -%}
                  <h3 class="ptg__card-title">{{ card_title | escape }}</h3>
                  <span class="ptg__card-type-tag">{{ product.type | escape }}</span>
                  {%- if section.settings.show_warranty and mileage_warranty != blank -%}
                    <span class="ptg__card-warranty">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {{ mileage_warranty }} warranty
                    </span>
                  {%- endif -%}
                  {%- if section.settings.show_specs -%}
                    {%- if card_speed != blank or card_load != blank -%}
                      <div class="ptg__card-specs">
                        {%- if card_load != blank -%}<span class="ptg__card-spec">{{ card_load }}LI</span>{%- endif -%}
                        {%- if card_speed != blank -%}<span class="ptg__card-spec">{{ card_speed }}</span>{%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if section.settings.show_rebate and rebate_text != blank -%}
                    <span class="ptg__card-rebate">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                      {{ rebate_text }}
                    </span>
                  {%- endif -%}
                  {%- comment -%} Phase 5A · trade-price toggle. data-pt-price spans get their text overwritten with retail × multiplier from /apps/api/wholesale/pricing; the trade badge below renders the wholesale cost. {%- endcomment -%}
                  {%- assign card_variant_id = product.selected_or_first_available_variant.id -%}
                  <div class="ptg__card-price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="ptg__price-sale" data-pt-price data-pt-variant-id="{{ card_variant_id }}" data-pt-multiplier="1">${{ product.price | money_without_currency }}</span>
                      <span class="ptg__price-was">${{ product.compare_at_price | money_without_currency }}</span>
                    {%- else -%}
                      <span data-pt-price data-pt-variant-id="{{ card_variant_id }}" data-pt-multiplier="1">${{ product.price | money_without_currency }}</span>
                    {%- endif -%}
                    <span class="ptg__price-per">/tire</span>
                    {%- if section.settings.show_set_price -%}
                      <span class="ptg__price-set"><span data-pt-price data-pt-variant-id="{{ card_variant_id }}" data-pt-multiplier="{{ card_set_count }}">${{ card_set_price | money_without_currency }}</span> for {{ card_set_count }}</span>
                    {%- endif -%}
                  </div>
                  {%- if is_clearance_sale and pct_off > 0 -%}
                    <span class="ptg__price-off">{{ pct_off }}% off</span>
                  {%- endif -%}
                  {%- comment -%} Low-stock urgency on the grid (mirrors the PDP badge). Fires only for genuinely low stock (1-4 on hand) so it stays meaningful; card_max_qty is already gated on tracked + inventory_policy: deny. {%- endcomment -%}
                  {%- if product.available and card_max_qty > 0 and card_max_qty <= 4 -%}
                    <span class="ptg__card-lowstock"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>{{ 'products.product.low_stock' | t: count: card_max_qty }}</span>
                  {%- endif -%}
                  {%- if customer.b2b? or customer.tags contains 'wholesale' -%}
                    {%- comment -%} Visible only when the header toggle is ON (body.pt-trade-visible). JS fills in amount + tier + pct from the API. Gate matches the header — either Shopify's native B2B flag OR the legacy tag. {%- endcomment -%}
                    <div class="ptg__card-trade" data-pt-trade-info data-pt-variant-id="{{ card_variant_id }}">
                      <span class="ptg__card-trade-label">Your cost</span>
                      <span class="ptg__card-trade-amount" data-pt-trade-amount>—</span>
                      <span class="ptg__card-trade-pct"><span data-pt-trade-pct>—</span>% off</span>
                    </div>
                  {%- endif -%}
                  <div class="ptg__card-actions">
                    {%- liquid
                      assign grid_vtype = 'passenger'
                      assign grid_ts = product.metafields.custom.tire_size | default: '' | upcase
                      assign grid_vmeta = product.metafields.custom.vehicle_type | downcase | default: ''
                      if grid_vmeta contains 'suv' or grid_vmeta contains 'cuv'
                        assign grid_vtype = 'suv'
                      elsif grid_vmeta contains 'light truck'
                        assign grid_vtype = 'truck'
                      elsif grid_vmeta contains 'trailer'
                        assign grid_vtype = 'trailer'
                      elsif grid_vmeta contains 'van'
                        assign grid_vtype = 'van'
                      elsif grid_vmeta contains 'truck'
                        assign grid_vtype = 'truck'
                      elsif grid_ts contains 'LT'
                        assign grid_vtype = 'truck'
                      elsif grid_ts contains 'ST'
                        assign grid_vtype = 'trailer'
                      elsif grid_ts contains 'R21' or grid_ts contains 'R22' or grid_ts contains 'R23' or grid_ts contains 'R24'
                        assign grid_vtype = 'largetruck'
                      else
                        assign grid_pt = product.type | downcase
                        if grid_pt contains 'trailer'
                          assign grid_vtype = 'trailer'
                        elsif grid_pt contains 'light truck'
                          assign grid_vtype = 'truck'
                        endif
                      endif
                    -%}
                    {%- capture grid_supplier_tier -%}{% render 'pt-supplier-tier', product: product %}{%- endcapture -%}
                    <button type="button" class="ptg__card-book"
                      data-tire-name="{{ product.title | escape }}"
                      data-tire-size="{{ product.metafields.custom.tire_size | default: '' | escape }}"
                      data-vehicle-type="{{ grid_vtype }}"
                      data-tire-price="{{ product.selected_or_first_available_variant.price }}"
                      data-install-price="{{ product.metafields.custom.install_price.value | default: 30 }}"
                      data-supplier-tier="{{ grid_supplier_tier | strip }}"
                      data-product-handle="{{ product.handle }}"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      data-max-qty="{{ card_max_qty }}"
                      onclick="event.preventDefault();event.stopPropagation();if(typeof openBookingModal==='function')openBookingModal(this)">Book Install</button>
                    <button type="button" class="ptg__card-cart"
                      data-variant="{{ product.selected_or_first_available_variant.id }}"
                      data-title="{{ product.title | escape }}"
                      aria-label="Add {{ product.title | escape }} to cart">
                      <svg class="ptg__cart-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                      <svg class="ptg__cart-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="display:none"><path d="M20 6L9 17l-5-5"/></svg>
                      <svg class="ptg__cart-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="display:none"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
                    </button>
                  </div>
                </div>
              </a>
