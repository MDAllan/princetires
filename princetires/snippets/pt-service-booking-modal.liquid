{% doc %}
  3-step service booking modal for Prince Tires.
  Triggered by any element with [data-book-service] and optional [data-service-name].
  Include once in layout/theme.liquid before </body>.

  @example
  {% render 'pt-service-booking-modal' %}
{% enddoc %}

<div class="bk-overlay" id="sb-overlay" hidden>
  <div class="bk-modal" role="dialog" aria-modal="true" aria-label="Request a service">

    <div class="bk-header">
      <span class="bk-header-title">Request a service</span>
      <div class="bk-stepper" id="sb-stepper">
        <div class="bk-step" data-sb-step="1"><div class="bk-step-circle bk-step-circle--active">1</div></div>
        <div class="bk-step-line" data-sb-line="1"></div>
        <div class="bk-step" data-sb-step="2"><div class="bk-step-circle">2</div></div>
        <div class="bk-step-line" data-sb-line="2"></div>
        <div class="bk-step" data-sb-step="3"><div class="bk-step-circle">3</div></div>
      </div>
      <button class="bk-close" onclick="closeServiceModal()" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {%- comment -%} Step 1: Service → Vehicle + sub-options {%- endcomment -%}
    <div class="bk-page" id="sb-page-1">
      {%- comment -%} Required-field marks (owner, 2026-11-15): * = must answer; each step button explains what is missing (PTBookingCore.req). {%- endcomment -%}
      <p class="pt-req-note"><span class="pt-req-mark" aria-hidden="true">*</span>required</p>

      {%- comment -%} Location picker — only shown when 2+ shops are bookable (see sbRenderLocations) {%- endcomment -%}
      <div id="sb-location-section" hidden>
        <p class="bk-label">Which location?</p>
        <div class="sb-loc-grid" id="sb-location-grid"></div>
        {%- comment -%} "Also open" line, filled by JS only while the PRIMARY shop is selected. {%- endcomment -%}
        <p class="sb-loc-nudge" id="sb-loc-nudge" hidden></p>
        {%- comment -%} Filled by JS when the chosen service is offered at some shops only (road force balancing → Edmonton Trail). {%- endcomment -%}
        <p class="sb-loc-note" id="sb-location-note" hidden></p>
      </div>

      <p class="bk-label">What service do you need?<span class="pt-req-mark" aria-hidden="true">*</span></p>
      <div class="sb-service-grid" id="sb-service-grid"></div>

      {%- comment -%} Revealed after service is selected {%- endcomment -%}
      <div id="sb-details-section" hidden>

        <p class="bk-label" style="margin-top:1.1rem">Vehicle type</p>
        <div class="sb-veh-scroll">
          <div class="bk-vehicle-grid" id="sb-vehicles"></div>
        </div>

        {%- comment -%} Flat repair sub-options {%- endcomment -%}
        <div id="sb-repair-section" hidden>
          <p class="bk-label" style="margin-top:1.1rem">Repair type</p>
          <div class="sb-repair-grid" id="sb-repair-grid"></div>
        </div>

        {%- comment -%} Trailer setup (installation + trailer only) {%- endcomment -%}
        <div id="sb-looserim-section" hidden>
          <p class="bk-label" style="margin-top:1.1rem">Trailer setup</p>
          <div class="sb-repair-grid" id="sb-looserim-grid"></div>
        </div>

        {%- comment -%} Qty selector for installation & TPMS {%- endcomment -%}
        <div id="sb-qty-section" hidden>
          <p class="bk-label" id="sb-qty-label" style="margin-top:1.1rem">How many tires?</p>
          <select class="bk-qty-select" id="sb-qty-select"></select>
        </div>

        {%- comment -%}
          Old tires (Tire Installation only — the old tires come off the rims).
          REQUIRED, neither choice pre-selected; replaces the old "Tire disposal"
          checkbox. "Dispose" sets addons.disposal, so the estimate math is unchanged.
        {%- endcomment -%}
        <div id="sb-oldtires-section" hidden>
          <p class="bk-label" id="sb-oldtires-label" style="margin-top:1.1rem">What should we do with your old tires?<span class="pt-req-mark" aria-hidden="true">*</span></p>
          <div class="bk-addons" id="sb-oldtires" role="radiogroup" aria-labelledby="sb-oldtires-label" aria-required="true"></div>
          <p class="sb-field-err" id="sb-oldtires-err" role="alert" hidden>Please choose what we should do with your old tires.</p>
        </div>

        {%- comment -%} Add-ons: installation + seasonal only {%- endcomment -%}
        <div id="sb-addons-section" hidden>
          <p class="bk-label" style="margin-top:1.1rem">Add-ons</p>
          <div class="bk-addons" id="sb-addons"></div>
        </div>

        {%- comment -%} Price estimate with GST breakdown {%- endcomment -%}
        <div class="sb-price-box" id="sb-price-box" hidden>
          <div class="sb-price-row">
            <span class="sb-price-label">Subtotal</span>
            <span class="sb-price-sub" id="sb-price-sub"></span>
          </div>
          <div class="sb-price-row">
            <span class="sb-price-label">GST (5%)</span>
            <span class="sb-price-gst" id="sb-price-gst"></span>
          </div>
          <div class="sb-price-divider"></div>
          <div class="sb-price-row">
            <span class="sb-price-label sb-price-total-label">Estimated total</span>
            <span class="sb-price-amount" id="sb-price-amount"></span>
          </div>
          <p class="sb-price-note" id="sb-price-note"></p>
        </div>

      </div>

      <button class="bk-next-btn" id="sb-next-1" onclick="sbNext1()" style="margin-top:1.2rem" disabled>Pick a time &rarr;</button>
    </div>

    {%- comment -%} Step 2: Date + Time {%- endcomment -%}
    <div class="bk-page" id="sb-page-2" hidden>
      <p class="pt-req-note"><span class="pt-req-mark" aria-hidden="true">*</span>required</p>
      <div class="bk-week-nav">
        <button class="bk-week-arrow" id="sb-prev-week">&#8249;</button>
        <span class="bk-week-label" id="sb-week-label"></span>
        <button class="bk-week-arrow" id="sb-next-week">&#8250;</button>
      </div>
      <div class="bk-day-strip" id="sb-day-strip"></div>

      <p class="bk-label" id="sb-time-label">Time<span class="pt-req-mark" aria-hidden="true">*</span></p>
      <div class="bk-time-grid" id="sb-time-grid" role="group" aria-labelledby="sb-time-label"></div>
      {%- capture bw_mso -%}{% render 'pt-nap', location: 'sw', field: 'hours_mon_sat_open' %}{%- endcapture -%}{%- capture bw_msc -%}{% render 'pt-nap', location: 'sw', field: 'hours_mon_sat_close' %}{%- endcapture -%}{%- capture bw_suo -%}{% render 'pt-nap', location: 'sw', field: 'hours_sun_open' %}{%- endcapture -%}{%- capture bw_suc -%}{% render 'pt-nap', location: 'sw', field: 'hours_sun_close' %}{%- endcapture -%}{%- capture bw_cut -%}{% render 'pt-nap', location: 'sw', field: 'booking_cutoff_minutes' %}{%- endcapture -%}
      <p class="bk-hours-note">Mon–Sat {% render 'pt-book-window', open: bw_mso, close: bw_msc, cutoff: bw_cut %} · Sun {% render 'pt-book-window', open: bw_suo, close: bw_suc, cutoff: bw_cut %}</p>

      <div class="bk-nav-row">
        <button class="bk-back-btn" onclick="sbGoTo(1)">&larr; Back</button>
        <button class="bk-next-btn" id="sb-next-2" onclick="sbGoTo(3)" disabled>Your details &rarr;</button>
      </div>
    </div>

    {%- comment -%} Step 3: Contact {%- endcomment -%}
    <div class="bk-page" id="sb-page-3" hidden>
      <div class="bk-summary" id="sb-summary"></div>

      <div class="bk-form">
        <p class="pt-req-note"><span class="pt-req-mark" aria-hidden="true">*</span>required</p>
        {%- comment -%} Bot trap (security, 2026-11-13): a person never sees or fills this.
           /api/book quietly drops any booking that has it filled. Its own <form> keeps
           browser autofill and password managers from filling it with the contact fields. {%- endcomment -%}
        <form class="pt-hp" aria-hidden="true" onsubmit="return false" autocomplete="off" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
          <label for="sb-company-website">Leave this empty</label>
          <input type="text" id="sb-company-website" name="company_website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other">
        </form>
        <div class="bk-form-row">
          <div class="bk-field" id="sb-field-name">
            <label for="sb-name">Name<span class="pt-req-mark" aria-hidden="true">*</span></label>
            <input type="text" id="sb-name" placeholder="Jane Smith" autocomplete="name" maxlength="120" aria-required="true">
          </div>
          <div class="bk-field" id="sb-field-phone">
            <label for="sb-phone">Phone<span class="pt-req-mark" aria-hidden="true">*</span></label>
            <input type="tel" id="sb-phone" placeholder="(403) 555-0123" autocomplete="tel" maxlength="30" aria-required="true">
          </div>
        </div>
        <div class="bk-field" id="sb-field-email">
          <label for="sb-email">Email<span class="pt-req-mark" aria-hidden="true">*</span></label>
          <input type="email" id="sb-email" placeholder="jane@email.com" autocomplete="email" maxlength="200" aria-required="true">
        </div>
        {%- comment -%} Vehicle details — all optional; year/make/model pre-filled from the saved vehicle {%- endcomment -%}
        <div class="bk-form-row">
          <div class="bk-field" id="sb-field-vyear">
            <label for="sb-vyear">Year <span class="bk-optional">(optional)</span></label>
            <input type="text" id="sb-vyear" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="e.g. 2019" autocomplete="off">
          </div>
          <div class="bk-field" id="sb-field-vmake">
            <label for="sb-vmake">Make <span class="bk-optional">(optional)</span></label>
            <input type="text" id="sb-vmake" maxlength="40" placeholder="e.g. Toyota" autocomplete="off">
          </div>
        </div>
        <div class="bk-form-row">
          <div class="bk-field" id="sb-field-vmodel">
            <label for="sb-vmodel">Model <span class="bk-optional">(optional)</span></label>
            <input type="text" id="sb-vmodel" maxlength="60" placeholder="e.g. RAV4" autocomplete="off">
          </div>
          <div class="bk-field" id="sb-field-odo">
            <label for="sb-odo">Current mileage (km) <span class="bk-optional">(optional)</span></label>
            <input type="text" id="sb-odo" inputmode="numeric" maxlength="12" placeholder="e.g. 84,500" autocomplete="off" aria-describedby="sb-odo-hint">
            <p class="sb-field-hint" id="sb-odo-hint">Helps us prepare</p>
          </div>
        </div>
        <div class="bk-field">
          <label for="sb-notes">Notes <span class="bk-optional">(optional)</span></label>
          <textarea id="sb-notes" rows="2" placeholder="Anything we should know…"></textarea>
        </div>
      </div>

      {%- comment -%}
        Own tires (installation_on / installation_off) only: the customer confirms
        tread depth + date code before the request can be sent (manager feedback
        d342773d; owner 2026-11-03: checkbox only, no age limit). A factual check,
        not a waiver — the legal T&C checkbox is separate. Shown by sbTireAckSync();
        posted as tireConditionAck. Unticked every time the modal opens.
      {%- endcomment -%}
      <div class="sb-tire-ack" id="sb-tire-ack" hidden>
        <label class="bk-addon sb-tire-ack__row" for="sb-tire-ack-cb">
          <input type="checkbox" id="sb-tire-ack-cb" required aria-required="true" autocomplete="off" aria-describedby="sb-tire-ack-err">
          <span class="bk-addon-name">I’ve checked the tires I’m bringing: they have at least 4/32&quot; (3&nbsp;mm) of tread, and I’ve checked the date code on the sidewall (the last 4 digits of the DOT code, e.g. 2321 = week 23 of 2021). I understand Prince Tires may decline to install tires that are worn, damaged or too old.<span class="pt-req-mark" aria-hidden="true">*</span></span>
        </label>
        <p class="sb-field-err" id="sb-tire-ack-err" role="alert" hidden>Please tick the box to confirm you’ve checked the tread depth and date code on your tires.</p>
      </div>

      <div class="bk-form-error" id="sb-form-error" hidden></div>

      <div class="bk-nav-row">
        <button class="bk-back-btn" onclick="sbGoTo(2)">&larr; Back</button>
        <button class="bk-confirm-btn" id="sb-confirm-btn" onclick="sbSubmit()">Send request</button>
      </div>
    </div>

    {%- comment -%} Done {%- endcomment -%}
    <div class="bk-page" id="sb-page-done" hidden>
      <div class="bk-done-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
      </div>
      <h2 class="bk-done-title">Request sent</h2>
      <p class="bk-done-sub" id="sb-done-sub">We'll confirm by email, usually within the day — your appointment isn't final until you hear from us.</p>
      <div class="bk-done-card" id="sb-done-card"></div>
      <div class="bk-done-actions">
        <button class="bk-cal-btn" onclick="sbDownloadICS()">Add to calendar</button>
        <button class="bk-done-btn" onclick="closeServiceModal()">Done</button>
      </div>
    </div>

  </div>
</div>

<style>
/* ── Location picker ── */
#sb-location-section { margin-bottom: 1.1rem; }
.sb-loc-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: .4rem;
}
.sb-loc-chip {
  display: flex;
  flex-direction: column;
  gap: .15rem;
  padding: .7rem .85rem;
  width: 100%;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  font-family: 'Outfit', sans-serif;
  background: #fff;
  text-align: left;
  transition: border-color .15s, background .15s, color .15s;
}
.sb-loc-chip:hover { border-color: #dc2626; }
.sb-loc-chip--active { border-color: #dc2626; background: #fef2f2; }
.sb-loc-name {
  font-size: .95rem;
  font-weight: 600;
  color: #111;
}
.sb-loc-chip--active .sb-loc-name { color: #dc2626; }
.sb-loc-addr {
  font-size: .8rem;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.3;
}
/* "Also open" nudge — only while the PRIMARY shop is selected and another is bookable */
.sb-loc-nudge[hidden] { display: none !important; }
.sb-loc-nudge { margin: .5rem 0 0; font-size: .9rem; line-height: 1.45; color: #4b5563; }
.sb-loc-nudge strong { color: #111; font-weight: 600; }
.sb-loc-nudge__btn {
  background: none; border: 0; padding: 0; margin-left: .2rem;
  font: inherit; font-weight: 600; color: #dc2626; cursor: pointer;
  text-decoration: underline; text-underline-offset: 2px;
}
.sb-loc-nudge__btn:hover { color: #b91c1c; }
/* "Only at Edmonton Trail" line under the picker when the service restricts the shop */
.sb-loc-note { margin: .5rem 0 0; font-size: .85rem; line-height: 1.45; color: #4b5563; }
.sb-loc-note strong { color: #111; font-weight: 600; }
.sb-loc-note[hidden] { display: none !important; }
/* Shop badge on a service chip offered at one location only */
.sb-chip-badge { display: inline-block; margin-top: .2rem; align-self: flex-start; padding: .1rem .45rem; border-radius: 999px; background: #fef3c7; color: #92400e; font-size: .7rem; font-weight: 600; }

/* ── Service chip grid ── */
.sb-service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: .4rem;
}

/* ── Chip wrapper (positions tooltip + info btn) ── */
.sb-chip-wrap {
  position: relative;
}

/* ── Info button ── */
.sb-info-btn {
  position: absolute;
  top: .45rem;
  right: .45rem;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 1.5px solid #d1d5db;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #9ca3af;
  padding: 0;
  line-height: 1;
  transition: border-color .15s, color .15s, background .15s;
  z-index: 1;
}
.sb-info-btn:hover,
.sb-info-btn--active {
  border-color: #dc2626;
  color: #dc2626;
  background: #fef2f2;
}

/* ── Tooltip ── */
.sb-tooltip {
  display: none;
  position: absolute;
  bottom: calc(100% + 6px);
  left: 0;
  right: 0;
  background: #1f2937;
  color: #f9fafb;
  font-family: 'Outfit', sans-serif;
  font-size: .82rem;
  line-height: 1.45;
  padding: .6rem .75rem;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0,0,0,.18);
  z-index: 10;
  pointer-events: none;
}
.sb-tooltip--open {
  display: block;
  animation: sb-tip-in .15s ease-out;
}
/* Arrow */
.sb-tooltip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 1.2rem;
  border: 5px solid transparent;
  border-top-color: #1f2937;
}
@keyframes sb-tip-in {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

.sb-service-chip {
  display: flex;
  align-items: center;
  gap: .55rem;
  padding: .75rem 1.8rem .75rem .75rem;
  width: 100%;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  font-family: 'Outfit', sans-serif;
  font-size: .95rem;
  font-weight: 500;
  color: #374151;
  background: #fff;
  text-align: left;
  transition: border-color .15s, background .15s, color .15s;
  line-height: 1.25;
}

.sb-service-chip:hover { border-color: #dc2626; color: #dc2626; }

.sb-service-chip--active {
  border-color: #dc2626;
  background: #fef2f2;
  color: #dc2626;
  font-weight: 600;
}

.sb-service-chip svg { flex-shrink: 0; opacity: .65; }
.sb-service-chip--active svg { opacity: 1; }

.sb-chip-text { display: flex; flex-direction: column; gap: .1rem; }
.sb-chip-price {
  font-size: .8rem;
  font-weight: 400;
  color: #9ca3af;
}
.sb-service-chip--active .sb-chip-price { color: #dc2626; opacity: .8; }

/* ── Vehicle scroll ── */
.sb-veh-scroll {
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  margin: 0 -.1rem;
  padding: .1rem .1rem .2rem;
}
.sb-veh-scroll::-webkit-scrollbar { display: none; }

/* ── Repair type grid ── */
.sb-repair-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .4rem; }

.sb-repair-chip {
  display: flex;
  flex-direction: column;
  gap: .15rem;
  padding: .85rem 1rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  font-family: 'Outfit', sans-serif;
  background: #fff;
  text-align: left;
  transition: border-color .15s, background .15s;
}
.sb-repair-chip:hover { border-color: #dc2626; }
.sb-repair-chip--active { border-color: #dc2626; background: #fef2f2; }

.sb-repair-name {
  font-size: 1rem;
  font-weight: 600;
  color: #111;
}
.sb-repair-chip--active .sb-repair-name { color: #dc2626; }

.sb-repair-desc {
  font-size: .85rem;
  color: #9ca3af;
  font-weight: 400;
}

.sb-repair-price {
  font-size: 1rem;
  font-weight: 700;
  color: #16a34a;
  margin-top: .1rem;
}

/* ── Price estimate box ── */
.sb-price-box {
  margin-top: 1rem;
  padding: .8rem 1rem;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 8px;
}
.sb-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sb-price-label {
  font-family: 'Outfit', sans-serif;
  font-size: .9rem;
  font-weight: 500;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.sb-price-amount {
  font-family: 'Outfit', sans-serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: #16a34a;
}
.sb-price-row + .sb-price-row { margin-top: .25rem; }
.sb-price-sub, .sb-price-gst {
  font-family: 'Outfit', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  color: #374151;
}
.sb-price-divider {
  border-top: 1px solid #bbf7d0;
  margin: .5rem 0 .4rem;
}
.sb-price-total-label { color: #111827; font-weight: 600; }

.sb-price-note {
  font-family: 'Outfit', sans-serif;
  font-size: .8rem;
  color: #9ca3af;
  margin: .25rem 0 0;
}

/* ── Old-tires question (required radio pair, reuses .bk-addon rows) ── */
#sb-oldtires-section[hidden] { display: none !important; }
#sb-oldtires .bk-addon input[type="radio"] { accent-color: #dc2626; }
.sb-oldtires--error .bk-addons { border: 1.5px solid #dc2626; border-radius: 8px; padding: 0 .65rem; }
.sb-field-err { margin: .35rem 0 0; font-size: .9rem; line-height: 1.4; color: #dc2626; font-weight: 500; }
.sb-field-err[hidden] { display: none !important; }
/* ── Own-tire condition check (installation_on/off) — one .bk-addon row in a box; red edge when unticked on submit ── */
.sb-tire-ack { margin-top: 1rem; }
.sb-tire-ack[hidden] { display: none !important; }
#sb-tire-ack .sb-tire-ack__row { display: flex; cursor: pointer; color: #374151; align-items: flex-start; flex-wrap: nowrap; gap: .7rem; padding: .75rem .85rem; border: 1px solid #e5e7eb; border-radius: 8px; background: #fafafa; }
#sb-tire-ack .sb-tire-ack__row input { flex-shrink: 0; width: 19px; height: 19px; margin-top: .15rem; accent-color: #dc2626; cursor: pointer; }
#sb-tire-ack .sb-tire-ack__row .bk-addon-name { font-weight: 400; line-height: 1.45; }
#sb-tire-ack .sb-tire-ack__row.bk-addon--active { border-color: #dc2626; background: #fff; }
.sb-tire-ack--error .sb-tire-ack__row { border: 1.5px solid #dc2626 !important; background: #fef2f2 !important; }
/* Small hint under an input (mileage) */
.sb-field-hint { margin: .25rem 0 0; font-size: .85rem; line-height: 1.35; color: #9ca3af; }
.bk-field--error .sb-field-hint { color: #dc2626; }

/* ── Reveal animation ── */
#sb-details-section:not([hidden]) {
  animation: sb-fade-in .2s ease-out;
}
@keyframes sb-fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── Mobile ── */
@media (max-width: 480px) {
  .sb-loc-grid     { grid-template-columns: 1fr; }
  .sb-service-grid { grid-template-columns: 1fr; }
  .sb-repair-grid   { grid-template-columns: 1fr; }
  /* On mobile, prefer tooltip above with full width */
  .sb-tooltip { font-size: .8rem; }
}
</style>

<script>
(function () {
  var BOOKING_API = 'https://app.princetires.ca/api/book';
  var AVAILABILITY_API = 'https://app.princetires.ca/api/availability';
  var SERVICES_API = 'https://app.princetires.ca/api/services';

  var sbSt = {
    service: '',
    vehicle: 'passenger',
    savedVehicle: null,
    repairType: 'patch', // only option remaining for flat_repair
    looseRims: false,
