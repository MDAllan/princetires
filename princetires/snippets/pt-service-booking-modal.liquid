           address_full: '111 42 Ave SW, Calgary, AB T2G 0A4',
           address: '111 42 Ave SW, Calgary', phone: '(403) 452-4283' };
  }

  // Resolve the default selection: ?location=<slug> / data-location override,
  // else the is_primary bookable shop, else the first bookable shop.
  function sbDefaultLocationSlug(preferred) {
    var picked = PTBookingCore.pickLocation(sbLocBookable, preferred);
    return picked ? picked.slug : '';
  }

  // ── Services offered at some shops only ───────────────────────────────────
  // Which shops offer a catalog row ([] = every shop). The road force balancer
  // is at Edmonton Trail NE; sbApplyCatalog() overlays this from /api/services
  // (`locations`). The picker offers only the shops that satisfy the chosen
  // service and every ticked catalog add-on, and says why underneath. The
  // server refuses the others, so this is the courtesy and /api/book the fence.
  var sbServiceShops = {
    road_force_balancing: ['ne'],
    addon_road_force: ['ne']
  };
  // Catalog add-ons this modal can offer beyond TPMS / disposal, by slug. Only
  // filled from /api/services — an add-on the server does not know is dropped
  // from the booking, so it is never offered from a fallback.
  var sbAddonCatalog = {};
  var sbAddonKeys = { addon_road_force: 'roadForce' };

  function sbRestrictions() {
    var lists = [], named = [];
    var svcShops = sbSt.service && sbServiceShops[sbSt.service];
    if (svcShops && svcShops.length) {
      var svc = sbServices.find(function (s) { return s.id === sbSt.service; });
      lists.push(svcShops);
      named.push({ name: svc ? svc.name : 'This service', shops: svcShops });
    }
    Object.keys(sbAddonKeys).forEach(function (slug) {
      if (sbSt.addons[sbAddonKeys[slug]] && sbAddonCatalog[slug] && sbServiceShops[slug] && sbServiceShops[slug].length) {
        lists.push(sbServiceShops[slug]);
        named.push({ name: sbAddonCatalog[slug].name, shops: sbServiceShops[slug] });
      }
    });
    return { lists: lists, named: named };
  }
  function sbAllowedLocations() {
    return PTBookingCore.allowedLocations(sbLocBookable, sbRestrictions().lists);
  }
  // Move the selection onto an allowed shop (dropping a picked time, since
  // availability is per shop), then repaint the picker.
  function sbSyncLocation() {
    var allowed = sbAllowedLocations();
    if (allowed.length && !PTBookingCore.bySlug(allowed, sbSt.location)) {
      sbSt.location = allowed[0].slug;
      if (sbSt.date) { sbSt.time = null; var n2 = document.getElementById('sb-next-2'); if (n2) n2.disabled = true; sbRenderTimes(); }
    }
    sbRenderLocations();
  }
  function sbOnlyAt(slug) {
    var shops = sbServiceShops[slug];
    if (!shops || !shops.length) return '';
    return PTBookingCore.onlyAtLabel(shops, sbLocAll);
  }

  // ── Service icons (presentation only — not part of the catalog API) ───────
  var sbIcons = {
    installation_off: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>',
    installation_on: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>',
    balancing: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>',
    road_force_balancing: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="13" r="8"/><circle cx="12" cy="13" r="2.5"/><path d="M12 2v3M4 13H2M22 13h-2M6.3 7.3L4.9 5.9M17.7 7.3l1.4-1.4"/></svg>',
    rotation: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1 .25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>',
    flat_repair: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>',
    tpms: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="13" r="7"/><path d="M12 8V6M8 13H6M18 13h-1M9.5 10.5l-1-1M15.5 10.5l1-1"/><circle cx="12" cy="13" r="2" fill="currentColor" stroke="none"/></svg>',
    _default: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>'
  };

  function sbFmtMoney(n) {
    return '$' + (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2));
  }
  // Customer-typed text (make / model) goes into innerHTML — escape it.
  function sbEsc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // ── Vehicle details (step 3, all optional) ────────────────────────────────
  // Reads the Year / Make / Model / Mileage inputs. Year must be 4 digits when
  // given; mileage is whole km with commas / spaces / a trailing "km" stripped.
  // Blank fields are fine — yearBad / odoBad only flag something typed wrong.
  function sbReadVehicle() {
    var g = function (id) { var el = document.getElementById(id); return el ? String(el.value || '').trim() : ''; };
    var year = g('sb-vyear').replace(/\D/g, '');
    var make = g('sb-vmake');
    var model = g('sb-vmodel');
    var odoRaw = g('sb-odo').replace(/km$/i, '').replace(/[\s,]/g, '');
    var yearBad = false, odoBad = false, odo = null;
    if (year) {
      var yn = parseInt(year, 10);
      if (year.length !== 4 || yn < 1900 || yn > new Date().getFullYear() + 2) yearBad = true;
    }
    if (odoRaw) {
      // Same ceiling as the server (ODOMETER_MAX_KM = 2,000,000 in
      // booking-request-details.ts) so an extra digit is caught here, not as a 400.
      if (/^\d{1,7}$/.test(odoRaw) && +odoRaw <= 2000000) odo = parseInt(odoRaw, 10);
      else odoBad = true;
    }
    return { year: year, make: make, model: model, odometerKm: odo, yearBad: yearBad, odoBad: odoBad };
  }
  // True when the typed year/make/model still match the saved garage vehicle
  // (so its trim can ride along); a customer who typed another car gets none.
  function sbSameAsSaved(v) {
    var s = sbSt.savedVehicle;
    if (!s) return false;
    var lc = function (x) { return String(x == null ? '' : x).trim().toLowerCase(); };
    return lc(s.year) === lc(v.year) && lc(s.make) === lc(v.make) && lc(s.model) === lc(v.model);
  }
  // "2019 Toyota RAV4 XLE" (trim only when it is still the saved vehicle), or ''.
  function sbVehicleText(v) {
    var ymm = [v.year, v.make, v.model].filter(Boolean).join(' ');
    if (ymm && sbSameAsSaved(v) && sbSt.savedVehicle.trim) ymm += ' ' + sbSt.savedVehicle.trim;
    else if (ymm && window.ptPickedTrim && window.ptPickedTrim('sb-vmodel')) ymm += ' ' + window.ptPickedTrim('sb-vmodel');
    return ymm;
  }
  function sbFmtKm(n) {
    return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',') + ' km';
  }
  // "Keeping" / "Tire disposal (+$5/tire)" for the summary + done card ('' when not asked).
  function sbOldTiresText() {
    if (sbSt.service !== 'installation_off') return '';
    var fee = (sbPricing.addon_disposal && sbPricing.addon_disposal.amount) || 5;
    return sbSt.oldTires === 'keep' ? 'Keeping' : sbSt.oldTires === 'dispose' ? 'Tire disposal (+$' + fee + '/tire)' : '';
  }
  var sbWk = 0;

  // ── Services (fallback) ───────────────────────────────────────────────────
  // Used until GET /api/services lands; sbApplyCatalog() overlays the live,
  // admin-managed catalog. Shape shared with sections/pt-booking-page.liquid.
  var sbServices = [
    { id: 'installation_off', name: 'Tire Installation', priceLabel: 'from $30 / tire',
      desc: 'Mount your new (or loose) tires onto your rims, balance all wheels, reset TPMS sensors, torque to spec, and get you road-ready. For tires that are NOT yet on rims.',
      icon: sbIcons.installation_off },
    { id: 'installation_on', name: 'Seasonal Swap', priceLabel: 'from $15 / tire',
      desc: 'Swap your stored seasonal tires — already mounted on their own rims — onto your vehicle, torque to spec. Tires must be pre-mounted on rims.',
      icon: sbIcons.installation_on },
    { id: 'balancing', name: 'Wheel Balancing', priceLabel: 'from $20 / wheel',
      desc: 'We spin each wheel on a balancer, detect heavy spots, and add weights so there\'s no vibration at highway speed.',
      icon: sbIcons.balancing },
    { id: 'road_force_balancing', name: 'Road Force Balancing', priceLabel: '$35 / wheel',
      desc: 'A load roller presses against the spinning tire to find stiff spots and runout a standard balance can\'t see, then we match tire to wheel so a stubborn vibration finally goes away. Edmonton Trail NE only.',
      icon: sbIcons.road_force_balancing },
    { id: 'rotation', name: 'Tire Rotation', priceLabel: 'from $15 / tire',
      desc: 'We move your tires to different positions so they wear evenly, extending their life and keeping handling balanced.',
      icon: sbIcons.rotation },
    { id: 'flat_repair', name: 'Flat Repair', priceLabel: '$50 / tire',
      desc: 'Patch repair: we dismount the tire and apply a permanent internal patch. (We don\'t do exterior plug repairs — they\'re not safe long-term.)',
      icon: sbIcons.flat_repair },
    { id: 'tpms', name: 'TPMS Service', priceLabel: '$60 / sensor',
      desc: 'We replace or reprogram your tire pressure monitoring sensors so your dashboard warning light stays off.',
      icon: sbIcons.tpms }
  ];

  // ── Vehicle types ─────────────────────────────────────────────────────────
  var sbVehs = [
    { id: 'passenger', name: 'Sedan' },
    { id: 'suv',       name: 'SUV / CUV' },
    { id: 'truck',     name: 'Truck' },
    { id: 'van',       name: 'Van' },
    { id: 'electric',  name: 'Electric' },
    { id: 'dually',     name: 'Dually' },
    { id: 'largetruck', name: 'Large / Cube / 21"+' },
    { id: 'trailer',    name: 'Trailer' }
  ];

  // ── Pricing (fallback) ────────────────────────────────────────────────────
  // sbApplyCatalog() overlays these with live values from GET /api/services
  // (editable in the admin app). Modes:
  //   per_unit_by_vehicle — per-unit rate by vehicle × qty, with a low-profile
  //                         floor and per-vehicle flat overrides (e.g. trailer)
  //   flat_by_vehicle     — a flat price per vehicle type
  //   per_unit_flat       — a single rate × qty
  var sbPricing = {
    installation_off: { mode: 'per_unit_by_vehicle', unit: 'tire',
      byVehicle: { passenger: 30, suv: 30, van: 35, electric: 30, truck: 35, largetruck: 40, dually: 45, trailer: 30 },
      lowProfileFloor: 40, flatOverride: { trailer: 120 } },
    // Per tire since the app's db/088 (owner 2026-11-02): 4 tires cost what the
    // old flat price did ($60 car, $80 truck), 2 tires half. Trailer stays flat.
    installation_on: { mode: 'per_unit_by_vehicle', unit: 'tire',
      byVehicle: { passenger: 15, suv: 15, van: 15, electric: 15, truck: 20, largetruck: 20, dually: 15, trailer: 25 },
      flatOverride: { trailer: 100 } },
    balancing: { mode: 'per_unit_flat', unit: 'wheel', amount: 20 },
    road_force_balancing: { mode: 'per_unit_flat', unit: 'wheel', amount: 35 },
    // Per tire since 2026-11-13 (owner): $15 car / SUV / van / EV, $20 truck /
    // large truck / dually. Always the whole set — 4, or 6 on a dually — so
    // the qty box stays hidden for rotation (the app enforces the set too).
    rotation: { mode: 'per_unit_by_vehicle', unit: 'tire',
      byVehicle: { passenger: 15, suv: 15, van: 15, electric: 15, truck: 20, largetruck: 20, dually: 20, trailer: 15 } },
    flat_repair: { mode: 'per_unit_flat', unit: 'tire', amount: 50 },
    tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 60 },
    addon_tpms: { mode: 'per_unit_flat', unit: 'sensor', amount: 60 },
    addon_disposal: { mode: 'per_unit_flat', unit: 'tire', amount: 5 },
    addon_road_force: { mode: 'per_unit_flat', unit: 'tire', amount: 20 }
  };

  // Generic, catalog-driven price calc. Reads sbPricing (overlaid by
  // sbApplyCatalog from GET /api/services). Verified to produce the same
  // numbers as the prior hardcoded per-service logic. Add-ons (TPMS / disposal)
  // apply to installation_off / installation_on only.
  function sbCalcPrice() {
    var s = sbSt.service, v = sbSt.vehicle, q = sbQty();
    var p = sbPricing[s];
    if (!p) return null;
    var subtotal = 0, parts = [];
    var unit = p.unit || 'unit';

    if (p.mode === 'per_unit_by_vehicle') {
      if (p.flatOverride && p.flatOverride[v] != null) {
        subtotal = p.flatOverride[v];
        parts.push('flat $' + subtotal + ' (' + v + ')');
      } else {
        var base = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 30;
        var per = (sbSt.addons.lowProfile && p.lowProfileFloor)
          ? Math.max(base, p.lowProfileFloor) : base;
        subtotal = per * q;
        parts.push('$' + per + '/' + unit + ' × ' + q);
        if (sbSt.addons.lowProfile && per > base) parts.push('low-profile');
      }
    } else if (p.mode === 'flat_by_vehicle') {
      subtotal = (p.byVehicle && p.byVehicle[v] != null) ? p.byVehicle[v] : 0;
      parts.push('flat $' + subtotal + ' per ' + unit);
    } else if (p.mode === 'per_unit_flat') {
      subtotal = (p.amount || 0) * q;
      parts.push('$' + (p.amount || 0) + '/' + unit + ' × ' + q);
    } else {
      return null;
    }

    if (s === 'installation_off' || s === 'installation_on') {
      if (sbSt.addons.tpms && sbPricing.addon_tpms) {
        subtotal += (sbPricing.addon_tpms.amount || 0) * q;
        parts.push('TPMS ×' + q);
      }
    }
    if (s === 'installation_off') {
      if (sbSt.addons.disposal && sbPricing.addon_disposal) {
        subtotal += (sbPricing.addon_disposal.amount || 0) * q;
        parts.push('tire disposal ×' + q);
      }
    }
    // Road force upgrade on any job (per tire, from the catalog).
    if (s !== 'road_force_balancing' && s !== 'balancing' && sbSt.addons.roadForce && sbAddonCatalog.addon_road_force) {
      subtotal += (sbAddonCatalog.addon_road_force.amount || 0) * q;
      parts.push('road force ×' + q);
    }

    var gst   = subtotal * 0.05;
    var total = subtotal + gst;
    return {
      subtotal: sbFmtMoney(subtotal),
      gst:      sbFmtMoney(gst),
      amount:   sbFmtMoney(total),
      note:     parts.join(' + ') + ' · est. before confirming'
    };
  }

  // ── Stage 2: derive a chip price label from a catalog service ─────────────
  function sbPriceLabel(svc) {
    var pr = svc.prices || {};
    var u = svc.unit || 'unit';
    if (svc.pricingMode === 'per_unit_flat') {
      return '$' + (pr.amount != null ? pr.amount : '?') + ' / ' + u;
    }
    var vals = [];
    if (pr.byVehicle) {
      Object.keys(pr.byVehicle).forEach(function (k) {
        var n = pr.byVehicle[k];
        // A vehicle billed flat (flatOverride: a trailer) is a total, not a
        // per-unit rate — it never sets the "from" price.
        if (svc.pricingMode === 'per_unit_by_vehicle' && pr.flatOverride && pr.flatOverride[k] != null) return;
        if (typeof n === 'number') vals.push(n);
      });
    }
    if (!vals.length) return '';
    return 'from $' + Math.min.apply(null, vals) + ' / ' + u;
  }

  // ── Stage 2: overlay the live catalog from GET /api/services ──────────────
  // Replaces the fallback service list + pricing with admin-managed values.
  // Defensive: empty/bad data leaves the hardcoded fallback untouched, so the
  // booking flow can never break on an API hiccup.
  function sbApplyCatalog(services) {
    if (!Array.isArray(services) || !services.length) return;
    var list = [];
    services.forEach(function (svc) {
      if (!svc || !svc.slug) return;
      var pr = svc.prices || {};
      sbPricing[svc.slug] = {
        mode: svc.pricingMode,
        unit: svc.unit,
        byVehicle: pr.byVehicle || null,
        amount: pr.amount,
        lowProfileFloor: pr.lowProfileFloor,
        flatOverride: pr.flatOverride || null
      };
      // Which shops offer it — the live answer replaces the fallback entry.
      sbServiceShops[svc.slug] = PTBookingCore.serviceShops(svc);
      if (svc.kind === 'service') {
        list.push({
          id: svc.slug,
          name: svc.name,
          desc: svc.description || '',
          priceLabel: sbPriceLabel(svc),
          icon: sbIcons[svc.slug] || sbIcons._default
        });
      } else if (svc.kind === 'addon' && sbAddonKeys[svc.slug] && typeof pr.amount === 'number') {
        sbAddonCatalog[svc.slug] = { name: svc.name, amount: pr.amount, unit: svc.unit || 'tire' };
      }
    });
    if (list.length) sbServices = list;
    // Repaint if the modal is already open when the catalog lands.
    var ov = document.getElementById('sb-overlay');
    if (ov && !ov.hidden) {
      sbRenderServices();
      if (sbSt.service) { sbShowDetails(); sbUpdatePrice(); }
      sbSyncLocation();
    }
  }

  // ── Render: location picker ───────────────────────────────────────────────
  // Gated: only shows when 2+ shops are bookable. With <2 bookable, the section
  // stays hidden and behavior is identical to the prior SW-only flow.
  // "Prince Tires — Edmonton Trail NE" -> "Edmonton Trail NE", for copy that
  // already says Prince Tires.
  function sbShortShopName(l) {
    var n = l.public_name || l.name || 'Prince Tires';
    return n.replace(/^Prince Tires\s*[—–-]\s*/i, '');
  }

  function sbPickLocation(slug) {
    if (!slug || sbSt.location === slug) return;
    sbSt.location = slug;
    try { localStorage.setItem('pt-booking-location', sbSt.location); } catch (e) {}
    sbRenderLocations();
    // Availability is location-specific — re-query if the user is on / has
    // reached the time step.
    if (sbSt.date) { sbSt.time = null; var n2 = document.getElementById('sb-next-2'); if (n2) n2.disabled = true; sbRenderTimes(); }
  }

  // "Also open" line under the picker. Shown only while the PRIMARY shop is
  // selected and another shop is bookable: a customer who lands on the default
  // shop and finds it busy should learn there is a second one before giving up,
  // and a customer who already chose the other shop needs no nudge back. Name
  // and address come from the island, so a third shop needs no edit here.
  function sbRenderLocNudge() {
    var el = document.getElementById('sb-loc-nudge');
    if (!el) return;
    var cur = sbLocBySlug(sbSt.location);
    var other = sbLocBookable.find(function (l) { return l.slug !== sbSt.location; });
    if (!cur || !cur.is_primary || !other) { el.hidden = true; el.innerHTML = ''; return; }
    var name = sbShortShopName(other);
    var addr = other.address || other.address_full || '';
    el.innerHTML = 'Also open for bookings: <strong>' + name + '</strong>' + (addr ? ', ' + addr : '') + '.' +
      ' <button type="button" class="sb-loc-nudge__btn" data-loc-switch="' + other.slug + '">' +
      'Check out our ' + name + ' location →</button>';
    el.hidden = false;
    var btn = el.querySelector('[data-loc-switch]');
    if (btn) btn.addEventListener('click', function () { sbPickLocation(this.dataset.locSwitch); });
  }

  // A restricted service narrows the chips to the shops that offer it and
  // explains why underneath; with one bookable shop that cannot do the job the
  // note alone is shown, so the customer learns where to go.
  function sbRenderLocations() {
    var section = document.getElementById('sb-location-section');
    var grid = document.getElementById('sb-location-grid');
    var note = document.getElementById('sb-location-note');
    if (!section || !grid) return;
    var r = sbRestrictions();
    var allowed = PTBookingCore.allowedLocations(sbLocBookable, r.lists);
    var noteHtml = '';
    if (r.named.length) {
      noteHtml = r.named.map(function (n) {
        var label = PTBookingCore.onlyAtLabel(n.shops, sbLocAll).replace(/ only$/, '');
        return '<strong>' + n.name + '</strong> is only available at our ' + label + ' shop.';
      }).join(' ');
      if (!allowed.length) {
        var only = PTBookingCore.bySlug(sbLocAll, r.named[0].shops[0]);
        noteHtml += only && only.phone ? ' Call ' + only.phone + ' to book it.' : '';
      }
    }
    if (note) { note.innerHTML = noteHtml; note.hidden = !noteHtml; }
    if (sbLocBookable.length < 2 && !noteHtml) { section.hidden = true; return; }
    section.hidden = false;
    grid.innerHTML = allowed.map(function (l) {
      var active = sbSt.location === l.slug ? ' sb-loc-chip--active' : '';
      var label = l.name || l.public_name || l.slug;
      var addr = l.address || l.address_full || '';
      return '<button class="sb-loc-chip' + active + '" data-loc="' + l.slug + '">' +
        '<span class="sb-loc-name">' + label + '</span>' +
        '<span class="sb-loc-addr">' + addr + '</span>' +
        '</button>';
    }).join('');
    grid.querySelectorAll('.sb-loc-chip').forEach(function (el) {
      el.addEventListener('click', function () { sbPickLocation(this.dataset.loc); });
    });
    // No "also open" nudge while a service has pinned the shop — the other
    // shop cannot take this booking.
    if (r.lists.length) {
      var nudge = document.getElementById('sb-loc-nudge');
      if (nudge) { nudge.hidden = true; nudge.innerHTML = ''; }
    } else {
      sbRenderLocNudge();
    }
  }

  // ── Render: service chips ─────────────────────────────────────────────────
  function sbRenderServices() {
    var grid = document.getElementById('sb-service-grid');
    if (!grid) return;
    grid.innerHTML = sbServices.map(function (s) {
      var active = sbSt.service === s.id ? ' sb-service-chip--active' : '';
      var only = sbOnlyAt(s.id);
      return '<div class="sb-chip-wrap">' +
        '<button class="sb-service-chip' + active + '" data-svc="' + s.id + '">' +
          s.icon +
          '<span class="sb-chip-text"><span>' + s.name + '</span><span class="sb-chip-price">' + s.priceLabel + '</span>' +
            (only ? '<span class="sb-chip-badge">' + only + '</span>' : '') +
          '</span>' +
        '</button>' +
        '<button class="sb-info-btn" data-info="' + s.id + '" aria-label="What\'s included" tabindex="0">' +
          '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>' +
        '</button>' +
        '<div class="sb-tooltip" id="sb-tip-' + s.id + '" role="tooltip">' + s.desc + '</div>' +
      '</div>';
    }).join('');

    grid.querySelectorAll('.sb-service-chip').forEach(function (el) {
      el.addEventListener('click', function () {
        sbSt.service = this.dataset.svc;
        // The swap is priced per tire: start it at the vehicle's set (4, or 6
        // on a dually), never a count carried over from another service.
        if (sbSt.service === 'installation_on') { sbSt.qty = sbDefaultQty(); sbSt.qtyByHand = false; }
        sbSt.repairType = '';
        sbSt.addons = { disposal: false, tpms: false, lowProfile: false, roadForce: false };
        sbSt.oldTires = null;
        sbRenderServices();
        sbShowDetails();
        sbUpdatePrice();
        sbUpdateNextBtn();
        sbSyncLocation();
      });
    });

    // Info button: toggle tooltip on click/tap; close others first
    grid.querySelectorAll('.sb-info-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var tip = document.getElementById('sb-tip-' + this.dataset.info);
        var isOpen = tip.classList.contains('sb-tooltip--open');
        // Close all tooltips
        grid.querySelectorAll('.sb-tooltip').forEach(function (t) { t.classList.remove('sb-tooltip--open'); });
        grid.querySelectorAll('.sb-info-btn').forEach(function (b) { b.classList.remove('sb-info-btn--active'); });
        if (!isOpen) {
          tip.classList.add('sb-tooltip--open');
          this.classList.add('sb-info-btn--active');
        }
      });
    });

    // Click outside closes any open tooltip
    document.addEventListener('click', function sbCloseTooltips() {
      grid.querySelectorAll('.sb-tooltip').forEach(function (t) { t.classList.remove('sb-tooltip--open'); });
      grid.querySelectorAll('.sb-info-btn').forEach(function (b) { b.classList.remove('sb-info-btn--active'); });
    }, { once: false, capture: false });
  }

  // ── Show the details section (vehicle + sub-options) ──────────────────────
  function sbShowDetails() {
    var section = document.getElementById('sb-details-section');
    if (!sbSt.service) { section.hidden = true; return; }
    section.hidden = false;

    // Trailer not valid for balancing or rotation — reset to passenger
    var sbNoTrailer = ['balancing', 'road_force_balancing', 'rotation'];
    if (sbNoTrailer.indexOf(sbSt.service) > -1 && sbSt.vehicle === 'trailer') {
      sbSt.vehicle = 'passenger';
    }

    // Vehicle chips
    sbRenderVehicles();

    // Repair-type chooser is gone (only patch remains). Auto-set:
    document.getElementById('sb-repair-section').hidden = true;
    if (sbSt.service === 'flat_repair') sbSt.repairType = 'patch';

    // Trailer-setup chooser is gone (off-rims vs on-rims is now the parent service)
    document.getElementById('sb-looserim-section').hidden = true;

    // Qty selector — hidden for rotation only (always the whole set). The seasonal swap
    // is priced per tire (db/088), so it asks how many: some swap only 2.
    var noQty = (sbSt.service === 'rotation');
    document.getElementById('sb-qty-section').hidden = noQty;
    if (!noQty) sbRenderQty();

    // Old-tires question: Tire Installation only (shows / hides itself).
    sbRenderOldTires();

    // Add-ons: TPMS / low-profile ride on the two installs; the road
    // force upgrade is offered on every job (owner's call, 2026-10-22).
    var hasAddons = (sbSt.service === 'installation_off' || sbSt.service === 'installation_on') || sbRoadForceOffered();
    document.getElementById('sb-addons-section').hidden = !hasAddons;
    if (hasAddons) sbRenderAddons();
  }

  // ── Render: vehicle chips ─────────────────────────────────────────────────
  function sbRenderVehicles() {
    var grid = document.getElementById('sb-vehicles');
    if (!grid) return;
    // Trailers don't apply to balancing or rotation
    var sbNoTrailerSvcs = ['balancing', 'road_force_balancing', 'rotation'];
    var vehs = sbNoTrailerSvcs.indexOf(sbSt.service) > -1
      ? sbVehs.filter(function (v) { return v.id !== 'trailer'; })
      : sbVehs;
    grid.innerHTML = vehs.map(function (v) {
      var active = sbSt.vehicle === v.id ? ' bk-vehicle-card--active' : '';
      return '<button class="bk-vehicle-card' + active + '" data-veh="' + v.id + '"><span class="bk-vehicle-name">' + v.name + '</span></button>';
    }).join('');
    grid.querySelectorAll('.bk-vehicle-card').forEach(function (el) {
      el.addEventListener('click', function () {
        sbSt.vehicle = this.dataset.veh;
        // To or from a dually: the swap's count follows the vehicle's set
        // unless the customer chose a count.
        if (sbSt.service === 'installation_on' && !sbSt.qtyByHand) sbSt.qty = sbDefaultQty();
        sbRenderVehicles();
        if (sbSt.service !== 'rotation') sbRenderQty();
        sbUpdatePrice();
        try { localStorage.setItem('pt-booking-vehicle', sbSt.vehicle); } catch (e) {}
      });
    });
  }

  // ── Render: old-tires question (installation_off only) ────────────────────
  // Two radios, neither pre-selected; answering is required before step 2.
  // The disposal fee is the catalog's addon_disposal amount (same expression
  // the old checkbox used), and "Dispose" sets addons.disposal so sbCalcPrice
  // prices it exactly as the checkbox did.
  // Own tires (on or off rims): the tread / date-code check above Send request.
  function sbTireAckAsked() { return sbSt.service === 'installation_off' || sbSt.service === 'installation_on'; }
  function sbTireAckTicked() { var cb = document.getElementById('sb-tire-ack-cb'); return !!(cb && cb.checked); }
  function sbTireAckError(on) {
    var box = document.getElementById('sb-tire-ack');
    var err = document.getElementById('sb-tire-ack-err');
    if (box) box.classList.toggle('sb-tire-ack--error', !!on);
    if (err) err.hidden = !on;
  }
  function sbTireAckSync() {
    var box = document.getElementById('sb-tire-ack');
    if (!box) return;
    box.hidden = !sbTireAckAsked();
    if (box.hidden) sbTireAckError(false);
  }
  function sbTireAckReset() {
    var cb = document.getElementById('sb-tire-ack-cb');
    if (cb) {
      cb.checked = false;
      var row = cb.closest('.bk-addon');
      if (row) row.classList.remove('bk-addon--active');
    }
    sbTireAckError(false);
  }
  (function () {
    var cb = document.getElementById('sb-tire-ack-cb');
    if (!cb) return;
    cb.addEventListener('change', function () {
      var row = this.closest('.bk-addon');
      if (row) row.classList.toggle('bk-addon--active', this.checked);
      if (this.checked) sbTireAckError(false);
    });
  })();
  function sbOldTiresError(on) {
    var section = document.getElementById('sb-oldtires-section');
    var err = document.getElementById('sb-oldtires-err');
    if (section) section.classList.toggle('sb-oldtires--error', !!on);
    if (err) err.hidden = !on;
  }
  function sbRenderOldTires() {
    var section = document.getElementById('sb-oldtires-section');
    var host = document.getElementById('sb-oldtires');
    if (!section || !host) return;
    var show = sbSt.service === 'installation_off';
    section.hidden = !show;
    if (!show) {
      sbSt.oldTires = null;
      sbSt.addons.disposal = false;
      sbOldTiresError(false);
      host.innerHTML = '';
      return;
    }
    var fee = (sbPricing.addon_disposal && sbPricing.addon_disposal.amount) || 5;
    var opts = [
      // Own tires off rims: the $5/tire disposal stays, said plainly (owner,
      // 2026-11-02). Tire BUYERS leave theirs free — that is the product modal.
      { id: 'keep',    name: 'Keep them — I’ll take them home',             price: 'Free' },
      { id: 'dispose', name: 'Tire disposal (we recycle your old tires)', price: '+$' + fee + '/tire' }
    ];
    host.innerHTML = opts.map(function (o) {
      var on = sbSt.oldTires === o.id;
      return '<label class="bk-addon' + (on ? ' bk-addon--active' : '') + '">' +
        '<input type="radio" name="sb-oldtires" value="' + o.id + '"' + (on ? ' checked' : '') + '>' +
        '<span class="bk-addon-name">' + o.name + '</span>' +
        '<span class="bk-addon-price">' + o.price + '</span>' +
        '</label>';
    }).join('');
    host.querySelectorAll('input[name="sb-oldtires"]').forEach(function (el) {
      el.addEventListener('change', function () {
        if (!this.checked) return;
        sbSt.oldTires = this.value;
        sbSt.addons.disposal = this.value === 'dispose';
        host.querySelectorAll('.bk-addon').forEach(function (lbl) {
          var r = lbl.querySelector('input');
          lbl.classList.toggle('bk-addon--active', !!(r && r.checked));
        });
        sbOldTiresError(false);
        sbUpdatePrice();
      });
    });
  }

  // Step 1 → 2. The old-tires answer is required for Tire Installation; say so
  // next to the question instead of moving on.
  window.sbNext1 = function () {
    if (!sbSt.service) return;
    if (sbSt.service === 'installation_off' && !sbSt.oldTires) {
      sbOldTiresError(true);
      var sec = document.getElementById('sb-oldtires-section');
      try { sec.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
      var first = document.querySelector('#sb-oldtires input[type="radio"]');
      if (first) { try { first.focus({ preventScroll: true }); } catch (e) {} }
      return;
    }
    sbGoTo(2);
  };

  // ── Render: add-ons ───────────────────────────────────────────────────────
  // installation_off: TPMS, low-profile/run-flat (disposal is the old-tires question above)
  // installation_on: TPMS only
  function sbRenderAddons() {
    var container = document.getElementById('sb-addons');
    if (!container) return;

    var rows = [];
    var isOff = sbSt.service === 'installation_off';
    var isOn  = sbSt.service === 'installation_on';

    if (isOff || isOn) {
      rows.push({ id: 'tpms', name: 'New TPMS sensors', price: (sbPricing.addon_tpms.amount || 60), unit: '/sensor' });
    }
    if (isOff) {
      rows.push({ id: 'lowProfile', name: 'Low-profile or run-flat tires', priceLabel: '$' + (sbPricing.installation_off.lowProfileFloor || 40) + '/tire min' });
    }
    // Road force upgrade on any job (except road force itself) — from the
    // catalog, and only when a bookable shop offers it.
    if (sbRoadForceOffered()) {
      var rf = sbAddonCatalog.addon_road_force;
      rows.push({ id: 'roadForce', name: rf.name, price: rf.amount, unit: '/' + rf.unit, note: sbOnlyAt('addon_road_force') });
    } else {
      sbSt.addons.roadForce = false;
    }

    container.innerHTML = rows.map(function (a) {
      var active = sbSt.addons[a.id] ? ' bk-addon--active' : '';
      var checked = sbSt.addons[a.id] ? ' checked' : '';
      var priceTag = a.priceLabel
        ? '<span class="bk-addon-price">' + a.priceLabel + '</span>'
        : '<span class="bk-addon-price">+$' + a.price + a.unit + '</span>';
      return '<label class="bk-addon' + active + '">' +
        '<input type="checkbox" data-addon="' + a.id + '"' + checked + '>' +
        '<span class="bk-addon-name">' + a.name + '</span>' +
        priceTag +
        (a.note ? '<span class="bk-addon-note">' + a.note + '</span>' : '') +
        '</label>';
    }).join('');
    container.querySelectorAll('input[data-addon]').forEach(function (el) {
      el.addEventListener('change', function () {
        sbSt.addons[this.dataset.addon] = this.checked;
        var lbl = this.closest('.bk-addon');
        lbl.classList.toggle('bk-addon--active', this.checked);
        sbUpdatePrice();
        // A ticked road force upgrade narrows the shop to Edmonton Trail.
        if (this.dataset.addon === 'roadForce') sbSyncLocation();
      });
    });
  }

  // Can the road force upgrade be offered on the chosen job? Any service but
  // road force itself, once the catalog has it, and only while a bookable shop
  // offers it (the picker would otherwise have nothing to show).
  function sbRoadForceOffered() {
    if (!sbSt.service || sbSt.service === 'road_force_balancing' || sbSt.service === 'balancing' || !sbAddonCatalog.addon_road_force) return false;
    return PTBookingCore.allowedLocations(sbLocBookable, [sbServiceShops.addon_road_force || []]).length > 0;
  }

  // The catalog add-ons ticked on this booking, in the shape /api/book takes
  // (customAddons).
  function sbSelectedCatalogAddons() {
    var out = [];
    if (sbSt.service === 'road_force_balancing') return out;
    Object.keys(sbAddonKeys).forEach(function (slug) {
      var a = sbAddonCatalog[slug];
      if (a && sbSt.addons[sbAddonKeys[slug]]) out.push({ slug: slug, name: a.name, qty: sbQty(), amount: a.amount });
    });
    return out;
  }

  // The swap's count when the customer hasn't chosen one: the vehicle's set —
  // 6 on a dually (dual rear wheels), else 4. A dually's swap is 6 × $15 = $90.
  function sbDefaultQty() { return sbSt.vehicle === 'dually' ? 6 : 4; }
  // The count a price or the request uses: rotation is always the set.
  function sbQty() { return sbSt.service === 'rotation' ? sbDefaultQty() : sbSt.qty; }

  // ── Render: qty selector ──────────────────────────────────────────────────
  function sbRenderQty() {
    var sel = document.getElementById('sb-qty-select');
    var lbl = document.getElementById('sb-qty-label');
    if (!sel) return;
    var s = sbSt.service;
    var isTpms = s === 'tpms';
    var isBalancing = s === 'balancing' || s === 'road_force_balancing';
    var isRepair = s === 'flat_repair';
    var max = (isTpms || isBalancing || isRepair) ? 4 : 8;
    lbl.textContent = isTpms ? 'How many sensors?'
                    : isBalancing ? 'How many wheels?'
                    : isRepair ? 'How many tires to patch?'
                    : 'How many tires?';
    if (!sel._sbWired) {
      sel._sbWired = true;
      sel.addEventListener('change', function () {
        sbSt.qty = parseInt(this.value);
        sbSt.qtyByHand = true;
        sbUpdatePrice();
      });
    }
    // Rebuild options if max changed
    if (sel.dataset.max !== String(max)) {
      sel.dataset.max = String(max);
      var unit = isTpms ? ' sensor' : isBalancing ? ' wheel' : ' tire';
      var html = '';
      for (var i = 1; i <= max; i++) {
        html += '<option value="' + i + '"' + (i === sbSt.qty ? ' selected' : '') + '>' + i + unit + (i > 1 ? 's' : '') + '</option>';
      }
      sel.innerHTML = html;
    }
    sel.value = String(Math.min(sbSt.qty, max));
  }

  // ── Update price box ──────────────────────────────────────────────────────
  function sbUpdatePrice() {
    var box = document.getElementById('sb-price-box');
    var pr = sbCalcPrice();
    if (!pr) { box.hidden = true; return; }
    box.hidden = false;
    document.getElementById('sb-price-sub').textContent    = pr.subtotal;
    document.getElementById('sb-price-gst').textContent    = pr.gst;
    document.getElementById('sb-price-amount').textContent = pr.amount;
    document.getElementById('sb-price-note').textContent   = pr.note;
  }

  // ── Enable / disable next button ──────────────────────────────────────────
  function sbUpdateNextBtn() {
    var ok = !!sbSt.service;
    document.getElementById('sb-next-1').disabled = !ok;
  }

  {% comment %}
    Hours PER SHOP, rendered once from the store_hours metaobject pt-nap reads.
    This modal used to read SW's hours for every shop, so a customer who picked
    Edmonton Trail NE was shown SW's window (NE closes at 6 PM Mon–Thu/Sat and
    4 PM Sun) and the Friday split (closed 1:00–2:30, final close 5:00 at both
    shops) was ignored. Same block as sections/pt-booking-page.liquid. Opens
    with a NON-trimming tag and ends in plain JS so it can never swallow the
    line before it; a third shop is one slug added to _sb_slugs.
  {% endcomment %}
  {%- assign _sb_slugs = 'sw,ne' | split: ',' -%}
  {%- assign _sb_fields = 'hours_mon_sat_open,hours_mon_sat_close,hours_sun_open,hours_sun_close,hours_fri_open,hours_fri_close,hours_fri_reopen,hours_fri_final_close,booking_cutoff_minutes' | split: ',' -%}
  var SB_HOURS = {
  {%- for _s in _sb_slugs %}
    {{ _s | json }}: {
    {%- for _f in _sb_fields -%}
      {%- capture _v %}{% render 'pt-nap', location: _s, field: _f %}{% endcapture %}
      {{ _f | json }}: {{ _v | strip | json }},
    {%- endfor %}
    },
  {%- endfor %}
  };
  // The appointment window for a day at the SELECTED shop: first slot, last
  // slot (close − cutoff) and, on Fridays, the lunch gap. Falls back to SW.
  function sbHoursFor(d) {
    var H = SB_HOURS[sbSt.location] || SB_HOURS.sw || {};
    var toMin = function (s) { var p = String(s || '').split(':'); var v = parseInt(p[0], 10) * 60 + (parseInt(p[1], 10) || 0); return isNaN(v) ? null : v; };
    var dow = d.getDay(), open, close, gap = null;
    if (dow === 0) { open = toMin(H.hours_sun_open); close = toMin(H.hours_sun_close); }
    else if (dow === 5 && toMin(H.hours_fri_final_close) !== null) {
      open = toMin(H.hours_fri_open); close = toMin(H.hours_fri_final_close);
      var gc = toMin(H.hours_fri_close), gr = toMin(H.hours_fri_reopen);
      if (gc !== null && gr !== null && gr > gc) gap = [gc, gr];
    }
    else { open = toMin(H.hours_mon_sat_open); close = toMin(H.hours_mon_sat_close); }
    if (open === null) open = dow === 0 ? 600 : 540;
    if (close === null) close = dow === 0 ? 840 : 1020;
    return { open: open, last: close - (parseInt(H.booking_cutoff_minutes, 10) || 30), gap: gap };
  }
  // Minutes → the label shape the availability API uses ("9:00 AM", "12:30 PM").
  function sbMinsToSlot(mins) {
    var h = Math.floor(mins / 60), m = mins % 60, hr = h > 12 ? h - 12 : h;
    return hr + ':' + (m < 10 ? '0' : '') + m + ' ' + (h >= 12 ? 'PM' : 'AM');
  }
  // Monotonic render counter: a slow availability answer for an EARLIER day
  // click must never paint over a later one.
  var sbAvailSeq = 0;

  // ── Helper: "9:30 AM" → minutes from midnight ─────────────────────────────
  function sbSlotToMins(slot) {
    var m = slot.match(/(\d+):(\d+)\s*(AM|PM)/i);
    if (!m) return 0;
    var h = parseInt(m[1]), mn = parseInt(m[2]);
    if (m[3].toUpperCase() === 'PM' && h !== 12) h += 12;
    if (m[3].toUpperCase() === 'AM' && h === 12) h = 0;
    return h * 60 + mn;
  }

  // ── Render: week + day strip ──────────────────────────────────────────────
  function sbRenderWeek() {
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var start = new Date(today);
    start.setDate(start.getDate() - start.getDay() + 1 + sbWk * 7);
    var dn = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    var mn = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    var end = new Date(start); end.setDate(end.getDate() + 6);
    document.getElementById('sb-week-label').textContent = start.getDate() + ' ' + mn[start.getMonth()] + ' – ' + end.getDate() + ' ' + mn[end.getMonth()];
    document.getElementById('sb-prev-week').disabled = sbWk <= 0;

    var h = '';
    for (var i = 0; i < 7; i++) {
      var d = new Date(start); d.setDate(d.getDate() + i);
      var isPast = d < today;
      var isToday = d.getTime() === today.getTime();
      var isActive = sbSt.date && d.toDateString() === sbSt.date.toDateString();
      var cls = 'bk-day-card' + (isPast ? ' bk-day-card--past' : '') + (isToday ? ' bk-day-card--today' : '') + (isActive ? ' bk-day-card--active' : '');
      var localDate = PTBookingCore.localISO(d);
      h += '<div class="' + cls + '" data-date="' + localDate + '"><div class="bk-day-name">' + dn[i] + '</div><div class="bk-day-num">' + d.getDate() + '</div></div>';
    }
    document.getElementById('sb-day-strip').innerHTML = h;

    document.querySelectorAll('#sb-day-strip .bk-day-card:not(.bk-day-card--past)').forEach(function (el) {
      el.addEventListener('click', function () {
        sbSt.date = new Date(this.dataset.date + 'T12:00:00');
        sbSt.time = null;
        document.getElementById('sb-next-2').disabled = true;
        sbRenderWeek();
        sbRenderTimes();
      });
    });
  }

  // ── Render: time slots ────────────────────────────────────────────────────
  async function sbRenderTimes() {
    if (!sbSt.date) {
      document.getElementById('sb-time-grid').innerHTML = '<p style="color:#9ca3af;font-size:.9rem;grid-column:1/-1">Select a day above</p>';
      return;
    }
    // Take a ticket for THIS render: a slow availability answer for an earlier
    // click must never paint over a later one. The window comes from the
    // SELECTED shop's hours (sbHoursFor), not SW's for everyone.
    var seq = ++sbAvailSeq;
    var H = sbHoursFor(sbSt.date);
    var slots = [];
    for (var mins = H.open; mins <= H.last; mins += 30) slots.push(sbMinsToSlot(mins));
    document.getElementById('sb-time-grid').innerHTML = '<p style="color:#9ca3af;font-size:.9rem;grid-column:1/-1">Checking availability…</p>';
    var _avail = await PTBookingCore.fetchAvailability(AVAILABILITY_API, PTBookingCore.localISO(sbSt.date), sbSt.location, { service: sbSt.service });
    if (seq !== sbAvailSeq) return; // a newer click owns the grid now
    // The platform refused or could not be reached. Say so, with the number
    // of the shop they picked — never an open grid that fails at the end.
    if (_avail.unavailable) {
      var downLoc = sbCurrentLoc();
      var downPhone = (downLoc && downLoc.phone) ? downLoc.phone : '';
      document.getElementById('sb-time-grid').innerHTML = '<p style="color:#b91c1c;font-size:.95rem;line-height:1.5;grid-column:1/-1;text-align:center;padding:.5rem .25rem">Online booking is temporarily unavailable. Please call ' + (downPhone || 'the shop') + ' to book, or try again in a few minutes.</p>';
      document.getElementById('sb-next-2').disabled = true;
      return;
    }
    var booked = _avail.booked, allDayBlocked = _avail.allDayBlocked;
    if (allDayBlocked) {
      document.getElementById('sb-time-grid').innerHTML = '<p style="color:#dc2626;font-size:.95rem;grid-column:1/-1;text-align:center;padding:.5rem 0">' + (_avail.blockedReason || 'Not available this day — please pick another date.') + '</p>';
      return;
    }

    // Block past slots and slots within 6 hours of now (today only)
    var blockReason = {};
    var now = new Date();
    var nowMins = now.getHours() * 60 + now.getMinutes();
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var isToday = sbSt.date.toDateString() === today.toDateString();
    if (isToday) {
      slots.forEach(function (s) {
        var sm = sbSlotToMins(s);
        if (sm <= nowMins) {
          blockReason[s] = 'Time has passed';
        } else if (sm < nowMins + 120) {
          blockReason[s] = 'Book at least 2 hrs ahead';
        }
      });
    }

    // Friday lunch gap (both shops close 1:00–2:30): nothing inside it.
    if (H.gap) {
      slots.forEach(function (s) {
        var sm = sbSlotToMins(s);
        if (!blockReason[s] && sm >= H.gap[0] && sm < H.gap[1]) blockReason[s] = 'Closed ' + sbMinsToSlot(H.gap[0]) + ' – ' + sbMinsToSlot(H.gap[1]);
      });
    }

    // If every slot ends up blocked (past, lead-time, or booked), don't show
    // a wall of red — give one clear message that says WHY, and the shop's
    // number when a phone call could still get them in today.
    var pickable = 0;
    slots.forEach(function (s) {
      if (booked.indexOf(s) === -1 && !blockReason[s]) pickable++;
    });
    if (pickable === 0) {
      var sbLoc = sbCurrentLoc();
      var sbPhone = (sbLoc && sbLoc.phone) ? sbLoc.phone : '';
      var msg = (isToday && nowMins + 120 > H.last)
        ? 'Same-day appointments need 2 hours’ notice, and the last one today is ' + sbMinsToSlot(H.last) + ' — today can’t be booked online any more. Pick another day' + (sbPhone ? ', or call ' + sbPhone + ' to ask about a walk-in.' : '.')
        : 'Fully booked this day — please pick another day.';
      if (!(isToday && nowMins + 120 > H.last) && _avail.dayFull) {
        // Open but full: offer to request the day (pt-booking-core.js).
        var sbSvc = sbServices.find(function (s) { return s.id === sbSt.service; });
        PTBookingCore.renderRequestPanel(document.getElementById('sb-time-grid'), {
          apiBase: AVAILABILITY_API,
          dateISO: PTBookingCore.localISO(sbSt.date),
          locationSlug: sbSt.location || null,
          prefill: {
            name: (document.getElementById('sb-name') || {}).value || '',
            phone: (document.getElementById('sb-phone') || {}).value || '',
            email: (document.getElementById('sb-email') || {}).value || ''
          },
          service: (sbSvc && sbSvc.name) || null,
          vehicle: null
        });
        document.getElementById('sb-next-2').disabled = true;
        return;
      }
      document.getElementById('sb-time-grid').innerHTML =
        '<p style="color:#9ca3af;font-size:.95rem;grid-column:1/-1;text-align:center;padding:.6rem 0;line-height:1.4">' + msg + '</p>';
      document.getElementById('sb-next-2').disabled = true;
      return;
    }

    document.getElementById('sb-time-grid').innerHTML = slots.map(function (s) {
      var isCalBooked = booked.indexOf(s) > -1;
      var isBlocked = isCalBooked || !!blockReason[s];
      var titleAttr = isCalBooked ? 'Already booked' : (blockReason[s] || '');
      return '<div class="bk-time-slot' +
        (sbSt.time === s ? ' bk-time-slot--active' : '') +
        (isBlocked ? ' bk-time-slot--booked' : '') +
        '" data-time="' + s + '"' +
        (isBlocked ? ' title="' + titleAttr + '"' : '') +
        '>' + s + '</div>';
    }).join('');
    document.querySelectorAll('#sb-time-grid .bk-time-slot:not(.bk-time-slot--booked)').forEach(function (el) {
      el.addEventListener('click', function () {
        sbSt.time = this.dataset.time;
        sbRenderTimes();
        document.getElementById('sb-next-2').disabled = false;
      });
    });
  }

  // ── Render: step 3 summary ────────────────────────────────────────────────
  function sbRenderSummary() {
    var svc = sbServices.find(function (s) { return s.id === sbSt.service; });
    var veh = sbVehs.find(function (v) { return v.id === sbSt.vehicle; });
    var pr = sbCalcPrice();
    var ds = sbSt.date ? sbSt.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + sbSt.time : '';
    // Vehicle: what the customer typed in the step-3 fields (pre-filled from
    // the saved vehicle), else the vehicle type. Re-rendered as they type.
    var vin = sbReadVehicle();
    var vehLabel = sbEsc(sbVehicleText(vin)) || (veh ? veh.name : '');
    var oldTires = sbOldTiresText();

    var h = '';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
    if (sbSt.service === 'installation_off' && sbSt.addons.lowProfile) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Tire type</span><span class="bk-summary-val">Low-profile / run-flat</span></div>';
    }
    if (oldTires) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Old tires</span><span class="bk-summary-val">' + oldTires + '</span></div>';
    }
    var picked = sbSelectedCatalogAddons();
    if (picked.length) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Add-on</span><span class="bk-summary-val">' + picked.map(function (a) { return a.name; }).join(', ') + '</span></div>';
    }
    if (sbLocBookable.length > 1) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Location</span><span class="bk-summary-val">' + PTBookingCore.shortShopName(sbCurrentLoc()) + '</span></div>';
    }
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Date &amp; time</span><span class="bk-summary-val">' + ds + '</span></div>';
    h += '<div class="bk-summary-row"><span class="bk-summary-label">Vehicle</span><span class="bk-summary-val">' + vehLabel + '</span></div>';
    if (vin.odometerKm != null) {
      h += '<div class="bk-summary-row"><span class="bk-summary-label">Mileage</span><span class="bk-summary-val">' + sbFmtKm(vin.odometerKm) + '</span></div>';
    }
    if (pr) h += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
    document.getElementById('sb-summary').innerHTML = h;
  }

  // Step-3 vehicle inputs: keep the year digits-only, clear a field's error as
  // it is corrected, and refresh the summary above so it shows what they typed.
  ['sb-vyear', 'sb-vmake', 'sb-vmodel', 'sb-odo'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function () {
      if (id === 'sb-vyear' && /\D/.test(this.value)) this.value = this.value.replace(/\D/g, '');
      var f = document.getElementById('sb-field-' + id.slice(3));
      if (f) f.classList.remove('bk-field--error');
      if (!document.getElementById('sb-page-3').hidden) sbRenderSummary();
    });
  });

  // ── Step navigation ───────────────────────────────────────────────────────
  window.sbGoTo = function (step) {
    // A new step starts clean: no messages left over from an earlier try.
    try { PTBookingCore.req.clear(document.getElementById('sb-overlay')); } catch (e) {}
    [1, 2, 3].forEach(function (s) { document.getElementById('sb-page-' + s).hidden = s !== step; });
    document.getElementById('sb-page-done').hidden = true;
    document.getElementById('sb-stepper').style.opacity = '1';

    [1, 2, 3].forEach(function (s) {
      var ci = document.querySelector('[data-sb-step="' + s + '"] .bk-step-circle');
      var li = document.querySelector('[data-sb-line="' + s + '"]');
      ci.className = 'bk-step-circle';
      if (li) li.className = 'bk-step-line';
      if (s < step) {
        ci.className = 'bk-step-circle bk-step-circle--done'; ci.innerHTML = '&#10003;';
        if (li) li.className = 'bk-step-line bk-step-line--done';
      } else if (s === step) {
        ci.className = 'bk-step-circle bk-step-circle--active'; ci.textContent = s;
      } else { ci.textContent = s; }
    });

    if (step === 2) {
      if (!sbSt.date) { var t = new Date(); t.setHours(0, 0, 0, 0); sbSt.date = t; }
      sbRenderWeek(); sbRenderTimes();
    }
    if (step === 3) { sbRenderSummary(); sbTireAckSync(); }
  };

  // ── Open modal ────────────────────────────────────────────────────────────
  window.openServiceModal = function (btn) {
    var pre = (btn.dataset.serviceName || '').toLowerCase();

    // Resolve the location BEFORE rendering. Override order:
    //   ?location=<slug>  →  data-location on the trigger  →  saved choice  →  is_primary
    sbInitLocations();
    var preferredLoc = '';
    try {
      var qp = new URLSearchParams(window.location.search).get('location');
      if (qp) preferredLoc = qp.toLowerCase();
    } catch (e) {}
    if (!preferredLoc && btn.dataset.location) preferredLoc = btn.dataset.location.toLowerCase();
    if (!preferredLoc) {
      try {
        var savedLoc = localStorage.getItem('pt-booking-location');
        if (savedLoc) preferredLoc = savedLoc.toLowerCase();
      } catch (e) {}
    }
    sbSt.location = sbDefaultLocationSlug(preferredLoc);

    // Match pre-selected service by name
    sbSt.service = '';
    if (pre) {
      // Order matters: more specific phrases checked first.
      var keywordMap = [
        ['installation_on',  ['season', 'changeover', 'swap', 'on rim', 'on-rim']],
        ['installation_off', ['install', 'mount', 'changeover-off', 'off rim', 'off-rim']],
        ['road_force_balancing', ['road force', 'road-force', 'roadforce']],
        ['balancing',        ['balanc']],
        ['rotation',         ['rotat']],
        ['flat_repair',      ['flat', 'patch', 'repair', 'puncture', 'leak']],
        ['tpms',             ['tpms', 'sensor']]
      ];
      keywordMap.forEach(function (entry) {
        var id = entry[0]; var kws = entry[1];
        kws.forEach(function (kw) { if (!sbSt.service && pre.indexOf(kw) > -1) sbSt.service = id; });
      });
    }

    sbSt.repairType = 'patch';
    sbSt.qty = 4;
    sbSt.vehicle = 'passenger';
    sbSt.addons = { disposal: false, tpms: false, lowProfile: false, roadForce: false };
    sbSt.oldTires = null;
    sbOldTiresError(false);
    sbTireAckReset();
    sbSt.savedVehicle = null;
    sbSt.date = null;
    sbSt.time = null;
    sbWk = 0;

    // Load saved vehicle
    try {
      var gKeys = Object.keys(localStorage).filter(function (k) { return k.startsWith('pt-garage-'); });
      for (var i = 0; i < gKeys.length; i++) {
        var gv = JSON.parse(localStorage.getItem(gKeys[i]));
        var gd = (gv || []).find(function (v) { return v.isDefault; });
        if (gd) { sbSt.savedVehicle = gd; break; }
      }
      var lv = localStorage.getItem('pt-booking-vehicle');
      if (lv && sbVehs.find(function (v) { return v.id === lv; })) sbSt.vehicle = lv;
    } catch (e) {}

    // Prefill contact
    try {
      var cust = window.__bkCustomer || {};
      var saved = JSON.parse(localStorage.getItem('pt-booking-contact') || 'null');
      document.getElementById('sb-name').value = cust.name || (saved && saved.name) || '';
      document.getElementById('sb-phone').value = cust.phone || (saved && saved.phone) || '';
      document.getElementById('sb-email').value = cust.email || (saved && saved.email) || '';
      document.getElementById('sb-notes').value = '';
    } catch (e) {}

    // Prefill vehicle details from the saved (searched) vehicle; mileage blank.
    try {
      var sv = sbSt.savedVehicle || {};
      document.getElementById('sb-vyear').value = sv.year ? String(sv.year).replace(/\D/g, '').slice(0, 4) : '';
      document.getElementById('sb-vmake').value = sv.make ? String(sv.make) : '';
      document.getElementById('sb-vmodel').value = sv.model ? String(sv.model) : '';
      document.getElementById('sb-odo').value = '';
      ['sb-field-vyear', 'sb-field-vmake', 'sb-field-vmodel', 'sb-field-odo'].forEach(function (id) {
        var f = document.getElementById(id); if (f) f.classList.remove('bk-field--error');
      });
    } catch (e) {}

    sbRenderLocations();
    sbRenderServices();
    // A pre-selected swap starts at the (saved) vehicle's set: 4, or 6 on a dually.
    sbSt.qtyByHand = false;
    if (sbSt.service === 'installation_on') sbSt.qty = sbDefaultQty();
    if (sbSt.service) { sbShowDetails(); sbUpdatePrice(); }
    sbUpdateNextBtn();
    // A pre-selected restricted service (road force) narrows the picker now.
    sbSyncLocation();

    sbGoTo(1);
    document.getElementById('sb-overlay').hidden = false;
    document.body.style.overflow = 'hidden';
  };

  // ── Close modal ───────────────────────────────────────────────────────────
  window.closeServiceModal = function () {
    document.getElementById('sb-overlay').hidden = true;
    document.body.style.overflow = '';
  };

  // ── Submit booking ────────────────────────────────────────────────────────
  window.sbSubmit = async function () {
    var name = document.getElementById('sb-name').value.trim();
    var phone = document.getElementById('sb-phone').value.trim();
    var email = document.getElementById('sb-email').value.trim();
    var notes = document.getElementById('sb-notes').value.trim();
    var errEl = document.getElementById('sb-form-error');
    ['sb-field-name', 'sb-field-phone', 'sb-field-email', 'sb-field-vyear', 'sb-field-odo'].forEach(function (id) { document.getElementById(id).classList.remove('bk-field--error'); });
    errEl.hidden = true;

    // Defensive: Tire Installation needs the old-tires answer (step 1 enforces
    // it; this catches any path around that). Send them back to the question.
    if (sbSt.service === 'installation_off' && !sbSt.oldTires) {
      sbGoTo(1);
      sbOldTiresError(true);
      try { document.getElementById('sb-oldtires-section').scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
      return;
    }

    // Required: name (2+), phone, a valid email — what /api/book rejects
    // without. Vehicle details are optional, but something typed wrong is
    // flagged. Own tires: the tread / date-code box. Each bad field gets a
    // red outline + one line under it, with a count at the top.
    var vin = sbReadVehicle();
    sbTireAckSync();
    var sbRules = PTBookingCore.req.contactRules(document.getElementById('sb-name'), document.getElementById('sb-phone'), document.getElementById('sb-email'));
    sbRules.push({ el: document.getElementById('sb-vyear'), kind: 'invalid', msg: 'Enter the year as 4 digits (e.g. 2019), or leave it blank', ok: function () { return !sbReadVehicle().yearBad; } });
    sbRules.push({ el: document.getElementById('sb-odo'), kind: 'invalid', msg: 'Enter the mileage as a number of km (e.g. 84,500), or leave it blank', ok: function () { return !sbReadVehicle().odoBad; } });
    if (sbTireAckAsked()) sbRules.push({ el: document.getElementById('sb-tire-ack-cb'), useEl: document.getElementById('sb-tire-ack-err'), msg: 'Tick the box to confirm you’ve checked your tires', ok: sbTireAckTicked });
    if (!PTBookingCore.req.check(document.getElementById('sb-page-3'), sbRules)) return;

    // Guard: date and time must be set (defensive — buttons should enforce this)
    if (!sbSt.date || !sbSt.time) {
      errEl.textContent = 'Please select a date and time before sending your request.';
      errEl.hidden = false;
      return;
    }

    // Own tires: the request is not sent until the tread / date-code box is ticked.
    sbTireAckSync();
    if (sbTireAckAsked() && !sbTireAckTicked()) {
      sbTireAckError(true);
      var ackCb = document.getElementById('sb-tire-ack-cb');
      try { document.getElementById('sb-tire-ack').scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
      if (ackCb) { try { ackCb.focus({ preventScroll: true }); } catch (e) {} }
      return;
    }

    var btn = document.getElementById('sb-confirm-btn');
    btn.disabled = true; btn.textContent = 'Sending…';

    var svc = sbServices.find(function (s) { return s.id === sbSt.service; });
    var veh = sbVehs.find(function (v) { return v.id === sbSt.vehicle; });
    var pr = sbCalcPrice();

    var sbParseAmt = function (str) { return str ? parseFloat(str.replace('$', '')) || 0 : 0; };

    // Build date string using local time to avoid UTC day-shift
    var d = sbSt.date;
    var dateStr = PTBookingCore.localISO(d);

    try {
      var payload = {
        bookType: 'service',
        location_id: sbSt.location || '',
        serviceName: svc ? svc.name : 'Service',
        serviceId:   sbSt.service,
        mountState:  sbSt.service === 'installation_off' ? 'off'
                  : sbSt.service === 'installation_on'  ? 'on' : '',
        repairType: sbSt.repairType || '',
        qty: sbQty(),
        tpms: sbSt.addons.tpms || false,
        // Old tires: 'keep' | 'dispose' on Tire Installation, null elsewhere.
        disposal: sbSt.service === 'installation_off' && sbSt.oldTires === 'dispose',
        oldTires: sbSt.service === 'installation_off' ? sbSt.oldTires : null,
        // Own tires: the customer ticked the tread / date-code check (required above).
        tireConditionAck: sbTireAckAsked() ? sbTireAckTicked() : null,
        lowProfile: sbSt.addons.lowProfile || false,
        customAddons: sbSelectedCatalogAddons(),
        name: name, phone: phone, email: email, notes: notes,
        vehicleType: sbSt.vehicle,
        // What the customer typed (pre-filled from the saved vehicle). Trim
        // only rides along while it is still the saved vehicle.
        vehicleYear: vin.year,
        vehicleMake: vin.make,
        vehicleModel: vin.model,
        vehicleTrim: (sbSameAsSaved(vin) ? (sbSt.savedVehicle.trim || '') : '') || (window.ptPickedTrim ? window.ptPickedTrim('sb-vmodel') : ''),
        odometerKm: vin.odometerKm,
        date: dateStr,
        time: sbSt.time,
        subtotal: pr ? sbParseAmt(pr.subtotal) : 0,
        gst:      pr ? sbParseAmt(pr.gst)      : 0,
        total:    pr ? sbParseAmt(pr.amount)    : 0,
        // Bot trap — empty for every real customer.
        company_website: (function () { var h = document.getElementById('sb-company-website'); return h ? String(h.value || '') : ''; })()
      };

      var res;
      try {
        if (window.PTBookingCore && window.PTBookingCore.bookingRef) { var ptRef = window.PTBookingCore.bookingRef(); if (ptRef) payload.ref = ptRef; }
        res = await fetch(BOOKING_API, { method: 'POST', mode: 'cors', credentials: 'omit', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } catch (netErr) {
        console.error('[service booking] network failure:', netErr);
        // The shop they picked — never SW's number for an NE customer.
        var shopPhone = ((sbCurrentLoc() || {}).phone) || '(403) 452-4283';
        var diagErr = new Error("Couldn't reach the booking server. This is usually a browser extension (ad-blocker, privacy tool) blocking the request, or an unstable network. Try: (1) disable extensions for this site, (2) open in a private window, (3) use a different browser, or call " + shopPhone + ".");
        diagErr.isNetworkError = true; throw diagErr;
      }
      if (!res.ok) {
        var ed = await res.json().catch(function () { return {}; });
        var shopPhone = ((sbCurrentLoc() || {}).phone) || '(403) 452-4283';
        if (res.status === 429) throw new Error("Too many bookings from this device — please wait a minute and try again.");
        // The shop's online bookings for that day are used up: phone, not another time.
        if (res.status === 409 && ed.error === 'online_full') throw new Error('Online booking is full for that day — please call ' + ((typeof ed.phone === 'string' && ed.phone) || shopPhone) + '.');
        if (res.status === 409) throw new Error("That time slot was just booked. Please pick another time.");
        // 402 is the platform switched off (a billing stop took the whole app
        // down for an hour on 2026-10-19); 5xx is it falling over. Neither is
        // fixed by retrying — give them the phone.
        if (res.status === 402 || res.status >= 500) throw new Error("Online booking is temporarily unavailable. Please call " + shopPhone + " to book — sorry for the trouble.");
        throw new Error(ed.error || ("Booking failed (HTTP " + res.status + ")"));
      }

      try {
        var bookData = await res.json().catch(function () { return {}; });
        // A01: store HMAC lookup token so customer can retrieve their own bookings
        if (bookData.lookupToken && email) {
          localStorage.setItem('pt-book-token-' + email.toLowerCase(), bookData.lookupToken);
        }
        localStorage.setItem('pt-booking-contact', JSON.stringify({ name: name, phone: phone, email: email, savedAt: new Date().toISOString() }));
        localStorage.setItem('pt-booking-vehicle', sbSt.vehicle);
      } catch (ex) {}

      // Done card — address/phone come from the SELECTED location (NAP fallback
      // via PTBookingCore.napOf so it matches the other booking surfaces).
      var nap = PTBookingCore.napOf(sbCurrentLoc());
      var doneAddr = nap.addressFull;
      var donePhone = nap.phone;
      var ds = sbSt.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + sbSt.time;
      var vehLabel = sbEsc(sbVehicleText(vin)) || (veh ? veh.name : '');
      var doneOldTires = sbOldTiresText();
      var subEl = document.getElementById('sb-done-sub');
      if (subEl) subEl.textContent = 'Requested at Prince Tires — ' + nap.address + '. We’ll confirm by email, usually within the day — your appointment isn’t final until you hear from us.';
      var doneH = '';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Service</span><span class="bk-summary-val">' + (svc ? svc.name : '—') + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Date & time</span><span class="bk-summary-val">' + ds + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Address</span><span class="bk-summary-val">' + doneAddr + '</span></div>';
      doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Phone</span><span class="bk-summary-val">' + donePhone + '</span></div>';
      if (doneOldTires) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Old tires</span><span class="bk-summary-val">' + doneOldTires + '</span></div>';
      if (vehLabel) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Vehicle</span><span class="bk-summary-val">' + vehLabel + '</span></div>';
      if (vin.odometerKm != null) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Mileage</span><span class="bk-summary-val">' + sbFmtKm(vin.odometerKm) + '</span></div>';
      if (pr) doneH += '<div class="bk-summary-row"><span class="bk-summary-label">Est. price</span><span class="bk-summary-val bk-summary-val--green">' + pr.amount + '</span></div>';
      document.getElementById('sb-done-card').innerHTML = doneH;

      [1, 2, 3].forEach(function (s) { document.getElementById('sb-page-' + s).hidden = true; });
      document.getElementById('sb-page-done').hidden = false;
      document.getElementById('sb-stepper').style.opacity = '0';

    } catch (err) {
      console.error('[service booking] submit failed:', err);
      btn.disabled = false; btn.textContent = 'Send request';
      errEl.textContent = err.message || ('Something went wrong. Please try again or call ' + (((sbCurrentLoc() || {}).phone) || '(403) 452-4283') + '.');
      errEl.hidden = false;
      try { errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
    }
  };

  // ── ICS download ──────────────────────────────────────────────────────────
  window.sbDownloadICS = function () {
    var svc = sbServices.find(function (s) { return s.id === sbSt.service; });
    var svcName = svc ? svc.name : 'Service';
    // LOCATION reflects the SELECTED shop; NAP fallback via PTBookingCore.napOf
    // so it matches the done card + the other booking surfaces.
    var icsLoc = PTBookingCore.napOf(sbCurrentLoc()).addressFull;
    var ics = PTBookingCore.buildICS({
      dateISO: PTBookingCore.localISO(sbSt.date),
      time: sbSt.time,
      durationMinutes: 60,
      summary: svcName + ' at Prince Tires',
      description: svcName + ' — requested. Not final until Prince Tires confirms by email.',
      location: icsLoc
    });
    if (ics) PTBookingCore.downloadICS(ics, 'prince-tires-service.ics');
  };

  // ── Event listeners ───────────────────────────────────────────────────────
  document.getElementById('sb-prev-week').addEventListener('click', function () { if (sbWk > 0) { sbWk--; sbRenderWeek(); } });
  document.getElementById('sb-next-week').addEventListener('click', function () { sbWk++; sbRenderWeek(); });

  // Step buttons explain what is missing instead of sitting greyed out
  // (owner, 2026-11-15). The existing disabled logic stays the source of
  // truth; `soft` keeps Next clickable so a click can say why.
  // pt-booking-core.js is deferred on every page but /pages/book (layout/
  // theme.liquid), so off that page it lands after this script: wait for it.
  (function wire() {
    var R = window.PTBookingCore && PTBookingCore.req;
    if (!R) {
      if (!wire.waiting && document.readyState === 'loading') { wire.waiting = true; document.addEventListener('DOMContentLoaded', wire); }
      return;
    }
    R.styles();
    R.gate(document.getElementById('sb-next-1'), document.getElementById('sb-page-1'), function () {
      var out = [{ el: document.getElementById('sb-service-grid'), msg: 'Pick a service', ok: function () { return !!sbSt.service; } }];
      if (sbSt.service === 'installation_off') out.push({ el: document.getElementById('sb-oldtires'), useEl: document.getElementById('sb-oldtires-err'), msg: 'Choose what we should do with your old tires', ok: function () { return sbSt.service !== 'installation_off' || !!sbSt.oldTires; } });
      return out;
    }, { soft: true });
    var n2 = document.getElementById('sb-next-2');
    var grid2 = document.getElementById('sb-time-grid');
    R.gate(n2, document.getElementById('sb-page-2'), function () {
      return [R.timeRule(grid2, function () { return !!sbSt.time; })];
    }, { soft: true, blockedMsg: function () { return { el: grid2, msg: 'Pick a time', ok: function () { return !n2.disabled; } }; } });
  })();
  document.getElementById('sb-overlay').addEventListener('click', function (e) { if (e.target === this) closeServiceModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !document.getElementById('sb-overlay').hidden) closeServiceModal(); });
  document.addEventListener('click', function (e) { var b = e.target.closest('[data-book-service]'); if (b) openServiceModal(b); });

  // ── Stage 2: pull the live service catalog (prices/durations are editable
  //    in the admin app). Fires on page load; sbApplyCatalog overlays the
  //    fallback values above. On any failure it silently keeps the fallback,
  //    so booking always works. See docs/phase-3.5-service-catalog.md.
  fetch(SERVICES_API)
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (data) { if (data && data.services) sbApplyCatalog(data.services); })
    .catch(function () {});
})();
</script>
