{% doc %}
  Sidebar filters for the tires collection — Season, Brand, Model,
  Product type, Tire width / Aspect / Rim pills, Service type,
  Studdable, Run flat, plus the price-range slider at the top and an
  active-filters chip bar.

  Mobile: this same aside slides in as a drawer when the customer taps
  the floating Filters button.

  All filter wiring (toggleFilter, isFilterActive, the price-slider
  handler, brand/model search, chip rendering) lives in the parent
  section's {% javascript %} block — this snippet is markup-only.

  Note: the price slider needs `price_max_rounded` from the parent
  section. The active-filter values (`active_vendor`, `active_season`,
  `active_type`, `active_price_min/max`) and the model list are computed
  in this snippet from `collection.filters`.

  @example
  {% render 'pt-collection-sidebar', price_max_rounded: 600 %}
{% enddoc %}

{%- comment -%}
  Active filter values, read from collection.filters: drives the Stud-option
  toggle (shown only for Winter or LT), pre-fills the price slider, and lets
  the Stud / Run-flat links carry the customer's other active filters.
{%- endcomment -%}
{%- liquid
  assign active_vendor = ''
  assign active_season = ''
  assign active_type = ''
  assign active_price_min = ''
  assign active_price_max = ''
  for f in collection.filters
    case f.param_name
      when 'filter.p.vendor'
        if f.active_values.size > 0
          assign active_vendor = f.active_values.first.value
        endif
      when 'filter.p.m.custom.seasonality'
        if f.active_values.size > 0
          assign active_season = f.active_values.first.value
        endif
      when 'filter.p.m.custom.service_type'
        if f.active_values.size > 0
          assign active_type = f.active_values.first.value
        endif
      when 'filter.v.price'
        if f.min_value.value != blank
          assign active_price_min = f.min_value.value
        endif
        if f.max_value.value != blank
          assign active_price_max = f.max_value.value
        endif
    endcase
  endfor
  # Detect whether this is the wheels collection — drives the sidebar to
  # hide tire-only filter groups (season, tire-type, aspect ratio, etc.)
  # and surface wheel-specific groups (bolt pattern, rim width, offset,
  # center bore) instead. Single source of truth: collection.handle.
  assign is_wheels = false
  if collection.handle == 'wheels'
    assign is_wheels = true
  endif
-%}

      <div class="ptg__sidebar-backdrop" data-filter-backdrop></div>
      <aside class="ptg__sidebar" data-sidebar>
        <div class="ptg__sidebar-mobile-head">
          <span class="ptg__sidebar-mobile-title">Filters</span>
          <button class="ptg__sidebar-close" data-close-filters>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        {%- comment -%} Tire Size editor — tire-only (parses tire-size syntax) {%- endcomment -%}
        {%- unless is_wheels -%}
        <div class="ptg__size-display" data-size-display>
          <span class="ptg__size-display-label">Tire size</span>
          <div class="ptg__size-display-row">
            <input type="text" class="ptg__size-display-input" value="" placeholder="e.g. 225/65R17" data-size-edit>
            <a href="{{ collection.url }}" class="ptg__size-display-clear" title="Clear size" data-size-clear-link hidden>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </a>
          </div>
        </div>
        {%- endunless -%}

        <div class="ptg__sidebar-head">
          <span class="ptg__sidebar-title">Filters</span>
        </div>

        <div class="ptg__active-filters" data-active-filters-sidebar hidden></div>

        {%- comment -%} Price Range Slider {%- endcomment -%}
        <div class="ptg__filter ptg__filter--open">
          <span class="ptg__filter-label ptg__filter-label--static">Price range</span>
          <div class="ptg__price-slider">
            <div class="ptg__price-values">
              <span data-price-min-display>${{ active_price_min | default: '0' }}</span>
              <span data-price-max-display>${{ active_price_max | default: price_max_rounded }}</span>
            </div>
            <div class="ptg__price-track">
              <input type="range" min="0" max="{{ price_max_rounded }}" value="{{ active_price_min | default: 0 }}" step="10" class="ptg__price-range ptg__price-range--min" data-price-min>
              <input type="range" min="0" max="{{ price_max_rounded }}" value="{{ active_price_max | default: price_max_rounded }}" step="10" class="ptg__price-range ptg__price-range--max" data-price-max>
            </div>
          </div>
        </div>

        {%- comment -%} Tire-only filter groups — hidden on /collections/wheels {%- endcomment -%}
        {%- unless is_wheels -%}

        {%- comment -%} Season Icons {%- endcomment -%}
        <details class="ptg__filter" open>
          <summary class="ptg__filter-label">
            Season
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options">
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.seasonality" data-filter-value="Summer">
              <span class="ptg__filter-check"></span>
              <span class="ptg__season-dot" style="background:#eab308"></span>
              Summer
              <span class="ptg__filter-cnt" data-filter-cnt="seasonality:summer"></span>
            </a>
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.seasonality" data-filter-value="All-Season">
              <span class="ptg__filter-check"></span>
              <span class="ptg__season-dot" style="background:#16a34a"></span>
              All-season
              <span class="ptg__filter-cnt" data-filter-cnt="seasonality:all-season"></span>
            </a>
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.seasonality" data-filter-value="All-Weather">
              <span class="ptg__filter-check"></span>
              <span class="ptg__season-dot" style="background:#F5820B"></span>
              All-weather <span class="ptg__filter-symbol">(3PMSF)</span>
              <span class="ptg__filter-cnt" data-filter-cnt="seasonality:all-weather"></span>
            </a>
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.seasonality" data-filter-value="Winter">
              <span class="ptg__filter-check"></span>
              <span class="ptg__season-dot" style="background:#2563eb"></span>
              Winter
              <span class="ptg__filter-cnt" data-filter-cnt="seasonality:winter"></span>
            </a>
          </div>
        </details>

        {%- comment -%} Tire Type {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Tire type
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options">
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.service_type" data-filter-value="P">
              <span class="ptg__filter-check"></span>
              Passenger <span class="ptg__filter-symbol">(P)</span>
            </a>
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.service_type" data-filter-value="LT">
              <span class="ptg__filter-check"></span>
              Light Truck <span class="ptg__filter-symbol">(LT)</span>
            </a>
            <a href="#" class="ptg__filter-link" data-filter-key="filter.p.m.custom.service_type" data-filter-value="ST">
              <span class="ptg__filter-check"></span>
              Trailer <span class="ptg__filter-symbol">(ST)</span>
            </a>
          </div>
        </details>

        {%- endunless -%}{%- comment -%} end tire-only: Season + Tire type {%- endcomment -%}

        {%- comment -%} Brand — scrollable (shared: tires + wheels) {%- endcomment -%}
        <details class="ptg__filter" open>
          <summary class="ptg__filter-label">
            Brand
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <input type="search" class="ptg__filter-search" data-brand-search placeholder="Search brands..." aria-label="Search brands">
          <div class="ptg__filter-options ptg__filter-options--scroll" data-brand-list>
            {%- comment -%}
              Pulled from collection.filters (Shopify's native filter facet) so
              every stocked vendor appears, with live product counts.
              Falls back to a hardcoded list if the native filter isn't
              available (e.g. on /search results or a metaobject page).
            {%- endcomment -%}
            {%- assign vendor_filter = blank -%}
            {%- for f in collection.filters -%}
              {%- if f.param_name == 'filter.p.vendor' -%}
                {%- assign vendor_filter = f -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if vendor_filter != blank -%}
              {%- for v in vendor_filter.values -%}
                <a href="#" class="ptg__filter-link" data-filter-key="filter.p.vendor" data-filter-value="{{ v.label | escape }}">
                  <span class="ptg__filter-check"></span>
                  {{ v.label }}
                  <span class="ptg__filter-cnt" data-filter-cnt="vendor:{{ v.label | handleize }}">({{ v.count }})</span>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- assign brand_list = 'BFGoodrich,Bridgestone,CARLSTAR,Continental,Cooper,Falken,Farroad,Firemax,Firestone,Fortune,General,Goodyear,Haida,Kumho,Linglong,Michelin,Mickey Thompson,Pirelli,Radar,Rotalla,Tesche,Toyo,Uniroyal,Yeada,Yokohama' | split: ',' -%}
              {%- for brand in brand_list -%}
                <a href="#" class="ptg__filter-link" data-filter-key="filter.p.vendor" data-filter-value="{{ brand }}">
                  <span class="ptg__filter-check"></span>
                  {{ brand }}
                  <span class="ptg__filter-cnt" data-filter-cnt="vendor:{{ brand | handleize }}"></span>
                </a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </details>

        {%- comment -%} Tire-only filter groups: Model + Product Type + Width + Aspect {%- endcomment -%}
        {%- unless is_wheels -%}

        {%- comment -%}
          Tire Model — sourced from collection.filters when the
          custom.tire_model metafield is configured under
          Shopify admin → Search & Discovery → Filters.
          Falls back to scanning collection.products for unique values
          if the storefront filter facet hasn't been set up yet.
          Hidden entirely when neither source returns any values.
        {%- endcomment -%}
        {%- assign model_filter = blank -%}
        {%- for f in collection.filters -%}
          {%- if f.param_name == 'filter.p.m.custom.tire_model' -%}
            {%- assign model_filter = f -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign model_values_fallback = '' -%}
        {%- if model_filter == blank -%}
          {%- for p in collection.products -%}
            {%- assign m = p.metafields.custom.tire_model -%}
            {%- if m != blank and m != nil -%}
              {%- assign mv = m | strip -%}
              {%- unless model_values_fallback contains mv -%}
                {%- assign model_values_fallback = model_values_fallback | append: mv | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if model_filter != blank or model_values_fallback != '' -%}
          <details class="ptg__filter" open>
            <summary class="ptg__filter-label">
              Model
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <input type="search" class="ptg__filter-search" data-model-search placeholder="Search models..." aria-label="Search models">
            <div class="ptg__filter-options ptg__filter-options--scroll" data-model-list>
              {%- if model_filter != blank -%}
                {%- for v in model_filter.values -%}
                  <a href="{{ collection.url }}?filter.p.m.custom.tire_model={{ v.label | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.tire_model" data-filter-value="{{ v.label | escape }}">
                    <span class="ptg__filter-check"></span>
                    {{ v.label }}
                    <span class="ptg__filter-cnt">({{ v.count }})</span>
                  </a>
                {%- endfor -%}
              {%- else -%}
                {%- assign mvals = model_values_fallback | split: '|' | uniq | sort -%}
                {%- for mv in mvals -%}
                  {%- if mv != '' -%}
                    <a href="{{ collection.url }}?filter.p.m.custom.tire_model={{ mv | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.tire_model" data-filter-value="{{ mv | escape }}">
                      <span class="ptg__filter-check"></span>
                      {{ mv }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- comment -%} Product Type {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Product type
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options">
            {%- assign ptypes = 'Heavy Duty,Performance,All-Terrain,Mud-Terrain,Highway Terrain' | split: ',' -%}
            {%- for pt in ptypes -%}
              <a href="#" class="ptg__filter-link" data-filter-key="filter.p.product_type" data-filter-value="{{ pt }}">
                <span class="ptg__filter-check"></span>
                {{ pt }}
                <span class="ptg__filter-cnt" data-filter-cnt="type:{{ pt | handleize }}"></span>
              </a>
            {%- endfor -%}
          </div>
        </details>

        {%- comment -%} Tire Width {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Tire width
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options ptg__filter-options--wrap">
            {%- assign widths = '155,165,175,185,195,205,215,225,235,245,255,265,275,285,295,305,315,325' | split: ',' -%}
            {%- for w in widths -%}
              <a href="#" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.tire_width" data-filter-set-value="{{ w }}">{{ w }}</a>
            {%- endfor -%}
          </div>
        </details>

        {%- comment -%} Aspect Ratio {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Aspect ratio
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options ptg__filter-options--wrap">
            {%- assign aspects = '30,35,40,45,50,55,60,65,70,75,80,85' | split: ',' -%}
            {%- for a in aspects -%}
              <a href="#" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.tire_profile" data-filter-set-value="{{ a }}">{{ a }}</a>
            {%- endfor -%}
          </div>
        </details>

        {%- endunless -%}{%- comment -%} end tire-only: Model + Type + Width + Aspect {%- endcomment -%}

        {%- comment -%} ════════════════════════════════════════════
             WHEEL-ONLY FILTERS — only render on /collections/wheels.
             Pull facet values from collection.filters (storefront
             filter, configured in Search & Discovery) when available;
             fall back to scanning collection.products[].metafields.custom
             so the filter still works before the admin step is done.
             ════════════════════════════════════════════ {%- endcomment -%}
        {%- if is_wheels -%}

        {%- comment -%} Bolt pattern (5x114.3, 6x139.7, etc.) {%- endcomment -%}
        {%- assign bolt_filter = blank -%}
        {%- for f in collection.filters -%}
          {%- if f.param_name == 'filter.p.m.custom.bolt_pattern' -%}
            {%- assign bolt_filter = f -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign bolt_fallback = '' -%}
        {%- if bolt_filter == blank -%}
          {%- for p in collection.products -%}
            {%- assign bp = p.metafields.custom.bolt_pattern -%}
            {%- if bp != blank -%}
              {%- assign bpv = bp | strip -%}
              {%- unless bolt_fallback contains bpv -%}
                {%- assign bolt_fallback = bolt_fallback | append: bpv | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if bolt_filter != blank or bolt_fallback != '' -%}
          <details class="ptg__filter" open>
            <summary class="ptg__filter-label">
              Bolt pattern
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="ptg__filter-options">
              {%- if bolt_filter != blank -%}
                {%- for v in bolt_filter.values -%}
                  <a href="{{ collection.url }}?filter.p.m.custom.bolt_pattern={{ v.label | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.bolt_pattern" data-filter-value="{{ v.label | escape }}">
                    <span class="ptg__filter-check"></span>
                    {{ v.label }}
                    <span class="ptg__filter-cnt">({{ v.count }})</span>
                  </a>
                {%- endfor -%}
              {%- else -%}
                {%- assign bvals = bolt_fallback | split: '|' | uniq | sort -%}
                {%- for bv in bvals -%}
                  {%- if bv != '' -%}
                    <a href="{{ collection.url }}?filter.p.m.custom.bolt_pattern={{ bv | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.bolt_pattern" data-filter-value="{{ bv | escape }}">
                      <span class="ptg__filter-check"></span>
                      {{ bv }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- comment -%} Rim width (the second number in 17x7.5) {%- endcomment -%}
        {%- assign width_filter = blank -%}
        {%- for f in collection.filters -%}
          {%- if f.param_name == 'filter.p.m.custom.rim_width' -%}
            {%- assign width_filter = f -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign width_fallback = '' -%}
        {%- if width_filter == blank -%}
          {%- for p in collection.products -%}
            {%- assign rw = p.metafields.custom.rim_width -%}
            {%- if rw != blank -%}
              {%- assign rwv = rw | strip -%}
              {%- unless width_fallback contains rwv -%}
                {%- assign width_fallback = width_fallback | append: rwv | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if width_filter != blank or width_fallback != '' -%}
          <details class="ptg__filter">
            <summary class="ptg__filter-label">
              Rim width
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="ptg__filter-options ptg__filter-options--wrap">
              {%- if width_filter != blank -%}
                {%- for v in width_filter.values -%}
                  <a href="{{ collection.url }}?filter.p.m.custom.rim_width={{ v.label | url_encode }}" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.rim_width" data-filter-set-value="{{ v.label | escape }}">{{ v.label }}"</a>
                {%- endfor -%}
              {%- else -%}
                {%- assign wvals = width_fallback | split: '|' | uniq | sort -%}
                {%- for wv in wvals -%}
                  {%- if wv != '' -%}
                    <a href="{{ collection.url }}?filter.p.m.custom.rim_width={{ wv | url_encode }}" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.rim_width" data-filter-set-value="{{ wv | escape }}">{{ wv }}"</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- comment -%} Rim offset / ET — can be negative {%- endcomment -%}
        {%- assign offset_filter = blank -%}
        {%- for f in collection.filters -%}
          {%- if f.param_name == 'filter.p.m.custom.rim_offset' -%}
            {%- assign offset_filter = f -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign offset_fallback = '' -%}
        {%- if offset_filter == blank -%}
          {%- for p in collection.products -%}
            {%- assign ro = p.metafields.custom.rim_offset -%}
            {%- if ro != blank -%}
              {%- assign rov = ro | strip -%}
              {%- unless offset_fallback contains rov -%}
                {%- assign offset_fallback = offset_fallback | append: rov | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if offset_filter != blank or offset_fallback != '' -%}
          <details class="ptg__filter">
            <summary class="ptg__filter-label">
              Offset (ET)
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="ptg__filter-options ptg__filter-options--wrap">
              {%- if offset_filter != blank -%}
                {%- for v in offset_filter.values -%}
                  <a href="{{ collection.url }}?filter.p.m.custom.rim_offset={{ v.label | url_encode }}" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.rim_offset" data-filter-set-value="{{ v.label | escape }}">ET{{ v.label }}</a>
                {%- endfor -%}
              {%- else -%}
                {%- assign ovals = offset_fallback | split: '|' | uniq | sort -%}
                {%- for ov in ovals -%}
                  {%- if ov != '' -%}
                    <a href="{{ collection.url }}?filter.p.m.custom.rim_offset={{ ov | url_encode }}" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.rim_offset" data-filter-set-value="{{ ov | escape }}">ET{{ ov }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- comment -%} Center bore (hub bore, mm — matters for hub-centric fitment) {%- endcomment -%}
        {%- assign cb_filter = blank -%}
        {%- for f in collection.filters -%}
          {%- if f.param_name == 'filter.p.m.custom.center_bore' -%}
            {%- assign cb_filter = f -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign cb_fallback = '' -%}
        {%- if cb_filter == blank -%}
          {%- for p in collection.products -%}
            {%- assign cb = p.metafields.custom.center_bore -%}
            {%- if cb != blank -%}
              {%- assign cbv = cb | strip -%}
              {%- unless cb_fallback contains cbv -%}
                {%- assign cb_fallback = cb_fallback | append: cbv | append: '|' -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if cb_filter != blank or cb_fallback != '' -%}
          <details class="ptg__filter">
            <summary class="ptg__filter-label">
              Center bore (mm)
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="ptg__filter-options">
              {%- if cb_filter != blank -%}
                {%- for v in cb_filter.values -%}
                  <a href="{{ collection.url }}?filter.p.m.custom.center_bore={{ v.label | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.center_bore" data-filter-value="{{ v.label | escape }}">
                    <span class="ptg__filter-check"></span>
                    {{ v.label }} mm
                    <span class="ptg__filter-cnt">({{ v.count }})</span>
                  </a>
                {%- endfor -%}
              {%- else -%}
                {%- assign cbvals = cb_fallback | split: '|' | uniq | sort -%}
                {%- for cv in cbvals -%}
                  {%- if cv != '' -%}
                    <a href="{{ collection.url }}?filter.p.m.custom.center_bore={{ cv | url_encode }}" class="ptg__filter-link" data-filter-key="filter.p.m.custom.center_bore" data-filter-value="{{ cv | escape }}">
                      <span class="ptg__filter-check"></span>
                      {{ cv }} mm
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- endif -%}{%- comment -%} end wheel-only filters {%- endcomment -%}

        {%- comment -%} Rim Diameter — shared (tires + wheels both use rim_diameter) {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Rim diameter
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options ptg__filter-options--wrap">
            {%- assign rims = '13,14,15,16,17,18,19,20,22,24' | split: ',' -%}
            {%- for r in rims -%}
              <a href="#" class="ptg__filter-pill" data-filter-set-key="filter.p.m.custom.rim_diameter" data-filter-set-value="{{ r }}">{{ r }}"</a>
            {%- endfor -%}
          </div>
        </details>

        {%- comment -%} Availability {%- endcomment -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Availability
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options">
            <a href="#" class="ptg__filter-link" data-filter-set-key="filter.v.availability" data-filter-set-value="1">In stock</a>
            <a href="#" class="ptg__filter-link" data-filter-set-key="filter.v.availability" data-filter-set-value="0">Out of stock</a>
          </div>
        </details>

        {%- comment -%} Stud Option — tire-only (Winter or LT) {%- endcomment -%}
        {%- liquid
          assign show_stud = false
          unless is_wheels
            if active_season == 'Winter'
              assign show_stud = true
            endif
            if active_type == 'LT'
              assign show_stud = true
            endif
          endunless
        -%}
        {%- if show_stud -%}
          <details class="ptg__filter" open>
            <summary class="ptg__filter-label">
              Stud option
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="ptg__filter-options">
              <a href="{{ collection.url }}?filter.p.m.custom.stud_option=Studdable{% if active_vendor != blank %}&filter.p.vendor={{ active_vendor | url_encode }}{% endif %}{% if active_season != blank %}&filter.p.m.custom.seasonality={{ active_season | url_encode }}{% endif %}{% if active_type != blank %}&filter.p.m.custom.service_type={{ active_type | url_encode }}{% endif %}" class="ptg__filter-link">Studdable</a>
              <a href="{{ collection.url }}?filter.p.m.custom.stud_option=Non-Studdable{% if active_vendor != blank %}&filter.p.vendor={{ active_vendor | url_encode }}{% endif %}{% if active_season != blank %}&filter.p.m.custom.seasonality={{ active_season | url_encode }}{% endif %}{% if active_type != blank %}&filter.p.m.custom.service_type={{ active_type | url_encode }}{% endif %}" class="ptg__filter-link">Non-studdable</a>
            </div>
          </details>
        {%- endif -%}

        {%- comment -%} Run Flat — tire-only {%- endcomment -%}
        {%- unless is_wheels -%}
        <details class="ptg__filter">
          <summary class="ptg__filter-label">
            Run flat
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="ptg__filter-options">
            <a href="{{ collection.url }}?filter.p.m.custom.run_flat=Yes{% if active_vendor != blank %}&filter.p.vendor={{ active_vendor | url_encode }}{% endif %}{% if active_season != blank %}&filter.p.m.custom.seasonality={{ active_season | url_encode }}{% endif %}" class="ptg__filter-link">Run flat only</a>
          </div>
        </details>
        {%- endunless -%}

      </aside>
