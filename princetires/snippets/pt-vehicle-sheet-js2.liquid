        var f = Array.prototype.filter.call(sheet.querySelectorAll('button, input, a[href]'), function (el) { return el.offsetParent && el.tabIndex !== -1 && !el.closest('.out-fwd, .out-back'); });
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      }
    });

    /* swipe down to close (phones) */
    var y0 = null, dy = 0;
    var handle = wrap.querySelector('.ptvs__head');
    [handle, wrap.querySelector('.ptvs__grab')].forEach(function (h) {
      h.addEventListener('touchstart', function (e) { y0 = e.touches[0].clientY; dy = 0; wrap.classList.add('is-dragging'); }, { passive: true });
    });
    window.addEventListener('touchmove', function (e) {
      if (y0 === null) return;
      dy = Math.max(0, e.touches[0].clientY - y0);
      sheet.style.transform = 'translateY(' + dy + 'px)';
    }, { passive: true });
    window.addEventListener('touchend', function () {
      if (y0 === null) return;
      y0 = null; wrap.classList.remove('is-dragging');
      if (dy > 110) close(); else sheet.style.transform = '';
    });
  }

  function mergePills() {
    Array.prototype.forEach.call(document.querySelectorAll('.pt-scene__meta'), function (meta) {
      if (meta.hasAttribute('data-pt-merged')) return;
      var eb = meta.querySelector('.pt-scene__eyebrow'), t = meta.querySelector('[data-pt-temp]');
      if (!eb || !t) return;
      meta.setAttribute('data-pt-merged', '');
      var out = document.createElement('span');
      out.className = 'ptvs-temp';
      eb.appendChild(out);
      function sync() { var m = (t.textContent || '').match(/-?\d+\s*°\s*[CF]?/); out.textContent = m ? m[0].replace(/\s+/g, '') : ''; out.hidden = !m; }
      sync();
      try { new MutationObserver(sync).observe(t, { childList: true, characterData: true, subtree: true }); } catch (e) {}
    });
  }

  function init() {
    mergePills();
    Array.prototype.forEach.call(document.querySelectorAll('[data-vehicle-picker]'), function (root) {
      setup({ kind: 'tires', root: root, mount: root,
        sel: { year: root.querySelector('[data-vp-year]'), make: root.querySelector('[data-vp-make]'), model: root.querySelector('[data-vp-model]'), trim: root.querySelector('[data-vp-trim]') },
        hide: [root.querySelector('.hero-smart-search__picker-selects'), root.querySelector('.hero-smart-search__picker-label')] });
    });
    Array.prototype.forEach.call(document.querySelectorAll('[data-pt-ws]'), function (w) {
      var panel = w.querySelector('[data-pt-ws-panel="vehicle"]');
      if (!panel) return;
      var submit = w.querySelector('[data-pt-ws-submit-vehicle]');
      var hide = Array.prototype.filter.call(panel.querySelectorAll('.pt-ws__row'), function (r) { return r.querySelector('select'); });
      if (submit) hide.push(submit.closest('.pt-ws__actions') || submit);
      setup({ kind: w.classList.contains('pt-ws--package') ? 'packages' : 'wheels', root: w, mount: panel, submit: submit, section: w, hide: hide,
        sel: { year: panel.querySelector('[data-pt-ws-year]'), make: panel.querySelector('[data-pt-ws-make]'), model: panel.querySelector('[data-pt-ws-model]'), trim: panel.querySelector('[data-pt-ws-trim]') } });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('shopify:section:load', init);
})();
</script>
