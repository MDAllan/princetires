    function sizeOf(text) { var m = String(text).match(/(?:HL|LT|ST|P)?\d{2,3}\/\d{2}Z?RF?\d{2}(?:\.\d)?(?:\/[A-Z]\b|C\b)?|\d{2}[xX]\d{1,2}\.\d{2}R\d{2}(?:LT(?:\/[A-Z]\b)?)?|\d{3}R\d{2}(?:LT\b|C\b)?/i); return m ? m[0] : ''; }
