{% doc %}
  Compare tray + side-by-side table for the tire and wheel results pages
  (redesign 2026-11-13, mockups Main / WheelResults .dc.html: the black
  pill "2 tires selected · Clear · Compare side by side").

  Customers tick the `.ptg__compare-check` checkbox on a card
  (snippets/pt-collection-card). Up to 3. The table shows only facts the
  product carries - no scores, no radar, nothing inferred (owner rule
  2026-11-13: the old hexagon invented snow / comfort / durability scores).
    Tires:  Brand, Model, Size, Season, Price / tire, Set of 4, Speed rating,
            Load index, Warranty, Ready
    Wheels: Brand, Model, Size, Bolt pattern, Offset, Centre bore, Finish,
            Price / wheel, Set of 4, Ready
  Mixed tires and wheels: the shared rows only. Desktop only (the card hides
  the checkbox below 750px, as before).

  @example
  {% if section.settings.enable_compare %}
    {% render 'pt-collection-compare' %}
  {% endif %}
{% enddoc %}
<div class="rd rd-cmp-tray" data-compare-tray hidden>
  <span class="rd-cmp-tray__label" data-compare-label aria-live="polite"></span>
  <button type="button" class="rd-cmp-tray__clear" data-compare-clear>Clear</button>
  <button type="button" class="rd-cmp-tray__go" data-compare-open disabled>Compare side by side</button>
</div>

<div class="rd rd-cmp" data-compare-modal hidden>
  <div class="rd-cmp__backdrop" data-compare-modal-close></div>
  <div class="rd-cmp__panel" role="dialog" aria-modal="true" aria-labelledby="rd-cmp-title" tabindex="-1">
    <div class="rd-cmp__head">
      <h2 class="rd-cmp__title" id="rd-cmp-title" data-compare-heading>Compare</h2>
      <button type="button" class="rd-iconbtn rd-iconbtn--bare" data-compare-modal-close aria-label="Close comparison">{% render 'pt-icon', name: 'close', size: 22 %}</button>
    </div>
    <div class="rd-cmp__body" data-compare-table></div>
    <p class="rd-cmp__note">Prices are before GST. Only facts listed on each product are shown.</p>
  </div>
</div>

<script>
(function () {
  if (window.__rdCompare) return;
  window.__rdCompare = true;
  var tray = document.querySelector('[data-compare-tray]');
  var label = document.querySelector('[data-compare-label]');
  var openBtn = document.querySelector('[data-compare-open]');
  var clearBtn = document.querySelector('[data-compare-clear]');
  var modal = document.querySelector('[data-compare-modal]');
  var panel = modal ? modal.querySelector('.rd-cmp__panel') : null;
  var tableWrap = document.querySelector('[data-compare-table]');
  var titleEl = document.querySelector('[data-compare-heading]');
  if (!tray || !modal) return;

  var MAX = 3;
  var list = [];
  var opener = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function allWheels() { return list.length > 0 && list.every(function (i) { return i.wheel; }); }
  function noneWheels() { return list.every(function (i) { return !i.wheel; }); }
  function noun(n) {
    var w = allWheels() ? 'wheel' : (noneWheels() ? 'tire' : 'item');
    return n + ' ' + w + (n === 1 ? '' : 's');
  }

  function update() {
    if (!list.length) { tray.hidden = true; return; }
    tray.hidden = false;
    label.textContent = noun(list.length) + ' selected' + (list.length === MAX ? ' (most we can compare)' : '');
    openBtn.disabled = list.length < 2;
    openBtn.textContent = list.length < 2 ? 'Pick one more to compare' : 'Compare side by side';
  }

  function read(cb) {
    var d = cb.dataset;
    return {
      id: d.compareId, title: d.compareTitle, vendor: d.compareVendor, price: d.comparePrice,
      setPrice: d.compareSet, img: d.compareImg, size: d.compareSize, url: d.compareUrl,
      season: d.compareSeason, type: d.compareType, speed: d.compareSpeed, load: d.compareLoad,
      warranty: d.compareWarranty, wheel: d.compareWheel === 'true', bolt: d.compareBolt,
      offset: d.compareOffset, bore: d.compareBore, finish: d.compareFinish, lead: d.compareLead
    };
  }

  document.addEventListener('change', function (e) {
    var cb = e.target;
    if (!cb.classList || !cb.classList.contains('ptg__compare-check')) return;
    var id = cb.dataset.compareId;
    if (cb.checked) {
      if (list.length >= MAX) { cb.checked = false; label.textContent = 'You can compare up to ' + MAX + ' at a time.'; return; }
      if (!list.some(function (i) { return i.id === id; })) list.push(read(cb));
    } else {
      list = list.filter(function (i) { return i.id !== id; });
    }
    update();
  });

  clearBtn.addEventListener('click', function () {
    list = [];
    document.querySelectorAll('.ptg__compare-check').forEach(function (cb) { cb.checked = false; });
    update();
  });

  function build() {
    var wheels = allWheels();
    var tires = noneWheels();
    var unit = wheels ? 'wheel' : (tires ? 'tire' : 'item');
    var rows = [
      { label: 'Brand', key: 'vendor' },
      { label: 'Model', key: 'title' },
      { label: 'Size', key: 'size' }
    ];
    if (tires) rows.push({ label: 'Season', key: 'season' });
    if (wheels) {
      rows.push({ label: 'Bolt pattern', key: 'bolt' });
      rows.push({ label: 'Offset', key: 'offset' });
      rows.push({ label: 'Centre bore', key: 'bore' });
      rows.push({ label: 'Finish', key: 'finish' });
      rows.push({ label: 'Winter approved', key: 'season' });
    }
    rows.push({ label: 'Price / ' + unit, key: 'price', money: true, strong: true });
    rows.push({ label: 'Set of 4', key: 'setPrice', money: true });
    if (tires) {
      rows.push({ label: 'Speed rating', key: 'speed' });
      rows.push({ label: 'Load index', key: 'load' });
      rows.push({ label: 'Warranty', key: 'warranty' });
    }
    rows.push({ label: 'Ready', key: 'lead' });
    // Drop a row nobody has data for.
    rows = rows.filter(function (r) { return list.some(function (i) { return i[r.key]; }); });

    var h = '<div class="rd-cmp__scroll"><table class="rd-cmp__table"><thead><tr><th scope="col"><span class="rd-sr">Detail</span></th>';
    list.forEach(function (i) {
      h += '<th scope="col">' + (i.img ? '<img src="' + esc(i.img) + '" alt="" width="96" height="96" loading="lazy">' : '') +
        '<span class="rd-cmp__name">' + esc(i.vendor) + ' ' + esc(i.title) + '</span></th>';
    });
    h += '</tr></thead><tbody>';
    rows.forEach(function (r) {
      h += '<tr><th scope="row">' + esc(r.label) + '</th>';
      list.forEach(function (i) {
        var v = i[r.key];
        if (r.key === 'season' && wheels) v = v ? 'Yes' : '';
        var out = v ? (r.money ? '$' + esc(v) : esc(v)) : '—';
        h += '<td' + (r.strong ? ' class="rd-cmp__price"' : '') + '>' + out + '</td>';
      });
      h += '</tr>';
    });
    h += '<tr><th scope="row"><span class="rd-sr">Link</span></th>';
    list.forEach(function (i) {
      h += '<td><a class="rd-cmp__link" href="' + esc(i.url) + '">View ' + (i.wheel ? 'wheel' : 'tire') + ' →</a></td>';
    });
    h += '</tr></tbody></table></div>';
    tableWrap.innerHTML = h;
    if (titleEl) titleEl.textContent = 'Compare ' + (wheels ? 'wheels' : (tires ? 'tires' : 'products'));
  }

  function open() {
    if (list.length < 2) return;
    opener = document.activeElement;
    build();
    modal.hidden = false;
    document.documentElement.classList.add('rd-lock');
    if (panel) panel.focus();
  }
  function close() {
    if (modal.hidden) return;
    modal.hidden = true;
    document.documentElement.classList.remove('rd-lock');
    if (opener && opener.focus) opener.focus();
  }
  openBtn.addEventListener('click', open);
  modal.querySelectorAll('[data-compare-modal-close]').forEach(function (el) { el.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
})();
</script>
