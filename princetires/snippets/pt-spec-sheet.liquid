{%- comment -%}
  Prince Tires — spec popups (Nov 8, 2026): "Search by wheel specs" (Wheels tab) and
  "I know my tire size and bolt pattern" (Packages tab). Reuses the .ptvs sheet styles
  from pt-vehicle-sheet. Script split across pt-spec-sheet-js / -js2 (Shopify upload size limit).
{%- endcomment -%}
<style>
  .ptvs-on [data-pt-ws-panel].is-active { display: block !important; }
  .ptvs-on [data-pt-ws-panel] > .ptvs-trigger, .ptvs-on [data-pt-ws-panel] > .ptvs-alt { flex: 0 0 100%; width: 100%; max-width: 560px; margin-left: auto; margin-right: auto; }
  .ptvs__tile small { display: block; font-size: 12px; font-weight: 400; color: #98989f; margin-top: 3px; }
  .ptvs__tile.is-picked small { color: #ffd0d0; }
  .ptvs-alt { all: unset; box-sizing: border-box; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; max-width: 560px;
    margin: 10px auto 0; padding: 8px; font-size: 14px; color: rgba(255,255,255,.82); text-decoration: underline; text-underline-offset: 3px; font-family: inherit; white-space: normal; text-align: center; }
  .ptvs-alt--solid { color: #1c1c1e; }
  .ptvs-alt:hover { color: #fff; }
  .ptvs-alt--solid:hover { color: #dc2626; }
  .ptvs__field { all: unset; box-sizing: border-box; width: 100%; height: 60px; padding: 0 18px; border-radius: 14px; background: #2c2c2e; color: #fff;
    font-size: 24px; font-weight: 600; letter-spacing: .02em; font-family: inherit; text-transform: uppercase; border: 2px solid transparent; transition: border-color .2s; }
  .ptvs__field:focus { border-color: #dc2626; }
  .ptvs__field::placeholder { color: #5a5a5f; }
  .ptvs__err { color: #ff6b6b; font-size: 14px; margin: 8px 2px 0; min-height: 20px; }
  .ptvs__hint { color: #98989f; font-size: 14px; margin: -8px 2px 14px; }
  .ptvs__skip { all: unset; cursor: pointer; display: block; margin: 14px auto 0; padding: 8px 12px; font-size: 15px; color: #ff8a8a; }
  .ptvs__now { position: sticky; bottom: -28px; margin: 16px -16px -28px; padding: 18px 16px 24px; background: linear-gradient(rgba(28,28,30,0), #1c1c1e 28%); animation: ptvs-rise .4s cubic-bezier(.32,.72,0,1) both; }
  .ptvs__now span { display: block; font-size: 13px; font-weight: 400; opacity: .85; margin-top: 2px; }
  .ptvs__sum { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; text-align: left; }
  .ptvs__sum div { background: #2c2c2e; border-radius: 14px; padding: 12px 14px; }
  .ptvs__sum small { display: block; font-size: 12px; color: #98989f; }
  .ptvs__sum b { font-size: 18px; font-weight: 600; }
  .ptvs__cta + .ptvs__cta2 { margin-top: 8px; }
  .ptvs__cta2 { all: unset; box-sizing: border-box; cursor: pointer; display: block; width: 100%; text-align: center; padding: 14px; border-radius: 14px;
    background: #2c2c2e; color: #fff; font-size: 16px; font-weight: 600; transition: transform .22s cubic-bezier(.2,.8,.2,1); }
  .ptvs__cta2:active { transform: scale(.97); }
  .ptvs-float { position: fixed; left: 50%; bottom: 18px; z-index: 2147482000; transform: translateX(-50%); display: flex; align-items: center; gap: 10px;
    background: #1c1c1e; color: #fff; border-radius: 999px; padding: 8px 8px 8px 16px; box-shadow: 0 10px 30px rgba(0,0,0,.3); font-size: 14px;
    animation: ptvs-rise .5s cubic-bezier(.32,.72,0,1) both; max-width: calc(100vw - 24px); white-space: nowrap; }
  .ptvs-float a { background: #dc2626; color: #fff; text-decoration: none; border-radius: 999px; padding: 8px 14px; font-weight: 600; }
  .ptvs-float button { all: unset; cursor: pointer; padding: 6px 8px; opacity: .6; font-size: 18px; line-height: 1; }
</style>
{%- render 'pt-spec-sheet-js' -%}
{%- render 'pt-spec-sheet-js2' -%}