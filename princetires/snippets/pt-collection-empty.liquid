{% doc %}
  Empty state for the tire and wheel results pages (restyled 2026-11-13, mockup Main.dc.html) — shown when no products match
  the active filters. Includes a 'Clear all filters' shortcut and a
  miniature missing-vehicle form that POSTs to the same Google Sheet
  webhook used by the homepage smart-search and the tire-search widget.

  Also auto-fires the webhook on page load when the customer arrived
  with size filters but got zero results — captures the demand without
  requiring the customer to type anything. Dedup via sessionStorage so
  it only fires once per size combination per tab.

  @param {boolean} [is_wheels] - wheel collection: wheel wording, no tire-size demand capture

  @example
  {% render 'pt-collection-empty', is_wheels: is_wheels %}
{% enddoc %}

{%- assign empty_webhook = settings.missing_vehicle_webhook_url -%}

<div class="rd-empty ptg__empty" data-ptg-empty data-webhook="{{ empty_webhook | escape }}"{% if is_wheels %} data-wheels{% endif %}>
  <p class="rd-empty__title">No {% if is_wheels %}wheels{% else %}tires{% endif %} match these filters</p>
  <p class="rd-empty__sub">{% if is_wheels %}Try another size, or call us and we'll find one that fits.{% else %}Try another season or size, or call us and we'll find one.{% endif %}</p>
  <div class="rd-empty__actions">
    <a href="#" class="rd-btn rd-btn--line" data-clear-all-empty>Clear all filters</a>
    {%- if is_wheels -%}
      <a href="{{ routes.collections_url }}/wheels" class="rd-btn rd-btn--text">Show all wheels</a>
    {%- else -%}
      <a href="{{ routes.collections_url }}/tires" class="rd-btn rd-btn--text">Show all tires</a>
    {%- endif -%}
  </div>
  {%- if empty_webhook != blank -%}
    <div class="rd-empty__missing">
      <label class="rd-empty__missing-h" for="rd-empty-missing">Don't see the {% if is_wheels %}wheel{% else %}tire{% endif %} you need?</label>
      <form class="rd-empty__form" data-empty-missing-form>
        <input type="text" id="rd-empty-missing" class="rd-input" placeholder="{% if is_wheels %}e.g. 2018 Ford F-150, 18 inch, 6x135{% else %}e.g. 2018 Subaru Crosstrek or 225/45R17{% endif %}" maxlength="120" required>
        <button type="submit" class="rd-btn rd-btn--dark">Tell us</button>
      </form>
      <p class="rd-empty__status" data-empty-missing-status aria-live="polite" hidden></p>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Styles: assets/pt-rd-results.css (.rd-empty, redesign 2026-11-13). {%- endcomment -%}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-ptg-empty]');
    if (!root) return;
    var webhook = root.dataset.webhook || '';

    // ─── "Clear all filters" CTA ───────────────────────────────────────
    var clearBtn = root.querySelector('[data-clear-all-empty]');
    if (clearBtn) clearBtn.addEventListener('click', function (e) {
      e.preventDefault();
      window.location.href = window.location.pathname;
    });

    // ─── Auto-fire webhook when customer landed with size filters ──────
    // Only fires once per unique size combo per tab (sessionStorage dedup).
    try {
      var params = new URLSearchParams(window.location.search);
      var w = params.get('filter.p.m.custom.tire_width');
      var a = params.get('filter.p.m.custom.tire_profile');
      var r = params.get('filter.p.m.custom.rim_diameter');
      if (webhook && !root.hasAttribute('data-wheels') && (w || a || r)) {
        var sizeStr = (w || '?') + '/' + (a || '?') + 'R' + (r || '?');
        var dedupKey = '__pt_empty_' + sizeStr;
        if (!sessionStorage.getItem(dedupKey)) {
          sessionStorage.setItem(dedupKey, '1');
          fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              vehicle:    'OUT OF STOCK: ' + sizeStr,
              year: '', make: '', model: '', trim: '',
              page_url:   window.location.href,
              user_agent: navigator.userAgent,
              timestamp:  new Date().toISOString()
            })
          }).catch(function () { /* best-effort */ });
        }
      }
    } catch (e) { /* never break the page */ }

    // ─── Missing-vehicle mini-form ────────────────────────────────────
    var form = root.querySelector('[data-empty-missing-form]');
    var status = root.querySelector('[data-empty-missing-status]');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = form.querySelector('input');
      var vehicle = (input.value || '').trim();
      if (!vehicle) return;
      var btn = form.querySelector('button');
      var orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending...';
      function setStatus(msg, kind) {
        status.textContent = msg;
        status.className = 'rd-empty__status' + (kind ? ' is-' + kind : '');
        status.hidden = !msg;
      }
      if (!webhook) {
        window.location.href = 'mailto:info@princetires.ca?subject=' + encodeURIComponent('Missing tire: ' + vehicle) +
          '&body=' + encodeURIComponent('Tire request: ' + vehicle + '\nPage: ' + window.location.href);
        btn.disabled = false; btn.textContent = orig;
        return;
      }
      fetch(webhook, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          vehicle:    'EMPTY-COLLECTION: ' + vehicle,
          year: '', make: '', model: '', trim: '',
          page_url:   window.location.href,
          user_agent: navigator.userAgent,
          timestamp:  new Date().toISOString()
        })
      }).then(function (r) {
        if (r.ok || r.status === 302) {
          setStatus("Thanks — we'll be in touch.", 'success');
          input.value = '';
        } else { throw new Error('HTTP ' + r.status); }
      }).catch(function () {
        setStatus("Couldn't send — opening your email app.", 'error');
        window.location.href = 'mailto:info@princetires.ca?subject=' + encodeURIComponent('Missing tire: ' + vehicle);
      }).finally(function () {
        btn.disabled = false; btn.textContent = orig;
      });
    });
  })();
{% endjavascript %}
