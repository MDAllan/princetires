{% doc %}
  Empty state for the tires collection — shown when no products match
  the active filters. Includes a 'Clear all filters' shortcut and a
  miniature missing-vehicle form that POSTs to the same Google Sheet
  webhook used by the homepage smart-search and the tire-search widget.

  Also auto-fires the webhook on page load when the customer arrived
  with size filters but got zero results — captures the demand without
  requiring the customer to type anything. Dedup via sessionStorage so
  it only fires once per size combination per tab.

  @example
  {% render 'pt-collection-empty' %}
{% enddoc %}

{%- assign empty_webhook = settings.missing_vehicle_webhook_url -%}

<div class="ptg__empty" data-ptg-empty data-webhook="{{ empty_webhook | escape }}">
  <p class="ptg__empty-title">No products match your filters.</p>
  <p class="ptg__empty-sub">Try clearing some filters, or tell us what you're looking for — we'll get back to you.</p>
  <div class="ptg__empty-actions">
    <a href="{{ routes.collections_url }}/tires" class="ptg__empty-btn ptg__empty-btn--ghost">Browse all tires</a>
    <a href="#" class="ptg__empty-btn ptg__empty-btn--primary" data-clear-all-empty>Clear all filters</a>
  </div>
  {%- if empty_webhook != blank -%}
    <div class="ptg__empty-missing">
      <p>Don't see the tire you need?</p>
      <form data-empty-missing-form>
        <input type="text" placeholder="e.g. 2018 Subaru Crosstrek or 225/45R17" maxlength="120" required>
        <button type="submit">Tell us</button>
      </form>
      <p class="ptg__empty-missing-status" data-empty-missing-status aria-live="polite" hidden></p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ptg__empty {
    text-align: center;
    padding: 5rem 0;
    font-family: 'Outfit', sans-serif;
    color: #6b7280;
    font-size: 1.3rem;
  }
  .ptg__empty-title { font-size: 1.15rem; font-weight: 600; color: #111; margin: 0 0 0.35rem; }
  .ptg__empty-sub { color: #6b7280; margin: 0 0 1rem; line-height: 1.5; }
  .ptg__empty-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; margin-bottom: 1.2rem; }
  .ptg__empty-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .ptg__empty-btn--ghost { color: #374151; border: 1.5px solid #e5e7eb; }
  .ptg__empty-btn--ghost:hover { border-color: #9ca3af; color: #111; }
  .ptg__empty-btn--primary { background: #dc2626; color: #fff; }
  .ptg__empty-btn--primary:hover { background: #b91c1c; }
  .ptg__empty-missing {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
  }
  .ptg__empty-missing p { margin: 0 0 0.5rem; font-size: 0.9rem; color: #374151; }
  .ptg__empty-missing form { display: flex; gap: 0.5rem; }
  .ptg__empty-missing input {
    flex: 1;
    height: 38px;
    padding: 0 0.7rem;
    border: 1.5px solid #d1d5db;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;
  }
  .ptg__empty-missing input:focus { border-color: #dc2626; }
  .ptg__empty-missing button {
    background: #dc2626;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0 0.95rem;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .ptg__empty-missing button:hover { background: #b91c1c; }
  .ptg__empty-missing-status { font-size: 0.85rem; margin-top: 0.5rem !important; }
  .ptg__empty-missing-status.is-success { color: #15803d; }
  .ptg__empty-missing-status.is-error { color: #dc2626; }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-ptg-empty]');
    if (!root) return;
    var webhook = root.dataset.webhook || '';

    // ─── "Clear all filters" CTA ───────────────────────────────────────
    var clearBtn = root.querySelector('[data-clear-all-empty]');
    if (clearBtn) clearBtn.addEventListener('click', function (e) {
      e.preventDefault();
      window.location.href = window.location.pathname;
    });

    // ─── Auto-fire webhook when customer landed with size filters ──────
    // Only fires once per unique size combo per tab (sessionStorage dedup).
    try {
      var params = new URLSearchParams(window.location.search);
      var w = params.get('filter.p.m.custom.tire_width');
      var a = params.get('filter.p.m.custom.tire_profile');
      var r = params.get('filter.p.m.custom.rim_diameter');
      if (webhook && (w || a || r)) {
        var sizeStr = (w || '?') + '/' + (a || '?') + 'R' + (r || '?');
        var dedupKey = '__pt_empty_' + sizeStr;
        if (!sessionStorage.getItem(dedupKey)) {
          sessionStorage.setItem(dedupKey, '1');
          fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              vehicle:    'OUT OF STOCK: ' + sizeStr,
              year: '', make: '', model: '', trim: '',
              page_url:   window.location.href,
              user_agent: navigator.userAgent,
              timestamp:  new Date().toISOString()
            })
          }).catch(function () { /* best-effort */ });
        }
      }
    } catch (e) { /* never break the page */ }

    // ─── Missing-vehicle mini-form ────────────────────────────────────
    var form = root.querySelector('[data-empty-missing-form]');
    var status = root.querySelector('[data-empty-missing-status]');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = form.querySelector('input');
      var vehicle = (input.value || '').trim();
      if (!vehicle) return;
      var btn = form.querySelector('button');
      var orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending...';
      function setStatus(msg, kind) {
        status.textContent = msg;
        status.className = 'ptg__empty-missing-status' + (kind ? ' is-' + kind : '');
        status.hidden = !msg;
      }
      if (!webhook) {
        window.location.href = 'mailto:info@princetires.ca?subject=' + encodeURIComponent('Missing tire: ' + vehicle) +
          '&body=' + encodeURIComponent('Tire request: ' + vehicle + '\nPage: ' + window.location.href);
        btn.disabled = false; btn.textContent = orig;
        return;
      }
      fetch(webhook, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          vehicle:    'EMPTY-COLLECTION: ' + vehicle,
          year: '', make: '', model: '', trim: '',
          page_url:   window.location.href,
          user_agent: navigator.userAgent,
          timestamp:  new Date().toISOString()
        })
      }).then(function (r) {
        if (r.ok || r.status === 302) {
          setStatus("Thanks — we'll be in touch.", 'success');
          input.value = '';
        } else { throw new Error('HTTP ' + r.status); }
      }).catch(function () {
        setStatus("Couldn't send — opening your email app.", 'error');
        window.location.href = 'mailto:info@princetires.ca?subject=' + encodeURIComponent('Missing tire: ' + vehicle);
      }).finally(function () {
        btn.disabled = false; btn.textContent = orig;
      });
    });
  })();
{% endjavascript %}
