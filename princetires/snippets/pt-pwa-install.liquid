{% doc %}
  Renders a one-time install banner for the Prince Tires PWA.

  Behavior:
  - Only shown on mobile (viewport <= 768px) and never inside the Shopify theme editor.
  - On Android/Chrome it catches the `beforeinstallprompt` event and offers a real install.
  - On iOS Safari it shows static instructions ("Share → Add to Home Screen") since
    iOS does not expose a programmatic install API.
  - After the user dismisses or installs, the banner stays hidden for 30 days
    (per-device, via localStorage).

  @example
  {% render 'pt-pwa-install' %}
{% enddoc %}

{%- unless request.design_mode -%}
<div id="pt-pwa-install" class="pt-pwa-install" data-pt-pwa hidden aria-live="polite">
  <div class="pt-pwa-install__inner">
    <img
      class="pt-pwa-install__icon"
      alt=""
      width="44"
      height="44"
      src="{% if settings.favicon != blank %}{{ settings.favicon | image_url: width: 88, height: 88 }}{% endif %}"
      loading="lazy">
    <div class="pt-pwa-install__copy">
      <strong class="pt-pwa-install__title">Install Prince Tires</strong>
      <span class="pt-pwa-install__sub" id="pt-pwa-install__sub">Faster booking, one tap from your home screen.</span>
    </div>
    <button type="button" class="pt-pwa-install__cta" id="pt-pwa-install__cta">Install</button>
    <button type="button" class="pt-pwa-install__close" id="pt-pwa-install__close" aria-label="Dismiss">×</button>
  </div>
</div>
{%- endunless -%}

{% stylesheet %}
  .pt-pwa-install {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 9998;
    background: #fff;
    color: #111;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0,0,0,.18);
    padding: 12px;
    transform: translateY(120%);
    transition: transform .28s ease;
  }
  .pt-pwa-install.is-open { transform: translateY(0); }
  .pt-pwa-install__inner {
    display: grid;
    grid-template-columns: 44px 1fr auto auto;
    gap: 10px;
    align-items: center;
  }
  .pt-pwa-install__icon { border-radius: 10px; object-fit: cover; }
  .pt-pwa-install__copy { display: flex; flex-direction: column; min-width: 0; }
  .pt-pwa-install__title { font-size: 14px; line-height: 1.2; }
  .pt-pwa-install__sub { font-size: 12px; color: #555; line-height: 1.3; }
  .pt-pwa-install__cta {
    background: #000; color: #fff; border: 0; border-radius: 999px;
    padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  .pt-pwa-install__cta:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .pt-pwa-install__close {
    background: transparent; border: 0; font-size: 22px; line-height: 1;
    color: #777; cursor: pointer; padding: 4px 8px;
  }
  @media (min-width: 769px) { .pt-pwa-install { display: none; } }
{% endstylesheet %}

{% javascript %}
  (function () {
    var KEY = 'pt-pwa-install-dismissed';
    var DAYS = 30;
    var el = document.getElementById('pt-pwa-install');
    if (!el) return;

    // Mobile-only
    if (window.matchMedia('(min-width: 769px)').matches) return;

    // Already installed? Hide forever for this session.
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;
    if (isStandalone) return;

    // Recently dismissed?
    try {
      var until = parseInt(localStorage.getItem(KEY) || '0', 10);
      if (until && Date.now() < until) return;
    } catch (e) {}

    var sub = document.getElementById('pt-pwa-install__sub');
    var cta = document.getElementById('pt-pwa-install__cta');
    var closeBtn = document.getElementById('pt-pwa-install__close');
    var deferredPrompt = null;

    function show() {
      el.hidden = false;
      // next frame so the transition runs
      requestAnimationFrame(function () { el.classList.add('is-open'); });
    }
    function hideAndRemember() {
      el.classList.remove('is-open');
      setTimeout(function () { el.hidden = true; }, 280);
      try {
        localStorage.setItem(KEY, String(Date.now() + DAYS * 86400000));
      } catch (e) {}
    }

    var ua = navigator.userAgent || '';
    var isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
    var isSafari = isIOS && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);

    if (isIOS && isSafari) {
      // iOS: no programmatic install — show instructions.
      sub.textContent = 'Tap Share, then "Add to Home Screen".';
      cta.textContent = 'Got it';
      cta.addEventListener('click', hideAndRemember);
      closeBtn.addEventListener('click', hideAndRemember);
      show();
      return;
    }

    // Android / Chromium: wait for the install event.
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferredPrompt = e;
      show();
    });

    cta.addEventListener('click', function () {
      if (!deferredPrompt) { hideAndRemember(); return; }
      deferredPrompt.prompt();
      deferredPrompt.userChoice.finally(function () {
        deferredPrompt = null;
        hideAndRemember();
      });
    });
    closeBtn.addEventListener('click', hideAndRemember);

    window.addEventListener('appinstalled', function () {
      try { localStorage.setItem(KEY, String(Date.now() + 365 * 86400000)); } catch (e) {}
      el.hidden = true;
    });
  })();
{% endjavascript %}
