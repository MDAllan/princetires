  /* ---------- 3. tire size: iPhone-style picker instead of a plain text box ---------- */
  var SIZES_KEY = 'pt_sizes_v1';
  function loadSizes() {
    try { var c = JSON.parse(localStorage.getItem(SIZES_KEY) || 'null'); if (c && Date.now() - c.t < 432e5 && c.s.length) return Promise.resolve(c.s); } catch (e) {}
    var set = {}, re = /(\d{3})\/(\d{2})Z?R(\d{2})/i;
    function page(n) {
      return fetch('/collections/tires/products.json?limit=250&page=' + n).then(function (r) { return r.json(); }).then(function (j) {
        (j.products || []).forEach(function (p) { var m = p.title.match(re); if (m) set[m[1] + '/' + m[2] + '/' + m[3]] = 1; });
        return (j.products || []).length === 250 && n < 40 ? page(n + 1) : null;
      });
    }
    return page(1).then(function () {
      var s = Object.keys(set);
      try { localStorage.setItem(SIZES_KEY, JSON.stringify({ t: Date.now(), s: s })); } catch (e) {}
      return s;
    });
  }
  function uniq(a) { var o = {}; return a.filter(function (x) { return o[x] ? 0 : (o[x] = 1); }).sort(function (x, y) { return x - y; }); }

  function setupSize(input) {
    var ITEM = 44;
    var wrap = document.createElement('div');
    wrap.className = 'ptvs';
    wrap.hidden = true;
    wrap.innerHTML = '<div class="ptvs__backdrop" data-x></div><div class="ptvs__sheet ptfx-sheet" role="dialog" aria-modal="true" aria-label="Choose your tire size">' +
      '<div class="ptvs__grab"></div><div class="ptvs__head"><span></span><div class="ptvs__title">Tire size</div>' +
      '<button type="button" class="ptvs__iconbtn ptvs__close" aria-label="Close" data-x><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.5 1.5l9 9m0-9-9 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>' +
      '<div class="ptfx-body"><div class="ptfx-big" data-big>&nbsp;</div><div class="ptfx-heads"><span>Width</span><span>Aspect</span><span>Rim</span></div>' +
      '<div class="ptw" data-wheels><div class="ptw__band"></div><div class="ptw__col" data-c="w"></div><div class="ptw__col" data-c="p"></div><div class="ptw__col" data-c="r"></div></div>' +
      '<div class="ptfx-note">Only sizes we carry. It’s on the side of your tire.</div>' +
      '<button type="button" class="ptvs__cta" data-go>Show tires</button><a class="ptvs__alt" href="/" style="display:block;text-align:center">Don’t know your size? Search by vehicle</a></div></div>';
    document.body.appendChild(wrap);
    var sheet = wrap.querySelector('.ptvs__sheet'), big = wrap.querySelector('[data-big]'), go = wrap.querySelector('[data-go]');
    var cols = { w: wrap.querySelector('[data-c="w"]'), p: wrap.querySelector('[data-c="p"]'), r: wrap.querySelector('[data-c="r"]') };
    var sizes = [], sel = { w: null, p: null, r: null }, timers = {};

    function opts(c) {
      if (c === 'w') return uniq(sizes.map(function (s) { return s[0]; }));
      if (c === 'p') return uniq(sizes.filter(function (s) { return s[0] === sel.w; }).map(function (s) { return s[1]; }));
      return uniq(sizes.filter(function (s) { return s[0] === sel.w && s[1] === sel.p; }).map(function (s) { return s[2]; }));
    }
    function fill(c, keep) {
      var list = opts(c), col = cols[c];
      col.innerHTML = '<div class="ptw__pad"></div>' + list.map(function (v) { return '<div class="ptw__item" data-v="' + v + '">' + (c === 'r' ? 'R' + v : v) + '</div>'; }).join('') + '<div class="ptw__pad"></div>';
      var i = Math.max(0, list.indexOf(keep));
      sel[c] = list[i] || null;
      col.scrollTop = i * ITEM;
      mark(c);
    }
    function mark(c) {
      var i = Math.round(cols[c].scrollTop / ITEM);
      Array.prototype.forEach.call(cols[c].querySelectorAll('.ptw__item'), function (el, k) { el.classList.toggle('is-sel', k === i); });
    }
    function paint() {
      var t = sel.w && sel.p && sel.r ? sel.w + '/' + sel.p + 'R' + sel.r : '';
      big.textContent = t || ' ';
      go.textContent = t ? 'Show ' + t + ' tires' : 'Show tires';
    }
    function settle(c) {
      var items = cols[c].querySelectorAll('.ptw__item');
      var i = Math.min(items.length - 1, Math.max(0, Math.round(cols[c].scrollTop / ITEM)));
      var v = items[i] ? items[i].getAttribute('data-v') : null;
      if (v === sel[c]) return;
      sel[c] = v; buzz();
      if (c === 'w') { fill('p', sel.p); fill('r', sel.r); }
      if (c === 'p') fill('r', sel.r);
      paint();
    }
    Object.keys(cols).forEach(function (c) {
      cols[c].addEventListener('scroll', function () {
        requestAnimationFrame(function () { mark(c); });
        clearTimeout(timers[c]); timers[c] = setTimeout(function () { settle(c); }, 130);
      }, { passive: true });
      cols[c].addEventListener('click', function (e) {
        var it = e.target.closest('.ptw__item'); if (!it) return;
        var k = Array.prototype.indexOf.call(cols[c].querySelectorAll('.ptw__item'), it);
        cols[c].scrollTo({ top: k * ITEM, behavior: 'smooth' });
      });
    });
    function open() {
      wrap.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(function () { requestAnimationFrame(function () { wrap.classList.add('is-open'); }); });
      if (sizes.length) return;
      big.textContent = 'Loading sizes…';
      loadSizes().then(function (s) {
        sizes = s.map(function (x) { return x.split('/'); });
        var cur = new URLSearchParams(location.search);
        sel.w = cur.get(SIZE_KEYS[0]) || '225'; sel.p = cur.get(SIZE_KEYS[1]) || '65'; sel.r = cur.get(SIZE_KEYS[2]) || '17';
        var want = { w: sel.w, p: sel.p, r: sel.r };
        fill('w', want.w); fill('p', want.p); fill('r', want.r); paint();
      }).catch(function () { big.textContent = 'Couldn’t load sizes. Call 403 452 4283.'; });
    }
    function close() {
      wrap.classList.remove('is-open'); document.documentElement.style.overflow = '';
      setTimeout(function () { wrap.hidden = true; }, 420);
    }
    wrap.addEventListener('click', function (e) { if (e.target.closest('[data-x]')) close(); });
    document.addEventListener('keydown', function (e) { if (!wrap.hidden && e.key === 'Escape') close(); });
    go.addEventListener('click', function () {
      if (!(sel.w && sel.p && sel.r)) return;
      buzz(); go.textContent = 'Loading…';
      var p = new URLSearchParams(location.search);
      SIZE_KEYS.forEach(function (k) { p.delete(k); });
      p.delete('page');
      p.append(SIZE_KEYS[0], sel.w); p.append(SIZE_KEYS[1], sel.p); p.append(SIZE_KEYS[2], sel.r);
      location.href = urlFor(p);
    });
    var box = input.closest('[data-size-display]') || input.parentElement;
    box.classList.add('ptfx-sizebox');
    var chg = document.createElement('button');
    chg.type = 'button'; chg.className = 'ptfx-change'; chg.textContent = input.value ? 'Change' : 'Pick size';
    (input.parentElement).insertBefore(chg, input.nextSibling);
    input.readOnly = true;
    input.setAttribute('aria-haspopup', 'dialog');
    function openFromBox(e) { e.preventDefault(); e.stopImmediatePropagation(); input.blur(); buzz(); open(); }
    input.addEventListener('click', openFromBox, true);
    input.addEventListener('focus', openFromBox, true);
    chg.addEventListener('click', openFromBox);
    var y0 = null, dy = 0;
    sheet.querySelector('.ptvs__head').addEventListener('touchstart', function (e) { y0 = e.touches[0].clientY; dy = 0; wrap.classList.add('is-dragging'); }, { passive: true });
    window.addEventListener('touchmove', function (e) { if (y0 === null) return; dy = Math.max(0, e.touches[0].clientY - y0); sheet.style.transform = 'translateY(' + dy + 'px)'; }, { passive: true });
    window.addEventListener('touchend', function () { if (y0 === null) return; y0 = null; wrap.classList.remove('is-dragging'); sheet.style.transform = ''; if (dy > 110) close(); });
  }

  function init() {
    var sb = document.querySelector('aside.ptg__sidebar');
    if (!sb || sb.getAttribute('data-ptfx')) return;
    sb.setAttribute('data-ptfx', '1');
    setupGroups(sb);
    setupBatch(sb);
    var inp = document.querySelector('[data-size-edit]');
    if (inp && noun === 'tires') setupSize(inp);
  }
  function later() { setTimeout(init, 0); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', later); else later();
})();
</script>