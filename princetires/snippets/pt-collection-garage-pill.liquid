{% doc %}
  My Garage chip — minimal pill rendered inline with the 'Showing X tires'
  row. Click to open a popover with the picker / sign-in CTA / add-vehicle
  CTA. Hidden until JS confirms the customer state.

  Sources, in priority order:
    1. pt-garage-{customerId} localStorage — default vehicle (logged-in customers)
    2. pt-tire-search-vehicle localStorage — last-used search vehicle (everyone)

  Not rendered for wholesale customers (business account, not personal).

  @example
  {% render 'pt-collection-garage-pill' %}
{% enddoc %}

{%- if customer.tags contains 'wholesale' -%}{%- comment -%}wholesale: skip{%- endcomment -%}{%- else -%}
<div class="pt-gp" data-pt-gp data-logged-in="{%- if customer -%}1{%- else -%}0{%- endif -%}" hidden>
  {%- comment -%} Has-state chip: button that opens a popover {%- endcomment -%}
  <button type="button" class="pt-gp__chip pt-gp__chip--has" data-pt-gp-chip-has aria-haspopup="true" aria-expanded="false" hidden>
    <span class="pt-gp__chip-label" data-pt-gp-chip-label>Garage</span>
    <span class="pt-gp__chip-badge" data-pt-gp-chip-badge hidden></span>
    <svg class="pt-gp__chevron" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>

  {%- comment -%} Sign-in chip: anchor that goes straight to login {%- endcomment -%}
  <a class="pt-gp__chip pt-gp__chip--link" data-pt-gp-signin href="{{ routes.account_login_url }}" hidden>
    Sign in to use your saved car
  </a>

  {%- comment -%} Add chip: anchor to the garage page #add anchor {%- endcomment -%}
  <a class="pt-gp__chip pt-gp__chip--link" data-pt-gp-add href="/pages/garage#add" hidden>
    Add a car
  </a>

  {%- comment -%} Has-state popover {%- endcomment -%}
  <div class="pt-gp__popover" data-pt-gp-popover hidden>
    <label class="pt-gp__pop-label">Your saved car</label>
    <select class="pt-gp__picker" data-pt-gp-picker aria-label="Pick a saved vehicle"></select>
    <button type="button" class="pt-gp__apply" data-pt-gp-apply>Apply →</button>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .pt-gp {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    font-family: 'Outfit', sans-serif;
  }
  .pt-gp[hidden] { display: none; }

  .pt-gp__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 28px;
    padding: 0 0.55rem;
    background: rgba(220,38,38,0.06);
    color: #dc2626;
    border: 1px solid rgba(220,38,38,0.35);
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition: background 0.15s, border-color 0.15s;
  }
  .pt-gp__chip:hover { background: rgba(220,38,38,0.12); border-color: #dc2626; }
  .pt-gp__chip[aria-expanded="true"] .pt-gp__chevron { transform: rotate(180deg); }
  .pt-gp__chip[hidden] { display: none; }
  .pt-gp__chip--link { text-decoration: none; }

  .pt-gp__icon-svg { flex-shrink: 0; }
  .pt-gp__icon-img { width: 14px; height: 14px; object-fit: contain; }

  .pt-gp__chip-label {
    max-width: 11ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pt-gp__chevron { flex-shrink: 0; transition: transform 0.15s; opacity: 0.7; }

  .pt-gp__chip-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: #dc2626;
    color: #fff;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
  }
  .pt-gp__chip-badge[hidden] { display: none; }

  .pt-gp__popover {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 220px;
    max-width: calc(100vw - 2rem);
    padding: 0.75rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    z-index: 200;
    font-size: 0.85rem;
    color: #111;
  }
  .pt-gp__popover[hidden] { display: none; }

  .pt-gp__pop-label {
    display: block;
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pt-gp__picker {
    width: 100%;
    height: 34px;
    padding: 0 0.55rem;
    margin-bottom: 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fff;
    font-family: inherit;
    font-size: 0.88rem;
    color: #111;
    cursor: pointer;
  }

  .pt-gp__apply {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 34px;
    padding: 0 0.85rem;
    background: #dc2626;
    color: #fff;
    border: 0;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .pt-gp__apply:hover { background: #b91c1c; }

  @media (max-width: 600px) {
    .pt-gp__chip { padding: 0 0.5rem; height: 26px; font-size: 0.72rem; }
    .pt-gp__chip-label { max-width: 8ch; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-pt-gp]');
    if (!root) return;
    var chipHas = root.querySelector('[data-pt-gp-chip-has]');
    var chipLabel = root.querySelector('[data-pt-gp-chip-label]');
    var popover = root.querySelector('[data-pt-gp-popover]');
    var picker = root.querySelector('[data-pt-gp-picker]');
    var applyBtn = root.querySelector('[data-pt-gp-apply]');
    var chipSignin = root.querySelector('[data-pt-gp-signin]');
    var chipAdd = root.querySelector('[data-pt-gp-add]');
    var isLoggedIn = root.dataset.loggedIn === '1';

    function showState(name) {
      chipHas.hidden = name !== 'has';
      chipSignin.hidden = name !== 'signin';
      chipAdd.hidden = name !== 'add';
      root.hidden = false;
    }
    function setChip(label) { if (chipLabel) chipLabel.textContent = label; }

    // ─── Collect every saved vehicle ───────────────────────────────────
    var vehicles = [];
    try {
      Object.keys(localStorage).filter(function (k) {
        return k.indexOf('pt-garage-') === 0;
      }).forEach(function (k) {
        var arr = JSON.parse(localStorage.getItem(k) || '[]');
        if (Array.isArray(arr)) arr.forEach(function (v) {
          if (v && v.year && v.make && v.model) {
            vehicles.push({
              source: 'garage', isDefault: !!v.isDefault,
              year: v.year, make: v.make, model: v.model,
              trim: v.trim || '', nickname: v.nickname || '',
              size: v.tireSize || (v.sizes && v.sizes[0]) || ''
            });
          }
        });
      });
    } catch (e) {}
    try {
      var raw = localStorage.getItem('pt-tire-search-vehicle');
      if (raw) {
        var ts = JSON.parse(raw);
        if (ts && ts.year && ts.make && ts.model) {
          var firstSize = ts.sizes && ts.sizes.length ? ts.sizes[0] : '';
          var dup = vehicles.some(function (v) {
            return v.year === ts.year && v.make === ts.make && v.model === ts.model && v.trim === (ts.trim || '');
          });
          if (!dup) {
            vehicles.push({
              source: 'search', isDefault: false,
              year: ts.year, make: ts.make, model: ts.model,
              trim: ts.trim || '', nickname: '',
              size: firstSize
            });
          }
        }
      }
    } catch (e) {}

    vehicles = vehicles.filter(function (v) { return v.size; });

    if (vehicles.length === 0) {
      if (isLoggedIn) {
        setChip('Add car');
        showState('add');
      } else {
        setChip('Sign in');
        showState('signin');
      }
    } else {
      vehicles.sort(function (a, b) {
        if (a.isDefault !== b.isDefault) return a.isDefault ? -1 : 1;
        if (a.source !== b.source) return a.source === 'garage' ? -1 : 1;
        return 0;
      });
      var html = '';
      vehicles.forEach(function (v, i) {
        var name = v.nickname || (v.year + ' ' + v.make + ' ' + v.model + (v.trim ? ' ' + v.trim : ''));
        html += '<option value="' + i + '">' + name.replace(/"/g, '&quot;') + ' (' + v.size + ')</option>';
      });
      picker.innerHTML = html;
      var primary = vehicles[0];
      setChip(primary.nickname || (primary.make + ' ' + primary.model));
      var badge = root.querySelector('[data-pt-gp-chip-badge]');
      if (badge && vehicles.length > 1) {
        badge.textContent = '+' + (vehicles.length - 1);
        badge.hidden = false;
      }
      showState('has');
    }

    // ─── Popover open/close (only on has-state chip) ────────────────────
    function openPopover() {
      popover.hidden = false;
      chipHas.setAttribute('aria-expanded', 'true');
    }
    function closePopover() {
      popover.hidden = true;
      chipHas.setAttribute('aria-expanded', 'false');
    }
    chipHas.addEventListener('click', function (e) {
      e.stopPropagation();
      if (popover.hidden) openPopover(); else closePopover();
    });
    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) closePopover();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !popover.hidden) { closePopover(); chipHas.focus(); }
    });

    // ─── Apply: navigate with the picked vehicle's size as filter ──────
    function parseSize(s) {
      var m = String(s || '').match(/(\d{3})\s*\/\s*(\d{2,3})\s*R\s*(\d{2})/i);
      return m ? { w: m[1], a: m[2], r: m[3] } : null;
    }
    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        var v = vehicles[parseInt(picker.value, 10) || 0];
        if (!v) return;
        var parts = parseSize(v.size);
        if (!parts) return;
        var params = new URLSearchParams(window.location.search);
        var newParams = new URLSearchParams();
        params.forEach(function (val, k) {
          if (k === 'filter.p.vendor' ||
              k === 'filter.p.m.custom.seasonality' ||
              k === 'filter.p.m.custom.service_type') {
            newParams.append(k, val);
          }
        });
        newParams.set('filter.p.m.custom.tire_width', parts.w);
        newParams.set('filter.p.m.custom.tire_profile', parts.a);
        newParams.set('filter.p.m.custom.rim_diameter', parts.r);
        window.location.href = window.location.pathname + '?' + newParams.toString();
      });
    }
  })();
{% endjavascript %}
