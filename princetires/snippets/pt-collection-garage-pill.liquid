{% doc %}
  My Garage pill — sits above the re-search strip on the collection page.
  Renders a "Use my saved car" shortcut for customers who already have a
  vehicle on file (either from a prior tire-search, or from the My Garage
  feature for logged-in customers).

  Sources, in priority order:
    1. pt-garage-{customerId} localStorage — default vehicle (logged-in customers)
    2. pt-tire-search-vehicle localStorage — last-used search vehicle (everyone)

  Hidden by default — only shown after JS confirms a saved vehicle exists.

  @example
  {% render 'pt-collection-garage-pill' %}
{% enddoc %}

<div class="pt-gp" data-pt-gp data-logged-in="{%- if customer -%}1{%- else -%}0{%- endif -%}" hidden>
  <span class="pt-gp__icon" aria-hidden="true">
    {%- if settings.garage_pill_icon -%}
      {{ settings.garage_pill_icon | image_url: width: 32 | image_tag: class: 'pt-gp__icon-img', loading: 'lazy', alt: '' }}
    {%- else -%}
      <svg width="20" height="14" viewBox="0 0 80 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20 L12 13 L22 9 L58 9 L68 13 L76 17 L76 22 L4 22 Z"/>
        <circle cx="18" cy="24" r="5"/>
        <circle cx="62" cy="24" r="5"/>
      </svg>
    {%- endif -%}
  </span>

  {%- comment -%} State A — has a saved vehicle (filled in by JS) {%- endcomment -%}
  <span class="pt-gp__has" data-pt-gp-has hidden>
    <span class="pt-gp__label">Your saved car</span>
    <select class="pt-gp__picker" data-pt-gp-picker aria-label="Pick a saved vehicle"></select>
    <button type="button" class="pt-gp__apply" data-pt-gp-apply>Apply →</button>
  </span>

  {%- comment -%} State B — guest, no saved vehicle → sign-in CTA {%- endcomment -%}
  <span class="pt-gp__signin" data-pt-gp-signin hidden>
    <span class="pt-gp__label">Sign in to see your saved cars</span>
    <a class="pt-gp__signin-cta" href="{{ routes.account_login_url }}">Sign in →</a>
  </span>

  {%- comment -%} State C — logged in but garage is empty → add-vehicle CTA {%- endcomment -%}
  <span class="pt-gp__add" data-pt-gp-add hidden>
    <span class="pt-gp__label">No cars in your garage yet</span>
    <a class="pt-gp__signin-cta" href="/pages/garage#add">Add a vehicle →</a>
  </span>
</div>

{% stylesheet %}
  .pt-gp {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    padding: 0.6rem 0.9rem;
    background: linear-gradient(90deg, rgba(220,38,38,0.08), rgba(220,38,38,0.02));
    border: 1px solid rgba(220,38,38,0.25);
    border-radius: 10px;
    font-family: 'Outfit', sans-serif;
  }

  .pt-gp[hidden] { display: none; }

  .pt-gp__icon {
    color: #dc2626;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    width: 22px;
    height: 22px;
    justify-content: center;
  }

  .pt-gp__icon-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .pt-gp__label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
    flex-shrink: 0;
  }

  .pt-gp__picker {
    flex: 1 1 auto;
    min-width: 0;
    height: 34px;
    padding: 0 0.55rem;
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: #111;
    cursor: pointer;
  }

  .pt-gp__apply {
    height: 34px;
    padding: 0 0.9rem;
    background: #dc2626;
    color: #fff;
    border: 0;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }

  .pt-gp__apply:hover { background: #b91c1c; }

  .pt-gp__has,
  .pt-gp__signin,
  .pt-gp__add {
    display: contents;
  }

  .pt-gp__has[hidden],
  .pt-gp__signin[hidden],
  .pt-gp__add[hidden] { display: none; }

  .pt-gp__signin-cta {
    height: 34px;
    padding: 0 0.9rem;
    background: #dc2626;
    color: #fff;
    border: 0;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-left: auto;
  }

  .pt-gp__signin-cta:hover { background: #b91c1c; }

  @media (max-width: 600px) {
    .pt-gp {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .pt-gp__label { flex-basis: 100%; }
    .pt-gp__picker { flex: 1 1 60%; }
    .pt-gp__apply { flex: 0 0 auto; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-pt-gp]');
    if (!root) return;
    var picker = root.querySelector('[data-pt-gp-picker]');
    var applyBtn = root.querySelector('[data-pt-gp-apply]');
    var stateHas = root.querySelector('[data-pt-gp-has]');
    var stateSignin = root.querySelector('[data-pt-gp-signin]');
    var stateAdd = root.querySelector('[data-pt-gp-add]');
    var isLoggedIn = root.dataset.loggedIn === '1';

    function showState(name) {
      if (stateHas) stateHas.hidden = name !== 'has';
      if (stateSignin) stateSignin.hidden = name !== 'signin';
      if (stateAdd) stateAdd.hidden = name !== 'add';
      root.hidden = false;
    }

    // ─── Collect every saved vehicle ───────────────────────────────────
    var vehicles = [];
    try {
      var garageKeys = Object.keys(localStorage).filter(function (k) {
        return k.indexOf('pt-garage-') === 0;
      });
      garageKeys.forEach(function (k) {
        var arr = JSON.parse(localStorage.getItem(k) || '[]');
        if (Array.isArray(arr)) {
          arr.forEach(function (v) {
            if (v && v.year && v.make && v.model) {
              vehicles.push({
                source: 'garage',
                isDefault: !!v.isDefault,
                year: v.year,
                make: v.make,
                model: v.model,
                trim: v.trim || '',
                nickname: v.nickname || '',
                size: v.tireSize || (v.sizes && v.sizes[0]) || ''
              });
            }
          });
        }
      });
    } catch (e) {}

    try {
      var raw = localStorage.getItem('pt-tire-search-vehicle');
      if (raw) {
        var ts = JSON.parse(raw);
        if (ts && ts.year && ts.make && ts.model) {
          var firstSize = ts.sizes && ts.sizes.length ? ts.sizes[0] : '';
          // Only add if NOT already represented by a garage entry
          var dup = vehicles.some(function (v) {
            return v.year === ts.year && v.make === ts.make && v.model === ts.model && v.trim === (ts.trim || '');
          });
          if (!dup) {
            vehicles.push({
              source: 'search',
              isDefault: false,
              year: ts.year, make: ts.make, model: ts.model,
              trim: ts.trim || '', nickname: '',
              size: firstSize
            });
          }
        }
      }
    } catch (e) {}

    // ─── Drop entries with no size — they can't be applied ─────────────
    vehicles = vehicles.filter(function (v) { return v.size; });
    if (vehicles.length === 0) {
      // No saved cars — show the right CTA based on auth state
      if (isLoggedIn) showState('add');
      else showState('signin');
      return;
    }

    // ─── Sort: default garage vehicle first, then garage, then search ──
    vehicles.sort(function (a, b) {
      if (a.isDefault !== b.isDefault) return a.isDefault ? -1 : 1;
      if (a.source !== b.source) return a.source === 'garage' ? -1 : 1;
      return 0;
    });

    // ─── Build the picker options ──────────────────────────────────────
    function vehicleLabel(v) {
      var name = v.nickname || (v.year + ' ' + v.make + ' ' + v.model + (v.trim ? ' ' + v.trim : ''));
      return name + ' (' + v.size + ')';
    }
    var html = '';
    vehicles.forEach(function (v, i) {
      html += '<option value="' + i + '">' + vehicleLabel(v).replace(/"/g, '&quot;') + '</option>';
    });
    picker.innerHTML = html;

    // ─── Reveal the pill in 'has' state ────────────────────────────────
    showState('has');

    // ─── Apply: navigate to the collection with the size as filter ─────
    function parseSize(s) {
      var m = String(s || '').match(/(\d{3})\s*\/\s*(\d{2,3})\s*R\s*(\d{2})/i);
      return m ? { w: m[1], a: m[2], r: m[3] } : null;
    }

    applyBtn.addEventListener('click', function () {
      var v = vehicles[parseInt(picker.value, 10) || 0];
      if (!v) return;
      var parts = parseSize(v.size);
      if (!parts) return;
      var params = new URLSearchParams(window.location.search);
      var newParams = new URLSearchParams();
      // Keep vendor + season + service_type from the current URL
      params.forEach(function (val, k) {
        if (k === 'filter.p.vendor' ||
            k === 'filter.p.m.custom.seasonality' ||
            k === 'filter.p.m.custom.service_type') {
          newParams.append(k, val);
        }
      });
      newParams.set('filter.p.m.custom.tire_width', parts.w);
      newParams.set('filter.p.m.custom.tire_profile', parts.a);
      newParams.set('filter.p.m.custom.rim_diameter', parts.r);
      window.location.href = window.location.pathname + '?' + newParams.toString();
    });
  })();
{% endjavascript %}
