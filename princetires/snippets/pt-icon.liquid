{% doc %}
  Prince Tires icon set (redesign 2026-11-13). Original, drawn in-house:
  24 grid, 1.75 line, round caps and joins, currentColor. Source sheet:
  canvas Icons.dc.html (approved by the owner).

  Rule from the sheet: use an icon only where it helps someone act or scan
  (cart button, lead-time line, phone Filters button, basic controls).
  Seasons use their icon next to the word, never alone (tire results v16:
  card tag, Season filter, chips, phone quick row). "Request install" and
  the Filters heading stay as words.

  Decorative by default (aria-hidden, focusable=false). Pass `label` only when
  the icon is the ONLY content of a control - better still, put aria-label on
  the button and leave the icon decorative.

  The knob / badge circles (ready-today, ready-days, filter) are filled with
  var(--rd-icon-bg, #fff) so they cut out cleanly on any background; set
  --rd-icon-bg on the parent when the icon sits on a tinted tile.

  Names:
    Lead time   ready-today (tire + tick) · ready-days (tire + clock) · order-in (box) · clock
    Shopping    cart (cart with plus) · search · filter · change-size · compare
    Seasons     winter (snowflake) · all-weather · all-season · summer · severe-snow (3PMSF peaks; tires only)
    Tire facts  studs · road-hazard · speed · load · tire · wheel · car
    Controls    chevron-down · chevron-up · chevron-left · chevron-right · arrow-right ·
                close · check · plus · minus · menu · info · alert · share
    Contact     phone · map-pin · calendar
    Reviews     star (filled; only next to a REAL rating)
  Aliases: lead-today, lead-days, box, filters, sliders, back, x, snowflake, pin, location, tick.

  @param {string} name - Icon name (see above). Unknown name = renders nothing.
  @param {number} [size] - Width/height in px. Default 24.
  @param {string} [class] - Extra classes.
  @param {string} [label] - Accessible name; makes the svg role="img".

  @example
    {% render 'pt-icon', name: 'cart', size: 20 %}
{% enddoc %}
{%- liquid
  assign ic_size = size | default: 24
  assign ic_bg = 'fill:var(--rd-icon-bg,#fff)'
  capture ic_body
    case name
      when 'ready-today', 'lead-today'
        echo '<circle cx="10" cy="10" r="7.5"/><circle cx="10" cy="10" r="3"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2"/><circle cx="17.5" cy="17.5" r="5" style="' | append: ic_bg | append: '"/><path d="M15.3 17.6l1.5 1.5 2.9-3.1"/>'
      when 'ready-days', 'lead-days'
        echo '<circle cx="10" cy="10" r="7.5"/><circle cx="10" cy="10" r="3"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2"/><circle cx="17.5" cy="17.5" r="5" style="' | append: ic_bg | append: '"/><path d="M17.5 15.2v2.4l1.7 1.1"/>'
      when 'order-in', 'box'
        echo '<path d="M3.5 8L12 4l8.5 4v8.5L12 20.5l-8.5-4zM3.5 8L12 12l8.5-4M12 12v8.5"/>'
      when 'clock'
        echo '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'
      when 'cart'
        echo '<path d="M2.5 4h2.3l2 10.5h10.7l2-7.5H6"/><circle cx="9" cy="19" r="1.8"/><circle cx="16.5" cy="19" r="1.8"/><path d="M12.3 8.7v3.6M10.5 10.5h3.6"/>'
      when 'search'
        echo '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.9-3.9"/>'
      when 'filter', 'filters', 'sliders'
        echo '<path d="M3 6h18M3 12h18M3 18h18"/><circle cx="15.5" cy="6" r="2" style="' | append: ic_bg | append: '"/><circle cx="8.5" cy="12" r="3" style="' | append: ic_bg | append: '"/><circle cx="8.5" cy="12" r=".9" fill="currentColor"/><circle cx="16" cy="18" r="2" style="' | append: ic_bg | append: '"/>'
      when 'change-size'
        echo '<rect x="4" y="3" width="9" height="18" rx="3.5"/><path d="M4 8.5h9M4 12h9M4 15.5h9"/><path d="M18 5v14M16.2 6.8L18 5l1.8 1.8M16.2 17.2L18 19l1.8-1.8"/>'
      when 'compare'
        echo '<rect x="3" y="4" width="6.5" height="16" rx="2.5"/><rect x="14.5" y="4" width="6.5" height="16" rx="2.5"/><path d="M3 9h6.5M3 15h6.5M14.5 9H21M14.5 15H21"/><path d="M11 12h2"/>'
      when 'winter', 'snowflake'
        echo '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.8 4.8L12 7l2.2-2.2M9.8 19.2L12 17l2.2 2.2"/>'
      when 'all-weather'
        echo '<path d="M12 3v18M12 8a4 4 0 0 0 0 8M3 12h2.5M5.6 5.6l1.8 1.8M5.6 18.4l1.8-1.8M12 12h8.5M12 12l5.5-5.5M12 12l5.5 5.5"/>'
      when 'all-season'
        echo '<path d="M7.5 19h9a3.5 3.5 0 0 0 .4-7 5 5 0 0 0-9.5-1.3A3.2 3.2 0 0 0 7.5 19zM4 6.5l1.2 1.2M7.5 3.5v1.7M2.5 10h1.7"/>'
      when 'summer'
        echo '<circle cx="12" cy="12" r="4"/><path d="M12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>'
      when 'severe-snow', '3pmsf'
        echo '<path d="M2.5 19.5L8 11l2.4 3.4L15 6l6.5 13.5z"/><path d="M15 12.6v4.6M13 13.8l4 2.3M17 13.8l-4 2.3" style="stroke:var(--rd-icon-accent,#e8740a)"/>'
      when 'studs'
        echo '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="5.8" r=".8" fill="currentColor"/><circle cx="17.4" cy="9" r=".8" fill="currentColor"/><circle cx="17.4" cy="15" r=".8" fill="currentColor"/><circle cx="12" cy="18.2" r=".8" fill="currentColor"/><circle cx="6.6" cy="15" r=".8" fill="currentColor"/><circle cx="6.6" cy="9" r=".8" fill="currentColor"/>'
      when 'road-hazard'
        echo '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M9.5 9l5 5" style="stroke:var(--rd-icon-accent,#e8740a)"/><circle cx="9" cy="8.5" r="1.2" style="fill:var(--rd-icon-accent,#e8740a);stroke:var(--rd-icon-accent,#e8740a)"/>'
      when 'speed'
        echo '<path d="M3.5 16a8.5 8.5 0 0 1 17 0"/><path d="M12 7.5v1.5M6 10l1 1M18 10l-1 1M4.6 16h1.4M18 16h1.4"/><path d="M12 16l4-4.5"/><circle cx="12" cy="16" r="1.4"/>'
      when 'load'
        echo '<path d="M7 9.5h10l2 10.5H5z"/><path d="M9.5 9.5a2.5 2.5 0 0 1 5 0"/><path d="M12 3v3"/>'
      when 'tire'
        echo '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/>'
      when 'wheel', 'rim'
        echo '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="6.2"/><circle cx="12" cy="12" r="2.3"/><path d="M12 9.7V5.8M14.2 11.3l3.7-1.2M13.4 13.9l2.2 3.1M10.6 13.9l-2.2 3.1M9.8 11.3l-3.7-1.2"/>'
      when 'car'
        echo '<path d="M3 15.5l1.6-5a2 2 0 0 1 1.9-1.4h11a2 2 0 0 1 1.9 1.4l1.6 5v2.5h-18z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>'
      when 'chevron-down'
        echo '<path d="M6 9l6 6 6-6"/>'
      when 'chevron-up'
        echo '<path d="M6 15l6-6 6 6"/>'
      when 'chevron-left', 'back'
        echo '<path d="M15 6l-6 6 6 6"/>'
      when 'chevron-right'
        echo '<path d="M9 6l6 6-6 6"/>'
      when 'arrow-right'
        echo '<path d="M5 12h14M13 6l6 6-6 6"/>'
      when 'close', 'x'
        echo '<path d="M6 6l12 12M18 6L6 18"/>'
      when 'check', 'tick'
        echo '<path d="M5 12.5l4.5 4.5L19 7.5"/>'
      when 'plus'
        echo '<path d="M12 5v14M5 12h14"/>'
      when 'minus'
        echo '<path d="M5 12h14"/>'
      when 'menu'
        echo '<path d="M4 7h16M4 12h16M4 17h16"/>'
      when 'info'
        echo '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8v.1"/>'
      when 'alert'
        echo '<path d="M12 3.5L21.5 20h-19z"/><path d="M12 10v4.5M12 17.2v.1"/>'
      when 'share'
        echo '<circle cx="18" cy="5.5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="18.5" r="2.5"/><path d="M8.2 10.8l7.6-4.1M8.2 13.2l7.6 4.1"/>'
      when 'phone'
        echo '<path d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5z"/>'
      when 'map-pin', 'pin', 'location'
        echo '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>'
      when 'calendar'
        echo '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>'
      when 'star'
        echo '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" fill="currentColor" stroke="none"/>'
    endcase
  endcapture
-%}
{%- if ic_body != blank -%}
<svg class="rd-ico rd-ico--{{ name }}{% if class != blank %} {{ class }}{% endif %}" width="{{ ic_size }}" height="{{ ic_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true"{% endif %}>{{ ic_body }}</svg>
{%- endif -%}
