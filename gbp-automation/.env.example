# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
# From your OAuth "Web application" client (Google Cloud > Clients):
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret

# From the OAuth Playground (the long string starting with 1//):
REFRESH_TOKEN=1//your-refresh-token

# Fill this by running:  node resolve-ids.mjs   (it prints the value)
GBP_V4_PARENT=accounts/000000000000/locations/0000000000000000
